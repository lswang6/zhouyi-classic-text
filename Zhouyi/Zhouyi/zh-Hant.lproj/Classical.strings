/* 周易 · 繁體中文（台灣）· 卦辭、爻辭（據通行本） */
"hex.1.ci" = "元亨利貞。";
"hex.1.yao.0" = "潛龍勿用。";
"hex.1.yao.1" = "見龍在田，利見大人。";
"hex.1.yao.2" = "君子終日乾乾，夕惕若厲，無咎。";
"hex.1.yao.3" = "或躍在淵，無咎。";
"hex.1.yao.4" = "飛龍在天，利見大人。";
"hex.1.yao.5" = "亢龍有悔。";
"hex.2.ci" = "元亨，利牝馬之貞。君子有攸往，先迷後得主，利。西南得朋，東北喪朋。安貞吉。";
"hex.2.yao.0" = "履霜，堅冰至。";
"hex.2.yao.1" = "直方大，不習無不利。";
"hex.2.yao.2" = "含章可貞。或從王事，無成有終。";
"hex.2.yao.3" = "括囊，無咎無譽。";
"hex.2.yao.4" = "黃裳，元吉。";
"hex.2.yao.5" = "龍戰于野，其血玄黃。";
"hex.3.ci" = "元亨利貞，勿用有攸往，利建侯。";
"hex.3.yao.0" = "磐桓，利居貞，利建侯。";
"hex.3.yao.1" = "屯如邅如，乘馬班如。匪寇婚媾，女子貞不字，十年乃字。";
"hex.3.yao.2" = "即鹿無虞，惟入于林中，君子幾不如舍，往吝。";
"hex.3.yao.3" = "乘馬班如，求婚媾，往吉，無不利。";
"hex.3.yao.4" = "屯其膏，小貞吉，大貞凶。";
"hex.3.yao.5" = "乘馬班如，泣血漣如。";
"hex.4.ci" = "亨。匪我求童蒙，童蒙求我。初筮告，再三瀆，瀆則不告。利貞。";
"hex.4.yao.0" = "發蒙，利用刑人，用說桎梏，以往吝。";
"hex.4.yao.1" = "包蒙吉，納婦吉，子克家。";
"hex.4.yao.2" = "勿用取女，見金夫，不有躬，無攸利。";
"hex.4.yao.3" = "困蒙，吝。";
"hex.4.yao.4" = "童蒙，吉。";
"hex.4.yao.5" = "擊蒙，不利為寇，利禦寇。";
"hex.5.ci" = "有孚，光亨，貞吉。利涉大川。";
"hex.5.yao.0" = "需于郊，利用恆，無咎。";
"hex.5.yao.1" = "需于沙，小有言，終吉。";
"hex.5.yao.2" = "需于泥，致寇至。";
"hex.5.yao.3" = "需于血，出自穴。";
"hex.5.yao.4" = "需于酒食，貞吉。";
"hex.5.yao.5" = "入于穴，有不速之客三人來，敬之終吉。";
"hex.6.ci" = "有孚，窒惕，中吉，終凶。利見大人，不利涉大川。";
"hex.6.yao.0" = "不永所事，小有言，終吉。";
"hex.6.yao.1" = "不克訟，歸而逋，其邑人三百戶，無眚。";
"hex.6.yao.2" = "食舊德，貞厲，終吉。或從王事，無成。";
"hex.6.yao.3" = "不克訟，復即命，渝安貞，吉。";
"hex.6.yao.4" = "訟，元吉。";
"hex.6.yao.5" = "或錫之鞶帶，終朝三褫之。";
"hex.7.ci" = "貞，丈人吉，無咎。";
"hex.7.yao.0" = "師出以律，否臧凶。";
"hex.7.yao.1" = "在師中，吉無咎，王三錫命。";
"hex.7.yao.2" = "師或輿尸，凶。";
"hex.7.yao.3" = "師左次，無咎。";
"hex.7.yao.4" = "田有禽，利執言，無咎。長子帥師，弟子輿尸，貞凶。";
"hex.7.yao.5" = "大君有命，開國承家，小人勿用。";
"hex.8.ci" = "吉。原筮，元永貞，無咎。不寧方來，後夫凶。";
"hex.8.yao.0" = "有孚比之，無咎。有孚盈缶，終來有他，吉。";
"hex.8.yao.1" = "比之自內，貞吉。";
"hex.8.yao.2" = "比之匪人。";
"hex.8.yao.3" = "外比之，貞吉。";
"hex.8.yao.4" = "顯比，王用三驅，失前禽，邑人不誡，吉。";
"hex.8.yao.5" = "比之無首，凶。";
"hex.9.ci" = "亨。密雲不雨，自我西郊。";
"hex.9.yao.0" = "復自道，何其咎，吉。";
"hex.9.yao.1" = "牽復，吉。";
"hex.9.yao.2" = "輿說輻，夫妻反目。";
"hex.9.yao.3" = "有孚，血去惕出，無咎。";
"hex.9.yao.4" = "有孚攣如，富以其鄰。";
"hex.9.yao.5" = "既雨既處，尚德載，婦貞厲。月幾望，君子征凶。";
"hex.10.ci" = "履虎尾，不咥人，亨。";
"hex.10.yao.0" = "素履，往無咎。";
"hex.10.yao.1" = "履道坦坦，幽人貞吉。";
"hex.10.yao.2" = "眇能視，跛能履，履虎尾，咥人，凶。武人為于大君。";
"hex.10.yao.3" = "履虎尾，愬愬，終吉。";
"hex.10.yao.4" = "夬履，貞厲。";
"hex.10.yao.5" = "視履考祥，其旋元吉。";
"hex.11.ci" = "小往大來，吉亨。";
"hex.11.yao.0" = "拔茅茹，以其彙，征吉。";
"hex.11.yao.1" = "包荒，用馮河，不遐遺，朋亡，得尚于中行。";
"hex.11.yao.2" = "無平不陂，無往不復，艱貞無咎。勿恤其孚，于食有福。";
"hex.11.yao.3" = "翩翩，不富以其鄰，不戒以孚。";
"hex.11.yao.4" = "帝乙歸妹，以祉元吉。";
"hex.11.yao.5" = "城復于隍，勿用師，自邑告命，貞吝。";
"hex.12.ci" = "否之匪人，不利君子貞，大往小來。";
"hex.12.yao.0" = "拔茅茹，以其彙，貞吉亨。";
"hex.12.yao.1" = "包承，小人吉，大人否亨。";
"hex.12.yao.2" = "包羞。";
"hex.12.yao.3" = "有命無咎，疇離祉。";
"hex.12.yao.4" = "休否，大人吉。其亡其亡，繫于苞桑。";
"hex.12.yao.5" = "傾否，先否後喜。";
"hex.13.ci" = "同人于野，亨。利涉大川，利君子貞。";
"hex.13.yao.0" = "同人于門，無咎。";
"hex.13.yao.1" = "同人于宗，吝。";
"hex.13.yao.2" = "伏戎于莽，升其高陵，三歲不興。";
"hex.13.yao.3" = "乘其墉，弗克攻，吉。";
"hex.13.yao.4" = "同人，先號咷而後笑，大師克相遇。";
"hex.13.yao.5" = "同人于郊，無悔。";
"hex.14.ci" = "元亨。";
"hex.14.yao.0" = "無交害，匪咎，艱則無咎。";
"hex.14.yao.1" = "大車以載，有攸往，無咎。";
"hex.14.yao.2" = "公用亨于天子，小人弗克。";
"hex.14.yao.3" = "匪其彭，無咎。";
"hex.14.yao.4" = "厥孚交如，威如，吉。";
"hex.14.yao.5" = "自天祐之，吉無不利。";
"hex.15.ci" = "亨，君子有終。";
"hex.15.yao.0" = "謙謙君子，用涉大川，吉。";
"hex.15.yao.1" = "鳴謙，貞吉。";
"hex.15.yao.2" = "勞謙君子，有終吉。";
"hex.15.yao.3" = "無不利，撝謙。";
"hex.15.yao.4" = "不富以其鄰，利用侵伐，無不利。";
"hex.15.yao.5" = "鳴謙，利用行師，征邑國。";
"hex.16.ci" = "利建侯行師。";
"hex.16.yao.0" = "鳴豫，凶。";
"hex.16.yao.1" = "介于石，不終日，貞吉。";
"hex.16.yao.2" = "盱豫，悔。遲有悔。";
"hex.16.yao.3" = "由豫，大有得。勿疑，朋盍簪。";
"hex.16.yao.4" = "貞疾，恆不死。";
"hex.16.yao.5" = "冥豫，成有渝，無咎。";
"hex.17.ci" = "元亨利貞，無咎。";
"hex.17.yao.0" = "官有渝，貞吉。出門交有功。";
"hex.17.yao.1" = "係小子，失丈夫。";
"hex.17.yao.2" = "係丈夫，失小子。隨有求得，利居貞。";
"hex.17.yao.3" = "隨有獲，貞凶。有孚在道，以明，何咎。";
"hex.17.yao.4" = "孚于嘉，吉。";
"hex.17.yao.5" = "拘係之，乃從維之。王用亨于西山。";
"hex.18.ci" = "元亨，利涉大川。先甲三日，後甲三日。";
"hex.18.yao.0" = "幹父之蠱，有子，考無咎，厲終吉。";
"hex.18.yao.1" = "幹母之蠱，不可貞。";
"hex.18.yao.2" = "幹父之蠱，小有悔，無大咎。";
"hex.18.yao.3" = "裕父之蠱，往見吝。";
"hex.18.yao.4" = "幹父之蠱，用譽。";
"hex.18.yao.5" = "不事王侯，高尚其事。";
"hex.19.ci" = "元亨利貞。至于八月有凶。";
"hex.19.yao.0" = "咸臨，貞吉。";
"hex.19.yao.1" = "咸臨，吉無不利。";
"hex.19.yao.2" = "甘臨，無攸利。既憂之，無咎。";
"hex.19.yao.3" = "至臨，無咎。";
"hex.19.yao.4" = "知臨，大君之宜，吉。";
"hex.19.yao.5" = "敦臨，吉無咎。";
"hex.20.ci" = "盥而不薦，有孚顒若。";
"hex.20.yao.0" = "童觀，小人無咎，君子吝。";
"hex.20.yao.1" = "窺觀，利女貞。";
"hex.20.yao.2" = "觀我生，進退。";
"hex.20.yao.3" = "觀國之光，利用賓于王。";
"hex.20.yao.4" = "觀我生，君子無咎。";
"hex.20.yao.5" = "觀其生，君子無咎。";
"hex.21.ci" = "亨。利用獄。";
"hex.21.yao.0" = "屨校滅趾，無咎。";
"hex.21.yao.1" = "噬膚滅鼻，無咎。";
"hex.21.yao.2" = "噬腊肉，遇毒，小吝，無咎。";
"hex.21.yao.3" = "噬乾胏，得金矢，利艱貞，吉。";
"hex.21.yao.4" = "噬乾肉，得黃金，貞厲，無咎。";
"hex.21.yao.5" = "何校滅耳，凶。";
"hex.22.ci" = "亨。小利有攸往。";
"hex.22.yao.0" = "賁其趾，舍車而徒。";
"hex.22.yao.1" = "賁其須。";
"hex.22.yao.2" = "賁如濡如，永貞吉。";
"hex.22.yao.3" = "賁如皤如，白馬翰如，匪寇婚媾。";
"hex.22.yao.4" = "賁于丘園，束帛戔戔，吝，終吉。";
"hex.22.yao.5" = "白賁，無咎。";
"hex.23.ci" = "不利有攸往。";
"hex.23.yao.0" = "剝床以足，蔑貞凶。";
"hex.23.yao.1" = "剝床以辨，蔑貞凶。";
"hex.23.yao.2" = "剝之，無咎。";
"hex.23.yao.3" = "剝床以膚，凶。";
"hex.23.yao.4" = "貫魚，以宮人寵，無不利。";
"hex.23.yao.5" = "碩果不食，君子得輿，小人剝廬。";
"hex.24.ci" = "亨。出入無疾，朋來無咎。反復其道，七日來復，利有攸往。";
"hex.24.yao.0" = "不遠復，無祗悔，元吉。";
"hex.24.yao.1" = "休復，吉。";
"hex.24.yao.2" = "頻復，厲無咎。";
"hex.24.yao.3" = "中行獨復。";
"hex.24.yao.4" = "敦復，無悔。";
"hex.24.yao.5" = "迷復，凶，有災眚。用行師，終有大敗，以其國君凶，至于十年不克征。";
"hex.25.ci" = "元亨利貞。其匪正有眚，不利有攸往。";
"hex.25.yao.0" = "無妄，往吉。";
"hex.25.yao.1" = "不耕穫，不菑畬，則利有攸往。";
"hex.25.yao.2" = "無妄之災，或繫之牛，行人之得，邑人之災。";
"hex.25.yao.3" = "可貞，無咎。";
"hex.25.yao.4" = "無妄之疾，勿藥有喜。";
"hex.25.yao.5" = "無妄，行有眚，無攸利。";
"hex.26.ci" = "利貞，不家食吉，利涉大川。";
"hex.26.yao.0" = "有厲，利已。";
"hex.26.yao.1" = "輿說輹。";
"hex.26.yao.2" = "良馬逐，利艱貞。曰閑輿衛，利有攸往。";
"hex.26.yao.3" = "童牛之牿，元吉。";
"hex.26.yao.4" = "豶豕之牙，吉。";
"hex.26.yao.5" = "何天之衢，亨。";
"hex.27.ci" = "貞吉。觀頤，自求口實。";
"hex.27.yao.0" = "舍爾靈龜，觀我朵頤，凶。";
"hex.27.yao.1" = "顛頤，拂經，于丘頤，征凶。";
"hex.27.yao.2" = "拂頤，貞凶，十年勿用，無攸利。";
"hex.27.yao.3" = "顛頤吉，虎視眈眈，其欲逐逐，無咎。";
"hex.27.yao.4" = "拂經，居貞吉，不可涉大川。";
"hex.27.yao.5" = "由頤，厲吉，利涉大川。";
"hex.28.ci" = "棟橈，利有攸往，亨。";
"hex.28.yao.0" = "藉用白茅，無咎。";
"hex.28.yao.1" = "枯楊生稊，老夫得其女妻，無不利。";
"hex.28.yao.2" = "棟橈，凶。";
"hex.28.yao.3" = "棟隆，吉；有它吝。";
"hex.28.yao.4" = "枯楊生華，老婦得其士夫，無咎無譽。";
"hex.28.yao.5" = "過涉滅頂，凶，無咎。";
"hex.29.ci" = "習坎，有孚，維心亨，行有尚。";
"hex.29.yao.0" = "習坎，入于坎窞，凶。";
"hex.29.yao.1" = "坎有險，求小得。";
"hex.29.yao.2" = "來之坎坎，險且枕，入于坎窞，勿用。";
"hex.29.yao.3" = "樽酒簋貳，用缶，納約自牖，終無咎。";
"hex.29.yao.4" = "坎不盈，祗既平，無咎。";
"hex.29.yao.5" = "係用徽纆，寘于叢棘，三歲不得，凶。";
"hex.30.ci" = "利貞，亨。畜牝牛，吉。";
"hex.30.yao.0" = "履錯然，敬之無咎。";
"hex.30.yao.1" = "黃離，元吉。";
"hex.30.yao.2" = "日昃之離，不鼓缶而歌，則大耋之嗟，凶。";
"hex.30.yao.3" = "突如其來如，焚如，死如，棄如。";
"hex.30.yao.4" = "出涕沱若，戚嗟若，吉。";
"hex.30.yao.5" = "王用出征，有嘉折首，獲匪其醜，無咎。";
"hex.31.ci" = "亨，利貞，取女吉。";
"hex.31.yao.0" = "咸其拇。";
"hex.31.yao.1" = "咸其腓，凶，居吉。";
"hex.31.yao.2" = "咸其股，執其隨，往吝。";
"hex.31.yao.3" = "貞吉悔亡，憧憧往來，朋從爾思。";
"hex.31.yao.4" = "咸其脢，無悔。";
"hex.31.yao.5" = "咸其輔頰舌。";
"hex.32.ci" = "亨，無咎，利貞，利有攸往。";
"hex.32.yao.0" = "浚恆，貞凶，無攸利。";
"hex.32.yao.1" = "悔亡。";
"hex.32.yao.2" = "不恆其德，或承之羞，貞吝。";
"hex.32.yao.3" = "田無禽。";
"hex.32.yao.4" = "恆其德，貞，婦人吉，夫子凶。";
"hex.32.yao.5" = "振恆，凶。";
"hex.33.ci" = "亨，小利貞。";
"hex.33.yao.0" = "遯尾，厲，勿用有攸往。";
"hex.33.yao.1" = "執之用黃牛之革，莫之勝說。";
"hex.33.yao.2" = "係遯，有疾厲，畜臣妾吉。";
"hex.33.yao.3" = "好遯，君子吉，小人否。";
"hex.33.yao.4" = "嘉遯，貞吉。";
"hex.33.yao.5" = "肥遯，無不利。";
"hex.34.ci" = "利貞。";
"hex.34.yao.0" = "壯于趾，征凶，有孚。";
"hex.34.yao.1" = "貞吉。";
"hex.34.yao.2" = "小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。";
"hex.34.yao.3" = "貞吉悔亡，藩決不羸，壯于大輿之輹。";
"hex.34.yao.4" = "喪羊于易，無悔。";
"hex.34.yao.5" = "羝羊觸藩，不能退，不能遂，無攸利，艱則吉。";
"hex.35.ci" = "康侯用錫馬蕃庶，晝日三接。";
"hex.35.yao.0" = "晉如摧如，貞吉。罔孚，裕無咎。";
"hex.35.yao.1" = "晉如愁如，貞吉。受茲介福，于其王母。";
"hex.35.yao.2" = "眾允，悔亡。";
"hex.35.yao.3" = "晉如鼫鼠，貞厲。";
"hex.35.yao.4" = "悔亡，失得勿恤，往吉無不利。";
"hex.35.yao.5" = "晉其角，維用伐邑，厲吉無咎，貞吝。";
"hex.36.ci" = "利艱貞。";
"hex.36.yao.0" = "明夷于飛，垂其翼。君子于行，三日不食，有攸往，主人有言。";
"hex.36.yao.1" = "明夷，夷于左股，用拯馬壯，吉。";
"hex.36.yao.2" = "明夷于南狩，得其大首，不可疾貞。";
"hex.36.yao.3" = "入于左腹，獲明夷之心，于出門庭。";
"hex.36.yao.4" = "箕子之明夷，利貞。";
"hex.36.yao.5" = "不明晦，初登于天，後入于地。";
"hex.37.ci" = "利女貞。";
"hex.37.yao.0" = "閑有家，悔亡。";
"hex.37.yao.1" = "無攸遂，在中饋，貞吉。";
"hex.37.yao.2" = "家人嗃嗃，悔厲吉；婦子嘻嘻，終吝。";
"hex.37.yao.3" = "富家，大吉。";
"hex.37.yao.4" = "王假有家，勿恤吉。";
"hex.37.yao.5" = "有孚威如，終吉。";
"hex.38.ci" = "小事吉。";
"hex.38.yao.0" = "悔亡，喪馬勿逐，自復；見惡人，無咎。";
"hex.38.yao.1" = "遇主于巷，無咎。";
"hex.38.yao.2" = "見輿曳，其牛掣，其人天且劓，無初有終。";
"hex.38.yao.3" = "睽孤，遇元夫，交孚，厲無咎。";
"hex.38.yao.4" = "悔亡，厥宗噬膚，往何咎。";
"hex.38.yao.5" = "睽孤，見豕負塗，載鬼一車，先張之弧，後說之弧，匪寇婚媾，往遇雨則吉。";
"hex.39.ci" = "利西南，不利東北；利見大人，貞吉。";
"hex.39.yao.0" = "往蹇，來譽。";
"hex.39.yao.1" = "王臣蹇蹇，匪躬之故。";
"hex.39.yao.2" = "往蹇，來反。";
"hex.39.yao.3" = "往蹇，來連。";
"hex.39.yao.4" = "大蹇，朋來。";
"hex.39.yao.5" = "往蹇，來碩，吉；利見大人。";
"hex.40.ci" = "利西南，無所往，其來復吉。有攸往，夙吉。";
"hex.40.yao.0" = "無咎。";
"hex.40.yao.1" = "田獲三狐，得黃矢，貞吉。";
"hex.40.yao.2" = "負且乘，致寇至，貞吝。";
"hex.40.yao.3" = "解而拇，朋至斯孚。";
"hex.40.yao.4" = "君子維有解，吉；有孚于小人。";
"hex.40.yao.5" = "公用射隼于高墉之上，獲之，無不利。";
"hex.41.ci" = "有孚，元吉，無咎，可貞，利有攸往。曷之用，二簋可用享。";
"hex.41.yao.0" = "已事遄往，無咎，酌損之。";
"hex.41.yao.1" = "利貞，征凶，弗損益之。";
"hex.41.yao.2" = "三人行，則損一人；一人行，則得其友。";
"hex.41.yao.3" = "損其疾，使遄有喜，無咎。";
"hex.41.yao.4" = "或益之，十朋之龜弗克違，元吉。";
"hex.41.yao.5" = "弗損益之，無咎，貞吉，利有攸往，得臣無家。";
"hex.42.ci" = "利有攸往，利涉大川。";
"hex.42.yao.0" = "利用為大作，元吉，無咎。";
"hex.42.yao.1" = "或益之，十朋之龜弗克違，永貞吉。王用享于帝，吉。";
"hex.42.yao.2" = "益之用凶事，無咎。有孚中行，告公用圭。";
"hex.42.yao.3" = "中行，告公從，利用為依遷國。";
"hex.42.yao.4" = "有孚惠心，勿問元吉。有孚惠我德。";
"hex.42.yao.5" = "莫益之，或擊之，立心勿恆，凶。";
"hex.43.ci" = "揚于王庭，孚號，有厲，告自邑，不利即戎，利有攸往。";
"hex.43.yao.0" = "壯于前趾，往不勝為咎。";
"hex.43.yao.1" = "惕號，莫夜有戎，勿恤。";
"hex.43.yao.2" = "壯于頄，有凶。君子夬夬，獨行遇雨，若濡有慍，無咎。";
"hex.43.yao.3" = "臀無膚，其行次且。牽羊悔亡，聞言不信。";
"hex.43.yao.4" = "莧陸夬夬，中行無咎。";
"hex.43.yao.5" = "無號，終有凶。";
"hex.44.ci" = "女壯，勿用取女。";
"hex.44.yao.0" = "繫于金柅，貞吉，有攸往，見凶，羸豕孚蹢躅。";
"hex.44.yao.1" = "包有魚，無咎，不利賓。";
"hex.44.yao.2" = "臀無膚，其行次且，厲，無大咎。";
"hex.44.yao.3" = "包無魚，起凶。";
"hex.44.yao.4" = "以杞包瓜，含章，有隕自天。";
"hex.44.yao.5" = "姤其角，吝，無咎。";
"hex.45.ci" = "亨。王假有廟，利見大人，亨，利貞。用大牲吉，利有攸往。";
"hex.45.yao.0" = "有孚不終，乃亂乃萃，若號，一握為笑，勿恤，往無咎。";
"hex.45.yao.1" = "引吉，無咎，孚乃利用禴。";
"hex.45.yao.2" = "萃如嗟如，無攸利，往無咎，小吝。";
"hex.45.yao.3" = "大吉，無咎。";
"hex.45.yao.4" = "萃有位，無咎。匪孚，元永貞，悔亡。";
"hex.45.yao.5" = "齎咨涕洟，無咎。";
"hex.46.ci" = "元亨，用見大人，勿恤，南征吉。";
"hex.46.yao.0" = "允升，大吉。";
"hex.46.yao.1" = "孚乃利用禴，無咎。";
"hex.46.yao.2" = "升虛邑。";
"hex.46.yao.3" = "王用亨于岐山，吉無咎。";
"hex.46.yao.4" = "貞吉，升階。";
"hex.46.yao.5" = "冥升，利于不息之貞。";
"hex.47.ci" = "亨，貞，大人吉，無咎，有言不信。";
"hex.47.yao.0" = "臀困于株木，入于幽谷，三歲不覿。";
"hex.47.yao.1" = "困于酒食，朱紱方來，利用享祀，征凶，無咎。";
"hex.47.yao.2" = "困于石，據于蒺藜，入于其宮，不見其妻，凶。";
"hex.47.yao.3" = "來徐徐，困于金車，吝，有終。";
"hex.47.yao.4" = "劓刖，困于赤紱，乃徐有說，利用祭祀。";
"hex.47.yao.5" = "困于葛藟，于臲卼，曰動悔有悔，征吉。";
"hex.48.ci" = "改邑不改井，無喪無得，往來井井。汔至，亦未繘井，羸其瓶，凶。";
"hex.48.yao.0" = "井泥不食，舊井無禽。";
"hex.48.yao.1" = "井谷射鮒，甕敝漏。";
"hex.48.yao.2" = "井渫不食，為我心惻，可用汲，王明，並受其福。";
"hex.48.yao.3" = "井甃，無咎。";
"hex.48.yao.4" = "井冽，寒泉食。";
"hex.48.yao.5" = "井收勿幕，有孚元吉。";
"hex.49.ci" = "己日乃孚，元亨利貞，悔亡。";
"hex.49.yao.0" = "鞏用黃牛之革。";
"hex.49.yao.1" = "己日乃革之，征吉，無咎。";
"hex.49.yao.2" = "征凶，貞厲，革言三就，有孚。";
"hex.49.yao.3" = "悔亡，有孚改命，吉。";
"hex.49.yao.4" = "大人虎變，未占有孚。";
"hex.49.yao.5" = "君子豹變，小人革面，征凶，居貞吉。";
"hex.50.ci" = "元吉，亨。";
"hex.50.yao.0" = "鼎顛趾，利出否，得妾以其子，無咎。";
"hex.50.yao.1" = "鼎有實，我仇有疾，不我能即，吉。";
"hex.50.yao.2" = "鼎耳革，其行塞，雉膏不食，方雨虧悔，終吉。";
"hex.50.yao.3" = "鼎折足，覆公餗，其形渥，凶。";
"hex.50.yao.4" = "鼎黃耳金鉉，利貞。";
"hex.50.yao.5" = "鼎玉鉉，大吉，無不利。";
"hex.51.ci" = "亨。震來虩虩，笑言啞啞。震驚百里，不喪匕鬯。";
"hex.51.yao.0" = "震來虩虩，後笑言啞啞，吉。";
"hex.51.yao.1" = "震來厲，億喪貝，躋于九陵，勿逐，七日得。";
"hex.51.yao.2" = "震蘇蘇，震行無眚。";
"hex.51.yao.3" = "震遂泥。";
"hex.51.yao.4" = "震往來厲，億無喪，有事。";
"hex.51.yao.5" = "震索索，視矍矍，征凶。震不于其躬，于其鄰，無咎。婚媾有言。";
"hex.52.ci" = "艮其背，不獲其身，行其庭，不見其人，無咎。";
"hex.52.yao.0" = "艮其趾，無咎，利永貞。";
"hex.52.yao.1" = "艮其腓，不拯其隨，其心不快。";
"hex.52.yao.2" = "艮其限，列其夤，厲薰心。";
"hex.52.yao.3" = "艮其身，無咎。";
"hex.52.yao.4" = "艮其輔，言有序，悔亡。";
"hex.52.yao.5" = "敦艮，吉。";
"hex.53.ci" = "女歸吉，利貞。";
"hex.53.yao.0" = "鴻漸于干，小子厲，有言，無咎。";
"hex.53.yao.1" = "鴻漸于磐，飲食衎衎，吉。";
"hex.53.yao.2" = "鴻漸于陸，夫征不復，婦孕不育，凶；利禦寇。";
"hex.53.yao.3" = "鴻漸于木，或得其桷，無咎。";
"hex.53.yao.4" = "鴻漸于陵，婦三歲不孕，終莫之勝，吉。";
"hex.53.yao.5" = "鴻漸于陸，其羽可用為儀，吉。";
"hex.54.ci" = "征凶，無攸利。";
"hex.54.yao.0" = "歸妹以娣，跛能履，征吉。";
"hex.54.yao.1" = "眇能視，利幽人之貞。";
"hex.54.yao.2" = "歸妹以須，反歸以娣。";
"hex.54.yao.3" = "歸妹愆期，遲歸有時。";
"hex.54.yao.4" = "帝乙歸妹，其君之袂，不如其娣之袂良，月幾望，吉。";
"hex.54.yao.5" = "女承筐無實，士刲羊無血，無攸利。";
"hex.55.ci" = "亨，王假之，勿憂，宜日中。";
"hex.55.yao.0" = "遇其配主，雖旬無咎，往有尚。";
"hex.55.yao.1" = "豐其蔀，日中見斗，往得疑疾，有孚發若，吉。";
"hex.55.yao.2" = "豐其沛，日中見沫，折其右肱，無咎。";
"hex.55.yao.3" = "豐其蔀，日中見斗，遇其夷主，吉。";
"hex.55.yao.4" = "來章，有慶譽，吉。";
"hex.55.yao.5" = "豐其屋，蔀其家，窺其戶，闃其無人，三歲不覿，凶。";
"hex.56.ci" = "小亨，旅貞吉。";
"hex.56.yao.0" = "旅瑣瑣，斯其所取災。";
"hex.56.yao.1" = "旅即次，懷其資，得童僕貞。";
"hex.56.yao.2" = "旅焚其次，喪其童僕，貞厲。";
"hex.56.yao.3" = "旅于處，得其資斧，我心不快。";
"hex.56.yao.4" = "射雉一矢亡，終以譽命。";
"hex.56.yao.5" = "鳥焚其巢，旅人先笑後號咷。喪牛于易，凶。";
"hex.57.ci" = "小亨，利有攸往，利見大人。";
"hex.57.yao.0" = "進退，利武人之貞。";
"hex.57.yao.1" = "巽在床下，用史巫紛若，吉無咎。";
"hex.57.yao.2" = "頻巽，吝。";
"hex.57.yao.3" = "悔亡，田獲三品。";
"hex.57.yao.4" = "貞吉悔亡，無不利。無初有終，先庚三日，後庚三日，吉。";
"hex.57.yao.5" = "巽在床下，喪其資斧，貞凶。";
"hex.58.ci" = "亨，利貞。";
"hex.58.yao.0" = "和兌，吉。";
"hex.58.yao.1" = "孚兌，吉，悔亡。";
"hex.58.yao.2" = "來兌，凶。";
"hex.58.yao.3" = "商兌未寧，介疾有喜。";
"hex.58.yao.4" = "孚于剝，有厲。";
"hex.58.yao.5" = "引兌。";
"hex.59.ci" = "亨。王假有廟，利涉大川，利貞。";
"hex.59.yao.0" = "用拯馬壯，吉。";
"hex.59.yao.1" = "渙奔其机，悔亡。";
"hex.59.yao.2" = "渙其躬，無悔。";
"hex.59.yao.3" = "渙其群，元吉。渙有丘，匪夷所思。";
"hex.59.yao.4" = "渙汗其大號，渙王居，無咎。";
"hex.59.yao.5" = "渙其血，去逖出，無咎。";
"hex.60.ci" = "亨。苦節不可貞。";
"hex.60.yao.0" = "不出戶庭，無咎。";
"hex.60.yao.1" = "不出門庭，凶。";
"hex.60.yao.2" = "不節若，則嗟若，無咎。";
"hex.60.yao.3" = "安節，亨。";
"hex.60.yao.4" = "甘節，吉；往有尚。";
"hex.60.yao.5" = "苦節，貞凶，悔亡。";
"hex.61.ci" = "豚魚吉，利涉大川，利貞。";
"hex.61.yao.0" = "虞吉，有他不燕。";
"hex.61.yao.1" = "鳴鶴在陰，其子和之，我有好爵，吾與爾靡之。";
"hex.61.yao.2" = "得敵，或鼓或罷，或泣或歌。";
"hex.61.yao.3" = "月幾望，馬匹亡，無咎。";
"hex.61.yao.4" = "有孚攣如，無咎。";
"hex.61.yao.5" = "翰音登于天，貞凶。";
"hex.62.ci" = "亨，利貞，可小事，不可大事。飛鳥遺之音，不宜上宜下，大吉。";
"hex.62.yao.0" = "飛鳥以凶。";
"hex.62.yao.1" = "過其祖，遇其妣；不及其君，遇其臣；無咎。";
"hex.62.yao.2" = "弗過防之，從或戕之，凶。";
"hex.62.yao.3" = "無咎，弗過遇之。往厲必戒，勿用永貞。";
"hex.62.yao.4" = "密雲不雨，自我西郊，公弋取彼在穴。";
"hex.62.yao.5" = "弗遇過之，飛鳥離之，凶，是謂災眚。";
"hex.63.ci" = "亨，小利貞，初吉終亂。";
"hex.63.yao.0" = "曳其輪，濡其尾，無咎。";
"hex.63.yao.1" = "婦喪其茀，勿逐，七日得。";
"hex.63.yao.2" = "高宗伐鬼方，三年克之，小人勿用。";
"hex.63.yao.3" = "繻有衣袽，終日戒。";
"hex.63.yao.4" = "東鄰殺牛，不如西鄰之禴祭，實受其福。";
"hex.63.yao.5" = "濡其首，厲。";
"hex.64.ci" = "亨，小狐汔濟，濡其尾，無攸利。";
"hex.64.yao.0" = "濡其尾，吝。";
"hex.64.yao.1" = "曳其輪，貞吉。";
"hex.64.yao.2" = "未濟，征凶，利涉大川。";
"hex.64.yao.3" = "貞吉，悔亡，震用伐鬼方，三年有賞于大國。";
"hex.64.yao.4" = "貞吉，無悔，君子之光，有孚，吉。";
"hex.64.yao.5" = "有孚于飲酒，無咎，濡其首，有孚失是。";
"yongjiu.text" = "見群龍無首，吉。";
"yongliu.text" = "利永貞。";
