/* 周易 · 繁體中文（台灣）· 卦名、全名、白話要旨、八卦 */
"hex.1.name" = "乾";
"hex.1.full" = "乾為天";
"hex.1.bh" = "上下皆天，象徵天道剛健、運行不息。卦辭「元亨利貞」，大象云「君子以自強不息」；六爻以龍為喻，從潛龍勿用寫到亢龍有悔。";
"hex.2.name" = "坤";
"hex.2.full" = "坤為地";
"hex.2.bh" = "上下皆地，象徵大地柔順、厚載萬物。卦辭以「牝馬之貞」為喻，大象云「君子以厚德載物」；爻辭從履霜堅冰寫到龍戰於野。";
"hex.3.name" = "屯";
"hex.3.full" = "水雷屯";
"hex.3.bh" = "上坎下震，雲雷交動，象徵萬物初生時的艱難。卦辭言「利建侯」，大象云「君子以經綸」；爻辭多寫乘馬班如、徘徊難進的情景。";
"hex.4.name" = "蒙";
"hex.4.full" = "山水蒙";
"hex.4.bh" = "山下出泉，象徵蒙昧初開、有待啟發。卦辭講「童蒙求我」與「初筮告」，大象云「君子以果行育德」；爻辭圍繞發蒙、包蒙、困蒙、擊蒙，關乎教與學。";
"hex.5.name" = "需";
"hex.5.full" = "水天需";
"hex.5.bh" = "雲上於天，尚未成雨，象徵等待。卦辭言「有孚，光亨」，大象云「君子以飲食宴樂」；爻辭由需於郊、需於沙、需於泥一路寫到入於穴。";
"hex.6.name" = "訟";
"hex.6.full" = "天水訟";
"hex.6.bh" = "天與水相背而行，象徵爭訟。卦辭言「有孚，窒惕」與「利見大人」，大象云「君子以作事謀始」；爻辭多寫爭訟中的退讓與收場。";
"hex.7.name" = "師";
"hex.7.full" = "地水師";
"hex.7.bh" = "地中有水，象徵聚眾成軍。卦辭強調「丈人」統率，大象云「君子以容民畜眾」；爻辭從「師出以律」寫到「開國承家」，涉及軍紀與用人。";
"hex.8.name" = "比";
"hex.8.full" = "水地比";
"hex.8.bh" = "地上有水，水土相親，象徵親近依附。卦辭講「原筮」與「不寧方來」，大象云「先王以建萬國，親諸侯」；爻辭寫各種親附的方式。";
"hex.9.name" = "小畜";
"hex.9.full" = "風天小畜";
"hex.9.bh" = "風行天上，象徵以小蓄大、蓄積未厚。卦辭「密雲不雨，自我西郊」，大象云「君子以懿文德」；爻辭由「復自道」寫到「既雨既處」。";
"hex.10.name" = "履";
"hex.10.full" = "天澤履";
"hex.10.bh" = "上天下澤，象徵踐行與禮的秩序。卦辭以「履虎尾，不咥人」為喻，大象云「君子以辨上下，定民志」；爻辭從素履寫到視履考祥。";
"hex.11.name" = "泰";
"hex.11.full" = "地天泰";
"hex.11.bh" = "地在上、天在下，天地之氣相交，象徵通泰。卦辭「小往大來」，大象講「財成天地之道」；爻辭也提到「無平不陂，無往不復」與「城復于隍」。";
"hex.12.name" = "否";
"hex.12.full" = "天地否";
"hex.12.bh" = "天在上、地在下，天地不交，象徵閉塞。卦辭「大往小來」，大象云「君子以儉德辟難」；爻辭由包承、包羞寫到休否、傾否，閉塞漸轉。";
"hex.13.name" = "同人";
"hex.13.full" = "天火同人";
"hex.13.bh" = "天與火同向上，象徵與人和同。卦辭「同人于野」，大象云「君子以類族辨物」；爻辭依次寫同人於門、於宗、於郊，範圍由近及遠。";
"hex.14.name" = "大有";
"hex.14.full" = "火天大有";
"hex.14.bh" = "火在天上，光照萬物，象徵大為富有。卦辭僅言「元亨」，大象云「君子以遏惡揚善，順天休命」；爻辭以「大車以載」「自天佑之」寫富有之道。";
"hex.15.name" = "謙";
"hex.15.full" = "地山謙";
"hex.15.bh" = "地中有山，高者自處於下，象徵謙遜。卦辭「君子有終」，大象講「裒多益寡，稱物平施」；六爻分寫謙謙、鳴謙、勞謙、撝謙等謙德。";
"hex.16.name" = "豫";
"hex.16.full" = "雷地豫";
"hex.16.bh" = "雷出地上，萬物奮發，象徵和樂。卦辭「利建侯行師」，大象云「先王以作樂崇德」；爻辭對比鳴豫、盱豫、由豫、冥豫等不同的樂。";
"hex.17.name" = "隨";
"hex.17.full" = "澤雷隨";
"hex.17.bh" = "澤中有雷，象徵隨從與隨時。卦辭「元亨利貞，無咎」，大象云「君子以嚮晦入宴息」；爻辭寫係小子與係丈夫之間的取捨。";
"hex.18.name" = "蠱";
"hex.18.full" = "山風蠱";
"hex.18.bh" = "山下有風，象徵積弊待治。卦辭提到「先甲三日，後甲三日」，大象云「君子以振民育德」；爻辭多寫幹父之蠱、幹母之蠱，即整治前代積弊。";
"hex.19.name" = "臨";
"hex.19.full" = "地澤臨";
"hex.19.bh" = "澤上有地，象徵居上臨下。卦辭「元亨利貞」，大象云「君子以教思無窮，容保民無疆」；爻辭寫咸臨、甘臨、知臨、敦臨等治理方式。";
"hex.20.name" = "觀";
"hex.20.full" = "風地觀";
"hex.20.bh" = "風行地上，象徵觀察與示範。卦辭「盥而不薦，有孚顒若」取祭祀之象，大象云「先王以省方觀民設教」；爻辭由童觀、窺觀寫到觀國之光。";
"hex.21.name" = "噬嗑";
"hex.21.full" = "火雷噬嗑";
"hex.21.bh" = "上離下震，如口中有物、咬合而通，象徵刑獄與除障。卦辭「利用獄」，大象云「先王以明罰敕法」；爻辭多寫刑具與噬肉之象。";
"hex.22.name" = "賁";
"hex.22.full" = "山火賁";
"hex.22.bh" = "山下有火，光照山間草木，象徵文飾。卦辭「亨，小利有攸往」，大象云「君子以明庶政」；爻辭從賁其趾寫到「白賁」，由文飾復歸於素。";
"hex.23.name" = "剝";
"hex.23.full" = "山地剝";
"hex.23.bh" = "山附於地，五陰剝一陽，象徵剝落。卦辭「不利有攸往」，大象云「上以厚下安宅」；爻辭以剝床為喻層層逼近，上爻有「碩果不食」。";
"hex.24.name" = "復";
"hex.24.full" = "地雷復";
"hex.24.bh" = "雷在地中，一陽復生於下，象徵回復。卦辭「反復其道，七日來復」，大象云「先王以至日閉關」；爻辭寫不遠復、休復、頻復、迷復等各種回歸。";
"hex.25.name" = "無妄";
"hex.25.full" = "天雷無妄";
"hex.25.bh" = "天下雷行，物與無妄，象徵真實不妄。卦辭「元亨利貞」並言「其匪正有眚」，大象云「先王以茂對時育萬物」；爻辭提到「無妄之災」「無妄之疾」。";
"hex.26.name" = "大畜";
"hex.26.full" = "山天大畜";
"hex.26.bh" = "天在山中，象徵大有蓄積。卦辭言「不家食」「利涉大川」，大象云「君子以多識前言往行，以畜其德」；爻辭以童牛之牿、豶豕之牙寫蓄止之道。";
"hex.27.name" = "頤";
"hex.27.full" = "山雷頤";
"hex.27.bh" = "山下有雷，形如張開的口，象徵頤養。卦辭「觀頤，自求口實」，大象云「君子以慎言語，節飲食」；爻辭圍繞顛頤、拂頤、由頤，討論養身與養人。";
"hex.28.name" = "大過";
"hex.28.full" = "澤風大過";
"hex.28.bh" = "澤水淹沒樹木，象徵過盛與非常。卦辭以「棟橈」即棟梁彎曲為喻，大象云「君子以獨立不懼，遯世無悶」；爻辭有枯楊生稊、過涉滅頂等象。";
"hex.29.name" = "坎";
"hex.29.full" = "坎為水";
"hex.29.bh" = "上下皆水，重重險陷。卦辭「習坎，有孚，維心亨」，大象以水流不斷喻「常德行，習教事」；爻辭多寫入於坎窞與出險之難。";
"hex.30.name" = "離";
"hex.30.full" = "離為火";
"hex.30.bh" = "上下皆火，象徵光明與依附。卦辭言「畜牝牛」，大象云「大人以繼明照于四方」；爻辭從「黃離」寫到「日昃之離」，以日之升落為象。";
"hex.31.name" = "咸";
"hex.31.full" = "澤山咸";
"hex.31.bh" = "山上有澤，山澤通氣，象徵感應。卦辭言「取女」，大象云「君子以虛受人」；爻辭由拇、腓、股寫到輔頰舌，以身體部位依次言感。";
"hex.32.name" = "恆";
"hex.32.full" = "雷風恆";
"hex.32.bh" = "雷風相與，象徵恆久。卦辭「利貞，利有攸往」，大象云「君子以立不易方」；爻辭對比浚恆、不恆其德、振恆等，討論怎樣才算恆常。";
"hex.33.name" = "遯";
"hex.33.full" = "天山遯";
"hex.33.bh" = "天下有山，山高而天退，象徵退避。卦辭「亨，小利貞」，大象云「君子以遠小人，不惡而嚴」；爻辭寫遯尾、係遯、好遯、嘉遯、肥遯諸種退隱。";
"hex.34.name" = "大壯";
"hex.34.full" = "雷天大壯";
"hex.34.bh" = "雷在天上，聲勢強盛，象徵陽剛壯大。卦辭「利貞」，大象云「君子以非禮弗履」；爻辭多以羝羊觸藩為喻，寫強力的運用與節制。";
"hex.35.name" = "晉";
"hex.35.full" = "火地晉";
"hex.35.bh" = "日出地上，象徵進升。卦辭以康侯受賜馬、「晝日三接」為喻，大象云「君子以自昭明德」；爻辭寫晉如摧如、晉如鼫鼠等進身情形。";
"hex.36.name" = "明夷";
"hex.36.full" = "地火明夷";
"hex.36.bh" = "日入地中，象徵光明受傷。卦辭「利艱貞」，大象云「君子以蒞眾，用晦而明」；爻辭從明夷于飛寫起，並以「箕子之明夷」為例。";
"hex.37.name" = "家人";
"hex.37.full" = "風火家人";
"hex.37.bh" = "風自火出，象徵家庭之道。卦辭「利女貞」，大象云「君子以言有物，而行有恆」；爻辭寫閑有家、在中饋、富家等治家之事。";
"hex.38.name" = "睽";
"hex.38.full" = "火澤睽";
"hex.38.bh" = "上火下澤，火炎上而澤潤下，象徵乖離。卦辭「小事吉」，大象云「君子以同而異」；爻辭多寫睽孤中的奇異見聞與最終相遇。";
"hex.39.name" = "蹇";
"hex.39.full" = "水山蹇";
"hex.39.bh" = "山上有水，象徵行路艱難。卦辭「利西南，不利東北」，大象云「君子以反身修德」；爻辭多以「往蹇，來譽」「往蹇，來反」等往來對舉。";
"hex.40.name" = "解";
"hex.40.full" = "雷水解";
"hex.40.bh" = "雷雨並作，象徵險難解散。卦辭「利西南」，大象云「君子以赦過宥罪」；爻辭有田獲三狐、「負且乘，致寇至」、射隼於高墉等象。";
"hex.41.name" = "損";
"hex.41.full" = "山澤損";
"hex.41.bh" = "山下有澤，損下益上，象徵減損。卦辭以「二簋可用享」說明誠心勝於豐盛，大象云「君子以懲忿窒欲」；爻辭討論損與益之間的轉化。";
"hex.42.name" = "益";
"hex.42.full" = "風雷益";
"hex.42.bh" = "風雷相助，損上益下，象徵增益。卦辭「利有攸往，利涉大川」，大象云「君子以見善則遷，有過則改」；爻辭以「十朋之龜」等寫增益之道。";
"hex.43.name" = "夬";
"hex.43.full" = "澤天夬";
"hex.43.bh" = "澤上於天，五陽決一陰，象徵決斷。卦辭「揚于王庭，孚號」，大象云「君子以施祿及下」；爻辭寫壯於前趾、「莧陸夬夬」等決斷的分寸。";
"hex.44.name" = "姤";
"hex.44.full" = "天風姤";
"hex.44.bh" = "天下有風，一陰始生於下，象徵相遇。卦辭「女壯，勿用取女」，大象云「后以施命誥四方」；爻辭以金柅、包有魚、以杞包瓜等寫對初陰的處置。";
"hex.45.name" = "萃";
"hex.45.full" = "澤地萃";
"hex.45.bh" = "澤上於地，水聚成澤，象徵薈萃聚合。卦辭講「王假有廟」與「用大牲」，大象云「君子以除戎器，戒不虞」；爻辭寫聚合中的號呼、嗟嘆與和合。";
"hex.46.name" = "升";
"hex.46.full" = "地風升";
"hex.46.bh" = "地中生木，象徵上升。卦辭言「用見大人」「南征」，大象云「君子以順德，積小以高大」；爻辭從「允升」寫到「升階」「冥升」。";
"hex.47.name" = "困";
"hex.47.full" = "澤水困";
"hex.47.bh" = "澤中無水，象徵困窮。卦辭提到大人與「有言不信」，大象云「君子以致命遂志」；爻辭寫困於株木、酒食、石、金車、葛藟等處境。";
"hex.48.name" = "井";
"hex.48.full" = "水風井";
"hex.48.bh" = "木入水中汲水而上，象徵取之不盡的養人之源。卦辭講井「改邑不改井」，爻辭由井泥不食寫到井收勿幕，關乎修治與利用。";
"hex.49.name" = "革";
"hex.49.full" = "澤火革";
"hex.49.bh" = "澤中有火，水火相息，象徵變革。卦辭「己日乃孚」，大象云「君子以治曆明時」；爻辭由「鞏用黃牛之革」寫到「大人虎變」「君子豹變」。";
"hex.50.name" = "鼎";
"hex.50.full" = "火風鼎";
"hex.50.bh" = "木上有火，以木烹飪，象徵鼎器與新立的秩序。卦辭「元吉，亨」，大象云「君子以正位凝命」；爻辭依鼎趾、鼎實、鼎耳、鼎足、鼎鉉逐一取象。";
"hex.51.name" = "震";
"hex.51.full" = "震為雷";
"hex.51.bh" = "上下皆雷，象徵震動與驚懼。卦辭「震來虩虩，笑言啞啞」，大象云「君子以恐懼修省」；爻辭寫雷震之下的各種反應。";
"hex.52.name" = "艮";
"hex.52.full" = "艮為山";
"hex.52.bh" = "兩山重疊，象徵止。卦辭「艮其背，不獲其身」，大象云「君子以思不出其位」；爻辭由趾、腓、限、身、輔依次寫止於各處。";
"hex.53.name" = "漸";
"hex.53.full" = "風山漸";
"hex.53.bh" = "山上有木，漸次生長，象徵循序漸進。卦辭「女歸吉」，大象云「君子以居賢德善俗」；六爻以鴻雁漸進於干、磐、陸、木、陵為喻。";
"hex.54.name" = "歸妹";
"hex.54.full" = "雷澤歸妹";
"hex.54.bh" = "澤上有雷，象徵少女出嫁。卦辭「征凶，無攸利」，大象云「君子以永終知敝」；爻辭寫以娣陪嫁、歸妹愆期、「帝乙歸妹」等婚嫁之事。";
"hex.55.name" = "豐";
"hex.55.full" = "雷火豐";
"hex.55.bh" = "雷電皆至，象徵豐盛盛大。卦辭「王假之，勿憂，宜日中」，大象云「君子以折獄致刑」；爻辭多寫「日中見斗」的昏暗之象，盛中有蔽。";
"hex.56.name" = "旅";
"hex.56.full" = "火山旅";
"hex.56.bh" = "山上有火，火行不止，象徵羈旅。卦辭「小亨，旅貞吉」，大象云「君子以明慎用刑，而不留獄」；爻辭寫旅途中居所、資財、童僕的得失。";
"hex.57.name" = "巽";
"hex.57.full" = "巽為風";
"hex.57.bh" = "兩風相隨，象徵順入。卦辭「小亨，利有攸往」，大象云「君子以申命行事」；爻辭有「巽在床下」與「先庚三日，後庚三日」等語。";
"hex.58.name" = "兌";
"hex.58.full" = "兌為澤";
"hex.58.bh" = "兩澤相連，象徵喜悅。卦辭「亨，利貞」，大象云「君子以朋友講習」；爻辭對比和兌、孚兌、來兌、引兌等不同的悅。";
"hex.59.name" = "渙";
"hex.59.full" = "風水渙";
"hex.59.bh" = "風行水上，象徵渙散與化解。卦辭講「王假有廟」，大象云「先王以享于帝立廟」；爻辭寫渙其躬、渙其群、渙王居等離散與重聚。";
"hex.60.name" = "節";
"hex.60.full" = "水澤節";
"hex.60.bh" = "澤上有水，容量有限，象徵節制。卦辭「亨。苦節不可貞」，大象云「君子以制數度，議德行」；爻辭對比安節、甘節、苦節。";
"hex.61.name" = "中孚";
"hex.61.full" = "風澤中孚";
"hex.61.bh" = "澤上有風，象徵誠信存於中。卦辭「豚魚吉」，大象云「君子以議獄緩死」；爻辭有「鳴鶴在陰，其子和之」等感通之象。";
"hex.62.name" = "小過";
"hex.62.full" = "雷山小過";
"hex.62.bh" = "山上有雷，象徵小有過越。卦辭言「可小事，不可大事」，以「飛鳥遺之音」為喻，大象云「君子以行過乎恭，喪過乎哀，用過乎儉」。";
"hex.63.name" = "既濟";
"hex.63.full" = "水火既濟";
"hex.63.bh" = "水在火上，各得其用，象徵事已成。卦辭「初吉終亂」，大象云「君子以思患而豫防之」；爻辭有「濡其尾」「高宗伐鬼方」「濡其首」等象。";
"hex.64.name" = "未濟";
"hex.64.full" = "火水未濟";
"hex.64.bh" = "火在水上，水火不交，象徵事未成。卦辭以「小狐汔濟，濡其尾」為喻，大象云「君子以慎辨物居方」；爻辭由「濡其尾」寫到「濡其首」。";
