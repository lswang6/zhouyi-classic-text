/* 周易 · 繁體中文（台灣）· 卦名、全名、白話要旨、八卦 */
"hex.1.name" = "乾";
"hex.1.full" = "乾為天";
"hex.1.bh" = "天道剛健運行不息。宜主動進取、自強不息，但要循序漸進，戒驕戒躁。";
"hex.2.name" = "坤";
"hex.2.full" = "坤為地";
"hex.2.bh" = "大地柔順承載。宜順勢而為、輔助他人，不宜搶先出頭，守正安穩則吉。";
"hex.3.name" = "屯";
"hex.3.full" = "水雷屯";
"hex.3.bh" = "萬物初生，艱難起步。事情剛開頭阻力多，宜穩住根基、尋求助力，不可冒進。";
"hex.4.name" = "蒙";
"hex.4.full" = "山水蒙";
"hex.4.bh" = "蒙昧待啟。當虛心求教、專心學習；同一問題不宜反覆占問。";
"hex.5.name" = "需";
"hex.5.full" = "水天需";
"hex.5.bh" = "等待時機。條件尚未成熟，保持誠信與耐心，時機一到自然通達。";
"hex.6.name" = "訟";
"hex.6.full" = "天水訟";
"hex.6.bh" = "爭訟之象。宜及早和解、適可而止，爭到底反而不利；可尋求公正的第三方。";
"hex.7.name" = "師";
"hex.7.full" = "地水師";
"hex.7.bh" = "興師動眾。做大事需紀律嚴明、用人得當，由德高望重者領導方能成功。";
"hex.8.name" = "比";
"hex.8.full" = "水地比";
"hex.8.bh" = "親近依附。宜真誠結交、擇善而從，及早靠攏，遲疑觀望則失機。";
"hex.9.name" = "小畜";
"hex.9.full" = "風天小畜";
"hex.9.bh" = "小有積蓄，力量未足。事情醞釀中尚未成形，宜積累實力、修養內在。";
"hex.10.name" = "履";
"hex.10.full" = "天澤履";
"hex.10.bh" = "如履虎尾，謹慎前行。處境有風險，只要守禮、小心，可以平安通過。";
"hex.11.name" = "泰";
"hex.11.full" = "地天泰";
"hex.11.bh" = "天地交泰，上下通達。諸事順利，宜把握良機，同時居安思危。";
"hex.12.name" = "否";
"hex.12.full" = "天地否";
"hex.12.bh" = "天地不交，閉塞不通。宜收斂低調、堅守原則，等待轉機。";
"hex.13.name" = "同人";
"hex.13.full" = "天火同人";
"hex.13.bh" = "與人和同。宜廣結同道、公開合作，不拘私門小圈子。";
"hex.14.name" = "大有";
"hex.14.full" = "火天大有";
"hex.14.bh" = "大有收穫，如日中天。宜揚善抑惡、謙和守成，方能長保豐盛。";
"hex.15.name" = "謙";
"hex.15.full" = "地山謙";
"hex.15.bh" = "謙虛退讓。越謙和越能得人助力，六爻皆吉，是有始有終之象。";
"hex.16.name" = "豫";
"hex.16.full" = "雷地豫";
"hex.16.bh" = "和樂順暢，眾人響應。宜提前籌劃、順勢行動，但不可沉溺安逸。";
"hex.17.name" = "隨";
"hex.17.full" = "澤雷隨";
"hex.17.bh" = "隨時而動，擇善而從。宜順應形勢、靈活變通，同時堅守正道。";
"hex.18.name" = "蠱";
"hex.18.full" = "山風蠱";
"hex.18.bh" = "積弊待治。舊問題需要整頓革新，事前謀劃、事後檢視，可轉危為安。";
"hex.19.name" = "臨";
"hex.19.full" = "地澤臨";
"hex.19.bh" = "居上臨下，漸入佳境。形勢向好，宜積極作為，也要預防盛極而衰。";
"hex.20.name" = "觀";
"hex.20.full" = "風地觀";
"hex.20.bh" = "觀察與示範。宜靜觀全局、反省自身，以誠意感人，不急於行動。";
"hex.21.name" = "噬嗑";
"hex.21.full" = "火雷噬嗑";
"hex.21.bh" = "咬合除障。中間有阻礙，須果斷處理、明辨是非，障礙除去即可通達。";
"hex.22.name" = "賁";
"hex.22.full" = "山火賁";
"hex.22.bh" = "文飾之美。適度修飾有益，但不可捨本逐末，小事順利、大事需重實質。";
"hex.23.name" = "剝";
"hex.23.full" = "山地剝";
"hex.23.bh" = "剝落衰退。形勢不利，宜守不宜攻，保存實力、等待來復。";
"hex.24.name" = "復";
"hex.24.full" = "地雷復";
"hex.24.bh" = "一陽來復，重新開始。低谷已過，宜及時回歸正道，循序恢復。";
"hex.25.name" = "無妄";
"hex.25.full" = "天雷無妄";
"hex.25.bh" = "真實不妄。順其自然、不存僥倖則吉；妄動妄求則有災。";
"hex.26.name" = "大畜";
"hex.26.full" = "山天大畜";
"hex.26.bh" = "大有積蓄。宜厚積學識與實力，時機成熟可外出成就大事。";
"hex.27.name" = "頤";
"hex.27.full" = "山雷頤";
"hex.27.bh" = "頤養之道。注意飲食起居與言語，靠自己的正當努力獲得所需。";
"hex.28.name" = "大過";
"hex.28.full" = "澤風大過";
"hex.28.bh" = "負荷過重，棟樑彎曲。非常之時需非常之舉，獨立擔當而不懼。";
"hex.29.name" = "坎";
"hex.29.full" = "坎為水";
"hex.29.bh" = "重重險阻。身處困境時保持信念與恆心，像水一樣堅持流動，終能脫險。";
"hex.30.name" = "離";
"hex.30.full" = "離為火";
"hex.30.bh" = "光明依附。宜依附正道與賢者，保持柔順謙和，光明才能持久。";
"hex.31.name" = "咸";
"hex.31.full" = "澤山咸";
"hex.31.bh" = "相互感應。人際與感情以真誠相感，虛心待人則關係順遂。";
"hex.32.name" = "恆";
"hex.32.full" = "雷風恆";
"hex.32.bh" = "恆久之道。宜堅守既定方向，持之以恆，不輕易改變。";
"hex.33.name" = "遯";
"hex.33.full" = "天山遯";
"hex.33.bh" = "退避之時。形勢對己不利，適時退讓保全自己，以退為進。";
"hex.34.name" = "大壯";
"hex.34.full" = "雷天大壯";
"hex.34.bh" = "聲勢強盛。力量充足時更要守正守禮，切忌恃強妄動。";
"hex.35.name" = "晉";
"hex.35.full" = "火地晉";
"hex.35.bh" = "旭日東昇，晉升進展。宜積極表現、展現才德，容易得到賞識。";
"hex.36.name" = "明夷";
"hex.36.full" = "地火明夷";
"hex.36.bh" = "光明受損。環境昏暗時宜韜光養晦，內守光明、外示柔順。";
"hex.37.name" = "家人";
"hex.37.full" = "風火家人";
"hex.37.bh" = "家庭之道。宜各守其位、言行有據，內部和睦則諸事順。";
"hex.38.name" = "睽";
"hex.38.full" = "火澤睽";
"hex.38.bh" = "乖離相背。意見分歧時求同存異，小事可成，大事需慢慢化解隔閡。";
"hex.39.name" = "蹇";
"hex.39.full" = "水山蹇";
"hex.39.bh" = "行路艱難。前方有阻，宜反省自身、尋求貴人，暫緩前進。";
"hex.40.name" = "解";
"hex.40.full" = "雷水解";
"hex.40.bh" = "困難解除。宜寬和處事、及早行動，化解舊怨，恢復秩序。";
"hex.41.name" = "損";
"hex.41.full" = "山澤損";
"hex.41.bh" = "減損之道。捨小利、去私欲，誠心付出，反而有所收穫。";
"hex.42.name" = "益";
"hex.42.full" = "風雷益";
"hex.42.bh" = "增益之時。利於開拓進取，見善則學、有過則改，收益可期。";
"hex.43.name" = "夬";
"hex.43.full" = "澤天夬";
"hex.43.bh" = "決斷之時。當斷則斷，但宜公開說理、以德服人，不宜硬碰硬。";
"hex.44.name" = "姤";
"hex.44.full" = "天風姤";
"hex.44.bh" = "不期而遇。有意外的相遇或機會，但需辨明來者，防微杜漸。";
"hex.45.name" = "萃";
"hex.45.full" = "澤地萃";
"hex.45.bh" = "薈萃聚合。人與資源匯聚之時，宜凝聚人心，同時做好防備。";
"hex.46.name" = "升";
"hex.46.full" = "地風升";
"hex.46.bh" = "步步高升。如樹木生長，積小成大，順勢向上，可大膽前進。";
"hex.47.name" = "困";
"hex.47.full" = "澤水困";
"hex.47.bh" = "困窮之境。身處逆境少說多做，堅守志向，困境終將打開。";
"hex.48.name" = "井";
"hex.48.full" = "水風井";
"hex.48.bh" = "井養不窮。根本穩固而持續付出，貴在修治與堅持，功虧一簣則不利。";
"hex.49.name" = "革";
"hex.49.full" = "澤火革";
"hex.49.bh" = "變革之時。改變需時機成熟、取信於人，順天應人則變革成功。";
"hex.50.name" = "鼎";
"hex.50.full" = "火風鼎";
"hex.50.bh" = "鼎新定位。宜穩固地位、任用賢才，新局面已經確立。";
"hex.51.name" = "震";
"hex.51.full" = "震為雷";
"hex.51.bh" = "驚雷震動。遇突發變故保持鎮定、警醒自省，事後反而安然。";
"hex.52.name" = "艮";
"hex.52.full" = "艮為山";
"hex.52.bh" = "止而不動。知止而止，控制欲念，安守本分，不越位行事。";
"hex.53.name" = "漸";
"hex.53.full" = "風山漸";
"hex.53.bh" = "循序漸進。如鴻雁漸飛，按部就班推進，不可急於求成。";
"hex.54.name" = "歸妹";
"hex.54.full" = "雷澤歸妹";
"hex.54.bh" = "名分未正。行事需注意身分與分寸，貿然前進不利，宜守常待時。";
"hex.55.name" = "豐";
"hex.55.full" = "雷火豐";
"hex.55.bh" = "豐盛盛大。正值鼎盛，宜把握當下，也要明白日中則昃的道理。";
"hex.56.name" = "旅";
"hex.56.full" = "火山旅";
"hex.56.bh" = "羈旅在外。身處陌生環境宜謙和守正、謹慎行事，小事可成。";
"hex.57.name" = "巽";
"hex.57.full" = "巽為風";
"hex.57.bh" = "如風入物，謙遜滲透。宜柔和溝通、反覆申明，順勢而入。";
"hex.58.name" = "兌";
"hex.58.full" = "兌為澤";
"hex.58.bh" = "喜悅和樂。以真誠待人、互相切磋，喜悅發自正道則亨通。";
"hex.59.name" = "渙";
"hex.59.full" = "風水渙";
"hex.59.bh" = "渙散與化解。人心離散時宜凝聚共識；鬱結之事可藉機化開。";
"hex.60.name" = "節";
"hex.60.full" = "水澤節";
"hex.60.bh" = "節制有度。凡事適可而止、量入為出，但過度苛刻也難持久。";
"hex.61.name" = "中孚";
"hex.61.full" = "風澤中孚";
"hex.61.bh" = "誠信於中。以真誠感化他人，誠意所至，難事亦可成。";
"hex.62.name" = "小過";
"hex.62.full" = "雷山小過";
"hex.62.bh" = "小有過越。宜做小事、放低姿態，不宜好高騖遠。";
"hex.63.name" = "既濟";
"hex.63.full" = "水火既濟";
"hex.63.bh" = "事已成功。成功之後易生懈怠，宜居安思危、防患未然。";
"hex.64.name" = "未濟";
"hex.64.full" = "火水未濟";
"hex.64.bh" = "事未完成。尚在過程之中，謹慎收尾、慎辨方向，終有可成之時。";
