/* 周易 · de · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: de.json */
"hex.1.ci" = "Vier Tugenden: schöpferischer Anfang, Gelingen, förderliche Harmonie und Standhaftigkeit im Rechten.";
"hex.1.daxiang" = "Der Himmel bewegt sich kraftvoll und unablässig. So stärkt sich der Edle ohne Unterlass.";
"hex.1.yao.0" = "Der Drache bleibt unter Wasser verborgen. Noch ist es nicht Zeit zu handeln.";
"hex.1.yao.1" = "Der Drache erscheint auf dem Feld. Es ist förderlich, den großen Menschen zu sehen.";
"hex.1.yao.2" = "Der Edle ist den ganzen Tag unermüdlich tätig und bleibt auch abends wachsam, als drohe Gefahr. Kein Makel.";
"hex.1.yao.3" = "Der Drache springt empor oder zieht sich in die Tiefe zurück, je nach der Zeit. Kein Makel.";
"hex.1.yao.4" = "Der Drache fliegt am Himmel. Es ist förderlich, den großen Menschen zu sehen.";
"hex.1.yao.5" = "Der Drache steigt zu hoch. Es wird Reue geben.";
"hex.2.ci" = "Schöpferischer Anfang und Gelingen. Förderlich ist Standhaftigkeit im Rechten mit der Fügsamkeit einer Stute. Bricht der Edle auf und geht voran, verirrt er sich; folgt er, findet er einen Herrn. Das ist förderlich. Im Südwesten findet er Freunde, im Nordosten verliert er Freunde. Ruhig am Rechten festhalten bringt Heil.";
"hex.2.daxiang" = "Die Erde ist fügsam, weit und tief. So trägt der Edle durch die Fülle seiner Tugend alle Wesen.";
"hex.2.yao.0" = "Wer auf Reif tritt, weiß, dass festes Eis naht (dem Übel schon bei den ersten Anzeichen vorbeugen).";
"hex.2.yao.1" = "Geradheit, Lauterkeit und Größe: Ohne bewusstes Einüben ist alles förderlich.";
"hex.2.yao.2" = "Die Tugend im Verborgenen bewahren und am Rechten festhalten. Dient man dem König, beansprucht man nicht den Verdienst, führt das Werk aber zu Ende.";
"hex.2.yao.3" = "Den Sack zubinden (vorsichtig schweigen). Kein Makel, kein Lob.";
"hex.2.yao.4" = "Ein gelbes Untergewand tragen (Gelb steht für die Mitte, das untere Gewand für eine niedrige Stellung: Bilder von Maß und Bescheidenheit). Großes Heil.";
"hex.2.yao.5" = "Drachen kämpfen auf freiem Feld; ihr Blut ist schwarzblau und gelb (die Farben von Himmel und Erde: Yin und Yang bekämpfen und verletzen einander).";
"hex.3.ci" = "Schöpferischer Anfang und Gelingen. Förderlich ist Standhaftigkeit im Rechten. Nicht übereilt aufbrechen. Es ist förderlich, Fürsten einzusetzen (einen Herrscher bestellen und Helfer suchen).";
"hex.3.daxiang" = "Oben Wolken, unten Donner: Die Anfangsschwierigkeit. So plant und ordnet der Edle die Welt, wie man Seidenfäden entwirrt.";
"hex.3.yao.0" = "Zögern, ohne voranzukommen. Es ist förderlich, am Ort im Rechten auszuharren und Fürsten einzusetzen.";
"hex.3.yao.1" = "Mühsam stocken und zögern; zu Pferd im Kreis treten. Es kommen keine Räuber, sondern Brautwerber. Die junge Frau hält am Rechten fest und verweigert die Verlobung; erst nach zehn Jahren stimmt sie zu.";
"hex.3.yao.2" = "Wer ohne Wildhüter (Beamter für die Wälder) einen Hirsch verfolgt, verirrt sich nur im Wald. Der Edle erkennt die ersten Anzeichen und lässt besser davon ab. Weiterzugehen bringt Beschämung.";
"hex.3.yao.3" = "Zu Pferd im Kreis treten. Aufbrechen, um eine Ehe zu erbitten, bringt Heil. Alles ist förderlich.";
"hex.3.yao.4" = "Wohltaten stauen sich und können nicht verteilt werden. Standhaftigkeit im Rechten bringt bei kleinen Vorhaben Heil, bei großen Unheil.";
"hex.3.yao.5" = "Zu Pferd im Kreis treten; blutige Tränen strömen.";
"hex.4.ci" = "Gelingen. Nicht ich suche den unwissenden Jungen; er sucht mich. Bei der ersten Befragung gebe ich Auskunft. Zwei- oder dreimal zu fragen ist eine Entweihung; darauf gebe ich keine Auskunft mehr. Förderlich ist Standhaftigkeit im Rechten.";
"hex.4.daxiang" = "Am Fuß des Berges entspringt eine Quelle: Die Jugendtorheit. So handelt der Edle entschlossen und pflegt seine Tugend.";
"hex.4.yao.0" = "Unwissenheit aufklären. Es ist förderlich, Menschen durch Strafen zur Ordnung zu bringen, um sie von Fesseln zu befreien. Mit dem Strafen immer fortzufahren bringt Beschämung.";
"hex.4.yao.1" = "Den Unwissenden nachsichtig aufnehmen bringt Heil. Eine Frau heiraten bringt Heil. Der Sohn vermag das Haus zu führen.";
"hex.4.yao.2" = "Diese Frau nicht heiraten: Sie sieht einen reichen Mann und gibt sich ohne Selbstachtung hin. Nichts ist förderlich.";
"hex.4.yao.3" = "In Unwissenheit gefangen: Beschämung.";
"hex.4.yao.4" = "Mit der Unbefangenheit eines Kindes Belehrung suchen bringt Heil.";
"hex.4.yao.5" = "Unwissenheit entschieden bekämpfen. Es ist nicht förderlich, wie ein Räuber gewaltsam vorzugehen; förderlich ist es, Übergriffe abzuwehren.";
"hex.5.ci" = "Aufrichtigkeit bringt Klarheit und Gelingen. Standhaftigkeit im Rechten bringt Heil. Es ist förderlich, den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden).";
"hex.5.daxiang" = "Wolken steigen am Himmel auf (und warten auf die Zeit, Regen zu geben): Das Warten. So isst und trinkt der Edle und erfreut sich in Ruhe, während er auf die rechte Zeit wartet.";
"hex.5.yao.0" = "Fern von der Stadt warten. Es ist förderlich, beständig zu bleiben. Kein Makel.";
"hex.5.yao.1" = "Auf dem Sand warten. Ein wenig Wortstreit; am Ende Heil.";
"hex.5.yao.2" = "Im Schlamm warten zieht Räuber herbei.";
"hex.5.yao.3" = "Im Blut warten (an einem Ort der Verwundung), dann aus der Grube herauskommen.";
"hex.5.yao.4" = "Bei Speise und Wein ruhig warten. Standhaftigkeit im Rechten bringt Heil.";
"hex.5.yao.5" = "In die Grube geraten. Drei ungebetene Gäste kommen. Sie ehrerbietig behandeln bringt am Ende Heil.";
"hex.6.ci" = "Aufrichtigkeit stößt auf Hemmnisse. Wachsam bleiben und auf halbem Weg einhalten bringt Heil; den Streit bis zum Ende treiben bringt Unheil. Es ist förderlich, den großen Menschen zu sehen (um ein gerechtes Urteil zu erhalten). Es ist nicht förderlich, den großen Fluss zu überqueren.";
"hex.6.daxiang" = "Der Himmel steigt auf, das Wasser fließt abwärts; ihre Wege gehen auseinander: Der Streit. So plant der Edle jedes Vorhaben schon zu Beginn sorgfältig (um Streit vorzubeugen).";
"hex.6.yao.0" = "Den Streit nicht in die Länge ziehen. Ein wenig Wortstreit; am Ende Heil.";
"hex.6.yao.1" = "Im Rechtsstreit unterliegen, heimkehren und sich entziehen. Sein Lehen zählt nur dreihundert Haushalte: kein Unheil.";
"hex.6.yao.2" = "Von früher gewährten Einkünften und Wohltaten leben. Angesichts der Gefahr am Rechten festhalten: am Ende Heil. Dient man dem König, beansprucht man nicht den Verdienst.";
"hex.6.yao.3" = "Im Rechtsstreit unterliegen, zur rechten Ordnung zurückkehren, seine Absicht ändern und ruhig am Rechten festhalten: Heil.";
"hex.6.yao.4" = "Den Rechtsstreit entscheiden (mit gerechtem Urteil): großes Heil.";
"hex.6.yao.5" = "Selbst wenn einem ein prächtiger Gürtel verliehen wird, wird er einem an einem einzigen Tag dreimal wieder genommen.";
"hex.7.ci" = "Standhaftigkeit im Rechten. Führt ein durch seine Tugend geachteter Älterer, bringt dies Heil. Kein Makel.";
"hex.7.daxiang" = "In der Erde ruht Wasser: Das Heer. So nimmt der Edle das Volk auf und sorgt für die Vielen.";
"hex.7.yao.0" = "Das Heer muss unter strenger Disziplin ausziehen. Mangelhafte Disziplin bringt Unheil.";
"hex.7.yao.1" = "Inmitten des Heeres den Befehl führen: Heil, kein Makel. Der König verleiht wiederholt ehrende Auszeichnungen.";
"hex.7.yao.2" = "Das Heer kehrt womöglich mit Leichen beladen zurück. Unheil.";
"hex.7.yao.3" = "Das Heer zieht sich zurück und schlägt sein Lager auf. Kein Makel.";
"hex.7.yao.4" = "Wild ist auf dem Feld (Bild eines feindlichen Einfalls). Es ist förderlich, es anzuklagen und zu ergreifen. Kein Makel. Der älteste Sohn soll das Heer führen; übernimmt ein tugendloser Jüngerer den Befehl, kehrt es mit Leichen zurück. Selbst bei Standhaftigkeit im Rechten: Unheil.";
"hex.7.yao.5" = "Der Herrscher erlässt seinen Befehl: Verdiente erhalten Fürstentümer oder erbliche Lehen. Gemeine Menschen dürfen nicht eingesetzt werden.";
"hex.8.ci" = "Heil. Den ursprünglichen Sinn des Orakels ergründen: Mit schöpferischem Anfang, Dauer und Standhaftigkeit im Rechten bleibt kein Makel. Die unruhigen Länder schließen sich an. Wer zu spät kommt, erfährt Unheil.";
"hex.8.daxiang" = "Wasser liegt auf der Erde (beide sind eng verbunden): Das Zusammenhalten. So gründeten die früheren Könige die vielen Staaten und pflegten Nähe zu den Fürsten.";
"hex.8.yao.0" = "Sich anderen mit Aufrichtigkeit anschließen. Kein Makel. Aufrichtigkeit füllt den Tonkrug wie überfließender Wein; am Ende kommt noch unerwarteter Gewinn hinzu. Heil.";
"hex.8.yao.1" = "Sich aus innerstem Herzen anschließen. Standhaftigkeit im Rechten bringt Heil.";
"hex.8.yao.2" = "Sich Menschen anschließen, denen man sich nicht anschließen sollte.";
"hex.8.yao.3" = "Sich nach außen einem Würdigen anschließen. Standhaftigkeit im Rechten bringt Heil.";
"hex.8.yao.4" = "Sich offen und redlich zusammenschließen. Bei der Jagd lässt der König das Wild von drei Seiten treiben und durch die offene Seite entkommen. Die Bewohner müssen einander nicht misstrauen. Heil.";
"hex.8.yao.5" = "Sich anschließen, ohne rechtzeitig voranzugehen (nach anderer Lesart: ohne guten Anfang): Unheil.";
"hex.9.ci" = "Gelingen. Dichte Wolken steigen vom westlichen Umland herauf, doch es regnet nicht.";
"hex.9.daxiang" = "Der Wind weht über dem Himmel: Des Kleinen Zähmungskraft. So veredelt der Edle seine Bildung und Tugend.";
"hex.9.yao.0" = "Auf den eigenen rechten Weg zurückkehren: Welchen Makel könnte es geben? Heil.";
"hex.9.yao.1" = "Gemeinsam auf den rechten Weg zurückgezogen werden. Heil.";
"hex.9.yao.2" = "Die Speichen des Wagenrads lösen sich. Mann und Frau entzweien sich.";
"hex.9.yao.3" = "Durch Aufrichtigkeit weichen die Sorgen und schwindet die Furcht. Kein Makel.";
"hex.9.yao.4" = "Aufrichtigkeit verbindet die Menschen; man teilt den Wohlstand mit seinen Nachbarn.";
"hex.9.yao.5" = "Der Regen ist gefallen; das Yang wird zurückgehalten und kommt zur Ruhe. Dies bewirkt die Hochschätzung angesammelter Tugend. Für die Frau besteht selbst bei Standhaftigkeit im Rechten Gefahr. Der Mond ist fast voll (das Yin erstarkt und wird dem Yang ebenbürtig). Zieht der Edle aus, bringt das Unheil.";
"hex.10.ci" = "Auf den Schwanz des Tigers treten, ohne dass er beißt. Gelingen.";
"hex.10.daxiang" = "Oben der Himmel, unten der See: Das Auftreten. So unterscheidet der Edle höhere und niedrigere Stellungen und festigt den Sinn des Volkes.";
"hex.10.yao.0" = "In natürlicher Schlichtheit handeln. Vorangehen: kein Makel.";
"hex.10.yao.1" = "Der Weg ist breit und eben. Wer zurückgezogen und gelassen lebt, findet durch Standhaftigkeit im Rechten Heil.";
"hex.10.yao.2" = "Ein Einäugiger meint, klar sehen zu können; ein Lahmer meint, weit gehen zu können. Auf den Schwanz des Tigers treten und gebissen werden: Unheil. Wie ein Kriegsmann, der sich anmaßt, Herrscher zu werden.";
"hex.10.yao.3" = "Auf den Schwanz des Tigers treten, voll Furcht und Vorsicht. Am Ende Heil.";
"hex.10.yao.4" = "Mit fester Entschlossenheit handeln. Selbst bei Standhaftigkeit im Rechten besteht Gefahr.";
"hex.10.yao.5" = "Den zurückgelegten Weg betrachten und die Zeichen von Glück und Unglück prüfen. Ist alles umfassend vollendet, gibt es großes Heil.";
"hex.11.ci" = "Das Kleine geht, das Große kommt (Yin weicht, Yang kommt). Heil und Gelingen.";
"hex.11.daxiang" = "Himmel und Erde verbinden sich: Der Friede. So gibt der Herrscher dem Wirken von Himmel und Erde seine Ordnung, unterstützt ihr förderndes Schaffen und hilft damit dem Volk.";
"hex.11.yao.0" = "Gras ausreißen, dessen Wurzeln miteinander verflochten sind. Mit seinesgleichen ausziehen bringt Heil.";
"hex.11.yao.1" = "Auch das Unkultivierte aufnehmen, den Fluss zu Fuß zu durchqueren wagen, ferne Würdige nicht übergehen und keine eigennützigen Parteien bilden: So erlangt man Achtung durch den Weg der Mitte.";
"hex.11.yao.2" = "Keine Ebene ohne Hang, kein Fortgehen ohne Wiederkehr. In Schwierigkeiten am Rechten festhalten: kein Makel. Nicht um das Vertrauen anderer sorgen; Segen und Nahrung werden einem zuteil.";
"hex.11.yao.3" = "Leicht herabschweben. Ohne auf Reichtum zu bauen mit den Nachbarn einig sein; einander aufrichtig und ohne Misstrauen begegnen.";
"hex.11.yao.4" = "Di Yi (König der Shang-Dynastie) verheiratet seine jüngere Schwester. Daraus erwächst Segen: großes Heil.";
"hex.11.yao.5" = "Die Stadtmauer stürzt in den Graben zurück. Kein Heer einsetzen. In der eigenen Stadt Befehle verkünden. Selbst bei Standhaftigkeit im Rechten: Beschämung.";
"hex.12.ci" = "Die Stockung entspricht nicht dem rechten menschlichen Weg (nach anderer Lesart wird sie von gemeinen Menschen verursacht). Sie ist der Standhaftigkeit des Edlen im Rechten nicht förderlich. Das Große geht, das Kleine kommt (Yang weicht, Yin kommt).";
"hex.12.daxiang" = "Himmel und Erde verbinden sich nicht: Die Stockung. So hält der Edle seine Tugend zurück, um Gefahren zu entgehen, und begehrt weder Ruhm noch besoldete Ämter.";
"hex.12.yao.0" = "Gras ausreißen, dessen Wurzeln miteinander verflochten sind. Mit seinesgleichen am Rechten festhalten: Heil und Gelingen.";
"hex.12.yao.1" = "Die Höhergestellten aufnehmen und ihnen folgen bringt dem gemeinen Menschen Heil. Der große Mensch hält in der Stockung stand und findet so Gelingen.";
"hex.12.yao.2" = "Scham in sich verbergen.";
"hex.12.yao.3" = "Dem Auftrag des Himmels folgen: kein Makel. Gleichgesinnte schließen sich an und teilen den Segen.";
"hex.12.yao.4" = "Die Stockung beenden bringt dem großen Menschen Heil. Stets wachsam bleiben: „Untergang droht! Untergang droht!“ So bleibt man fest, als wäre man an einen Büschel Maulbeerbäume gebunden.";
"hex.12.yao.5" = "Die Stockung stürzen. Erst Hemmung, dann Freude.";
"hex.13.ci" = "Sich auf freiem Feld mit Menschen verbinden: Gelingen. Es ist förderlich, den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden). Die Standhaftigkeit des Edlen im Rechten ist förderlich.";
"hex.13.daxiang" = "Himmel und Feuer stimmen überein: Gemeinschaft mit Menschen. So gliedert der Edle die Menschen nach ihrer Art und unterscheidet die Dinge, um Gemeinsamkeit und Unterschiede zu erkennen.";
"hex.13.yao.0" = "Sich gleich vor der Haustür mit Menschen verbinden. Kein Makel.";
"hex.13.yao.1" = "Sich nur mit dem eigenen Geschlecht verbinden. Beschämung.";
"hex.13.yao.2" = "Soldaten im Dickicht verbergen, zur hohen Anhöhe hinaufsteigen und spähen; drei Jahre lang wagt man keinen Angriff.";
"hex.13.yao.3" = "Die Mauer des Gegners besteigen, doch schließlich nicht angreifen. Heil.";
"hex.13.yao.4" = "Bei der Vereinigung mit Menschen erst laut weinen, dann lachen. Nachdem das große Heer den Feind besiegt hat, kann man sich wieder begegnen.";
"hex.13.yao.5" = "Sich im nahen Umland mit Menschen verbinden. Keine Reue (auch wenn die Gemeinschaft noch nicht das weite Land umfasst).";
"hex.14.ci" = "Großes Gelingen.";
"hex.14.daxiang" = "Feuer leuchtet über dem Himmel: Der Besitz von Großem. So hemmt der Edle das Böse, fördert das Gute und folgt dem segensreichen Auftrag des Himmels.";
"hex.14.yao.0" = "Sich nicht mit Schädlichem verbinden vermeidet Schuld. Sich stets der Schwierigkeiten bewusst bleiben: kein Makel.";
"hex.14.yao.1" = "Güter auf einen großen Wagen laden und aufbrechen. Kein Makel.";
"hex.14.yao.2" = "Der Fürst bringt dem Himmelssohn Tribut dar (nach anderer Lesart nimmt er an dessen Festmahl teil). Der gemeine Mensch vermag dies nicht.";
"hex.14.yao.3" = "Die eigene Größe nicht übermäßig zur Schau stellen. Kein Makel.";
"hex.14.yao.4" = "Aufrichtigkeit im Umgang mit Höheren und Niedrigeren, verbunden mit Würde. Heil.";
"hex.14.yao.5" = "Der Himmel selbst gewährt Schutz. Heil; alles ist förderlich.";
"hex.15.ci" = "Gelingen. Der Edle führt die Dinge zu einem guten Ende.";
"hex.15.daxiang" = "Ein Berg inmitten der Erde: Die Bescheidenheit. So mindert der Edle das Übermaß und ergänzt den Mangel; er wägt die Dinge ab und verteilt gerecht.";
"hex.15.yao.0" = "Der Edle, bescheiden und nochmals bescheiden, kann so den großen Fluss überqueren (Gefahren bestehen und ein Vorhaben vollenden). Heil.";
"hex.15.yao.1" = "Die Bescheidenheit wird weithin bekannt. Standhaftigkeit im Rechten bringt Heil.";
"hex.15.yao.2" = "Der Edle bleibt trotz seiner Verdienste bescheiden. Am Ende Heil.";
"hex.15.yao.3" = "Alles ist förderlich. Bescheidenheit entfalten (sie ausüben und zur Geltung bringen).";
"hex.15.yao.4" = "Die Nachbarn folgen, ohne dass man auf Reichtum bauen muss. Es ist förderlich, Widerspenstige mit Waffengewalt zu unterwerfen. Alles ist förderlich.";
"hex.15.yao.5" = "Die Bescheidenheit wird weithin bekannt. Es ist förderlich, das Heer einzusetzen und die Städte und Länder des eigenen Herrschaftsgebiets zu unterwerfen.";
"hex.16.ci" = "Es ist förderlich, Fürsten einzusetzen und das Heer ausziehen zu lassen.";
"hex.16.daxiang" = "Der Donner bricht kraftvoll aus der Erde hervor: Die Begeisterung. So schufen die früheren Könige Musik, um die Tugend zu ehren, und brachten sie dem höchsten Himmelsgott feierlich dar, wobei sie ihre Ahnen in die Verehrung einbezogen.";
"hex.16.yao.0" = "Mit empfangener Gunst und Freude prahlen, selbstgefällig jubeln. Unheil.";
"hex.16.yao.1" = "Fest wie ein Fels, den rechten Augenblick erkennen und noch vor Tagesende handeln. Standhaftigkeit im Rechten bringt Heil.";
"hex.16.yao.2" = "Mit schmeichelndem Aufblick Behagen suchen: Reue. Zu spät zur Einsicht kommen: abermals Reue.";
"hex.16.yao.3" = "Durch ihn finden alle Freude; groß ist der Gewinn. Nicht zweifeln: Freunde sammeln sich wie Haare um eine Haarnadel.";
"hex.16.yao.4" = "Trotz Standhaftigkeit im Rechten erkrankt, doch auf Dauer nicht vom Tod ereilt.";
"hex.16.yao.5" = "Blind in Vergnügungen versinken. Findet man zur Umkehr, bleibt kein Makel.";
"hex.17.ci" = "Großes Gelingen. Förderlich ist Standhaftigkeit im Rechten. Kein Makel.";
"hex.17.daxiang" = "Im See ruht der Donner: Die Nachfolge. So zieht sich der Edle bei Einbruch der Dunkelheit ins Haus zur Ruhe zurück.";
"hex.17.yao.0" = "Die geleitete Aufgabe ändert sich (nach anderer Lesart: die Vorstellungen ändern sich). Standhaftigkeit im Rechten bringt Heil. Hinausgehen und Beziehungen knüpfen bringt Erfolg.";
"hex.17.yao.1" = "Wer sich an den Jungen bindet, verliert den erwachsenen Mann.";
"hex.17.yao.2" = "Wer sich an den erwachsenen Mann bindet, verliert den Jungen. Im Folgen erhält man, was man sucht. Es ist förderlich, im Rechten zu verharren.";
"hex.17.yao.3" = "Die Nachfolge bringt Gewinn, doch selbst bei Standhaftigkeit im Rechten droht Unheil. Mit Aufrichtigkeit, Treue zum rechten Weg und Einsicht: Welchen Makel könnte es geben?";
"hex.17.yao.4" = "Den Guten und Tugendhaften mit Aufrichtigkeit begegnen. Heil.";
"hex.17.yao.5" = "Ihn festhalten und binden, dann die Bande festziehen, damit er folgt. Der König bringt am Westberg (Berg Qi) ein Opfer dar.";
"hex.18.ci" = "Großes Gelingen. Es ist förderlich, den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden). Drei Tage vor dem Jia-Tag (am Xin-Tag) planen; drei Tage danach (am Ding-Tag) prüfen und überdenken.";
"hex.18.daxiang" = "Unter dem Berg weht Wind: Die Arbeit am Verdorbenen. So stärkt der Edle das Volk und pflegt die Tugend.";
"hex.18.yao.0" = "Die vom Vater hinterlassenen Missstände beheben. Mit einem solchen Sohn bleibt der verstorbene Vater ohne Makel. Gefahr, doch am Ende Heil.";
"hex.18.yao.1" = "Die von der Mutter hinterlassenen Missstände beheben. Nicht starr oder eigensinnig sein (mit Takt vorgehen).";
"hex.18.yao.2" = "Die vom Vater hinterlassenen Missstände beheben. Ein wenig Reue, doch kein großer Makel.";
"hex.18.yao.3" = "Die vom Vater hinterlassenen Missstände dulden. So fortzufahren bringt Beschämung.";
"hex.18.yao.4" = "Die vom Vater hinterlassenen Missstände beheben und dafür Anerkennung erhalten.";
"hex.18.yao.5" = "Weder Königen noch Fürsten dienen; die eigenen Bestrebungen und das eigene Handeln hochhalten.";
"hex.19.ci" = "Großes Gelingen. Förderlich ist Standhaftigkeit im Rechten. Im achten Monat kommt Unheil.";
"hex.19.daxiang" = "Erde über dem See: Die Annäherung. So ist das Sinnen des Edlen auf die Bildung des Volkes unerschöpflich, und seine Fürsorge und sein Schutz sind grenzenlos.";
"hex.19.yao.0" = "Dem Volk nahen und sein Herz bewegen (durch sittlichen Einfluss). Standhaftigkeit im Rechten bringt Heil.";
"hex.19.yao.1" = "Dem Volk nahen und sein Herz bewegen. Heil; alles ist förderlich.";
"hex.19.yao.2" = "Dem Volk mit süßen Worten nahen: Nichts ist förderlich. Sich darüber sorgen und sich bessern: kein Makel.";
"hex.19.yao.3" = "Dem Volk persönlich ganz nahekommen. Kein Makel.";
"hex.19.yao.4" = "Dem Volk mit Weisheit nahen, wie es einem großen Herrscher gebührt. Heil.";
"hex.19.yao.5" = "Dem Volk mit aufrichtiger Güte nahen. Heil, kein Makel.";
"hex.20.ci" = "Beim Opfer sind die Hände gewaschen und die Trankspende ausgegossen, die Gaben aber noch nicht dargebracht (der Augenblick tiefster Andacht). Aufrichtigkeit und würdevolle Haltung wecken Ehrfurcht.";
"hex.20.daxiang" = "Der Wind zieht über die Erde: Die Betrachtung. So bereisten die früheren Könige die Regionen, beobachteten die Lebensverhältnisse des Volkes und richteten seine Unterweisung ein.";
"hex.20.yao.0" = "Mit dem begrenzten Blick eines Kindes betrachten. Für den gemeinen Menschen kein Makel; für den Edlen Beschämung.";
"hex.20.yao.1" = "Durch den Türspalt schauen. Die Standhaftigkeit der Frau im Rechten ist förderlich.";
"hex.20.yao.2" = "Das eigene Handeln betrachten, um über Vorangehen oder Rückzug zu entscheiden.";
"hex.20.yao.3" = "Den Glanz eines gut regierten Landes betrachten. Es ist förderlich, als Gast zum König zu kommen (um ein Amt anzutreten und ihm beizustehen).";
"hex.20.yao.4" = "Das eigene Handeln betrachten. Für den Edlen kein Makel.";
"hex.20.yao.5" = "Das Handeln anderer betrachten (nach anderer Lesart wird das eigene Handeln von anderen betrachtet). Für den Edlen kein Makel.";
"hex.21.ci" = "Gelingen. Es ist förderlich, die Strafgerichtsbarkeit anzuwenden.";
"hex.21.daxiang" = "Donner und Blitz verbinden sich: Das Durchbeißen. So machten die früheren Könige die Strafen deutlich und hielten die Gesetze in Ordnung.";
"hex.21.yao.0" = "Die Füße stecken in Fesseln, die die Zehen verdecken. Kein Makel (eine kleine Strafe dient als ernste Warnung).";
"hex.21.yao.1" = "In weiches Fleisch beißen, bis die Nase darin versinkt. Kein Makel.";
"hex.21.yao.2" = "In hartes Dörrfleisch beißen und auf Gift stoßen. Geringe Beschämung, kein Makel.";
"hex.21.yao.3" = "In Dörrfleisch mit Knochen beißen und eine metallene Pfeilspitze finden (Bild fester Geradheit). Es ist förderlich, in Schwierigkeiten am Rechten festzuhalten. Heil.";
"hex.21.yao.4" = "In Dörrfleisch beißen und gelbes Gold finden (Bild von Mitte und Festigkeit). Angesichts der Gefahr am Rechten festhalten. Kein Makel.";
"hex.21.yao.5" = "Ein Strafjoch auf den Schultern tragen, das die Ohren verdeckt. Unheil.";
"hex.22.ci" = "Gelingen. Aufzubrechen ist in geringem Maß förderlich.";
"hex.22.daxiang" = "Feuer unter dem Berg (sein Licht reicht nur begrenzt): Die Anmut. So bringt der Edle Klarheit in die Regierungsgeschäfte, wagt aber keine leichtfertigen Gerichtsurteile.";
"hex.22.yao.0" = "Die Zehen schmücken; den Wagen verlassen und zu Fuß gehen.";
"hex.22.yao.1" = "Den Bart schmücken.";
"hex.22.yao.2" = "Prächtiger Schmuck, feucht glänzend. Dauerhafte Standhaftigkeit im Rechten bringt Heil.";
"hex.22.yao.3" = "Schmuck in reinem Weiß; ein weißes Pferd eilt wie im Flug. Es kommt kein Räuber, sondern ein Brautwerber.";
"hex.22.yao.4" = "Hügel und Gärten schmücken (schlichte Weise ehren). Das dargebrachte Seidenbündel ist bescheiden. Beschämung, doch am Ende Heil.";
"hex.22.yao.5" = "Reines Weiß als Schmuck. Kein Makel.";
"hex.23.ci" = "Es ist nicht förderlich, aufzubrechen.";
"hex.23.daxiang" = "Der Berg ruht auf der Erde: Die Zersplitterung. So behandeln die Oberen die Unteren großzügig und sichern dadurch ihre Wohnstatt.";
"hex.23.yao.0" = "Das Bett zerfällt von den Füßen her. Der rechte Weg wird zerstört. Unheil.";
"hex.23.yao.1" = "Das Bett zerfällt bis zur Verbindung von Füßen und Rahmen. Der rechte Weg wird zerstört. Unheil.";
"hex.23.yao.2" = "In der Zeit des Zerfalls (als Einziger mit der obersten Yang-Linie verbunden): kein Makel.";
"hex.23.yao.3" = "Der Zerfall des Bettes erreicht die Haut. Unheil.";
"hex.23.yao.4" = "Wie aufgereihte Fische ziehen die Yin-Kräfte geordnet heran und empfangen die Gunst des Königs wie die Frauen des Palastes. Alles ist förderlich.";
"hex.23.yao.5" = "Die große Frucht bleibt ungegessen. Der Edle erhält einen Wagen (den Rückhalt des Volkes); der gemeine Mensch zerstört sein eigenes Haus.";
"hex.24.ci" = "Gelingen. Ausgehen und heimkehren ohne Krankheit. Freunde kommen: kein Makel. Gehen und Wiederkehren folgen ihrem Kreislauf; nach sieben Tagen erfolgt die Wiederkehr. Es ist förderlich, aufzubrechen.";
"hex.24.daxiang" = "Der Donner in der Erde: Die Wiederkehr. So schlossen die früheren Könige zur Wintersonnenwende die Pässe; Kaufleute und Reisende zogen nicht umher, und der Herrscher bereiste die Regionen nicht.";
"hex.24.yao.0" = "Zum rechten Weg zurückkehren, bevor man sich weit entfernt hat. Keine große Reue. Großes Heil.";
"hex.24.yao.1" = "Auf gute Weise zum rechten Weg zurückkehren. Heil.";
"hex.24.yao.2" = "Immer wieder zum rechten Weg zurückkehren (nach anderer Lesart: sorgenvoll zurückkehren). Gefahr, doch kein Makel.";
"hex.24.yao.3" = "Inmitten der Yin-Kräfte allein zum rechten Weg zurückkehren.";
"hex.24.yao.4" = "Mit aufrichtigem, gütigem Herzen zum rechten Weg zurückkehren. Keine Reue.";
"hex.24.yao.5" = "Sich verirren und nicht zurückzufinden wissen. Unheil und Unglück. So ein Heer ausziehen zu lassen führt zu schwerer Niederlage, zieht den Herrscher ins Unheil und verhindert zehn Jahre lang jeden Feldzug.";
"hex.25.ci" = "Großes Gelingen. Förderlich ist Standhaftigkeit im Rechten. Vom Rechten abzuweichen bringt Unglück; aufzubrechen ist dann nicht förderlich.";
"hex.25.daxiang" = "Unter dem Himmel zieht der Donner dahin; kein Wesen wagt willkürlich zu handeln. So richteten sich die früheren Könige sorgsam nach den Zeiten des Himmels und nährten alle Wesen.";
"hex.25.yao.0" = "Ohne Willkür handeln. Vorangehen bringt Heil.";
"hex.25.yao.1" = "Pflügen, ohne schon an die Ernte zu denken; roden, ohne schon fruchtbares Ackerland zu erwarten (dem natürlichen Verlauf folgen, ohne Gewinn vorwegzunehmen). Dann ist es förderlich, aufzubrechen.";
"hex.25.yao.2" = "Ein unerwartetes Unglück: Jemand hat einen Ochsen angebunden; ein Vorübergehender nimmt ihn mit. Der Reisende hat den Gewinn, doch die Bewohner trifft das Unglück des Verdachts.";
"hex.25.yao.3" = "Am Rechten festhalten können. Kein Makel.";
"hex.25.yao.4" = "Eine Krankheit, die nicht aus willkürlichem Handeln entstand. Ohne Arznei bringt die Genesung Freude.";
"hex.25.yao.5" = "Auch ohne Willkür bringt Handeln Unglück (die Zeit ist an ihre Grenze gelangt). Nichts ist förderlich.";
"hex.26.ci" = "Förderlich ist Standhaftigkeit im Rechten. Nicht daheim seinen Unterhalt finden (sondern vom Hof versorgt werden) bringt Heil. Es ist förderlich, den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden).";
"hex.26.daxiang" = "Der Himmel ist im Berg enthalten: Des Großen Zähmungskraft. So lernt der Edle gründlich die Worte und Taten früherer Weiser kennen, um seine Tugend zu nähren.";
"hex.26.yao.0" = "Es besteht Gefahr. Es ist förderlich, innezuhalten.";
"hex.26.yao.1" = "Der Wagenkasten hat sich von seiner Achsbefestigung gelöst; der Wagen kann nicht weiterfahren.";
"hex.26.yao.2" = "Gute Pferde laufen und jagen einander nach. Es ist förderlich, in Schwierigkeiten am Rechten festzuhalten. Täglich Wagenlenken und Verteidigung üben; aufzubrechen ist förderlich.";
"hex.26.yao.3" = "Dem jungen Stier ein Querholz an die Hörner binden, damit er niemanden stößt. Großes Heil.";
"hex.26.yao.4" = "Der kastrierte Eber hat noch seine Hauer, verletzt aber niemanden. Heil.";
"hex.26.yao.5" = "Wie frei ist die große Straße des Himmels! Gelingen. (Nach anderer Lesart: die große Straße des Himmels empfangen.)";
"hex.27.ci" = "Standhaftigkeit im Rechten bringt Heil. Die Art der Ernährung betrachten und wie jemand selbst seine Nahrung sucht.";
"hex.27.daxiang" = "Donner unter dem Berg: Die Mundwinkel. So ist der Edle achtsam in seinen Worten und mäßig im Essen und Trinken.";
"hex.27.yao.0" = "Du gibst die Gaben deiner heiligen Schildkröte auf (die sich ohne Essen nähren kann) und schaust begehrlich auf meine kauenden Wangen. Unheil.";
"hex.27.yao.1" = "Unten Nahrung suchen kehrt die gewöhnliche Ordnung um. Auf der hohen Anhöhe (bei der obersten Yang-Linie) Nahrung suchen: Aufbrechen bringt Unheil.";
"hex.27.yao.2" = "Vom rechten Weg des Nährens abweichen. Selbst bei Standhaftigkeit im Rechten: Unheil. Zehn Jahre lang nichts unternehmen. Nichts ist förderlich.";
"hex.27.yao.3" = "Unten Nahrung suchen (um die Welt zu nähren) bringt Heil. Wie ein Tiger aufmerksam nach unten blicken und unablässig danach streben. Kein Makel.";
"hex.27.yao.4" = "Von der gewöhnlichen Ordnung abweichen (für den Unterhalt von der obersten Yang-Linie abhängen). Im Rechten verharren bringt Heil. Den großen Fluss nicht überqueren (kein Wagnis eingehen).";
"hex.27.yao.5" = "Durch ihn wird die Welt genährt. Gefahr, doch Heil. Es ist förderlich, den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden).";
"hex.28.ci" = "Der Firstbalken biegt sich. Es ist förderlich, aufzubrechen. Gelingen.";
"hex.28.daxiang" = "Das Wasser des Sees überflutet die Bäume: Des Großen Übergewicht. So steht der Edle allein ohne Furcht und zieht sich ohne Verdruss aus der Welt zurück.";
"hex.28.yao.0" = "Weiße Gräser unter die Opfergaben legen. Kein Makel.";
"hex.28.yao.1" = "Die verdorrte Pappel treibt neue Knospen; ein alter Mann heiratet eine junge Frau. Alles ist förderlich.";
"hex.28.yao.2" = "Der Firstbalken biegt sich. Unheil.";
"hex.28.yao.3" = "Der Firstbalken steht fest aufgerichtet: Heil. Andere Bindungen bringen Beschämung.";
"hex.28.yao.4" = "Die verdorrte Pappel blüht; eine alte Frau heiratet einen jungen Mann. Kein Makel, kein Lob.";
"hex.28.yao.5" = "Zu tief ins Wasser gehen, bis es über den Kopf steigt. Unheil, doch kein Makel (wer für das Rechte handelt, verdient keinen Vorwurf).";
"hex.29.ci" = "Gefahr auf Gefahr. Mit Aufrichtigkeit und einem Herzen, das seinen Weg findet, erlangt das Handeln Anerkennung.";
"hex.29.daxiang" = "Wasser strömt unablässig nach: Das Abgründige, wiederholt. So bleibt der Edle beständig in seiner Tugend und übt immer wieder das Regieren und Unterweisen.";
"hex.29.yao.0" = "In wiederholten Gefahren in die Tiefe der Grube fallen. Unheil.";
"hex.29.yao.1" = "Im Abgrund bleibt Gefahr. Nur einen kleinen Gewinn suchen.";
"hex.29.yao.2" = "Vorwärts wie rückwärts Abgründe. Vorn Gefahr, hinten kein sicherer Halt. In die Tiefe der Grube geraten. Nicht handeln.";
"hex.29.yao.3" = "Ein Krug Wein, zwei Schalen Reis, einfache Tongefäße; diese schlichten Gaben durchs Fenster reichen (sich in Aufrichtigkeit verbinden). Am Ende kein Makel.";
"hex.29.yao.4" = "Das Wasser im Abgrund läuft nicht über; es reicht gerade bis zum Ufer (das Wort kann eine kleine Anhöhe bezeichnen oder „nur“ bedeuten). Kein Makel.";
"hex.29.yao.5" = "Mit Stricken gefesselt und inmitten von Dornen eingesperrt, drei Jahre ohne Befreiung. Unheil.";
"hex.30.ci" = "Förderlich ist Standhaftigkeit im Rechten. Gelingen. Eine Kuh halten (Bild fügsamer Tugend) bringt Heil.";
"hex.30.daxiang" = "Das Licht geht zweimal nacheinander auf: Das Haftende. So lässt der große Mensch sein Licht unablässig in alle vier Himmelsrichtungen scheinen.";
"hex.30.yao.0" = "Die Schritte kreuzen sich wirr. Mit Ehrfurcht und Vorsicht bleibt kein Makel.";
"hex.30.yao.1" = "Gelbes, anhaftendes Licht (Gelb ist die Farbe der Mitte). Großes Heil.";
"hex.30.yao.2" = "Das Licht der sinkenden Sonne. Wer nicht singt und den Tonkrug schlägt (um sich rechtzeitig zu freuen), seufzt wie ein Greis. Unheil.";
"hex.30.yao.3" = "Plötzliches Kommen, loderndes Brennen; dann Tod und Verlassenheit.";
"hex.30.yao.4" = "Strömende Tränen, schmerzliche Seufzer. Heil.";
"hex.30.yao.5" = "Der König schickt ihn in den Krieg. Ein rühmlicher Erfolg: Der feindliche Anführer wird enthauptet; die Menge der Mitläufer wird nicht gefangen genommen (nur der Hauptschuldige wird bestraft). Kein Makel.";
"hex.31.ci" = "Gelingen. Förderlich ist Standhaftigkeit im Rechten. Eine Frau heiraten bringt Heil. (Die Einwirkung meint wechselseitige Resonanz, dargestellt durch die Anziehung zwischen einem jungen Mann und einer jungen Frau.)";
"hex.31.daxiang" = "Ein See auf dem Berg (der Berg nimmt ihn in seiner Vertiefung auf): Die Einwirkung. So nimmt der Edle andere mit offenem Herzen auf.";
"hex.31.yao.0" = "Die Einwirkung wird im großen Zeh spürbar. (Sie beginnt erst und ist noch oberflächlich; die Absicht richtet sich schon nach außen.)";
"hex.31.yao.1" = "Die Einwirkung erreicht die Wade. Unruhiges, unbedachtes Handeln bringt Unheil; ruhig zu bleiben bringt Heil.";
"hex.31.yao.2" = "Die Einwirkung erreicht den Oberschenkel. Eigensinnig anderen folgen: Vorangehen bringt Beschämung.";
"hex.31.yao.3" = "Standhaftigkeit im Rechten bringt Heil; die Reue schwindet. Schwankt der Sinn rastlos hin und her, folgen nur gleichgesinnte Freunde deinen Gedanken. (Die Einwirkung bleibt begrenzt.)";
"hex.31.yao.4" = "Die Einwirkung erreicht das Fleisch des Rückens. Keine Reue. (Sie berührt das Herz nicht; nach anderer Lesart bleibt sie schwach und oberflächlich.)";
"hex.31.yao.5" = "Die Einwirkung erreicht Zahnfleisch, Wangen und Zunge. (Sie wirkt nur durch Worte.)";
"hex.32.ci" = "Gelingen, kein Makel. Förderlich sind Standhaftigkeit im Rechten und das Aufbrechen. (Die Dauer bedeutet Beständigkeit.)";
"hex.32.daxiang" = "Donner und Wind begleiten einander: Die Dauer. So steht der Edle fest im Rechten und ändert seine Richtung nicht leichtfertig.";
"hex.32.yao.0" = "Gleich zu Beginn tiefe Beständigkeit verlangen (zu tief graben). Selbst bei Standhaftigkeit im Rechten: Unheil. Nichts ist förderlich.";
"hex.32.yao.1" = "Die Reue schwindet. (Die zweite Linie, Yang an einem weichen, aber mittigen Platz, kann den Weg der Mitte dauerhaft bewahren.)";
"hex.32.yao.2" = "Wer in seiner Tugend nicht beständig bleibt, setzt sich der Schande aus. Selbst bei Standhaftigkeit im Rechten: Beschämung.";
"hex.32.yao.3" = "Jagen, ohne Wild zu erbeuten. (Lange an einem unpassenden Platz verharren: vergebliche Mühe.)";
"hex.32.yao.4" = "In fügsamer Tugend beständig am Rechten festhalten: Heil für die Frau, Unheil für den Mann.";
"hex.32.yao.5" = "Beständigkeit in rastloser Erschütterung suchen (unruhiges Schwanken). Unheil.";
"hex.33.ci" = "Rückzug bringt Gelingen. In kleinen Dingen ist Standhaftigkeit im Rechten förderlich. (Der Rückzug bedeutet, sich zurückzuziehen.)";
"hex.33.daxiang" = "Ein Berg unter dem Himmel (so hoch er ist, der Himmel bleibt fern): Der Rückzug. So hält sich der Edle von gemeinen Menschen fern, ohne Hass zu zeigen, doch mit Strenge.";
"hex.33.yao.0" = "Beim Rückzug als Letzter zurückbleiben: Gefahr. Es ist nicht ratsam, aufzubrechen.";
"hex.33.yao.1" = "Ihn mit einem Riemen aus gelbem Rindsleder festbinden: Niemand kann ihn lösen. (Bild festen Willens; nach anderer Lesart wird ein Weiser zurückgehalten.)";
"hex.33.yao.2" = "Bindungen verhindern den Rückzug, wie eine Krankheit; Gefahr. Diener und Dienerinnen zu halten bringt Heil.";
"hex.33.yao.3" = "Sich trotz lieb gewordener Bindungen entschlossen zurückziehen. Für den Edlen Heil; der gemeine Mensch vermag es nicht.";
"hex.33.yao.4" = "Sich würdig und zur rechten Zeit zurückziehen. Standhaftigkeit im Rechten bringt Heil.";
"hex.33.yao.5" = "Sich gelassen und unbeschwert zurückziehen (nach anderer Lesart: weit davonfliegen). Alles ist förderlich.";
"hex.34.ci" = "Förderlich ist Standhaftigkeit im Rechten. (Des Großen Macht bezeichnet die erstarkte Yang-Kraft.)";
"hex.34.daxiang" = "Donner über dem Himmel, von gewaltiger Macht: Des Großen Macht. So tut der Edle nichts, was der rituellen Ordnung widerspricht.";
"hex.34.yao.0" = "Die Kraft zeigt sich in den Zehen (Drang zum Vorangehen). Auszuziehen bringt Unheil; das ist gewiss.";
"hex.34.yao.1" = "Standhaftigkeit im Rechten bringt Heil.";
"hex.34.yao.2" = "Der gemeine Mensch setzt auf Gewalt; der Edle tut dies nicht (nach anderer Lesart verwendet er ein Netz). Selbst bei Standhaftigkeit im Rechten besteht Gefahr. Der Widder stößt gegen die Hecke; seine Hörner verfangen sich.";
"hex.34.yao.3" = "Standhaftigkeit im Rechten bringt Heil; die Reue schwindet. Die Hecke bricht, die Hörner sind frei. Die Kraft liegt in der Achsbefestigung des großen Wagens (dem tragfähigen Verbindungsstück zwischen Achse und Kasten).";
"hex.34.yao.4" = "Das Schaf auf leichtem Gelände unbemerkt verlieren. Keine Reue. (Nach anderer Lesart ist eine Feldgrenze gemeint.)";
"hex.34.yao.5" = "Der Widder stößt gegen die Hecke; er kann weder zurück noch voran. Nichts ist förderlich. Die Schwierigkeiten erkennen und am Rechten festhalten bringt Heil.";
"hex.35.ci" = "Fürst Kang (ein das Land befriedender Fürst; nach anderer Lesart Kang Shu, jüngerer Bruder des Zhou-Königs Wu) erhält vom König zahlreiche Wagen und Pferde und wird an einem Tag dreimal empfangen. (Der Fortschritt bedeutet Aufstieg.)";
"hex.35.daxiang" = "Das Licht steigt über der Erde auf: Der Fortschritt. So lässt der Edle seine leuchtende Tugend aus sich selbst hervortreten.";
"hex.35.yao.0" = "Vorankommen wollen, doch zurückgedrängt werden. Standhaftigkeit im Rechten bringt Heil. Noch kein Vertrauen finden, aber gelassen und geduldig bleiben: kein Makel.";
"hex.35.yao.1" = "Vorankommen wollen, doch voller Sorgen sein. Standhaftigkeit im Rechten bringt Heil. Großen Segen von der Großmutter empfangen (Bild der hohen Stellung der fünften Yin-Linie).";
"hex.35.yao.2" = "Alle schenken Vertrauen und Zustimmung. Die Reue schwindet.";
"hex.35.yao.3" = "Wie eine Ratte vorankommen (gierig und ängstlich). Selbst bei Standhaftigkeit im Rechten besteht Gefahr.";
"hex.35.yao.4" = "Die Reue schwindet. Nicht um Gewinn und Verlust sorgen. Vorangehen bringt Heil; alles ist förderlich.";
"hex.35.yao.5" = "Bis zur Hornspitze vordringen (zum äußersten Punkt). Dies eignet sich nur, um die eigene Stadt zu unterwerfen (inneren Aufruhr zu beenden). Gefahr, doch Heil und kein Makel. Selbst bei Standhaftigkeit im Rechten: Beschämung.";
"hex.36.ci" = "Es ist förderlich, in Schwierigkeiten am Rechten festzuhalten. (Die Verfinsterung des Lichts bedeutet verletzte Helligkeit.)";
"hex.36.daxiang" = "Das Licht sinkt in die Erde: Die Verfinsterung des Lichts. So führt der Edle die Menschen, indem er nach außen seine Helligkeit verbirgt und innen klar erkennt.";
"hex.36.yao.0" = "Zur Zeit des verletzten Lichts mit hängenden Flügeln fliegen. Der Edle bricht hastig auf und findet drei Tage lang keine Zeit zum Essen. Auf seinem Weg macht ihm der Gastgeber Vorwürfe.";
"hex.36.yao.1" = "Das Licht ist verletzt, der linke Oberschenkel verwundet. Ein starkes Pferd bringt Rettung. Heil.";
"hex.36.yao.2" = "Zur Zeit des verletzten Lichts nach Süden ziehen und den Hauptschuldigen fangen. Alte Missstände nicht übereilt berichtigen wollen; schrittweise vorgehen.";
"hex.36.yao.3" = "In die linke Bauchseite eindringen (ins Innere gelangen), den Grund des verletzten Lichts erkennen und dann durch das Tor fortgehen.";
"hex.36.yao.4" = "Wie Jizi (Onkel des Shang-Königs Zhou, der Wahnsinn vortäuschte, um Unheil zu entgehen) zur Zeit des verletzten Lichts leben. Förderlich ist Standhaftigkeit im Rechten.";
"hex.36.yao.5" = "Nicht leuchten, sondern finster werden. Erst zum Himmel steigen, dann unter die Erde stürzen.";
"hex.37.ci" = "Die Standhaftigkeit der Frau im Rechten ist förderlich. (Die Sippe bezeichnet den Weg der Haushaltsführung.)";
"hex.37.daxiang" = "Der Wind entsteht aus dem Feuer (von innen nach außen): Die Sippe. So gibt der Edle seinen Worten Gehalt und seinen Taten Beständigkeit.";
"hex.37.yao.0" = "Von Anfang an schützende Regeln im Haus aufstellen. Die Reue schwindet.";
"hex.37.yao.1" = "Nicht eigenmächtig entscheiden; für die Mahlzeiten im Haus sorgen. Standhaftigkeit im Rechten bringt Heil.";
"hex.37.yao.2" = "Strenge Haushaltsführung lässt die Familie klagen. Reue und Gefahr, doch schließlich Heil. Lachen Frauen und Kinder ohne Maß, folgt am Ende Beschämung.";
"hex.37.yao.3" = "Das Haus wohlhabend machen. Großes Heil.";
"hex.37.yao.4" = "Der König erreicht die Seinen durch seine Tugend. Nicht sorgen: Heil.";
"hex.37.yao.5" = "Aufrichtigkeit verbunden mit Würde. Am Ende Heil.";
"hex.38.ci" = "Heil in kleinen Angelegenheiten. (Der Gegensatz bedeutet Trennung und Auseinanderstreben.)";
"hex.38.daxiang" = "Oben Feuer, unten der See (ihre Naturen streben auseinander): Der Gegensatz. So sucht der Edle Gemeinsamkeit im Wesentlichen und bewahrt die Unterschiede.";
"hex.38.yao.0" = "Die Reue schwindet. Das Pferd ist entlaufen: Nicht nachjagen, es kehrt von selbst zurück. Dem bösen Menschen begegnen, ohne das Treffen abzulehnen: kein Makel.";
"hex.38.yao.1" = "Dem Herrn in einer Gasse begegnen. Kein Makel.";
"hex.38.yao.2" = "Den Wagen zurückgehalten sehen, den Ochsen gehemmt, den Wagenlenker mit tätowierter Stirn und abgeschnittener Nase bestraft. Ein schlechter Anfang, doch ein gutes Ende.";
"hex.38.yao.3" = "Getrennt und einsam einem kraftvollen Mann begegnen (der ersten Yang-Linie) und sich aufrichtig mit ihm verbinden. Gefahr, doch kein Makel.";
"hex.38.yao.4" = "Die Reue schwindet. Sich mit seinem Verwandten (der zweiten Yang-Linie) zu verbinden ist so leicht wie in zartes Fleisch zu beißen. Welchen Makel könnte das Vorangehen bringen?";
"hex.38.yao.5" = "Getrennt und einsam einen schlammverschmierten Eber und einen Wagen voller Geister zu sehen glauben (Argwohn erzeugt Trugbilder). Erst den Bogen spannen, dann lösen: Es kommen keine Räuber, sondern Brautwerber. Aufbrechen und Regen begegnen (Einklang von Yin und Yang) bringt Heil.";
"hex.39.ci" = "Der Südwesten ist förderlich (ebenes Land), der Nordosten nicht (gefährliches Gelände). Es ist förderlich, den großen Menschen zu sehen. Standhaftigkeit im Rechten bringt Heil. (Das Hemmnis bezeichnet mühsames Vorankommen.)";
"hex.39.daxiang" = "Wasser auf dem Berg (Hemmnis auf Hemmnis): Das Hemmnis. So prüft sich der Edle selbst und pflegt seine Tugend.";
"hex.39.yao.0" = "Vorangehen trifft auf Hemmnisse; zurückkehren bringt Anerkennung.";
"hex.39.yao.1" = "Der Diener des Königs besteht Schwierigkeit um Schwierigkeit, um Hilfe zu leisten, nicht um seiner selbst willen.";
"hex.39.yao.2" = "Vorangehen trifft auf Hemmnisse; umkehren (zu den beiden unteren Yin-Linien zurückkehren).";
"hex.39.yao.3" = "Vorangehen trifft auf Hemmnisse; zurückkehren, um sich mit anderen zu verbinden.";
"hex.39.yao.4" = "In großer Not kommen Freunde zu Hilfe.";
"hex.39.yao.5" = "Vorangehen trifft auf Hemmnisse; zurückkehren ermöglicht ein großes Werk. Heil. Es ist förderlich, den großen Menschen zu sehen.";
"hex.40.ci" = "Der Südwesten ist förderlich. Gibt es nichts mehr zu lösen, bringt die Rückkehr Heil. Steht noch ein Vorhaben an, bringt frühes Handeln Heil. (Die Befreiung bedeutet Erlösung aus Gefahr.)";
"hex.40.daxiang" = "Donner und Regen erheben sich: Die Befreiung. So verzeiht der Edle Verfehlungen und übt Milde bei Verbrechen.";
"hex.40.yao.0" = "Kein Makel.";
"hex.40.yao.1" = "Bei der Jagd drei Füchse fangen und einen gelben Pfeil erhalten. Standhaftigkeit im Rechten bringt Heil. (Die Füchse stehen für gemeine Menschen; der gelbe Pfeil für Mitte und Geradheit.)";
"hex.40.yao.2" = "Eine Last tragen und zugleich im Wagen fahren (ein gemeiner Mensch nimmt unrechtmäßig einen hohen Rang ein) zieht Räuber an. Selbst bei Standhaftigkeit im Rechten: Beschämung.";
"hex.40.yao.3" = "Den großen Zeh lösen (anhängende gemeine Menschen abschütteln). Freunde werden kommen und aufrichtig sein.";
"hex.40.yao.4" = "Der Edle vermag aus Gefahr zu befreien: Heil. Der Abzug der gemeinen Menschen bestätigt es (nach anderer Lesart gewinnt er ihr Vertrauen).";
"hex.40.yao.5" = "Der Fürst schießt auf den Falken auf der hohen Stadtmauer und trifft ihn. Alles ist förderlich.";
"hex.41.ci" = "Mit Aufrichtigkeit: großes Heil, kein Makel. Man kann am Rechten festhalten; aufzubrechen ist förderlich. Was soll man opfern? Zwei Schalen schlichter Speise genügen (rituelle Gefäße für Hirse). Die Minderung bedeutet Verringerung.";
"hex.41.daxiang" = "Der See unter dem Berg (er mindert sich, um den Berg zu erhöhen): Die Minderung. So bezähmt der Edle seinen Zorn und hemmt seine Begierden.";
"hex.41.yao.0" = "Nach Erledigung der eigenen Aufgaben rasch helfen gehen. Kein Makel. Doch das Maß der eigenen Einbuße abwägen.";
"hex.41.yao.1" = "Förderlich ist Standhaftigkeit im Rechten. Auszuziehen bringt Unheil. Man kann andere mehren, ohne sich selbst zu mindern.";
"hex.41.yao.2" = "Gehen drei Menschen gemeinsam, scheidet einer aus. Geht einer allein, findet er einen Gefährten.";
"hex.41.yao.3" = "Das eigene Leiden mindern; rasche Besserung bringt Freude. Kein Makel.";
"hex.41.yao.4" = "Jemand bringt ihm Mehrung. Selbst eine kostbare Schildkröte im Wert von zehn Peng (alte Geldeinheit) kann dem günstigen Orakel nicht widersprechen. Großes Heil.";
"hex.41.yao.5" = "Andere mehren, ohne sich selbst zu mindern. Kein Makel. Standhaftigkeit im Rechten bringt Heil. Aufzubrechen ist förderlich. Man gewinnt Untertanen aus dem ganzen Land, nicht nur aus einem Haus.";
"hex.42.ci" = "Es ist förderlich, aufzubrechen und den großen Fluss zu überqueren (ein Wagnis eingehen, um ein Vorhaben zu vollenden). Die Mehrung bedeutet Zuwachs.";
"hex.42.daxiang" = "Wind und Donner fördern einander: Die Mehrung. So folgt der Edle dem Guten, das er sieht, und bessert seine Fehler.";
"hex.42.yao.0" = "Es ist förderlich, große Werke zu vollbringen. Großes Heil, kein Makel.";
"hex.42.yao.1" = "Jemand bringt ihm Mehrung. Selbst eine kostbare Schildkröte im Wert von zehn Peng kann dem Zeichen nicht widersprechen. Dauerhafte Standhaftigkeit im Rechten bringt Heil. Der König setzt ihn beim Opfer für den Himmelsgott ein: Heil.";
"hex.42.yao.2" = "Die erhaltene Mehrung zur Hilfe in Notfällen einsetzen. Kein Makel. Mit Aufrichtigkeit und rechter Mitte dem Fürsten Bericht erstatten, die Jadetafel in der Hand.";
"hex.42.yao.3" = "Der rechten Mitte gemäß handeln; dem Fürsten berichten und Zustimmung erhalten. Es ist förderlich, mit Unterstützung der höheren Obrigkeit die Hauptstadt zu verlegen.";
"hex.42.yao.4" = "Ein aufrichtiges, wohltätiges Herz: Ohne das Orakel zu befragen, großes Heil. Alle erkennen meine Wohltaten aufrichtig an.";
"hex.42.yao.5" = "Niemand mehrt ihn; manche greifen ihn an. Seinem Herzen fehlt Beständigkeit. Unheil.";
"hex.43.ci" = "Die Verfehlungen gemeiner Menschen am Königshof öffentlich verkünden. Die Menschen aufrichtig aufrufen; wachsam bleiben, denn Gefahr besteht weiterhin. Zuerst die eigene Stadt warnen. Sofort zu den Waffen zu greifen ist nicht förderlich; aufzubrechen ist förderlich. (Der Durchbruch bedeutet entschiedenes Trennen und Beseitigen.)";
"hex.43.daxiang" = "Das Wasser des Sees steigt zum Himmel (um als Regen herabzukommen): Der Durchbruch. So verteilt der Edle Wohltaten an das Volk; sie für sich anzuhäufen weckt Missgunst.";
"hex.43.yao.0" = "Die Kraft drängt in die vorwärtsschreitenden Zehen. Aufbrechen, ohne siegen zu können, wird zur Schuld.";
"hex.43.yao.1" = "Wachsam Alarm rufen. Selbst wenn der Feind nachts angreift, nicht sorgen.";
"hex.43.yao.2" = "Die Kraft zeigt sich in den Wangenknochen (Zorn tritt ins Gesicht): Unheil. Der Edle geht entschlossen voran; allein im Regen wird er durchnässt und erregt Unmut. Am Ende kein Makel.";
"hex.43.yao.3" = "Das Gesäß wund, mühsam und stockend gehen. Das Schaf führen (mit der Herde gehen) ließe die Reue schwinden; doch man hört diese Worte und glaubt ihnen nicht.";
"hex.43.yao.4" = "Entschlossen beseitigen, wie man Xianlu ausreißt (ein zartes, leicht nachwachsendes Kraut). Dem Weg der Mitte folgen: kein Makel.";
"hex.43.yao.5" = "Weiteres Rufen ist vergeblich (niemand kommt zu Hilfe). Am Ende Unheil.";
"hex.44.ci" = "Die Frau ist zu mächtig. Eine solche Frau soll man nicht heiraten. (Das Entgegenkommen bedeutet Begegnung.)";
"hex.44.daxiang" = "Der Wind unter dem Himmel weht über alle Wesen: Das Entgegenkommen. So erlässt der Herrscher seine Befehle und verkündet sie in alle vier Himmelsrichtungen.";
"hex.44.yao.0" = "An eine feste metallene Wagenbremse gebunden. Standhaftigkeit im Rechten bringt Heil. Vorangehen bringt Unheil, wie eine magere Sau, die unweigerlich unruhig wird (Bild des neu entstehenden, schon rastlosen Yin).";
"hex.44.yao.1" = "Fisch im Bündel (nach anderer Lesart: in der Küche). Kein Makel. Es ist nicht förderlich, ihn Gästen anzubieten.";
"hex.44.yao.2" = "Das Gesäß wund, mühsam gehen. Gefahr, doch kein großer Makel.";
"hex.44.yao.3" = "Kein Fisch im Bündel. Sich zum Handeln erheben bringt Unheil.";
"hex.44.yao.4" = "Die Melone mit Zweigen und Blättern des Qi-Baums umhüllen (das Hohe schützt das Niedrige). Die Tugend im Verborgenen bewahren: Segen kommt vom Himmel herab.";
"hex.44.yao.5" = "Die Begegnung findet an der Hornspitze statt (am äußersten Punkt). Beschämung, doch kein Makel.";
"hex.45.ci" = "Gelingen. Der König geht zum Ahnentempel, um zu opfern. Es ist förderlich, den großen Menschen zu sehen. Gelingen; förderlich ist Standhaftigkeit im Rechten. Ein großes Opfertier darzubringen bringt Heil. Aufzubrechen ist förderlich. (Die Sammlung bedeutet Zusammenkommen.)";
"hex.45.daxiang" = "Das Wasser des Sees sammelt sich auf der Erde: Die Sammlung. So hält der Edle die Waffen instand und rüstet sich gegen Unvorhergesehenes.";
"hex.45.yao.0" = "Die Aufrichtigkeit hält nicht bis zum Ende; Verwirrung führt zu ungeordnetem Zusammenschluss. Um Antwort rufen: Ein Händedruck verwandelt Tränen in Lachen. Nicht sorgen; vorangehen bleibt ohne Makel.";
"hex.45.yao.1" = "Sich zur Vereinigung hinziehen lassen: Heil, kein Makel. Mit Aufrichtigkeit ist selbst ein schlichtes Sommeropfer förderlich.";
"hex.45.yao.2" = "Sich sammeln wollen, doch nur seufzen. Nichts ist förderlich. Vorangehen: kein Makel, nur geringe Beschämung.";
"hex.45.yao.3" = "Nur großes Heil ermöglicht es, ohne Makel zu bleiben.";
"hex.45.yao.4" = "Bei der Sammlung den hohen Rang innehaben: kein Makel. Fehlt manchen noch Vertrauen, an großer Güte festhalten und dauerhaft im Rechten bestehen. Die Reue schwindet.";
"hex.45.yao.5" = "Seufzen und weinen, mit Tränen und laufender Nase. Kein Makel.";
"hex.46.ci" = "Großes Gelingen. Den großen Menschen aufzusuchen ist angemessen; nicht sorgen. Ein Zug nach Süden bringt Heil. (Das Empordringen bedeutet Aufstieg.)";
"hex.46.daxiang" = "Holz wächst in der Erde: Das Empordringen. So folgt der Edle der Tugend und häuft kleine gute Taten an, um Höhe und Größe zu erreichen.";
"hex.46.yao.0" = "Dank des entgegengebrachten Vertrauens aufsteigen (nach anderer Lesart: voranschreiten). Großes Heil.";
"hex.46.yao.1" = "Mit Aufrichtigkeit ist selbst ein schlichtes Sommeropfer förderlich. Kein Makel.";
"hex.46.yao.2" = "In eine leere Stadt hinaufsteigen (ohne auf Hindernisse zu stoßen).";
"hex.46.yao.3" = "Der König opfert am Berg Qi (wo die Zhou ihre Macht begründeten). Heil, kein Makel.";
"hex.46.yao.4" = "Standhaftigkeit im Rechten bringt Heil. Die Stufen hinaufsteigen.";
"hex.46.yao.5" = "Blindlings immer weiter aufsteigen. Es ist förderlich, dieses Streben auf unablässige Standhaftigkeit im Rechten zu richten.";
"hex.47.ci" = "Gelingen durch Standhaftigkeit im Rechten. Für den großen Menschen Heil, kein Makel. Gesprochenen Worten wird nicht geglaubt. (Die Bedrängnis bedeutet Not.)";
"hex.47.daxiang" = "Der See ist ohne Wasser: Die Bedrängnis. So gibt der Edle sein Leben hin, um sein Streben zu vollenden.";
"hex.47.yao.0" = "Das Gesäß auf einem Baumstumpf bedrängt, in ein dunkles Tal gehen und drei Jahre niemanden sehen.";
"hex.47.yao.1" = "Bei Wein und Speise bedrängt (nach anderer Lesart: unter Nahrungsmangel leiden). Ein Würdenträger mit scharlachrotem Knieschurz kommt heran. Ein Opfer darzubringen ist förderlich. Auszuziehen bringt Unheil. Kein Makel.";
"hex.47.yao.2" = "Von einem Stein bedrängt, auf Dornen Halt suchen. Heimkehren und die eigene Frau nicht finden. Unheil.";
"hex.47.yao.3" = "Langsam kommen, von einem metallbeschlagenen Wagen aufgehalten (Bild der zweiten Yang-Linie). Beschämung, doch es kommt zu einem Abschluss.";
"hex.47.yao.4" = "Nase und Füße abgeschnitten (oben wie unten bedrängt), von Trägern roter Knieschurze unterdrückt. Allmählich kommt Befreiung. Ein Opfer darzubringen ist förderlich.";
"hex.47.yao.5" = "In Schlingpflanzen gefangen, auf unsicherem Grund. Sich sagen: „Handeln wird Reue bringen.“ Kommt es zu wirklicher Reue und Einsicht, bringt Aufbrechen Heil.";
"hex.48.ci" = "Die Stadt kann verlegt werden, der Brunnen nicht. Schöpfen mindert ihn nicht, Nichtschöpfen mehrt ihn nicht. Die Menschen kommen und gehen und holen Wasser. Der Krug erreicht fast den Rand, zerbricht aber, bevor er aus dem Brunnen kommt: Unheil.";
"hex.48.daxiang" = "Der Holzeimer taucht ins Wasser und hebt es herauf: Der Brunnen. So stärkt der Edle das Volk und ermutigt es zu gegenseitiger Hilfe.";
"hex.48.yao.0" = "Der Brunnen ist verschlammt; sein Wasser ist ungenießbar. Zum alten, verlassenen Brunnen kommen nicht einmal Vögel zum Trinken.";
"hex.48.yao.1" = "In der Vertiefung des Brunnens kann man nur nach kleinen Fischen zielen (nach anderer Lesart: Kröten). Der alte Krug ist undicht; der Brunnen kann seinen Zweck nicht erfüllen.";
"hex.48.yao.2" = "Der Brunnen ist gereinigt, doch niemand trinkt; das betrübt mein Herz. Man könnte daraus schöpfen. Ist der König einsichtig, kommen seine Wohltaten allen zugute.";
"hex.48.yao.3" = "Die Brunnenwand mit Steinen oder Ziegeln ausmauern. Kein Makel.";
"hex.48.yao.4" = "Der Brunnen ist klar; kühles Quellwasser steht zum Trinken bereit.";
"hex.48.yao.5" = "Das Wasser ist geschöpft. Den Brunnen nicht abdecken (damit alle ihn nutzen können). Mit Aufrichtigkeit: großes Heil.";
"hex.49.ci" = "Erst am Ji-Tag gewinnt man Vertrauen (nach anderer Lesart: nach Vollendung der Umwälzung). Großes Gelingen. Förderlich ist Standhaftigkeit im Rechten. Die Reue schwindet.";
"hex.49.daxiang" = "Feuer im See: Die Umwälzung. So ordnet der Edle den Kalender und bestimmt die Jahreszeiten klar.";
"hex.49.yao.0" = "Mit gelbem Rindsleder festbinden (Mitte und Fügsamkeit bewahren, nicht unbedacht handeln).";
"hex.49.yao.1" = "Erst am Ji-Tag die Umwälzung beginnen. Vorangehen bringt Heil, kein Makel.";
"hex.49.yao.2" = "Übereiltes Vorangehen bringt Unheil; starres Beharren birgt ebenfalls Gefahr. Sind die Vorschläge zur Umwälzung wiederholt beraten und beschlossen, entsteht Vertrauen.";
"hex.49.yao.3" = "Die Reue schwindet. Mit Aufrichtigkeit den Auftrag des Himmels ändern (die alte Ordnung erneuern). Heil.";
"hex.49.yao.4" = "Der große Mensch wandelt wie der Tiger beim Fellwechsel, in neuem Glanz. Noch bevor das Orakel befragt wird, hat er Vertrauen gewonnen.";
"hex.49.yao.5" = "Der Edle wandelt sich wie der Leopard beim Fellwechsel; der gemeine Mensch ändert sein Gesicht und fügt sich der neuen Ordnung. Weiter vorzudrängen bringt Unheil. Im Rechten verharren bringt Heil.";
"hex.50.ci" = "Großes Heil. Gelingen.";
"hex.50.daxiang" = "Feuer brennt über dem Holz: Der Tiegel. So richtet der Edle seine Stellung recht aus und hält an seinem Auftrag fest.";
"hex.50.yao.0" = "Den Tiegel mit den Füßen nach oben umstürzen, um den Unrat auszuleeren. Wie eine Nebenfrau nehmen und einen Erben erhalten: kein Makel.";
"hex.50.yao.1" = "Der Tiegel ist voller Speise. Mein Ehepartner (nach anderer Lesart: mein Feind) ist krank und kann mir nicht nahekommen. Heil.";
"hex.50.yao.2" = "Die Henkel des Tiegels lösen oder verformen sich; er lässt sich nicht bewegen, die köstliche Fasanensuppe bleibt ungenossen. Kommen Yin und Yang in Einklang und fällt Regen, nimmt die Reue ab. Am Ende Heil.";
"hex.50.yao.3" = "Ein Fuß des Tiegels bricht; die Speise des Fürsten wird verschüttet und beschmutzt das Gefäß (nach anderer Lesart wird eine schwere Strafe verhängt). Unheil.";
"hex.50.yao.4" = "Der Tiegel hat gelbe Henkel und eine metallene Tragstange. Förderlich ist Standhaftigkeit im Rechten.";
"hex.50.yao.5" = "Der Tiegel hat eine Tragstange aus Jade. Großes Heil; alles ist förderlich.";
"hex.51.ci" = "Gelingen. Der Donner kommt: Schrecken und ängstliche Blicke; dann wieder ruhiges Reden und Lachen. Der Donner erschüttert hundert Li, doch der Opfernde lässt weder den Opferlöffel noch den duftenden Opferwein fallen.";
"hex.51.daxiang" = "Donner folgt auf Donner: Das Erregende. So bessert und prüft sich der Edle in Furcht.";
"hex.51.yao.0" = "Der Donner kommt: Schrecken; dann wieder ruhiges Reden und Lachen. Heil.";
"hex.51.yao.1" = "Der Donner kommt heftig: Gefahr. Man rechnet mit dem Verlust seiner Kaurimuscheln (ehemaliges Geld) und flieht auf hohe Hügel. Nicht danach suchen: Nach sieben Tagen werden sie wiedergefunden.";
"hex.51.yao.2" = "Der Donner erschüttert den Sinn. Aus wachsamer Furcht handeln bewahrt vor Unglück.";
"hex.51.yao.3" = "Der Donner erschüttert, doch man bleibt im Schlamm stecken (unfähig, sich aufzuraffen).";
"hex.51.yao.4" = "Der Donner kommt und geht: Gefahr. Doch es ist kein Verlust zu erwarten; die Aufgabe bleibt gewahrt (nach anderer Lesart: der Opferdienst).";
"hex.51.yao.5" = "Der Donner lässt einen zittern und erschreckt umherblicken. Jetzt vorangehen bringt Unheil. Vorsorge treffen, solange der Schlag den Nachbarn und noch nicht einen selbst trifft: kein Makel. Doch über die Heirat wird geredet.";
"hex.52.ci" = "Den Rücken stillhalten (sich nicht vom Sichtbaren mitreißen lassen), den eigenen Körper vergessen. Durch den Hof gehen, ohne einander zu sehen. Kein Makel.";
"hex.52.daxiang" = "Zwei Berge übereinander: Das Stillehalten. So lässt der Edle seine Gedanken nicht über die Pflichten seiner Stellung hinausgehen.";
"hex.52.yao.0" = "Die Zehen stillhalten. Kein Makel. Dauerhafte Standhaftigkeit im Rechten ist förderlich.";
"hex.52.yao.1" = "Die Waden stillhalten, doch denjenigen, dem man folgt, nicht retten können (sein unbedachtes Handeln nicht aufhalten können). Das Herz ist unzufrieden.";
"hex.52.yao.2" = "Die Taille stillhalten; der Rücken erstarrt, als breche er entzwei. Die Gefahr versengt das Herz wie Rauch und Feuer.";
"hex.52.yao.3" = "Den Oberkörper stillhalten. Kein Makel.";
"hex.52.yao.4" = "Die Wangen stillhalten; geordnet sprechen. Die Reue schwindet.";
"hex.52.yao.5" = "Mit aufrichtiger, gefestigter Tugend stillhalten. Heil.";
"hex.53.ci" = "Die Heirat der Frau bringt Heil, wenn sie den Riten gemäß Schritt für Schritt erfolgt. Förderlich ist Standhaftigkeit im Rechten.";
"hex.53.daxiang" = "Ein Baum wächst auf dem Berg: Die Entwicklung. So sammelt der Edle Tugend und bessert die Sitten.";
"hex.53.yao.0" = "Die Wildgans nähert sich allmählich dem Ufer. Der junge Mann ist in Gefahr und wird getadelt. Kein Makel.";
"hex.53.yao.1" = "Die Wildgans nähert sich allmählich dem großen Felsen. In Ruhe und Freude essen und trinken. Heil.";
"hex.53.yao.2" = "Die Wildgans nähert sich allmählich der Hochebene. Der Mann zieht aus und kehrt nicht zurück; die schwangere Frau kann nicht gebären. Unheil. Es ist förderlich, Eindringlinge abzuwehren.";
"hex.53.yao.3" = "Die Wildgans nähert sich allmählich dem Baum. Vielleicht findet sie einen waagerechten Ast zum Ruhen. Kein Makel.";
"hex.53.yao.4" = "Die Wildgans nähert sich allmählich dem Hügel. Die Frau wird drei Jahre nicht schwanger, doch letztlich kann nichts den rechten Weg überwinden. Heil.";
"hex.53.yao.5" = "Die Wildgans erreicht allmählich die Höhe (nach anderer Lesart: die Wolkenbahn). Ihre Federn können als ritueller Schmuck dienen. Heil.";
"hex.54.ci" = "Das junge Mädchen heiratet außerhalb der rechten Riten. Vorangehen bringt Unheil. Nichts ist förderlich.";
"hex.54.daxiang" = "Donner über dem See: Das heiratende Mädchen. So sucht der Edle Dauer und ein gutes Ende und erkennt mögliche Missstände voraus.";
"hex.54.yao.0" = "Das junge Mädchen heiratet als jüngere Schwester im Gefolge der Hauptfrau. Wie ein Lahmer, der gehen kann: Vorangehen bringt Heil.";
"hex.54.yao.1" = "Wie ein Einäugiger, der sehen kann. Die Standhaftigkeit des Zurückgezogenen im Rechten ist förderlich.";
"hex.54.yao.2" = "Das junge Mädchen wartet im Bewusstsein seines Ranges (der Ausdruck kann auch eine ältere Schwester oder eine niedriggestellte Nebenfrau meinen). Schließlich heiratet es als jüngere Schwester im Gefolge der Hauptfrau.";
"hex.54.yao.3" = "Die Heirat des jungen Mädchens verzögert sich. Es wartet auf die rechte Zeit.";
"hex.54.yao.4" = "Di Yi (König der Shang-Dynastie) verheiratet seine jüngere Schwester. Der Schmuck der Hauptfrau ist weniger prächtig als der ihrer Begleiterin. Der Mond ist fast voll, aber noch nicht ganz. Heil.";
"hex.54.yao.5" = "Die Frau trägt einen leeren Bambuskorb; der Mann schlachtet das Schaf, doch kein Blut fließt (das Opfer kommt nicht zustande). Nichts ist förderlich.";
"hex.55.ci" = "Gelingen. Der König erreicht diese Fülle. Nicht sorgen; es ist angemessen, die Welt wie die Mittagssonne zu erhellen.";
"hex.55.daxiang" = "Donner und Blitz kommen zugleich: Die Fülle. So entscheidet der Edle Rechtsfälle und vollstreckt die Strafen.";
"hex.55.yao.0" = "Einem passenden Herrn begegnen. Auch bei gleichem Rang kein Makel. Vorangehen findet Anerkennung.";
"hex.55.yao.1" = "Die verhüllende Matte ist so groß, dass man mittags den Großen Wagen sieht. Vorangehen weckt Argwohn und Abneigung. Den anderen durch Aufrichtigkeit bewegen bringt Heil.";
"hex.55.yao.2" = "Der verhüllende Vorhang ist so groß, dass man mittags kleine Sterne sieht. Der rechte Arm ist gebrochen. Kein Makel.";
"hex.55.yao.3" = "Die verhüllende Matte ist so groß, dass man mittags den Großen Wagen sieht. Einem Herrn gleicher Tugend begegnen bringt Heil.";
"hex.55.yao.4" = "Begabte Menschen herbeirufen. Freude und Anerkennung. Heil.";
"hex.55.yao.5" = "Ein großes Gebäude, doch das Haus ist völlig verhüllt. Durch die Tür spähen: Stille, niemand da. Drei Jahre zeigt sich keiner. Unheil.";
"hex.56.ci" = "Kleines Gelingen. Für den Wanderer bringt Standhaftigkeit im Rechten Heil.";
"hex.56.daxiang" = "Feuer auf dem Berg: Der Wanderer. So wendet der Edle Strafen einsichtig und vorsichtig an, ohne Verfahren und Haft unnötig zu verlängern.";
"hex.56.yao.0" = "Sich auf der Wanderschaft kleinlich und unwürdig verhalten heißt, selbst Unglück herbeizuführen.";
"hex.56.yao.1" = "Der Wanderer findet eine Herberge, behält sein Geld und gewinnt einen treuen jungen Diener.";
"hex.56.yao.2" = "Die Herberge des Wanderers verbrennt; er verliert seinen jungen Diener. In dieser Lage zu verharren birgt Gefahr.";
"hex.56.yao.3" = "Der Wanderer findet vorläufige Unterkunft, Geld und eine Axt (nach anderer Lesart: Reisegeld). Doch mein Herz ist nicht froh.";
"hex.56.yao.4" = "Auf einen Fasan schießen und einen Pfeil verlieren. Am Ende Anerkennung und einen Adelstitel erhalten.";
"hex.56.yao.5" = "Das Vogelnest verbrennt. Der Wanderer lacht zuerst, dann weint er laut. Seinen Ochsen an der Grenze verlieren (nach anderen Lesarten im Land Youyi oder durch Nachlässigkeit). Unheil.";
"hex.57.ci" = "Kleines Gelingen. Es ist förderlich, aufzubrechen und den großen Menschen von hoher Tugend und Stellung zu sehen.";
"hex.57.daxiang" = "Wind folgt auf Wind: Das Sanfte. So bekräftigt der Edle seine Befehle und führt die Regierungsgeschäfte aus.";
"hex.57.yao.0" = "Zwischen Vorangehen und Rückzug schwanken. Es ist förderlich, mit der Entschlossenheit eines Kriegers am Rechten festzuhalten.";
"hex.57.yao.1" = "Demütig unter dem Bett liegen. Priester und Schamanen heranziehen, um den Geistern wiederholt die eigene Aufrichtigkeit zu bekunden. Heil, kein Makel.";
"hex.57.yao.2" = "Immer wieder widerwillig Unterwerfung zeigen. Beschämung.";
"hex.57.yao.3" = "Die Reue schwindet. Die Jagd bringt vielfältige Beute für drei Zwecke: Opfer, Bewirtung von Gästen und die Küche.";
"hex.57.yao.4" = "Standhaftigkeit im Rechten bringt Heil; die Reue schwindet. Alles ist förderlich. Ein schlechter Anfang, doch ein gutes Ende. Drei Tage vor dem Geng-Tag die Befehle verkünden, drei Tage danach ihre Wirkung prüfen. Heil.";
"hex.57.yao.5" = "Sich übermäßig unter das Bett ducken und Geld und Axt verlieren (Halt und Entschlusskraft einbüßen). Darin zu verharren bringt Unheil.";
"hex.58.ci" = "Gelingen. Förderlich ist Standhaftigkeit im Rechten.";
"hex.58.daxiang" = "Zwei Seen sind verbunden: Das Heitere. So erörtert und lernt der Edle mit seinen Freunden.";
"hex.58.yao.0" = "Andere durch friedliche Haltung erfreuen. Heil.";
"hex.58.yao.1" = "Andere durch Aufrichtigkeit erfreuen. Heil; die Reue schwindet.";
"hex.58.yao.2" = "Herankommen, um durch Schmeichelei Wohlgefallen zu suchen. Unheil.";
"hex.58.yao.3" = "Unruhig abwägen, wem man gefallen soll. Das zersetzende Übel fernhalten bringt Freude.";
"hex.58.yao.4" = "Gemeinen Menschen vertrauen, die die Yang-Kraft zersetzen. Gefahr.";
"hex.58.yao.5" = "Andere dazu verleiten, gemeinsam nach Freude zu suchen.";
"hex.59.ci" = "Gelingen. Der König geht zum Ahnentempel, um zu opfern (die zerstreuten Herzen zu vereinen). Es ist förderlich, den großen Fluss zu überqueren und am Rechten festzuhalten.";
"hex.59.daxiang" = "Der Wind zieht über das Wasser: Die Auflösung. So opferten die früheren Könige dem höchsten Himmelsgott und errichteten Ahnentempel (um die Herzen zu vereinen).";
"hex.59.yao.0" = "Ein starkes Pferd bringt Rettung. Heil.";
"hex.59.yao.1" = "In der Zeit der Zerstreuung zum Tisch eilen, der Halt bietet (Unterstützung finden). Die Reue schwindet.";
"hex.59.yao.2" = "Die eigene Selbstsucht auflösen. Keine Reue.";
"hex.59.yao.3" = "Eigennützige Parteien auflösen: großes Heil. Aus der Zerstreuung entsteht eine Gemeinschaft, groß wie ein Hügel, jenseits gewöhnlicher Vorstellung.";
"hex.59.yao.4" = "In der Zerstreuung große Befehle verbreiten wie Schweiß, der aus dem Körper tritt; die Vorräte des Königs verteilen (nach anderer Lesart nimmt der König seinen rechten Platz ein, um die Herzen zu vereinen). Kein Makel.";
"hex.59.yao.5" = "Blutige Verletzungen abwenden und weit fortgehen. Kein Makel.";
"hex.60.ci" = "Gelingen. Eine übermäßig bittere und strenge Beschränkung kann nicht dauerhaft beibehalten werden.";
"hex.60.daxiang" = "Wasser über dem See: Die Beschränkung. So legt der Edle Riten und Maßstäbe fest und beurteilt Tugend und Verhalten.";
"hex.60.yao.0" = "Nicht aus dem inneren Hof hinausgehen. Kein Makel.";
"hex.60.yao.1" = "Nicht aus dem Hof am äußeren Tor hinausgehen, obwohl es geboten wäre. Unheil.";
"hex.60.yao.2" = "Ohne Maß folgen Seufzen und Reue: Wem sonst könnte man Vorwürfe machen? (Nach anderer Lesart beseitigt reumütige Einsicht den Makel.)";
"hex.60.yao.3" = "Beschränkung gelassen üben. Gelingen.";
"hex.60.yao.4" = "Beschränkung auf angenehme, maßvolle Weise üben. Heil. Vorangehen findet Anerkennung.";
"hex.60.yao.5" = "Bittere, übermäßige Beschränkung. Darin zu verharren bringt Unheil; Einsicht und Besserung lassen die Reue schwinden.";
"hex.61.ci" = "Aufrichtigkeit erreicht selbst Ferkel und Fische (auch die geringsten Wesen). Heil. Es ist förderlich, den großen Fluss zu überqueren und am Rechten festzuhalten.";
"hex.61.daxiang" = "Wind über dem See: Innere Wahrheit. So prüft der Edle Rechtsfälle sorgfältig und schiebt Todesstrafen auf.";
"hex.61.yao.0" = "Ruhig bei der eigenen Pflicht bleiben (nach anderer Lesart: abwägen oder sich vorbereiten) bringt Heil. Andere Ziele zu verfolgen nimmt den Frieden.";
"hex.61.yao.1" = "Der Kranich ruft im Schatten; seinesgleichen antworten. Ich habe guten Wein, den ich mit dir teilen will.";
"hex.61.yao.2" = "Einem Gegner begegnen: Bald zum Angriff trommeln, bald den Kampf einstellen; bald weinen, bald singen.";
"hex.61.yao.3" = "Der Mond ist fast voll. Das Pferd verliert seinen Gefährten. Kein Makel.";
"hex.61.yao.4" = "Aufrichtigkeit verbindet die Menschen eng miteinander. Kein Makel.";
"hex.61.yao.5" = "Der Hahnenschrei steigt zum Himmel (der Ruf übersteigt den wirklichen Wert). Darin zu verharren bringt Unheil.";
"hex.62.ci" = "Gelingen. Förderlich ist Standhaftigkeit im Rechten. Kleine Vorhaben sind möglich, große nicht. Der fliegende Vogel lässt seinen Ruf nach unten dringen. Es ist angemessen, sich unten niederzulassen, statt hoch hinaufzufliegen. Großes Heil.";
"hex.62.daxiang" = "Donner auf dem Berg: Des Kleinen Übergewicht. So übt der Edle etwas mehr Ehrerbietung im Handeln, mehr Trauer beim Begräbnis und mehr Sparsamkeit bei den Ausgaben.";
"hex.62.yao.0" = "Der Vogel will hoch fliegen, statt unten zu bleiben, und zieht dadurch Unheil auf sich.";
"hex.62.yao.1" = "Am Großvater vorbeigehen und die Großmutter treffen; nicht über den Herrscher hinausgehen, sondern den Diener treffen. Kein Makel.";
"hex.62.yao.2" = "Nicht genügend Vorsorge treffen und den Dingen freien Lauf lassen setzt einen Verletzungen aus. Unheil.";
"hex.62.yao.3" = "Kein Makel. Ohne übermäßige Härte kann man ihm begegnen. Vorangehen ist gefährlich: Unbedingt wachsam sein. Nicht auf Dauer starr verharren.";
"hex.62.yao.4" = "Dichte Wolken kommen vom westlichen Umland, doch es regnet nicht. Der Fürst erlegt mit einem Pfeil an einer Schnur das Wild in seinem Versteck.";
"hex.62.yao.5" = "Die Begegnung verfehlen, indem man zu weit geht, wie ein Vogel, der ins Netz gerät. Unheil: Das ist ein Unglück.";
"hex.63.ci" = "Gelingen in kleinen Angelegenheiten. Förderlich ist Standhaftigkeit im Rechten. Anfangs Heil, am Ende Verwirrung.";
"hex.63.daxiang" = "Wasser über dem Feuer: Nach der Vollendung. So bedenkt der Edle mögliche Gefahren und beugt ihnen vor.";
"hex.63.yao.0" = "Das Wagenrad zurückhalten, um die Fahrt zu bremsen; der Fuchs benetzt beim Durchqueren des Flusses seinen Schwanz. Kein Makel.";
"hex.63.yao.1" = "Die Frau verliert den Vorhang ihres Wagens. Nicht danach suchen; nach sieben Tagen wird er wiedergefunden.";
"hex.63.yao.2" = "Gaozong (Wu Ding, König der Shang) zieht gegen die Guifang (einen Volksstamm im Norden) und unterwirft sie erst nach drei Jahren. Gemeine Menschen dürfen nicht eingesetzt werden.";
"hex.63.yao.3" = "Prächtige Kleider werden zu Lumpen (nach anderer Lesart: Lappen bereithalten, um Lecks im Boot zu stopfen). Den ganzen Tag wachsam bleiben.";
"hex.63.yao.4" = "Der östliche Nachbar opfert prunkvoll einen Ochsen; er empfängt weniger wirklichen Segen als der westliche Nachbar mit seinem schlichten Sommeropfer.";
"hex.63.yao.5" = "Beim Durchqueren des Flusses den Kopf benetzen. Gefahr.";
"hex.64.ci" = "Gelingen. Der junge Fuchs hat den Fluss fast durchquert, benetzt aber seinen Schwanz. Nichts ist förderlich.";
"hex.64.daxiang" = "Feuer über dem Wasser: Vor der Vollendung. So unterscheidet der Edle die Dinge sorgfältig und weist jedem seinen angemessenen Platz zu.";
"hex.64.yao.0" = "Den Schwanz benetzen. Beschämung.";
"hex.64.yao.1" = "Das Wagenrad zurückhalten (nicht übereilt vorangehen). Standhaftigkeit im Rechten bringt Heil.";
"hex.64.yao.2" = "Die Überquerung ist noch nicht vollendet. Vorangehen bringt Unheil. Es ist förderlich, den großen Fluss zu überqueren (nach anderer Lesart müsste es „nicht förderlich“ heißen).";
"hex.64.yao.3" = "Standhaftigkeit im Rechten bringt Heil; die Reue schwindet. Mit der Macht des Donners gegen die Guifang ziehen; nach drei Jahren vom großen Reich belohnt werden.";
"hex.64.yao.4" = "Standhaftigkeit im Rechten bringt Heil, keine Reue. Der Glanz des Edlen liegt in seiner Aufrichtigkeit. Heil.";
"hex.64.yao.5" = "In Ruhe und Aufrichtigkeit Wein trinken: kein Makel. Sich aber so darin verlieren, dass der Kopf benetzt wird, lässt einen trotz Aufrichtigkeit vom rechten Weg abkommen.";
"hex.1.yong" = "Eine Schar Drachen erscheint; keiner strebt danach, das Haupt zu sein. Heil.";
"hex.2.yong" = "Es ist förderlich, für immer am Rechten festzuhalten.";
