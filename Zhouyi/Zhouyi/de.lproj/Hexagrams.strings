/* Hexagrams – Deutsch (Titel nach Richard Wilhelm) */
"hex.1.name" = "Qián";
"hex.1.full" = "Das Schöpferische";
"hex.1.bh" = "Der Weg des Himmels ist stark und rastlos. Ergreifen Sie die Initiative und arbeiten Sie unermüdlich an sich selbst – doch gehen Sie Schritt für Schritt vor und hüten Sie sich vor Überheblichkeit und Ungeduld.";
"hex.2.name" = "Kūn";
"hex.2.full" = "Das Empfangende";
"hex.2.bh" = "Die Erde trägt alles in Hingabe. Gehen Sie mit dem Lauf der Dinge, unterstützen Sie andere und drängen Sie sich nicht vor. Wer beständig und rechtschaffen bleibt, hat Glück.";
"hex.3.name" = "Zhūn";
"hex.3.full" = "Die Anfangsschwierigkeit";
"hex.3.bh" = "Alles ist im Entstehen, der Anfang ist mühsam. Zu Beginn gibt es viele Widerstände: Festigen Sie das Fundament, suchen Sie Unterstützung und handeln Sie nicht überstürzt.";
"hex.4.name" = "Méng";
"hex.4.full" = "Die Jugendtorheit";
"hex.4.bh" = "Unwissenheit wartet auf Erleuchtung. Bitten Sie bescheiden um Rat und lernen Sie mit ganzer Aufmerksamkeit; stellen Sie dem Orakel nicht immer wieder dieselbe Frage.";
"hex.5.name" = "Xū";
"hex.5.full" = "Das Warten";
"hex.5.bh" = "Warten Sie auf den rechten Zeitpunkt. Die Bedingungen sind noch nicht reif – bleiben Sie aufrichtig und geduldig, dann öffnet sich der Weg von selbst.";
"hex.6.name" = "Sòng";
"hex.6.full" = "Der Streit";
"hex.6.bh" = "Ein Bild des Konflikts. Suchen Sie früh eine Einigung und wissen Sie, wann es genug ist; wer bis zum Ende streitet, verliert. Ziehen Sie gegebenenfalls einen unparteiischen Dritten hinzu.";
"hex.7.name" = "Shī";
"hex.7.full" = "Das Heer";
"hex.7.bh" = "Viele Kräfte werden aufgeboten. Große Vorhaben verlangen strenge Disziplin und die richtigen Leute; nur unter einer erfahrenen und geachteten Führung gelingen sie.";
"hex.8.name" = "Bǐ";
"hex.8.full" = "Das Zusammenhalten";
"hex.8.bh" = "Nähe und Verbundenheit. Knüpfen Sie aufrichtige Beziehungen, schließen Sie sich dem Guten an und suchen Sie frühzeitig Anschluss; wer zögert und abwartet, verpasst die Gelegenheit.";
"hex.9.name" = "Xiǎo Chù";
"hex.9.full" = "Des Kleinen Zähmungskraft";
"hex.9.bh" = "Ein wenig ist angesammelt, doch die Kraft reicht noch nicht aus. Die Sache reift, hat aber noch keine Gestalt angenommen. Sammeln Sie Kräfte und pflegen Sie Ihr Inneres.";
"hex.10.name" = "Lǚ";
"hex.10.full" = "Das Auftreten";
"hex.10.bh" = "Wie auf den Schwanz eines Tigers treten – gehen Sie behutsam voran. Die Lage birgt Gefahren, doch wer Anstand wahrt und vorsichtig bleibt, kommt sicher hindurch.";
"hex.11.name" = "Tài";
"hex.11.full" = "Der Friede";
"hex.11.bh" = "Himmel und Erde begegnen sich, oben und unten sind verbunden. Alles läuft gut – nutzen Sie die günstige Zeit, bleiben Sie aber auch im Wohlstand wachsam.";
"hex.12.name" = "Pǐ";
"hex.12.full" = "Die Stockung";
"hex.12.bh" = "Himmel und Erde begegnen sich nicht, alles ist blockiert. Halten Sie sich zurück, bleiben Sie Ihren Grundsätzen treu und warten Sie auf die Wende.";
"hex.13.name" = "Tóng Rén";
"hex.13.full" = "Gemeinschaft mit Menschen";
"hex.13.bh" = "Eintracht mit anderen. Suchen Sie Gleichgesinnte und arbeiten Sie offen zusammen, statt sich auf kleine, private Kreise zu beschränken.";
"hex.14.name" = "Dà Yǒu";
"hex.14.full" = "Der Besitz von Großem";
"hex.14.bh" = "Reiche Ernte, wie die Sonne im Zenit. Fördern Sie das Gute, wehren Sie dem Schlechten und bleiben Sie bescheiden – so bewahren Sie den Wohlstand auf Dauer.";
"hex.15.name" = "Qiān";
"hex.15.full" = "Die Bescheidenheit";
"hex.15.bh" = "Bescheidenheit und Zurückhaltung. Je bescheidener Sie sind, desto mehr Unterstützung erhalten Sie. Alle sechs Linien sind günstig – ein Bild für ein gutes Gelingen vom Anfang bis zum Ende.";
"hex.16.name" = "Yù";
"hex.16.full" = "Die Begeisterung";
"hex.16.bh" = "Freude und Leichtigkeit, andere folgen Ihnen. Planen Sie voraus und handeln Sie im Einklang mit der Lage, doch verlieren Sie sich nicht in Bequemlichkeit.";
"hex.17.name" = "Suí";
"hex.17.full" = "Die Nachfolge";
"hex.17.bh" = "Bewegen Sie sich mit der Zeit und folgen Sie dem Guten. Passen Sie sich flexibel den Umständen an, ohne vom rechten Weg abzuweichen.";
"hex.18.name" = "Gǔ";
"hex.18.full" = "Die Arbeit am Verdorbenen";
"hex.18.bh" = "Altlasten müssen bereinigt werden. Alte Probleme verlangen Ordnung und Erneuerung; mit guter Planung vorher und Überprüfung nachher lässt sich die Krise wenden.";
"hex.19.name" = "Lín";
"hex.19.full" = "Die Annäherung";
"hex.19.bh" = "Der Höhere wendet sich den Unteren zu, es geht allmählich aufwärts. Die Lage wird besser – handeln Sie tatkräftig, beugen Sie aber dem Niedergang nach dem Höhepunkt vor.";
"hex.20.name" = "Guān";
"hex.20.full" = "Die Betrachtung";
"hex.20.bh" = "Beobachten und Vorbild sein. Betrachten Sie in Ruhe das Ganze, prüfen Sie sich selbst und überzeugen Sie durch Aufrichtigkeit; handeln Sie nicht übereilt.";
"hex.21.name" = "Shì Kè";
"hex.21.full" = "Das Durchbeißen";
"hex.21.bh" = "Durchbeißen und Hindernisse beseitigen. Etwas steht im Weg – handeln Sie entschlossen und unterscheiden Sie klar Recht von Unrecht. Ist das Hindernis beseitigt, ist der Weg frei.";
"hex.22.name" = "Bì";
"hex.22.full" = "Die Anmut";
"hex.22.bh" = "Die Schönheit der Form. Maßvoller Schmuck tut gut, doch vernachlässigen Sie nicht das Wesentliche. Kleine Dinge gelingen; bei großen zählt die Substanz.";
"hex.23.name" = "Bō";
"hex.23.full" = "Die Zersplitterung";
"hex.23.bh" = "Zerfall und Niedergang. Die Lage ist ungünstig – verteidigen Sie, statt anzugreifen, bewahren Sie Ihre Kräfte und warten Sie auf die Wiederkehr.";
"hex.24.name" = "Fù";
"hex.24.full" = "Die Wiederkehr";
"hex.24.bh" = "Das Licht kehrt zurück, ein Neubeginn. Der Tiefpunkt ist überwunden – kehren Sie rechtzeitig auf den rechten Weg zurück und erholen Sie sich Schritt für Schritt.";
"hex.25.name" = "Wú Wàng";
"hex.25.full" = "Die Unschuld";
"hex.25.bh" = "Echtheit ohne Falsch. Wer natürlich handelt und nicht auf Glück spekuliert, hat Heil; unbedachtes Handeln und maßlose Wünsche bringen Unheil.";
"hex.26.name" = "Dà Chù";
"hex.26.full" = "Des Großen Zähmungskraft";
"hex.26.bh" = "Große Vorräte. Sammeln Sie reichlich Wissen und Stärke; wenn die Zeit reif ist, können Sie hinausgehen und Großes vollbringen.";
"hex.27.name" = "Yí";
"hex.27.full" = "Die Mundwinkel";
"hex.27.bh" = "Der Weg der Ernährung. Achten Sie auf Essen, Lebensweise und Ihre Worte, und erlangen Sie das Nötige durch eigene, redliche Anstrengung.";
"hex.28.name" = "Dà Guò";
"hex.28.full" = "Des Großen Übergewicht";
"hex.28.bh" = "Die Last ist zu schwer, der Firstbalken biegt sich. Außergewöhnliche Zeiten verlangen außergewöhnliche Schritte – übernehmen Sie furchtlos und eigenständig Verantwortung.";
"hex.29.name" = "Kǎn";
"hex.29.full" = "Das Abgründige";
"hex.29.bh" = "Gefahr über Gefahr. Bewahren Sie in der Not Zuversicht und Ausdauer; bleiben Sie wie Wasser beharrlich in Bewegung, dann finden Sie aus der Gefahr heraus.";
"hex.30.name" = "Lí";
"hex.30.full" = "Das Haftende";
"hex.30.bh" = "Das Licht haftet an etwas. Halten Sie sich an den rechten Weg und an weise Menschen, bleiben Sie sanft und bescheiden – nur so leuchtet das Licht dauerhaft.";
"hex.31.name" = "Xián";
"hex.31.full" = "Die Einwirkung";
"hex.31.bh" = "Gegenseitige Anziehung. In Beziehungen und Gefühlen wirkt Aufrichtigkeit; begegnen Sie anderen offen, dann verläuft alles harmonisch.";
"hex.32.name" = "Héng";
"hex.32.full" = "Die Dauer";
"hex.32.bh" = "Der Weg der Beständigkeit. Halten Sie an der eingeschlagenen Richtung fest, bleiben Sie ausdauernd und ändern Sie nicht leichtfertig den Kurs.";
"hex.33.name" = "Dùn";
"hex.33.full" = "Der Rückzug";
"hex.33.bh" = "Zeit des Rückzugs. Die Lage ist ungünstig – ziehen Sie sich rechtzeitig zurück, um sich zu schützen. Der Rückzug ist hier ein Weg nach vorn.";
"hex.34.name" = "Dà Zhuàng";
"hex.34.full" = "Des Großen Macht";
"hex.34.bh" = "Große Stärke. Gerade wenn Sie viel Kraft haben, sollten Sie Maß und Anstand wahren; pochen Sie nicht auf Ihre Stärke und handeln Sie nicht unbesonnen.";
"hex.35.name" = "Jìn";
"hex.35.full" = "Der Fortschritt";
"hex.35.bh" = "Die Sonne geht auf, es geht voran. Zeigen Sie tatkräftig Ihre Fähigkeiten und Ihren Charakter – Sie finden jetzt leicht Anerkennung.";
"hex.36.name" = "Míng Yí";
"hex.36.full" = "Die Verfinsterung des Lichts";
"hex.36.bh" = "Das Licht ist verdunkelt. In einer finsteren Umgebung verbergen Sie besser Ihr Licht: innerlich klar bleiben, nach außen nachgiebig auftreten.";
"hex.37.name" = "Jiā Rén";
"hex.37.full" = "Die Sippe";
"hex.37.bh" = "Der Weg der Familie. Jeder steht an seinem Platz, Worte und Taten sind wohlbegründet. Herrscht in der Familie Eintracht, gelingt alles.";
"hex.38.name" = "Kuí";
"hex.38.full" = "Der Gegensatz";
"hex.38.bh" = "Auseinanderstreben. Suchen Sie bei Meinungsverschiedenheiten das Gemeinsame und respektieren Sie das Trennende. Kleine Dinge gelingen; große Gräben überwinden Sie nur langsam.";
"hex.39.name" = "Jiǎn";
"hex.39.full" = "Das Hemmnis";
"hex.39.bh" = "Der Weg ist beschwerlich. Vor Ihnen liegt ein Hindernis – prüfen Sie sich selbst, suchen Sie Förderer und halten Sie vorerst inne.";
"hex.40.name" = "Xiè";
"hex.40.full" = "Die Befreiung";
"hex.40.bh" = "Die Schwierigkeiten lösen sich. Handeln Sie großzügig und frühzeitig, legen Sie alte Feindschaften bei und stellen Sie die Ordnung wieder her.";
"hex.41.name" = "Sǔn";
"hex.41.full" = "Die Minderung";
"hex.41.bh" = "Der Weg der Minderung. Verzichten Sie auf kleinen Vorteil und Eigennutz, geben Sie aufrichtig – gerade dadurch gewinnen Sie.";
"hex.42.name" = "Yì";
"hex.42.full" = "Die Mehrung";
"hex.42.bh" = "Zeit des Zuwachses. Günstig, um Neues zu erschließen und voranzukommen: Lernen Sie vom Guten, korrigieren Sie Fehler – Gewinn ist zu erwarten.";
"hex.43.name" = "Guài";
"hex.43.full" = "Der Durchbruch";
"hex.43.bh" = "Zeit der Entscheidung. Entscheiden Sie, wenn es nötig ist, doch argumentieren Sie offen und überzeugen Sie durch Integrität, statt mit dem Kopf durch die Wand zu gehen.";
"hex.44.name" = "Gòu";
"hex.44.full" = "Das Entgegenkommen";
"hex.44.bh" = "Eine unerwartete Begegnung. Es ergibt sich ein überraschendes Treffen oder eine Chance – prüfen Sie aber genau, wer Ihnen begegnet, und wehren Sie den Anfängen.";
"hex.45.name" = "Cuì";
"hex.45.full" = "Die Sammlung";
"hex.45.bh" = "Sammlung und Vereinigung. Menschen und Mittel kommen zusammen – stärken Sie den Zusammenhalt und treffen Sie zugleich Vorkehrungen.";
"hex.46.name" = "Shēng";
"hex.46.full" = "Das Empordringen";
"hex.46.bh" = "Schritt für Schritt aufwärts. Wie ein wachsender Baum wird aus Kleinem Großes; nutzen Sie den Aufwind und gehen Sie mutig voran.";
"hex.47.name" = "Kùn";
"hex.47.full" = "Die Bedrängnis";
"hex.47.bh" = "Eine Lage der Not. Reden Sie in schwierigen Zeiten wenig und handeln Sie viel, bleiben Sie Ihren Zielen treu – die Bedrängnis wird sich lösen.";
"hex.48.name" = "Jǐng";
"hex.48.full" = "Der Brunnen";
"hex.48.bh" = "Der Brunnen nährt unerschöpflich. Auf festem Grund beständig geben: Entscheidend sind Pflege und Ausdauer – wer kurz vor dem Ziel aufgibt, scheitert.";
"hex.49.name" = "Gé";
"hex.49.full" = "Die Umwälzung";
"hex.49.bh" = "Zeit des Wandels. Veränderung braucht den rechten Zeitpunkt und das Vertrauen der Menschen; im Einklang mit Himmel und Menschen gelingt der Umbruch.";
"hex.50.name" = "Dǐng";
"hex.50.full" = "Der Tiegel";
"hex.50.bh" = "Erneuerung und neue Ordnung. Festigen Sie Ihre Position und setzen Sie fähige Menschen ein – die neue Lage hat sich bereits gefestigt.";
"hex.51.name" = "Zhèn";
"hex.51.full" = "Das Erregende";
"hex.51.bh" = "Ein Donnerschlag erschüttert. Bewahren Sie bei plötzlichen Umbrüchen die Ruhe, seien Sie wachsam und selbstkritisch – danach finden Sie umso sicherer Frieden.";
"hex.52.name" = "Gèn";
"hex.52.full" = "Das Stillehalten";
"hex.52.bh" = "Innehalten und ruhen. Wissen Sie, wann Sie stehen bleiben müssen, zügeln Sie Ihre Begierden, bleiben Sie bei Ihren Aufgaben und überschreiten Sie nicht Ihre Rolle.";
"hex.53.name" = "Jiàn";
"hex.53.full" = "Die Entwicklung";
"hex.53.bh" = "Allmählicher Fortschritt. Wie die Wildgans nach und nach höher fliegt, so gehen Sie Schritt für Schritt vor und erzwingen Sie keinen schnellen Erfolg.";
"hex.54.name" = "Guī Mèi";
"hex.54.full" = "Das heiratende Mädchen";
"hex.54.bh" = "Die Stellung ist noch nicht geklärt. Achten Sie auf Ihre Rolle und das rechte Maß; überstürztes Vorgehen schadet – halten Sie sich an das Gewohnte und warten Sie ab.";
"hex.55.name" = "Fēng";
"hex.55.full" = "Die Fülle";
"hex.55.bh" = "Fülle und Größe. Sie stehen auf dem Höhepunkt – nutzen Sie den Augenblick, bedenken Sie aber: Nach dem Mittag neigt sich die Sonne.";
"hex.56.name" = "Lǚ";
"hex.56.full" = "Der Wanderer";
"hex.56.bh" = "Unterwegs in der Fremde. In ungewohnter Umgebung bleiben Sie bescheiden, rechtschaffen und vorsichtig; kleine Dinge gelingen.";
"hex.57.name" = "Xùn";
"hex.57.full" = "Das Sanfte";
"hex.57.bh" = "Wie der Wind in alles eindringt: bescheiden und durchdringend. Kommunizieren Sie sanft, erklären Sie Ihr Anliegen wiederholt und gehen Sie mit dem Strom.";
"hex.58.name" = "Duì";
"hex.58.full" = "Das Heitere";
"hex.58.bh" = "Freude und Heiterkeit. Begegnen Sie anderen aufrichtig und tauschen Sie sich aus; Freude, die aus dem rechten Weg kommt, bringt Gelingen.";
"hex.59.name" = "Huàn";
"hex.59.full" = "Die Auflösung";
"hex.59.bh" = "Zerstreuung und Auflösung. Wenn die Menschen auseinanderdriften, stiften Sie Einigkeit; was sich angestaut hat, lässt sich jetzt lösen.";
"hex.60.name" = "Jié";
"hex.60.full" = "Die Beschränkung";
"hex.60.bh" = "Maß halten. Wissen Sie in allem, wann es genug ist, und leben Sie nach Ihren Mitteln – doch allzu strenge Beschränkung hält nicht lange.";
"hex.61.name" = "Zhōng Fú";
"hex.61.full" = "Innere Wahrheit";
"hex.61.bh" = "Aufrichtigkeit im Innern. Bewegen Sie andere durch Ehrlichkeit; wo echte Aufrichtigkeit wirkt, gelingt selbst Schwieriges.";
"hex.62.name" = "Xiǎo Guò";
"hex.62.full" = "Des Kleinen Übergewicht";
"hex.62.bh" = "Ein kleines Übermaß. Widmen Sie sich kleinen Dingen und treten Sie bescheiden auf; greifen Sie nicht nach zu Hohem.";
"hex.63.name" = "Jì Jì";
"hex.63.full" = "Nach der Vollendung";
"hex.63.bh" = "Das Werk ist vollbracht. Nach dem Erfolg schleicht sich leicht Nachlässigkeit ein – bleiben Sie im Wohlstand wachsam und beugen Sie Problemen vor.";
"hex.64.name" = "Wèi Jì";
"hex.64.full" = "Vor der Vollendung";
"hex.64.bh" = "Noch nicht vollendet. Sie sind mitten im Prozess – bringen Sie die Sache sorgfältig zu Ende und prüfen Sie die Richtung genau, dann wird es gelingen.";
