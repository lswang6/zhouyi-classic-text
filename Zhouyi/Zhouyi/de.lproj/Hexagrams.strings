/* Hexagrams – Deutsch (Titel nach Richard Wilhelm) */
"hex.1.name" = "Qián";
"hex.1.full" = "Das Schöpferische";
"hex.1.bh" = "Der Himmel verdoppelt, alle sechs Linien fest: das Bild unermüdlicher schöpferischer Kraft. Das Urteil nennt es „erhaben und uranfänglich“; die Linien verfolgen einen Drachen, der in der Tiefe verborgen liegt, auf dem Feld erscheint, am Himmel fliegt und sich schließlich übernimmt.";
"hex.2.name" = "Kūn";
"hex.2.full" = "Das Empfangende";
"hex.2.bh" = "Die Erde verdoppelt, alle sechs Linien nachgiebig: das Bild der Erde, die alle Dinge trägt und erhält. Das Urteil vergleicht ihre Beständigkeit mit der einer Stute; die Linien reichen vom Reif, der festes Eis ankündigt, bis zu Drachen, die auf offenem Feld kämpfen.";
"hex.3.name" = "Zhūn";
"hex.3.full" = "Die Anfangsschwierigkeit";
"hex.3.bh" = "Donner unten und Wolken oben: das Bild eines Keims, der sich mitten im Gewitter durch den Boden drängt. Der Text handelt von der Verwirrung allen Anfangs; die Linien zeigen Pferd und Wagen, die stocken, einen Freier, der zunächst abgewiesen wird, und einen Jäger, der sich ohne Führer verirrt.";
"hex.4.name" = "Méng";
"hex.4.full" = "Die Jugendtorheit";
"hex.4.bh" = "Eine Quelle, die am Fuß eines Berges entspringt: das Bild der Jugendtorheit. Das Urteil beschreibt Lehrer und Schüler: Der Junge sucht den Lehrer auf, und Fragen, die immer wieder gestellt werden, bleiben unbeantwortet; die Linien behandeln Zucht, Geduld und die ungelehrte Jugend.";
"hex.5.name" = "Xū";
"hex.5.full" = "Das Warten";
"hex.5.bh" = "Wolken, die am Himmel aufsteigen, bevor der Regen fällt: das Bild des Wartens. Das Urteil verbindet das Warten mit Wahrhaftigkeit und mit dem Durchqueren des großen Wassers; die Linien warten auf dem Anger, im Sand, im Schlamm, bei Wein und Speise und schließlich in einer Grube.";
"hex.6.name" = "Sòng";
"hex.6.full" = "Der Streit";
"hex.6.bh" = "Der Himmel strebt nach oben, das Wasser fließt nach unten, beide entfernen sich voneinander: das Bild von Streit und Rechtshandel. Das Urteil stellt das Einhalten eines Streits auf halbem Weg seinem Austragen bis zum Ende gegenüber; die Linien zeigen fallengelassene Händel, eine Heimkehr und einen ledernen Ehrengürtel, der an einem Tag dreimal entzogen wird.";
"hex.7.name" = "Shī";
"hex.7.full" = "Das Heer";
"hex.7.bh" = "Wasser, das in der Erde gesammelt ist: das Bild einer Streitmacht, die aus dem Volk hervorgeht. Der Text handelt von der Ordnung eines Heeres und der Notwendigkeit eines erfahrenen Führers; die Linien führen vom geordneten Auszug über Wagen mit Leichen bis zum Herrscher, der nach dem Feldzug Belohnungen verleiht.";
"hex.8.name" = "Bǐ";
"hex.8.full" = "Das Zusammenhalten";
"hex.8.bh" = "Wasser, das über die Erde fließt: das Bild der Dinge, die einander nahekommen und sich verbinden. Das Urteil spricht von denen, die sich anschließen, und vom Nachzügler; die Linien beschreiben Zusammenhalten, das auf Wahrhaftigkeit gründet, Zusammenhalten von innen und von außen und Zusammenhalten ohne Haupt.";
"hex.9.name" = "Xiǎo Chù";
"hex.9.full" = "Des Kleinen Zähmungskraft";
"hex.9.bh" = "Wind, der über den Himmel zieht: das Bild einer sanften Kraft, die eine Zeit lang zurückhält. Das Urteil gibt mit „dichte Wolken, kein Regen“ aus dem westlichen Gebiet das Thema vor; die Linien zeigen die Rückkehr auf den eigenen Weg, einen Wagen, dem die Speichen abspringen, und schließlich den einsetzenden Regen.";
"hex.10.name" = "Lǚ";
"hex.10.full" = "Das Auftreten";
"hex.10.bh" = "Der Himmel über einem See: das Bild der rechten Ordnung zwischen Hoch und Niedrig. Die Gestalt des Urteils tritt einem Tiger auf den Schwanz, der nicht beißt; die Linien verfolgen schlichtes Verhalten, einen stillen, ebenen Pfad, einen Einäugigen, der zu sehen versucht, und eine abschließende Rückschau auf die getanen Schritte.";
"hex.11.name" = "Tài";
"hex.11.full" = "Der Friede";
"hex.11.bh" = "Die Erde oben und der Himmel unten, ihre Kräfte begegnen sich: das Bild von Himmel und Erde im Einklang. Das Urteil spricht davon, dass „das Kleine geht und das Große kommt“; die Linien führen vom Schilf, das gemeinsam ausgerissen wird, über „keine Ebene ohne Abhang“ bis zur Stadtmauer, die in ihren Graben zurückstürzt.";
"hex.12.name" = "Pǐ";
"hex.12.full" = "Die Stockung";
"hex.12.bh" = "Der Himmel oben und die Erde unten, sie entfernen sich voneinander ohne Berührung: das Bild der Stockung. Das Urteil spricht davon, dass „das Große geht und das Kleine kommt“; die Linien führen vom Ertragen einer schlechten Zeit über ein Schicksal, das an ein Büschel Maulbeerbäume gebunden ist, bis zur Stockung, die schließlich umgestürzt wird.";
"hex.13.name" = "Tóng Rén";
"hex.13.full" = "Gemeinschaft mit Menschen";
"hex.13.bh" = "Der Himmel über dem Feuer, beide streben nach oben: das Bild von Menschen, die sich für eine gemeinsame Sache vereinen. Das Urteil verlegt die Gemeinschaft mit Menschen ins offene Land; die Linien verfolgen Gemeinschaft am Tor, innerhalb einer Sippe, im Dickicht verborgene Truppen und Verbündete, die zuerst weinen und später lachen.";
"hex.14.name" = "Dà Yǒu";
"hex.14.full" = "Der Besitz von Großem";
"hex.14.bh" = "Feuer hoch am Himmel, das auf alles darunter scheint: das Bild des Besitzes von Großem. Das Urteil spricht von „erhabenem Fortgang“; die Linien behandeln die Verantwortung des Reichtums: einen großen Wagen zum Beladen, eine Gabe an den Sohn des Himmels und Fülle, die ohne Übermaß bewahrt wird.";
"hex.15.name" = "Qiān";
"hex.15.full" = "Die Bescheidenheit";
"hex.15.bh" = "Ein Berg, der in der Erde verborgen ist: das Bild von Größe, die sich niedrig hält. Das Urteil sagt, der Edle bringe die Dinge zu Ende; die Linien beschreiben die Bescheidenheit in ihren Formen: Bescheidenheit in der Bescheidenheit, Bescheidenheit, die sich äußert, und Bescheidenheit, die mit Verdienst verbunden ist.";
"hex.16.name" = "Yù";
"hex.16.full" = "Die Begeisterung";
"hex.16.bh" = "Donner, der aus der Erde hervorbricht: das Bild freigesetzter Kraft, die alle Dinge in Bewegung bringt. Das Große Bild verbindet es mit der Musik, die die alten Könige schufen; die Linien stellen prahlerische oder selbstversunkene Begeisterung einem Charakter gegenüber, der fest ist wie ein Fels.";
"hex.17.name" = "Suí";
"hex.17.full" = "Die Nachfolge";
"hex.17.bh" = "Donner, der im See ruht: das Bild der Nachfolge, die sich der Jahreszeit anpasst. Das Urteil verbindet die Nachfolge mit Festigkeit und Rechtschaffenheit; die Linien zeigen die Bindung an das Kleine oder an das Große, Wahrhaftigkeit auf dem rechten Weg und einen, der in Treue fest gebunden ist.";
"hex.18.name" = "Gǔ";
"hex.18.full" = "Die Arbeit am Verdorbenen";
"hex.18.bh" = "Wind, der am Fuß eines Berges weht, wo die Dinge stocken: das Bild des Verdorbenen, das wieder in Ordnung zu bringen ist. Das Urteil spricht von drei Tagen vor und drei Tagen nach einem Neubeginn; die Linien handeln davon, auszubessern, was Vater und Mutter verderben ließen, während die oberste Linie weder König noch Fürsten dient.";
"hex.19.name" = "Lín";
"hex.19.full" = "Die Annäherung";
"hex.19.bh" = "Die Erde über einem See: das Bild des Höheren, der sich den Unteren nähert. Das Urteil fügt eine Mahnung zum achten Monat hinzu, wenn sich der Kreislauf wendet; die Linien beschreiben eine Annäherung, die gemeinsam, leicht, vollkommen, weise und großherzig ist.";
"hex.20.name" = "Guān";
"hex.20.full" = "Die Betrachtung";
"hex.20.bh" = "Wind, der über die Erde zieht: das Bild des Betrachtens und Betrachtetwerdens. Die Gestalt des Urteils ist ein Opfernder, der sich die Hände gewaschen, das Opfer aber noch nicht dargebracht hat; die Linien weiten sich vom Blick eines Knaben und einem Spähen durch die Tür bis zur Betrachtung des eigenen Lebens.";
"hex.21.name" = "Shì Kè";
"hex.21.full" = "Das Durchbeißen";
"hex.21.bh" = "Donner und Blitz zugleich: das Bild eines Hindernisses zwischen den Kiefern, das durchgebissen werden muss. Der Text handelt von der Anwendung von Gesetz und Strafe; die Linien führen von Füßen im Block über das Beißen in zartes und in gedörrtes Fleisch bis zu einem Hals im Halsbrett.";
"hex.22.name" = "Bì";
"hex.22.full" = "Die Anmut";
"hex.22.bh" = "Feuer am Fuß eines Berges, das ihn erhellt: das Bild von Anmut und Schmuck. Das Urteil lässt nur kleine Angelegenheiten zu; die Linien führen von geschmückten Füßen und geschmücktem Bart über schimmernde Feuchtigkeit und ein weißes Pferd bis zur Anmut, die schlicht weiß geworden ist.";
"hex.23.name" = "Bō";
"hex.23.full" = "Die Zersplitterung";
"hex.23.bh" = "Fünf nachgiebige Linien unter einer festen Linie: ein Berg, der auf der Erde ruht und abgetragen wird. Die Linien zeigen ein Bett, das zuerst an den Beinen, dann am Rahmen und schließlich bis zur Haut zersplittert wird; ganz oben bleibt eine große Frucht ungegessen.";
"hex.24.name" = "Fù";
"hex.24.full" = "Die Wiederkehr";
"hex.24.bh" = "Donner in der Erde: das Bild des Lichts, das zur Wintersonnenwende wiederkehrt. Das Urteil spricht von einer Wiederkehr binnen sieben Tagen; die Linien unterscheiden eine rasche Wiederkehr, eine stille Wiederkehr, wiederholte Wiederkehr, ein Gehen allein und eine aus Verwirrung verfehlte Wiederkehr.";
"hex.25.name" = "Wú Wàng";
"hex.25.full" = "Die Unschuld";
"hex.25.bh" = "Donner, der unter dem Himmel rollt: das Bild der Dinge, die arglos aus ihrer eigenen Natur heraus handeln. Das Urteil verbindet die Unschuld mit Rechtschaffenheit; zu den Linien gehören ein Rind, das einer anbindet und ein Vorübergehender wegführt, und eine Krankheit, die ohne Arznei vergeht.";
"hex.26.name" = "Dà Chù";
"hex.26.full" = "Des Großen Zähmungskraft";
"hex.26.bh" = "Der Himmel im Inneren des Berges: das Bild großer Kraft, die gezähmt und gespeichert wird. Das Große Bild spricht davon, die Worte und Taten früherer Zeiten zu sammeln; die Linien reichen von einem Wagen ohne Achse und dem geschützten Horn eines jungen Stiers bis zum Weg des Himmels, der sich oben öffnet.";
"hex.27.name" = "Yí";
"hex.27.full" = "Die Mundwinkel";
"hex.27.bh" = "Donner unter einem Berg, wie Kiefer, die sich über der Nahrung schließen: das Bild der Ernährung. Das Urteil lenkt den Blick darauf, womit jemand den Mund zu füllen sucht; die Linien stellen einen, der seine Zauberschildkröte fahren lässt, um nach der Speise anderer zu schauen, der Nahrung aus rechten Quellen gegenüber.";
"hex.28.name" = "Dà Guò";
"hex.28.full" = "Des Großen Übergewicht";
"hex.28.bh" = "Der See, der über die Bäume steigt: das Bild eines Firstbalkens, der sich unter zu großer Last biegt. Der Text handelt von außergewöhnlichen Zeiten; die Linien zeigen eine Unterlage aus weißem Schilf, eine verdorrte Weide, die neue Triebe ansetzt, einen durchhängenden Firstbalken und eine Durchquerung, bei der das Wasser über den Kopf geht.";
"hex.29.name" = "Kǎn";
"hex.29.full" = "Das Abgründige";
"hex.29.bh" = "Wasser verdoppelt, das von einer Schlucht zur nächsten weiterfließt: das Bild wiederholter Gefahr. Das Urteil hebt Wahrhaftigkeit und einen klaren Sinn hervor; die Linien sprechen von einer Grube in der Grube, von Wein und Reis, die durch ein Fenster gereicht werden, und von einem mit Stricken gebundenen Gefangenen.";
"hex.30.name" = "Lí";
"hex.30.full" = "Das Haftende";
"hex.30.bh" = "Feuer verdoppelt, Helligkeit über Helligkeit: das Bild des Lichts, das an dem haftet, was es erleuchtet. Das Urteil fügt die Pflege einer Kuh hinzu; die Linien führen von verworrenen Schritten über gelbes Licht und die untergehende Sonne bis zu plötzlicher Flamme und dem Strafzug eines Königs.";
"hex.31.name" = "Xián";
"hex.31.full" = "Die Einwirkung";
"hex.31.bh" = "Ein See, der auf einem Berg ruht: das Bild gegenseitiger Anziehung zwischen jungem Mann und junger Frau. Das Urteil spricht davon, eine Frau zu nehmen; die Linien steigen am Körper empor: die große Zehe, die Waden, die Schenkel, der Rücken und schließlich Kiefer und Zunge.";
"hex.32.name" = "Héng";
"hex.32.full" = "Die Dauer";
"hex.32.bh" = "Donner und Wind, die stets zusammen auftreten: das Bild dessen, was Dauer hat. Das Große Bild zeigt ein festes Stehen, ohne die eigene Richtung zu ändern; die Linien stellen voreilig gesuchte Dauer, einen unbeständigen Charakter und ein Feld ohne Wild gegenüber.";
"hex.33.name" = "Dùn";
"hex.33.full" = "Der Rückzug";
"hex.33.bh" = "Ein Berg, der unter dem Himmel aufsteigt, und der Himmel weicht vor ihm zurück: das Bild des Rückzugs. Das Urteil handelt davon, sich rechtzeitig zurückzuziehen, während geringere Kräfte vordringen; die Linien reichen vom Schwanz des Rückzugs und einem, der mit gelber Rindshaut festgehalten wird, bis zu einem heiteren, gelassenen Rückzug.";
"hex.34.name" = "Dà Zhuàng";
"hex.34.full" = "Des Großen Macht";
"hex.34.bh" = "Donner hoch am Himmel: das Bild großer Stärke in Bewegung. Das Große Bild verbindet Macht mit dem Schicklichen; die Linien zeigen einen Widder, der gegen eine Hecke stößt und sich mit den Hörnern darin verfängt, und die Hecke, die sich schließlich öffnet.";
"hex.35.name" = "Jìn";
"hex.35.full" = "Der Fortschritt";
"hex.35.bh" = "Die Sonne, die über der Erde aufgeht: das Bild raschen, leichten Fortschritts. Das Urteil zeigt einen Fürsten, der mit vielen Pferden geehrt und an einem Tag dreimal empfangen wird; die Linien stellen gehemmten oder bekümmerten Fortschritt dem eines Hamsters und dem eines mit Hörnern Vordringenden gegenüber.";
"hex.36.name" = "Míng Yí";
"hex.36.full" = "Die Verfinsterung des Lichts";
"hex.36.bh" = "Die Sonne, unter die Erde gesunken: das Bild verwundeter und verborgener Helligkeit. Der Text handelt davon, das eigene Licht in dunklen Zeiten zu verbergen, mit dem Beispiel des Prinzen Ji; zu den Linien gehören ein Fasan, der mit hängenden Flügeln fliegt, und eine Jagd im Süden.";
"hex.37.name" = "Jiā Rén";
"hex.37.full" = "Die Sippe";
"hex.37.bh" = "Wind, der aus dem Feuer hervorgeht: das Bild der Sippe, deren Einfluss sich von innen nach außen ausbreitet. Das Urteil betont die Rolle der Frau; die Linien behandeln feste Regeln im Haus, die Zubereitung der Mahlzeiten und den Einfluss des Königs auf seine Familie.";
"hex.38.name" = "Kuí";
"hex.38.full" = "Der Gegensatz";
"hex.38.bh" = "Feuer über einem See, beide bewegen sich voneinander weg: das Bild von Gegensatz und Entfremdung. Das Urteil lässt kleine Angelegenheiten zu; zu den Linien gehören ein verlorenes Pferd, das von selbst zurückkehrt, die Begegnung mit dem eigenen Herrn in einer engen Gasse und ein Schwein voller Schmutz.";
"hex.39.name" = "Jiǎn";
"hex.39.full" = "Das Hemmnis";
"hex.39.bh" = "Wasser auf dem Gipfel eines Berges: das Bild eines gefährlichen Weges voraus. Das Urteil stellt den Südwesten dem Nordosten gegenüber und spricht davon, den großen Mann zu sehen; die Linien wechseln zwischen dem Vorangehen in das Hemmnis und der Umkehr, um Beistand zu finden.";
"hex.40.name" = "Xiè";
"hex.40.full" = "Die Befreiung";
"hex.40.bh" = "Donner und Regen, die die Spannung eines Gewitters lösen: das Bild der Befreiung. Das Urteil spricht von einer frühen Rückkehr, sobald die Not vorüber ist; zu den Linien gehören drei gefangene Füchse, ein Lastträger, der in einem Wagen fährt, und ein Habicht, der auf einer hohen Mauer geschossen wird.";
"hex.41.name" = "Sǔn";
"hex.41.full" = "Die Minderung";
"hex.41.bh" = "Ein See am Fuß eines Berges, dessen Wasser aufsteigt, um den Hang darüber zu nähren: das Bild der Minderung. Das Urteil merkt an, dass zwei kleine Schüsseln für das Opfer genügen können; die Linien handeln davon, unten zu mindern, um oben zu mehren, und von dem, was durch Geben gewonnen wird.";
"hex.42.name" = "Yì";
"hex.42.full" = "Die Mehrung";
"hex.42.bh" = "Wind und Donner, die einander verstärken: das Bild der Mehrung. Der Text handelt davon, dass der Höhere dem Niederen gibt, und das Große Bild verbindet es mit der Hinwendung zum Guten; zu den Linien gehören ein Geschenk von zehn Paar Schildkrötenschalen und ein Herz ohne Beständigkeit.";
"hex.43.name" = "Guài";
"hex.43.full" = "Der Durchbruch";
"hex.43.bh" = "Ein See, der hoch über den Himmel gestiegen ist: das Bild des Durchbruchs. Das Urteil spricht davon, die Sache am Hof des Königs zu verkünden; die Linien handeln von entschlossenem Vorgehen gegen das Unrecht: zu hastiges Vordringen, ausgerissenes Unkraut und ein einsamer Wanderer, den der Regen durchnässt.";
"hex.44.name" = "Gòu";
"hex.44.full" = "Das Entgegenkommen";
"hex.44.bh" = "Wind, der unter dem Himmel weht: das Bild einer einzelnen nachgiebigen Linie, die fünf festen entgegenkommt. Das Urteil rät davon ab, ein solches Mädchen zu heiraten; zu den Linien gehören ein Fisch im Behälter, eine mit Weidenblättern bedeckte Melone und ein Entgegenkommen mit den Hörnern.";
"hex.45.name" = "Cuì";
"hex.45.full" = "Die Sammlung";
"hex.45.bh" = "Ein See, der über der Erde steigt: das Bild gesammelter Wasser und sich versammelnder Menschen. Das Urteil erwähnt den König, der sich seinem Tempel naht, und große Opfergaben; die Linien behandeln die Sammlung am Anfang, das Zusammengezogenwerden, das Seufzen über die Trennung und das Weinen.";
"hex.46.name" = "Shēng";
"hex.46.full" = "Das Empordringen";
"hex.46.bh" = "Holz, das in der Erde emporwächst: das Bild stetigen Wachstums nach oben. Das Urteil erwähnt das Sehen des großen Mannes und den Aufbruch nach Süden; die Linien verfolgen das Empordringen in eine leere Stadt, das Opfer des Königs auf dem Berg Qi und das Ersteigen einer Treppe.";
"hex.47.name" = "Kùn";
"hex.47.full" = "Die Bedrängnis";
"hex.47.bh" = "Ein See, aus dem das Wasser abgeflossen ist: das Bild von Erschöpfung und Bedrängnis. Das Urteil merkt an, dass Worten in einer solchen Zeit nicht geglaubt wird; zu den Linien gehören Bedrängnis unter einem kahlen Baum, bei Wein und Speise, zwischen Felsen und Dornen und durch rankende Gewächse.";
"hex.48.name" = "Jǐng";
"hex.48.full" = "Der Brunnen";
"hex.48.bh" = "Holz, das ins Wasser hinabgeht, um es heraufzuholen: das Bild des Brunnens, einer Quelle der Nahrung, die nie versiegt. Das Urteil merkt an, dass eine Stadt verlegt werden kann, ihr Brunnen aber nicht; die Linien führen von einem schlammigen, unbenutzten Brunnen bis zu einem, der allen offensteht.";
"hex.49.name" = "Gé";
"hex.49.full" = "Die Umwälzung";
"hex.49.bh" = "Feuer in einem See, jedes sucht das andere auszulöschen: das Bild der Umwälzung. Das Urteil sagt, dass der Wandel erst an dem Tag geglaubt wird, an dem er vollendet ist; die Linien verfolgen einen in gelbe Rindshaut gebundenen Wandel, den großen Mann, der sich wandelt wie ein Tiger, und den Edlen, der sich wandelt wie ein Panther.";
"hex.50.name" = "Dǐng";
"hex.50.full" = "Der Tiegel";
"hex.50.bh" = "Holz unter dem Feuer: das Bild des Ding, des bronzenen Tiegels, in dem Opfergaben und Festmähler gekocht werden. Das Urteil spricht von großem Fortgang; die Linien führen von einem Tiegel, der umgestürzt wird, um ihn zu leeren, über gebrochene Beine und veränderte Griffe bis zu Tragringen aus Gold und aus Jade.";
"hex.51.name" = "Zhèn";
"hex.51.full" = "Das Erregende";
"hex.51.bh" = "Donner verdoppelt: das Bild von Erschütterung und Furcht. Das Urteil zeigt Schrecken, auf den Lachen folgt, und einen, der den Opferlöffel und den Wein festhält; die Linien folgen den Antworten auf die Erschütterung, vom Verlust von Schätzen und dem Ersteigen der neun Hügel bis zum Steckenbleiben im Schlamm.";
"hex.52.name" = "Gèn";
"hex.52.full" = "Das Stillehalten";
"hex.52.bh" = "Der Berg verdoppelt: das Bild von Stille und Ruhe. Das Urteil zeigt einen, der seinen Rücken stillhält und im Hof umhergeht, ohne jemanden zu sehen; die Linien steigen am Körper empor, über Zehen, Waden, Hüften, Rumpf und Kiefer, bis zu einem edlen Stillehalten an der Spitze.";
"hex.53.name" = "Jiàn";
"hex.53.full" = "Die Entwicklung";
"hex.53.bh" = "Ein Baum, der auf einem Berg wächst: das Bild allmählicher Entwicklung. Das Urteil nimmt die Heirat eines Mädchens als Beispiel; die Linien folgen einer Wildgans, die Schritt für Schritt vom Ufer zum Felsen, zur Hochebene, zum Baum, zum Gipfel und zu den Höhen darüber hinaus vorrückt.";
"hex.54.name" = "Guī Mèi";
"hex.54.full" = "Das heiratende Mädchen";
"hex.54.bh" = "Donner über einem See: das Bild einer jüngeren Schwester, die als Nebenfrau verheiratet wird. Das Große Bild bedenkt, wie man das Ende vom Anfang her erkennt; zu den Linien gehören ein Lahmer, der geht, ein Einäugiger, der sieht, eine aufgeschobene Heirat und die Ärmel einer Braut, die schlichter sind als die ihrer Brautjungfer.";
"hex.55.name" = "Fēng";
"hex.55.full" = "Die Fülle";
"hex.55.bh" = "Donner und Blitz, die zugleich eintreffen: das Bild der Fülle auf ihrem Höhepunkt. Das Urteil vergleicht den König mit der Sonne am Mittag; die Linien beschreiben eine so verdeckte Sonne, dass man am Mittag die Sterne sieht, und ein großes Haus, das leer steht.";
"hex.56.name" = "Lǚ";
"hex.56.full" = "Der Wanderer";
"hex.56.bh" = "Feuer auf einem Berg, das brennt und weiterzieht: das Bild des Wanderers. Das Urteil lässt kleine Angelegenheiten zu; die Linien beschreiben einen Wanderer in Herbergen, mit oder ohne Diener und Habe, und ein Vogelnest, das verbrennt, während der Wanderer erst lacht und dann weint.";
"hex.57.name" = "Xùn";
"hex.57.full" = "Das Sanfte";
"hex.57.bh" = "Wind verdoppelt, der überall eindringt: das Bild des Sanften und Durchdringenden. Das Urteil spricht von kleinem Fortgang und vom Sehen des großen Mannes; zu den Linien gehören Wahrsager und Beschwörer unter dem Bett, Jagdbeute für drei Zwecke und drei Tage vor und nach einer Veränderung.";
"hex.58.name" = "Duì";
"hex.58.full" = "Das Heitere";
"hex.58.bh" = "Der See verdoppelt, zwei Seen, die einander speisen: das Bild geteilter Freude. Das Große Bild verbindet es mit Freunden, die gemeinsam besprechen und üben; die Linien stellen Heiterkeit, die harmonisch und wahrhaftig ist, einer Heiterkeit gegenüber, die gesucht, berechnet oder verführerisch ist.";
"hex.59.name" = "Huàn";
"hex.59.full" = "Die Auflösung";
"hex.59.bh" = "Wind, der über das Wasser weht: das Bild der Auflösung dessen, was starr oder gespalten ist. Das Urteil erwähnt den König, der sich seinem Tempel naht, und das Durchqueren des großen Wassers; zu den Linien gehören die Auflösung des eigenen Selbst, der eigenen Gruppe und ein großer Ruf, der sich ausbreitet wie Schweiß.";
"hex.60.name" = "Jié";
"hex.60.full" = "Die Beschränkung";
"hex.60.bh" = "Wasser über einem See, der nur eine bestimmte Menge fassen kann: das Bild von Grenzen und Regelung. Das Urteil sagt, dass harte und bittere Beschränkung keinen Bestand hat; die Linien stellen das Nicht-Hinausgehen aus dem Hof, leicht angenommene Beschränkung und bittere Beschränkung gegenüber.";
"hex.61.name" = "Zhōng Fú";
"hex.61.full" = "Innere Wahrheit";
"hex.61.bh" = "Wind über einem See: das Bild einer Wahrhaftigkeit, die selbst Schweine und Fische erreicht. Zu den Linien gehören ein Kranich, der im Schatten ruft, und seine Jungen, die antworten, ein geteilter Becher Wein, ein Pferd, dessen Gespanngefährte davonläuft, und ein Hahn, der zum Himmel emporzufliegen versucht.";
"hex.62.name" = "Xiǎo Guò";
"hex.62.full" = "Des Kleinen Übergewicht";
"hex.62.bh" = "Donner über einem Berg: das Bild des Übergewichts des Kleinen. Das Urteil zeigt einen fliegenden Vogel, dessen Ruf zu hören ist, und stellt kleine Angelegenheiten großen gegenüber; die Linien zeigen einen Vogel, der zu hoch fliegt, und ein Vorbeigehen am Ahnherrn, um der Ahnfrau zu begegnen.";
"hex.63.name" = "Jì Jì";
"hex.63.full" = "Nach der Vollendung";
"hex.63.bh" = "Wasser über dem Feuer, jede Linie an ihrem rechten Platz: das Bild vollendeter Dinge. Das Urteil merkt Ordnung am Anfang und Unordnung am Ende an; zu den Linien gehören ein gebremstes Rad, ein verlorener Wagenvorhang und ein Fuchs, der sich den Kopf nass macht.";
"hex.64.name" = "Wèi Jì";
"hex.64.full" = "Vor der Vollendung";
"hex.64.bh" = "Feuer über dem Wasser, keine Linie an ihrem rechten Platz: das Bild eines noch nicht abgeschlossenen Übergangs. Das Urteil zeigt einen jungen Fuchs, der den Fluss beinahe durchquert hat und sich den Schwanz nass macht; die Linien führen von dieser unvollendeten Durchquerung bis zu Wein, der am Ende in Zuversicht getrunken wird.";
