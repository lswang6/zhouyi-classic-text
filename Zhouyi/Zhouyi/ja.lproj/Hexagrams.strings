/* Japanese — hexagram names (King Wen order) and trigrams (先天 order) */
"hex.1.name" = "乾";
"hex.1.full" = "乾為天";
"hex.1.bh" = "天の働きは力強く、休むことなく巡ります。自ら積極的に進み、たゆまず努力しましょう。ただし段階を踏み、おごりや焦りを戒めることが大切です。";
"hex.2.name" = "坤";
"hex.2.full" = "坤為地";
"hex.2.bh" = "大地のように柔順で、すべてを受け入れ支えます。流れに従い人を支える役に回るのがよく、先頭に立とうとせず、正しさを守って落ち着けば吉です。";
"hex.3.name" = "屯";
"hex.3.full" = "水雷屯";
"hex.3.bh" = "万物が生まれたばかりで、歩み出しに苦労する時です。物事は始まったばかりで抵抗が多いので、足場を固めて協力者を求め、無理に突き進まないようにしましょう。";
"hex.4.name" = "蒙";
"hex.4.full" = "山水蒙";
"hex.4.bh" = "まだ物事に暗く、啓発を待つ時です。謙虚に教えを請い、学ぶことに専念しましょう。同じことを何度も占うのは避けてください。";
"hex.5.name" = "需";
"hex.5.full" = "水天需";
"hex.5.bh" = "時機を待つ時です。条件はまだ整っていないので、誠実さと忍耐を保ちましょう。時機が来れば自然に道が開けます。";
"hex.6.name" = "訟";
"hex.6.full" = "天水訟";
"hex.6.bh" = "争いの象です。早めに和解し、ほどほどで引くのがよく、最後まで争うとかえって不利になります。公正な第三者を頼るのも一案です。";
"hex.7.name" = "師";
"hex.7.full" = "地水師";
"hex.7.bh" = "大勢の人を動かす時です。大事を成すには規律を正し、人を適材適所に用い、人望ある人の指導があってこそ成功します。";
"hex.8.name" = "比";
"hex.8.full" = "水地比";
"hex.8.bh" = "親しみ寄り添う時です。誠実に人と交わり、良い相手を選んで従いましょう。早めに歩み寄るのがよく、迷って様子見をすると機を逃します。";
"hex.9.name" = "小畜";
"hex.9.full" = "風天小畜";
"hex.9.bh" = "少し蓄えはあるものの、力はまだ足りません。物事は準備段階でまだ形になっていないので、実力を蓄え、内面を磨きましょう。";
"hex.10.name" = "履";
"hex.10.full" = "天沢履";
"hex.10.bh" = "虎の尾を踏むように、慎重に進む時です。危うい状況でも、礼を守り注意深く行動すれば無事に切り抜けられます。";
"hex.11.name" = "泰";
"hex.11.full" = "地天泰";
"hex.11.bh" = "天地が交わり、上下の意思が通じ合います。万事順調なので好機をつかみましょう。同時に、安泰な時こそ危機への備えを忘れずに。";
"hex.12.name" = "否";
"hex.12.full" = "天地否";
"hex.12.bh" = "天地が交わらず、ふさがって通じない時です。控えめに身を慎み、信念を守って、好転の時を待ちましょう。";
"hex.13.name" = "同人";
"hex.13.full" = "天火同人";
"hex.13.bh" = "人と心を同じくする時です。広く仲間を募り、オープンに協力しましょう。身内だけの小さな輪にこだわらないことです。";
"hex.14.name" = "大有";
"hex.14.full" = "火天大有";
"hex.14.bh" = "大きな収穫を得て、日が中天にあるような勢いです。善を広め悪を抑え、謙虚に守りを固めてこそ、豊かさを長く保てます。";
"hex.15.name" = "謙";
"hex.15.full" = "地山謙";
"hex.15.bh" = "謙虚に一歩譲る時です。控えめであるほど人の助けが得られます。六爻すべてが吉で、有終の美を飾れる象です。";
"hex.16.name" = "豫";
"hex.16.full" = "雷地豫";
"hex.16.bh" = "和やかで楽しく、多くの人が呼応します。前もって計画し、流れに乗って動きましょう。ただし安逸に溺れてはいけません。";
"hex.17.name" = "随";
"hex.17.full" = "沢雷随";
"hex.17.bh" = "時の流れに合わせて動き、善いものを選んで従う時です。状況に応じて柔軟に対応しつつ、正しい道はしっかり守りましょう。";
"hex.18.name" = "蠱";
"hex.18.full" = "山風蠱";
"hex.18.bh" = "積もった弊害を正す時です。古い問題を整理し刷新する必要があります。事前によく計画し、事後に点検すれば、危機を好機に変えられます。";
"hex.19.name" = "臨";
"hex.19.full" = "地沢臨";
"hex.19.bh" = "上に立って下に臨み、次第に好転していきます。情勢は良くなっているので積極的に動きましょう。ただし盛りの後の衰えにも備えを。";
"hex.20.name" = "観";
"hex.20.full" = "風地観";
"hex.20.bh" = "静かに観察し、また人の手本となる時です。全体を静かに見渡し、自分を省みて、誠意で人を動かしましょう。急いで行動する必要はありません。";
"hex.21.name" = "噬嗑";
"hex.21.full" = "火雷噬嗑";
"hex.21.bh" = "噛み砕いて障害を取り除く時です。間に妨げがあるので、是非をはっきりさせ、決断して処理すれば、道は開けます。";
"hex.22.name" = "賁";
"hex.22.full" = "山火賁";
"hex.22.bh" = "外見を美しく飾る時です。ほどよく整えることは有益ですが、本質を見失ってはいけません。小さなことは順調ですが、大きなことは中身を重視しましょう。";
"hex.23.name" = "剝";
"hex.23.full" = "山地剝";
"hex.23.bh" = "はがれ落ちて衰える時です。情勢が不利なので、攻めずに守り、力を温存して回復の時を待ちましょう。";
"hex.24.name" = "復";
"hex.24.full" = "地雷復";
"hex.24.bh" = "一陽来復、再出発の時です。どん底は過ぎました。すぐに正しい道へ戻り、一歩ずつ回復していきましょう。";
"hex.25.name" = "无妄";
"hex.25.full" = "天雷无妄";
"hex.25.bh" = "偽りのない真実の時です。自然に任せ、僥倖を当てにしなければ吉です。むやみに動いたり欲張ったりすると災いを招きます。";
"hex.26.name" = "大畜";
"hex.26.full" = "山天大畜";
"hex.26.bh" = "大いに蓄える時です。知識と実力をしっかり蓄えましょう。時機が熟せば外へ出て大きなことを成し遂げられます。";
"hex.27.name" = "頤";
"hex.27.full" = "山雷頤";
"hex.27.bh" = "心身を養う道を示す時です。飲食や生活習慣、言葉づかいに気をつけ、自分の正当な努力で必要なものを得ましょう。";
"hex.28.name" = "大過";
"hex.28.full" = "沢風大過";
"hex.28.bh" = "荷が重すぎて、梁がたわんでいる状態です。非常時には非常の手段が必要です。恐れず、自ら責任を引き受けましょう。";
"hex.29.name" = "坎";
"hex.29.full" = "坎為水";
"hex.29.bh" = "困難が幾重にも重なる時です。苦境にあっても信念と根気を保ち、水のように流れ続ければ、やがて危機を抜け出せます。";
"hex.30.name" = "離";
"hex.30.full" = "離為火";
"hex.30.bh" = "光が正しいものに寄り添う時です。正しい道や賢い人に従い、柔らかく謙虚でいれば、その明るさは長く続きます。";
"hex.31.name" = "咸";
"hex.31.full" = "沢山咸";
"hex.31.bh" = "互いに感じ合う時です。人間関係や恋愛は真心で通じ合います。素直な心で人に接すれば、関係は順調に進みます。";
"hex.32.name" = "恒";
"hex.32.full" = "雷風恒";
"hex.32.bh" = "変わらずに続けることが大切な時です。決めた方向をしっかり守り、根気よく続けましょう。安易に方針を変えないことです。";
"hex.33.name" = "遯";
"hex.33.full" = "天山遯";
"hex.33.bh" = "退く時です。情勢が自分に不利なので、適切に身を引いて自分を守りましょう。退くことが次の前進につながります。";
"hex.34.name" = "大壮";
"hex.34.full" = "雷天大壮";
"hex.34.bh" = "勢いが非常に盛んな時です。力が満ちている時こそ正しさと礼を守り、力に任せた無謀な行動は厳禁です。";
"hex.35.name" = "晋";
"hex.35.full" = "火地晋";
"hex.35.bh" = "朝日が昇るように、昇進し前進する時です。積極的に才能と人柄を示せば、評価を得やすいでしょう。";
"hex.36.name" = "明夷";
"hex.36.full" = "地火明夷";
"hex.36.bh" = "光が損なわれる時です。周囲が暗い時は才能を隠して力を蓄え、内に明るさを保ちつつ、外には柔らかく振る舞いましょう。";
"hex.37.name" = "家人";
"hex.37.full" = "風火家人";
"hex.37.bh" = "家庭の在り方を示す時です。それぞれが自分の役割を守り、言動に筋を通しましょう。内部がまとまれば万事うまくいきます。";
"hex.38.name" = "睽";
"hex.38.full" = "火沢睽";
"hex.38.bh" = "心が離れ、背き合う時です。意見が分かれる時は違いを認めつつ共通点を探しましょう。小さなことなら成就しますが、大きなことはゆっくり溝を埋めていきましょう。";
"hex.39.name" = "蹇";
"hex.39.full" = "水山蹇";
"hex.39.bh" = "行く道が困難な時です。前に障害があるので、自分を省み、力になってくれる人を求め、しばらく前進を控えましょう。";
"hex.40.name" = "解";
"hex.40.full" = "雷水解";
"hex.40.bh" = "困難が解ける時です。寛大に物事に当たり、早めに行動して古いわだかまりを解き、秩序を取り戻しましょう。";
"hex.41.name" = "損";
"hex.41.full" = "山沢損";
"hex.41.bh" = "減らすことに意味がある時です。小さな利益や私欲を手放し、真心を込めて尽くせば、かえって得るものがあります。";
"hex.42.name" = "益";
"hex.42.full" = "風雷益";
"hex.42.bh" = "利益が増していく時です。新しいことに挑戦し前進するのに適しています。良いことは学び、過ちは改めれば、成果が期待できます。";
"hex.43.name" = "夬";
"hex.43.full" = "沢天夬";
"hex.43.bh" = "決断の時です。断つべき時は断ちましょう。ただし公に筋道を説き、徳で人を納得させるのがよく、力ずくの衝突は避けましょう。";
"hex.44.name" = "姤";
"hex.44.full" = "天風姤";
"hex.44.bh" = "思いがけない出会いの時です。予期せぬ縁やチャンスが訪れますが、相手をよく見極め、小さな兆しのうちに警戒しましょう。";
"hex.45.name" = "萃";
"hex.45.full" = "沢地萃";
"hex.45.bh" = "多くのものが寄り集まる時です。人と資源が集まるこの時こそ、人心をひとつにまとめましょう。同時に、万一への備えも怠らないように。";
"hex.46.name" = "升";
"hex.46.full" = "地風升";
"hex.46.bh" = "一歩一歩上っていく時です。木が育つように小さな積み重ねが大きくなります。流れに乗って上を目指し、思い切って進みましょう。";
"hex.47.name" = "困";
"hex.47.full" = "沢水困";
"hex.47.bh" = "行き詰まり苦しむ時です。逆境では口数を減らして行動で示し、志を守り続ければ、苦境はいずれ開けます。";
"hex.48.name" = "井";
"hex.48.full" = "水風井";
"hex.48.bh" = "井戸のように尽きることなく人を養う時です。基盤をしっかりさせて与え続けましょう。手入れと継続が肝心で、あと一歩のところで投げ出すと不利です。";
"hex.49.name" = "革";
"hex.49.full" = "沢火革";
"hex.49.bh" = "変革の時です。変えるには時機が熟し、人の信頼を得ていることが必要です。天の理と人の心に沿えば改革は成功します。";
"hex.50.name" = "鼎";
"hex.50.full" = "火風鼎";
"hex.50.bh" = "新たな体制が定まる時です。地位を固め、優れた人材を登用しましょう。新しい局面はすでに確立しています。";
"hex.51.name" = "震";
"hex.51.full" = "震為雷";
"hex.51.bh" = "雷が轟き揺れ動く時です。突然の変化に遭っても落ち着きを保ち、気を引き締めて自分を省みれば、後にはかえって安泰です。";
"hex.52.name" = "艮";
"hex.52.full" = "艮為山";
"hex.52.bh" = "止まって動かない時です。止まるべき時を知って止まり、欲を抑え、分をわきまえて、自分の立場を越えた行動は慎みましょう。";
"hex.53.name" = "漸";
"hex.53.full" = "風山漸";
"hex.53.bh" = "少しずつ進む時です。雁が段階を追って飛ぶように、手順を踏んで進めましょう。成果を急いではいけません。";
"hex.54.name" = "帰妹";
"hex.54.full" = "雷沢帰妹";
"hex.54.bh" = "名分がまだ正しく定まっていない時です。自分の立場と分をわきまえて行動しましょう。軽率に進むと不利なので、平常を守り時を待つことです。";
"hex.55.name" = "豊";
"hex.55.full" = "雷火豊";
"hex.55.bh" = "豊かで盛大な時です。今はまさに最盛期なので、この時を生かしましょう。ただし、日は南中すれば傾くという道理も心得ておくことです。";
"hex.56.name" = "旅";
"hex.56.full" = "火山旅";
"hex.56.bh" = "旅先に身を置く時です。慣れない環境では謙虚に正しさを守り、慎重に行動しましょう。小事なら成就します。";
"hex.57.name" = "巽";
"hex.57.full" = "巽為風";
"hex.57.bh" = "風が物に染み込むように、謙虚に浸透していく時です。穏やかに意思を伝え、繰り返し説明し、流れに乗って入り込みましょう。";
"hex.58.name" = "兌";
"hex.58.full" = "兌為沢";
"hex.58.bh" = "喜び楽しむ時です。真心で人に接し、互いに切磋琢磨しましょう。喜びが正しい道から生まれるなら、物事は通じます。";
"hex.59.name" = "渙";
"hex.59.full" = "風水渙";
"hex.59.bh" = "散らばる時であり、また解きほぐす時でもあります。人の心が離れている時は合意をまとめましょう。わだかまっていたことは、これを機に解消できます。";
"hex.60.name" = "節";
"hex.60.full" = "水沢節";
"hex.60.bh" = "節度を保つ時です。何事もほどほどにし、収入に見合った支出を心がけましょう。ただし厳しすぎる節制も長続きしません。";
"hex.61.name" = "中孚";
"hex.61.full" = "風沢中孚";
"hex.61.bh" = "心の内に誠がある時です。真心で人を動かしましょう。誠意が届けば、難しいことも成し遂げられます。";
"hex.62.name" = "小過";
"hex.62.full" = "雷山小過";
"hex.62.bh" = "少しだけ行き過ぎる時です。小さなことに取り組み、姿勢を低く保ちましょう。高望みは禁物です。";
"hex.63.name" = "既済";
"hex.63.full" = "水火既済";
"hex.63.bh" = "物事がすでに成就した時です。成功の後は気が緩みやすいので、安泰な時こそ危機に備え、災いを未然に防ぎましょう。";
"hex.64.name" = "未済";
"hex.64.full" = "火水未済";
"hex.64.bh" = "物事がまだ完成していない時です。まだ途中なので、慎重に仕上げ、方向を見極めましょう。いずれ成し遂げられる時が来ます。";
