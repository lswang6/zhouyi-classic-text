/* 周易 · es · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: es.json */
"hex.1.ci" = "Iniciativa creadora, éxito, armonía favorable y perseverancia en lo recto.";
"hex.1.daxiang" = "El cielo se mueve con vigor incesante. Así, la persona noble se fortalece sin descanso.";
"hex.1.yao.0" = "El dragón permanece oculto bajo el agua. Aún no es tiempo de actuar.";
"hex.1.yao.1" = "El dragón aparece en el campo. Es favorable ver a una gran persona de virtud.";
"hex.1.yao.2" = "La persona noble se esfuerza sin descanso todo el día y al anochecer sigue alerta, como ante un peligro. Sin culpa.";
"hex.1.yao.3" = "El dragón puede saltar hacia arriba o retirarse al abismo, según lo requiera el momento. Sin culpa.";
"hex.1.yao.4" = "El dragón vuela en el cielo. Es favorable ver a una gran persona de virtud.";
"hex.1.yao.5" = "El dragón vuela demasiado alto. Hay arrepentimiento.";
"hex.2.ci" = "Iniciativa creadora y éxito. Es favorable perseverar en lo recto con la docilidad de una yegua. La persona noble emprende un camino: si se adelanta, se extravía; si sigue, encuentra a quien la guíe. Es favorable. Al sudoeste encuentra amigos; al nordeste los pierde. Reposar en lo recto trae buena fortuna.";
"hex.2.daxiang" = "La tierra es dócil, extensa y profunda. Así, la persona noble sostiene todas las cosas con la profundidad de su virtud.";
"hex.2.yao.0" = "Al pisar la escarcha, se anuncia el hielo firme (imagen de prevenir el mal desde sus primeros indicios).";
"hex.2.yao.1" = "Rectitud, integridad y amplitud: aun sin cultivo deliberado, todo es favorable.";
"hex.2.yao.2" = "Ocultar la propia virtud permite perseverar en lo recto. Si se sirve al rey, llevar la tarea hasta el fin sin atribuirse el mérito.";
"hex.2.yao.3" = "Atar la boca del saco (imagen del silencio prudente). Sin culpa ni elogio.";
"hex.2.yao.4" = "Una falda amarilla (el amarillo representa el centro; la prenda inferior, la humildad). Gran fortuna.";
"hex.2.yao.5" = "Los dragones combaten en el campo. Su sangre mezcla negro azulado y amarillo (colores del cielo y la tierra: en la lucha del yin y el yang, ambos salen heridos).";
"hex.3.ci" = "Iniciativa creadora y éxito. Es favorable perseverar en lo recto. No apresurarse a partir. Es favorable establecer señores feudales (instituir un soberano y buscar ayuda).";
"hex.3.daxiang" = "Nubes arriba y trueno abajo: La Dificultad Inicial. Así, la persona noble organiza y gobierna el mundo como quien ordena los hilos de un tejido.";
"hex.3.yao.0" = "Vacilar sin avanzar. Es favorable permanecer en lo recto; es favorable establecer señores feudales.";
"hex.3.yao.1" = "Avanzar con dificultad y vacilación; los caballos giran sin progresar. No son bandidos, sino pretendientes. La joven persevera en lo recto y no acepta casarse; solo al cabo de diez años acepta.";
"hex.3.yao.2" = "Perseguir al ciervo sin un guardabosques (oficial encargado de montes y bosques) solo lleva a perderse en la espesura. La persona noble advierte los indicios: mejor desistir. Avanzar trae pesar.";
"hex.3.yao.3" = "Los caballos giran sin avanzar. Buscar una unión matrimonial: partir trae buena fortuna. Todo es favorable.";
"hex.3.yao.4" = "Los beneficios se acumulan sin poder distribuirse. Perseverar en lo recto en asuntos pequeños trae buena fortuna; en asuntos grandes, infortunio.";
"hex.3.yao.5" = "Los caballos giran sin avanzar. Corren lágrimas de sangre.";
"hex.4.ci" = "Éxito. No soy yo quien busca al joven inexperto; él me busca a mí. A la primera consulta, respondo. Repetirla una y otra vez es irreverencia; ante la irreverencia, no respondo. Es favorable perseverar en lo recto.";
"hex.4.daxiang" = "Al pie de la montaña brota un manantial: La Necedad Juvenil. Así, la persona noble actúa con resolución y cultiva su virtud.";
"hex.4.yao.0" = "Disipar la ignorancia. Es favorable emplear el castigo para encauzar a las personas y liberarlas de sus grilletes. Persistir solo en castigar trae pesar.";
"hex.4.yao.1" = "Acoger al ignorante trae buena fortuna. Tomar esposa trae buena fortuna. El hijo puede hacerse cargo del hogar.";
"hex.4.yao.2" = "No tomar por esposa a una mujer que, al ver a un hombre rico, se entrega sin miramiento. Nada es favorable.";
"hex.4.yao.3" = "Quedar preso de la ignorancia. Pesar.";
"hex.4.yao.4" = "Buscar enseñanza con la sencillez de un niño. Buena fortuna.";
"hex.4.yao.5" = "Combatir con firmeza la ignorancia. No es favorable excederse como un bandido; es favorable defenderse de las agresiones.";
"hex.5.ci" = "Sinceridad, claridad y éxito. Perseverar en lo recto trae buena fortuna. Es favorable cruzar el gran río (afrontar riesgos para llevar una empresa a término).";
"hex.5.daxiang" = "Las nubes ascienden al cielo (aguardando el momento de llover): La Espera. Así, la persona noble come, bebe y celebra, aguardando serenamente su momento.";
"hex.5.yao.0" = "Esperar en las afueras lejanas. Es favorable mantener la constancia. Sin culpa.";
"hex.5.yao.1" = "Esperar en la arena. Hay leves disputas de palabra; al final, buena fortuna.";
"hex.5.yao.2" = "Esperar en el barro atrae a los bandidos.";
"hex.5.yao.3" = "Esperar entre sangre (en un lugar donde se sufre daño). Se logra salir de la cueva.";
"hex.5.yao.4" = "Esperar serenamente entre vino y comida. Perseverar en lo recto trae buena fortuna.";
"hex.5.yao.5" = "Caer en la cueva. Llegan tres huéspedes sin invitación. Tratarlos con respeto trae, al final, buena fortuna.";
"hex.6.ci" = "La sinceridad encuentra obstáculos. Mantenerse alerta y detenerse a medio camino trae buena fortuna; llevar el litigio hasta el extremo, infortunio. Es favorable ver a una gran persona de virtud (para obtener un juicio justo). No es favorable cruzar el gran río.";
"hex.6.daxiang" = "El cielo asciende y el agua desciende en direcciones opuestas: El Conflicto. Así, la persona noble planea sus actos desde el comienzo (para evitar disputas).";
"hex.6.yao.0" = "No prolongar el litigio. Hay leves disputas de palabra; al final, buena fortuna.";
"hex.6.yao.1" = "No vencer en el litigio; regresar y retirarse. El feudo tiene solo trescientas familias. No hay calamidad.";
"hex.6.yao.2" = "Vivir de las antiguas mercedes. Perseverar en lo recto para precaverse del peligro. Al final, buena fortuna. Si se sirve al rey, no atribuirse el mérito.";
"hex.6.yao.3" = "No vencer en el litigio. Volver a lo justo, cambiar de intención y reposar en lo recto. Buena fortuna.";
"hex.6.yao.4" = "Resolver el litigio (con un juicio justo). Gran fortuna.";
"hex.6.yao.5" = "Aunque se reciba un lujoso cinturón por el litigio, se lo arrebatan tres veces en un solo día.";
"hex.7.ci" = "Perseverancia en lo recto. Bajo el mando de un anciano de gran virtud y prestigio, buena fortuna. Sin culpa.";
"hex.7.daxiang" = "Dentro de la tierra hay agua: El Ejército. Así, la persona noble acoge y sustenta al pueblo.";
"hex.7.yao.0" = "El ejército sale a campaña sujeto a disciplina. Si la disciplina falla, infortunio.";
"hex.7.yao.1" = "Ocupar el centro y dirigir el ejército. Buena fortuna, sin culpa. El rey concede repetidamente honores por decreto.";
"hex.7.yao.2" = "El ejército puede regresar transportando cadáveres. Infortunio.";
"hex.7.yao.3" = "El ejército retrocede y acampa. Sin culpa.";
"hex.7.yao.4" = "Hay animales en el campo (imagen de una invasión enemiga). Es favorable denunciarlos y capturarlos. Sin culpa. El hijo mayor debe dirigir el ejército; si un joven sin virtud toma el mando, volverá con cadáveres. Aun perseverando en lo recto, infortunio.";
"hex.7.yao.5" = "El soberano dicta su mandato y recompensa los méritos: unos reciben estados como señores feudales; otros, casas como altos dignatarios. No se debe emplear a personas mezquinas.";
"hex.8.ci" = "Buena fortuna. Examinar el sentido de la consulta: con iniciativa creadora, constancia y perseverancia en lo recto, sin culpa. Los estados inquietos acuden a unirse. Quien llega tarde encuentra infortunio.";
"hex.8.daxiang" = "Sobre la tierra hay agua (íntimamente unidas): La Solidaridad. Así, los antiguos reyes fundaban los estados y estrechaban sus lazos con los señores feudales.";
"hex.8.yao.0" = "Unirse a otros con sinceridad. Sin culpa. La sinceridad desborda como buen vino en una vasija de barro. Al final llegan beneficios inesperados. Buena fortuna.";
"hex.8.yao.1" = "Unirse desde el corazón. Perseverar en lo recto trae buena fortuna.";
"hex.8.yao.2" = "Unirse a quien no se debe.";
"hex.8.yao.3" = "Unirse a personas virtuosas fuera del propio círculo. Perseverar en lo recto trae buena fortuna.";
"hex.8.yao.4" = "Unirse a todos de manera franca. En la caza, el rey hace avanzar a los batidores por tres lados y deja uno abierto, permitiendo escapar a los animales que tiene delante. Los habitantes tampoco necesitan recelar unos de otros. Buena fortuna.";
"hex.8.yao.5" = "Unirse sin hacerlo a tiempo (según otra lectura, sin un buen comienzo). Infortunio.";
"hex.9.ci" = "Éxito. Nubes densas sin lluvia se levantan desde nuestras afueras occidentales.";
"hex.9.daxiang" = "El viento recorre el cielo: La Fuerza Domesticadora de lo Pequeño. Así, la persona noble refina su cultura y su virtud.";
"hex.9.yao.0" = "Volver al propio camino recto. ¿Qué falta puede haber? Buena fortuna.";
"hex.9.yao.1" = "Dejarse llevar de vuelta, junto con otros, al camino recto. Buena fortuna.";
"hex.9.yao.2" = "Se desprenden los radios de la rueda del carro. Marido y mujer se enfrentan.";
"hex.9.yao.3" = "Con sinceridad, se alejan las preocupaciones y desaparece el temor. Sin culpa.";
"hex.9.yao.4" = "La sinceridad une a todos. Compartir la prosperidad con los vecinos.";
"hex.9.yao.5" = "Ya ha llovido y el yang ha sido contenido y reposa, gracias al cultivo de la virtud. Para la mujer, aun perseverando en lo recto, hay peligro. La luna está casi llena (el yin crece hasta rivalizar con el yang). Si la persona noble parte en campaña, infortunio.";
"hex.10.ci" = "Pisar tras la cola del tigre sin que este muerda. Éxito.";
"hex.10.daxiang" = "Arriba el cielo, abajo el lago: El Porte. Así, la persona noble distingue los rangos superiores e inferiores y da estabilidad al ánimo del pueblo.";
"hex.10.yao.0" = "Actuar con sencillez natural. Avanzar sin culpa.";
"hex.10.yao.1" = "El camino es llano y amplio. Para quien vive retirado y sereno, perseverar en lo recto trae buena fortuna.";
"hex.10.yao.2" = "Quien ve mal cree ver con claridad; quien cojea cree poder ir lejos. Pisa la cola del tigre y recibe una mordedura. Infortunio. Así es el guerrero que pretende ser soberano.";
"hex.10.yao.3" = "Pisar la cola del tigre con temor y cautela. Al final, buena fortuna.";
"hex.10.yao.4" = "Actuar con firme resolución. Aun perseverando en lo recto, hay peligro.";
"hex.10.yao.5" = "Revisar el camino recorrido y examinar sus señales de dicha y desventura. Si todo se cumple cabalmente, gran fortuna.";
"hex.11.ci" = "Lo pequeño se va y lo grande llega (el yin se retira y el yang avanza). Buena fortuna y éxito.";
"hex.11.daxiang" = "El cielo y la tierra se comunican: La Paz. Así, el soberano ordena la actividad humana según sus ciclos y favorece su acción fecunda para ayudar al pueblo.";
"hex.11.yao.0" = "Al arrancar la hierba, sus raíces entrelazadas arrastran otras del mismo grupo. Partir juntos en campaña trae buena fortuna.";
"hex.11.yao.1" = "Acoger lo inculto, atreverse a vadear el río, no olvidar a las personas capaces que viven lejos ni formar facciones por interés. Así se merece estima por seguir el camino del centro.";
"hex.11.yao.2" = "No hay llanura sin pendiente ni partida sin regreso. Perseverar en lo recto entre dificultades: sin culpa. No preocuparse por ganar la confianza ajena; se gozará de sustento y bendiciones.";
"hex.11.yao.3" = "Descender con ligereza. Unirse a los vecinos sin recurrir a la riqueza; tratarse con sinceridad, sin recelo.";
"hex.11.yao.4" = "Di Yi (rey de la dinastía Shang) entrega a su hermana menor en matrimonio. De ello vienen bendiciones y gran fortuna.";
"hex.11.yao.5" = "La muralla se derrumba en el foso. No emplear el ejército; proclamar las órdenes en la propia ciudad. Aun perseverando en lo recto, hay pesar.";
"hex.12.ci" = "La obstrucción contradice el orden humano normal (según otra lectura, la causan las personas mezquinas). No favorece la perseverancia de la persona noble en lo recto. Lo grande se va y lo pequeño llega (el yang se retira y el yin avanza).";
"hex.12.daxiang" = "El cielo y la tierra no se comunican: El Estancamiento. Así, la persona noble oculta su virtud para evitar calamidades y no codicia honores ni cargos remunerados.";
"hex.12.yao.0" = "Al arrancar la hierba, sus raíces entrelazadas arrastran otras del mismo grupo. Junto con los afines, perseverar en lo recto trae buena fortuna y éxito.";
"hex.12.yao.1" = "Acoger y obedecer a los superiores trae buena fortuna a la persona mezquina. La gran persona de virtud alcanza el éxito manteniéndose firme en el estancamiento.";
"hex.12.yao.2" = "Albergar vergüenza.";
"hex.12.yao.3" = "Cumplir el mandato del cielo. Sin culpa. Los afines se unen y comparten las bendiciones.";
"hex.12.yao.4" = "Poner fin al estancamiento. Buena fortuna para la gran persona de virtud. Recordar siempre: «¡Se acerca la ruina, se acerca la ruina!». Así se estará tan firme como atado a un grupo de moreras.";
"hex.12.yao.5" = "Derribar el estancamiento. Primero, obstrucción; después, alegría.";
"hex.13.ci" = "Unirse a los demás en campo abierto. Éxito. Es favorable cruzar el gran río (afrontar riesgos para llevar una empresa a término). Es favorable que la persona noble persevere en lo recto.";
"hex.13.daxiang" = "El cielo y el fuego se unen: Comunidad con los Hombres. Así, la persona noble clasifica los grupos humanos y distingue las cosas, buscando lo común y reconociendo las diferencias.";
"hex.13.yao.0" = "Unirse a otros al salir de casa. Sin culpa.";
"hex.13.yao.1" = "Unirse solo dentro del propio linaje. Pesar.";
"hex.13.yao.2" = "Ocultar tropas en la maleza y subir a una colina para observar. Durante tres años no se atreve a emprender la lucha.";
"hex.13.yao.3" = "Subir a la muralla del adversario, pero finalmente desistir del ataque. Buena fortuna.";
"hex.13.yao.4" = "Unirse a otros: primero, llanto amargo; después, risas. Tras la victoria del gran ejército, pueden reunirse.";
"hex.13.yao.5" = "Unirse a otros en las cercanías de la ciudad. Sin arrepentimiento (aunque la unión aún no abarque el campo abierto).";
"hex.14.ci" = "Gran éxito.";
"hex.14.daxiang" = "El fuego ilumina desde lo alto del cielo: La Posesión de lo Grande. Así, la persona noble frena el mal y promueve el bien, siguiendo el benéfico mandato del cielo.";
"hex.14.yao.0" = "No relacionarse con lo dañino evita la falta. Mantenerse alerta ante las dificultades: sin culpa.";
"hex.14.yao.1" = "Cargar los bienes en un gran carro y emprender el camino. Sin culpa.";
"hex.14.yao.2" = "El señor feudal ofrece tributo al Hijo del Cielo (según otra lectura, participa en su banquete). La persona mezquina no es capaz de ello.";
"hex.14.yao.3" = "No ostentar en exceso la propia grandeza. Sin culpa.";
"hex.14.yao.4" = "Relacionarse con superiores e inferiores con sinceridad y dignidad. Buena fortuna.";
"hex.14.yao.5" = "El cielo brinda su protección. Buena fortuna; todo es favorable.";
"hex.15.ci" = "Éxito. La persona noble lleva las cosas a buen término.";
"hex.15.daxiang" = "Dentro de la tierra hay una montaña: La Modestia. Así, la persona noble reduce lo excesivo y aumenta lo escaso, ponderando las cosas para distribuir con equidad.";
"hex.15.yao.0" = "La persona noble, humilde entre los humildes, puede cruzar el gran río (afrontar riesgos para llevar una empresa a término). Buena fortuna.";
"hex.15.yao.1" = "La fama de la modestia se difunde. Perseverar en lo recto trae buena fortuna.";
"hex.15.yao.2" = "La persona noble tiene méritos y conserva la modestia. Al final, buena fortuna.";
"hex.15.yao.3" = "Todo es favorable. Poner en práctica la modestia (desplegar y cultivar esta virtud).";
"hex.15.yao.4" = "Conseguir el apoyo de los vecinos sin apoyarse en la riqueza. Es favorable emprender una campaña contra los insumisos. Todo es favorable.";
"hex.15.yao.5" = "La fama de la modestia se difunde. Es favorable movilizar el ejército y someter las ciudades y estados (del propio territorio).";
"hex.16.ci" = "Es favorable establecer señores feudales y movilizar el ejército.";
"hex.16.daxiang" = "El trueno brota con fuerza de la tierra: El Entusiasmo. Así, los antiguos reyes creaban música para honrar la virtud y la ofrecían solemnemente al Soberano de lo Alto, asociando a sus antepasados al sacrificio.";
"hex.16.yao.0" = "Alardear de alegría y satisfacción por el favor recibido. Infortunio.";
"hex.16.yao.1" = "Firme como una roca, percibir el momento y actuar antes de que acabe el día. Perseverar en lo recto trae buena fortuna.";
"hex.16.yao.2" = "Mirar hacia arriba y adular para obtener placer trae arrepentimiento. Tardar en comprender también trae arrepentimiento.";
"hex.16.yao.3" = "Por él los demás encuentran bienestar. Grandes logros. No dudar: los amigos se reúnen como el cabello en torno a una horquilla.";
"hex.16.yao.4" = "Perseverar en lo recto, aunque haya enfermedad. Esta se prolonga, pero no llega la muerte.";
"hex.16.yao.5" = "Hundirse en los placeres hasta perder la lucidez. Si se logra cambiar, sin culpa.";
"hex.17.ci" = "Gran éxito. Es favorable perseverar en lo recto. Sin culpa.";
"hex.17.daxiang" = "Dentro del lago hay trueno (que se recoge allí para descansar): El Seguimiento. Así, la persona noble se retira a descansar al caer la tarde.";
"hex.17.yao.0" = "Cambian los asuntos a cargo de uno (según otra lectura, las ideas). Perseverar en lo recto trae buena fortuna. Salir y relacionarse con otros da fruto.";
"hex.17.yao.1" = "Unirse al joven es perder al hombre maduro.";
"hex.17.yao.2" = "Unirse al hombre maduro es perder al joven. Al seguir a otros se obtiene lo buscado. Es favorable permanecer en lo recto.";
"hex.17.yao.3" = "El seguimiento trae muchos logros, pero aun perseverando en lo recto hay infortunio. Con sinceridad, fidelidad al camino recto y comprensión clara, ¿qué falta puede haber?";
"hex.17.yao.4" = "Tratar con sinceridad a las personas buenas y virtuosas. Buena fortuna.";
"hex.17.yao.5" = "Retenerlo y atarlo, sujetarlo firmemente con cuerdas para que siga. El rey ofrece un sacrificio en la montaña occidental (el monte Qi).";
"hex.18.ci" = "Gran éxito. Es favorable cruzar el gran río (afrontar riesgos para llevar una empresa a término). Planear tres días antes del día Jia (día Xin) y revisar tres días después (día Ding).";
"hex.18.daxiang" = "Al pie de la montaña hay viento: El Trabajo en lo Echado a Perder. Así, la persona noble alienta y ayuda al pueblo y cultiva la virtud.";
"hex.18.yao.0" = "Corregir el deterioro dejado por el padre. Con un hijo así, el padre difunto queda sin culpa. Hay peligro; al final, buena fortuna.";
"hex.18.yao.1" = "Corregir el deterioro dejado por la madre. No ser excesivamente rígido ni obstinado (proceder con tacto).";
"hex.18.yao.2" = "Corregir el deterioro dejado por el padre. Hay un poco de arrepentimiento, pero ninguna falta grave.";
"hex.18.yao.3" = "Tolerar y dejar crecer el deterioro dejado por el padre. Continuar así trae pesar.";
"hex.18.yao.4" = "Corregir el deterioro dejado por el padre merece elogio.";
"hex.18.yao.5" = "No servir a reyes ni señores. Mantener elevados los propios propósitos y la conducta.";
"hex.19.ci" = "Gran éxito. Es favorable perseverar en lo recto. Al llegar el octavo mes, habrá infortunio.";
"hex.19.daxiang" = "Sobre el lago hay tierra: El Acercamiento. Así, la persona noble piensa sin cesar en la enseñanza y acoge y protege al pueblo sin límites.";
"hex.19.yao.0" = "Acercarse al pueblo mediante la influencia moral (moviendo su ánimo). Perseverar en lo recto trae buena fortuna.";
"hex.19.yao.1" = "Acercarse al pueblo mediante la influencia moral. Buena fortuna; todo es favorable.";
"hex.19.yao.2" = "Acercarse al pueblo con palabras dulces. Nada es favorable. Reconocer el problema con inquietud y corregirlo: sin culpa.";
"hex.19.yao.3" = "Acercarse al pueblo en persona y con proximidad. Sin culpa.";
"hex.19.yao.4" = "Acercarse al pueblo con sabiduría, como corresponde a un gran soberano. Buena fortuna.";
"hex.19.yao.5" = "Acercarse al pueblo con virtud generosa. Buena fortuna, sin culpa.";
"hex.20.ci" = "En el sacrificio, tras lavarse las manos y verter el vino, aún no se presenta la ofrenda (el momento de mayor recogimiento). Hay sinceridad y una solemnidad que inspira respeto.";
"hex.20.daxiang" = "El viento recorre la tierra: La Contemplación. Así, los antiguos reyes recorrían las regiones, observaban las costumbres del pueblo y establecían la enseñanza.";
"hex.20.yao.0" = "Observar con la mirada limitada de un niño. Para la persona mezquina, sin culpa; para la persona noble, pesar.";
"hex.20.yao.1" = "Mirar por una rendija de la puerta. Es favorable que la mujer persevere en lo recto.";
"hex.20.yao.2" = "Observar los propios actos para decidir si avanzar o retirarse.";
"hex.20.yao.3" = "Contemplar el esplendor del buen gobierno del país. Es favorable ser recibido como huésped por el rey (para entrar a su servicio y asistirlo).";
"hex.20.yao.4" = "Observar los propios actos. La persona noble queda sin culpa.";
"hex.20.yao.5" = "Observar los actos ajenos (según otra lectura, ser observado por otros). La persona noble queda sin culpa.";
"hex.21.ci" = "Éxito. Es favorable aplicar la justicia penal.";
"hex.21.daxiang" = "El trueno y el relámpago se unen: La Mordedura Tajante. Así, los antiguos reyes aclaraban las penas y ponían en orden las leyes.";
"hex.21.yao.0" = "Los pies llevan grilletes que ocultan los dedos. Sin culpa (un castigo leve sirve de seria advertencia).";
"hex.21.yao.1" = "Morder carne blanda hasta hundir en ella la nariz. Sin culpa.";
"hex.21.yao.2" = "Morder carne seca y dura y encontrar veneno. Un poco de pesar, sin culpa.";
"hex.21.yao.3" = "Morder carne seca con hueso y encontrar una punta de flecha de metal (imagen de firmeza y rectitud). Es favorable perseverar en lo recto entre dificultades. Buena fortuna.";
"hex.21.yao.4" = "Morder carne seca y encontrar oro (imagen de equilibrio y firmeza). Perseverar en lo recto para precaverse del peligro. Sin culpa.";
"hex.21.yao.5" = "Llevar una canga sobre los hombros que oculta las orejas. Infortunio.";
"hex.22.ci" = "Éxito. Emprender el camino es ligeramente favorable.";
"hex.22.daxiang" = "Al pie de la montaña hay fuego (cuya luz tiene alcance limitado): La Gracia. Así, la persona noble esclarece los asuntos de gobierno, pero no se atreve a juzgar litigios a la ligera.";
"hex.22.yao.0" = "Adornar los dedos de los pies. Dejar el carro y caminar.";
"hex.22.yao.1" = "Adornar la barba.";
"hex.22.yao.2" = "Adorno espléndido, húmedo y brillante. Perseverar largamente en lo recto trae buena fortuna.";
"hex.22.yao.3" = "Adorno blanco y sencillo. Un caballo blanco corre como si volara. Quien llega no es un bandido, sino un pretendiente.";
"hex.22.yao.4" = "Adornar las colinas y los jardines (honrar a las personas virtuosas que aprecian la sencillez). El haz de seda ofrecido es modesto. Pesar; al final, buena fortuna.";
"hex.22.yao.5" = "La blancura sencilla como adorno. Sin culpa.";
"hex.23.ci" = "No es favorable emprender el camino.";
"hex.23.daxiang" = "La montaña se apoya en la tierra: La Desintegración. Así, quienes están arriba tratan con generosidad a quienes están abajo y afianzan su morada.";
"hex.23.yao.0" = "El lecho se desintegra desde las patas. Destruir lo recto trae infortunio.";
"hex.23.yao.1" = "El lecho se desintegra hasta la unión del armazón con las patas (el bastidor). Destruir lo recto trae infortunio.";
"hex.23.yao.2" = "En medio de la desintegración (en correspondencia únicamente con la línea yang superior). Sin culpa.";
"hex.23.yao.3" = "La desintegración del lecho alcanza ya la piel. Infortunio.";
"hex.23.yao.4" = "Conducir a las fuerzas yin en orden, como peces ensartados. Recibir el favor del rey como las mujeres del palacio. Todo es favorable.";
"hex.23.yao.5" = "El gran fruto queda sin comer. La persona noble recibe un carro (el apoyo del pueblo); la persona mezquina destruye su propia casa.";
"hex.24.ci" = "Éxito. Salir y entrar sin dolencia; llegan amigos, sin culpa. El ir y venir sigue su ciclo: al cabo de siete días llega el retorno. Es favorable emprender el camino.";
"hex.24.daxiang" = "El trueno está dentro de la tierra: El Retorno. Así, los antiguos reyes cerraban los pasos en el solsticio de invierno; mercaderes y viajeros no partían, y el soberano no recorría las regiones.";
"hex.24.yao.0" = "Volver al camino recto antes de alejarse mucho. Sin gran arrepentimiento. Gran fortuna.";
"hex.24.yao.1" = "Volver de buena manera al camino recto. Buena fortuna.";
"hex.24.yao.2" = "Volver repetidamente al camino recto (según otra lectura, con el ceño fruncido por la aflicción). Hay peligro, pero sin culpa.";
"hex.24.yao.3" = "Avanzar entre las fuerzas yin y volver solo al camino recto.";
"hex.24.yao.4" = "Volver al camino recto con un corazón generoso. Sin arrepentimiento.";
"hex.24.yao.5" = "Extraviarse sin saber volver. Infortunio y calamidades. Movilizar el ejército lleva a una gran derrota y alcanza al soberano con el infortunio. Durante diez años no será posible emprender una campaña.";
"hex.25.ci" = "Gran éxito. Es favorable perseverar en lo recto. Apartarse de lo recto trae calamidades; no es favorable emprender el camino.";
"hex.25.daxiang" = "El trueno recorre cuanto está bajo el cielo, y nada se aparta de su naturaleza: La Inocencia. Así, los antiguos reyes se aplicaban a seguir las estaciones y a nutrir a todos los seres.";
"hex.25.yao.0" = "Actuar sin falsedad ni temeridad. Avanzar trae buena fortuna.";
"hex.25.yao.1" = "Cultivar sin anticipar la cosecha; roturar sin anticipar el campo fértil (seguir lo natural, sin expectativas). Así es favorable emprender el camino.";
"hex.25.yao.2" = "Una calamidad inesperada: alguien ata un buey, un transeúnte se lo lleva y los habitantes del lugar sufren las sospechas.";
"hex.25.yao.3" = "Poder perseverar en lo recto. Sin culpa.";
"hex.25.yao.4" = "Una enfermedad que no proviene de una conducta indebida. Sin tomar remedios, sanará y habrá alegría.";
"hex.25.yao.5" = "Aunque no se actúe indebidamente, avanzar trae calamidad (el momento ha llegado a su límite). Nada es favorable.";
"hex.26.ci" = "Es favorable perseverar en lo recto. Alimentarse fuera del hogar (al servicio de la corte) trae buena fortuna. Es favorable cruzar el gran río (afrontar riesgos para llevar una empresa a término).";
"hex.26.daxiang" = "El cielo está contenido en la montaña: La Fuerza Domesticadora de lo Grande. Así, la persona noble aprende muchas palabras y acciones de los sabios antiguos para acrecentar su virtud.";
"hex.26.yao.0" = "Hay peligro. Es favorable detenerse.";
"hex.26.yao.1" = "La caja del carro se desprende del soporte del eje y no puede avanzar.";
"hex.26.yao.2" = "Buenos caballos corren en persecución. Es favorable perseverar en lo recto entre dificultades. Practicar cada día la conducción del carro y la defensa. Es favorable emprender el camino.";
"hex.26.yao.3" = "Atar un travesaño a los cuernos de un ternero para impedir que embista. Gran fortuna.";
"hex.26.yao.4" = "Los colmillos del cerdo castrado: aunque permanecen, ya no hieren. Buena fortuna.";
"hex.26.yao.5" = "¡Qué amplio y abierto es el camino del cielo! Éxito. (Según otra lectura, se recibe o sostiene ese camino.)";
"hex.27.ci" = "Perseverar en lo recto trae buena fortuna. Observar cómo se procura el sustento y de qué manera cada cual busca su alimento.";
"hex.27.daxiang" = "Al pie de la montaña hay trueno: Las Comisuras de la Boca. Así, la persona noble cuida sus palabras y modera la comida y la bebida.";
"hex.27.yao.0" = "Abandonas tu valiosa condición de tortuga espiritual (capaz de sustentarse sin comer) y me miras masticar, lleno de deseo. Infortunio.";
"hex.27.yao.1" = "Buscar sustento abajo, invirtiendo el orden habitual; después, buscarlo en la colina (la línea yang superior). Avanzar trae infortunio.";
"hex.27.yao.2" = "Apartarse del camino recto del sustento. Aun perseverando en lo recto, infortunio. Durante diez años no se podrá actuar. Nada es favorable.";
"hex.27.yao.3" = "Buscar sustento abajo, invirtiendo el orden (para nutrir al mundo). Buena fortuna. Mirar hacia abajo con la atención de un tigre, buscando sin cesar. Sin culpa.";
"hex.27.yao.4" = "Apartarse del orden habitual (depender del sustento de la línea yang superior). Permanecer en lo recto trae buena fortuna. No cruzar el gran río (no afrontar riesgos).";
"hex.27.yao.5" = "De él depende el sustento del mundo. Hay peligro y buena fortuna. Es favorable cruzar el gran río (afrontar riesgos para llevar una empresa a término).";
"hex.28.ci" = "La viga maestra se dobla. Es favorable emprender el camino. Éxito.";
"hex.28.daxiang" = "Las aguas del lago cubren los árboles: La Preponderancia de lo Grande. Así, la persona noble permanece sola sin temor y se retira del mundo sin aflicción.";
"hex.28.yao.0" = "Poner hierba blanca y limpia debajo (de las ofrendas). Sin culpa.";
"hex.28.yao.1" = "El álamo marchito echa brotes nuevos. Un anciano toma una esposa joven. Todo es favorable.";
"hex.28.yao.2" = "La viga maestra se dobla. Infortunio.";
"hex.28.yao.3" = "La viga maestra se alza firme, sin doblarse. Buena fortuna. Si hay otros vínculos, pesar.";
"hex.28.yao.4" = "El álamo marchito florece. Una anciana toma un esposo joven. Sin culpa ni elogio.";
"hex.28.yao.5" = "Vadear aguas demasiado profundas hasta quedar sumergido por completo. Infortunio, pero sin culpa (actuar por justicia no merece reproche).";
"hex.29.ci" = "Peligros uno tras otro. Con sinceridad, si el corazón conserva su apertura, la acción merece estima.";
"hex.29.daxiang" = "El agua llega sin cesar: Lo Abismal, el Agua. Así, la persona noble mantiene constante su virtud y practica reiteradamente las tareas de gobierno y enseñanza.";
"hex.29.yao.0" = "Entre peligros sucesivos, caer en lo más hondo de la fosa. Infortunio.";
"hex.29.yao.1" = "En el abismo aún hay peligro. Buscar solo pequeños logros.";
"hex.29.yao.2" = "Al ir y al venir, peligros. Delante hay riesgo; detrás, ningún apoyo seguro. Caer en lo más hondo de la fosa. No actuar.";
"hex.29.yao.3" = "Una jarra de vino y dos cuencos de arroz, servidos en vasijas de barro. Entregar por la ventana una sencilla prenda de confianza (unirse con sinceridad). Al final, sin culpa.";
"hex.29.yao.4" = "El agua de la fosa no desborda, pero ya alcanza el nivel de la orilla (zhi puede leerse como di, «montículo», o como «solo»). Sin culpa.";
"hex.29.yao.5" = "Atado con cuerdas y recluido entre espinos, sin liberación durante tres años. Infortunio.";
"hex.30.ci" = "Es favorable perseverar en lo recto. Éxito. Criar una vaca (imagen de la virtud dócil) trae buena fortuna.";
"hex.30.daxiang" = "La luz se levanta dos veces seguidas: Lo Adherente, el Fuego. Así, la gran persona de virtud prolonga la claridad e ilumina las cuatro direcciones.";
"hex.30.yao.0" = "Los pasos se cruzan en desorden. Actuar con respeto y cautela: sin culpa.";
"hex.30.yao.1" = "Una luz adherente amarilla (el amarillo es el color del centro). Gran fortuna.";
"hex.30.yao.2" = "La luz del sol declinante. Si no se canta golpeando una vasija de barro (gozando a su tiempo), llegarán los lamentos de la vejez. Infortunio.";
"hex.30.yao.3" = "Llegar de repente, arder como el fuego, morir y ser abandonado.";
"hex.30.yao.4" = "Derramar lágrimas abundantes, afligirse y suspirar. Buena fortuna.";
"hex.30.yao.5" = "El rey lo envía en campaña. Obtiene un mérito digno de elogio: decapita al jefe enemigo y no captura indiscriminadamente a sus seguidores (castiga solo al principal culpable). Sin culpa.";
"hex.31.ci" = "Éxito. Es favorable perseverar en lo recto. Tomar esposa trae buena fortuna. (El influjo es la respuesta mutua, representada por la atracción entre un joven y una joven.)";
"hex.31.daxiang" = "Sobre la montaña hay un lago (la montaña lo acoge en su concavidad): El Influjo. Así, la persona noble acoge a los demás con un ánimo abierto.";
"hex.31.yao.0" = "El influjo alcanza el dedo gordo del pie. (Apenas comienza y es leve; la intención ya se dirige hacia fuera.)";
"hex.31.yao.1" = "El influjo alcanza la pantorrilla. Moverse con precipitación trae infortunio; permanecer quieto, buena fortuna.";
"hex.31.yao.2" = "El influjo alcanza el muslo. Empeñarse en seguir los movimientos de otros. Avanzar así trae pesar.";
"hex.31.yao.3" = "Perseverar en lo recto trae buena fortuna; desaparece el arrepentimiento. Si se va y viene con ánimo indeciso, solo los amigos afines siguen los propios pensamientos. (El influjo es limitado.)";
"hex.31.yao.4" = "El influjo alcanza la carne junto a la columna. Sin arrepentimiento. (No llega al corazón; según otra lectura, es un influjo superficial.)";
"hex.31.yao.5" = "El influjo alcanza las encías, las mejillas y la lengua. (Influir solo mediante palabras.)";
"hex.32.ci" = "Éxito, sin culpa. Es favorable perseverar en lo recto y emprender el camino. (La duración significa constancia.)";
"hex.32.daxiang" = "El trueno y el viento se acompañan: La Duración. Así, la persona noble se mantiene en lo recto y no cambia de rumbo a la ligera.";
"hex.32.yao.0" = "Exigir desde el comienzo una constancia profunda (como cavar hondo). Aun perseverando en lo recto, infortunio. Nada es favorable.";
"hex.32.yao.1" = "Desaparece el arrepentimiento. (La segunda línea, yang en posición yin y central, puede mantenerse en el camino del centro.)";
"hex.32.yao.2" = "No mantener constante la propia virtud lleva a la humillación. Aun perseverando en lo recto, hay pesar.";
"hex.32.yao.3" = "Cazar sin obtener presa. (Permanecer mucho tiempo en un lugar inadecuado es esforzarse en vano.)";
"hex.32.yao.4" = "Mantener constante la virtud (de la docilidad) y perseverar en lo recto: para la mujer, buena fortuna; para el hombre, infortunio.";
"hex.32.yao.5" = "Buscar constancia en medio de la agitación (inquietud incesante). Infortunio.";
"hex.33.ci" = "Retirarse trae éxito. En asuntos pequeños es favorable perseverar en lo recto. (Se trata de apartarse.)";
"hex.33.daxiang" = "Bajo el cielo hay una montaña (por alta que sea, el cielo se mantiene lejos): La Retirada. Así, la persona noble se distancia de las personas mezquinas, sin mostrar odio, pero con firmeza.";
"hex.33.yao.0" = "Quedar al final de la retirada. Hay peligro. No es favorable emprender el camino.";
"hex.33.yao.1" = "Atarlo firmemente con una correa de cuero de buey amarillo; nadie puede soltarse. (Imagen de una voluntad firme; según otra lectura, de retener a una persona virtuosa.)";
"hex.33.yao.2" = "Los apegos impiden retirarse: es como una enfermedad, y hay peligro. Mantener servidores y concubinas trae buena fortuna.";
"hex.33.yao.3" = "Retirarse con resolución a pesar de los afectos. Para la persona noble, buena fortuna; la persona mezquina no es capaz de hacerlo.";
"hex.33.yao.4" = "Retirarse de buena manera y en el momento oportuno. Perseverar en lo recto trae buena fortuna.";
"hex.33.yao.5" = "Retirarse con holgura y serenidad (según otra lectura, volar alto y retirarse lejos). Todo es favorable.";
"hex.34.ci" = "Es favorable perseverar en lo recto. (El poder de lo grande es el vigor creciente del yang.)";
"hex.34.daxiang" = "El trueno está sobre el cielo (con gran poder sonoro): El Poder de lo Grande. Así, la persona noble no hace nada contrario a los ritos.";
"hex.34.yao.0" = "El poder se manifiesta en los dedos del pie (prisa por avanzar). Partir en campaña trae infortunio; es seguro. (Aquí, fu indica certeza.)";
"hex.34.yao.1" = "Perseverar en lo recto trae buena fortuna.";
"hex.34.yao.2" = "La persona mezquina se vale de la fuerza; la persona noble se abstiene (según otra lectura, emplea una red). Aun perseverando en lo recto, hay peligro. El carnero embiste la cerca y sus cuernos quedan enredados.";
"hex.34.yao.3" = "Perseverar en lo recto trae buena fortuna; desaparece el arrepentimiento. La cerca se abre y los cuernos quedan libres. El poder está en el soporte del eje del gran carro (la unión con la caja, firme para avanzar con carga).";
"hex.34.yao.4" = "Perder sin advertirlo una oveja en terreno llano. Sin arrepentimiento. (Según otra lectura, en el lindero de un campo.)";
"hex.34.yao.5" = "El carnero embiste la cerca. No puede retroceder ni avanzar. Nada es favorable. Reconocer la dificultad y perseverar en lo recto trae buena fortuna.";
"hex.35.ci" = "El señor Kang (señor que pacifica el país; según otra lectura, Kang Shu, hermano del rey Wu de Zhou) recibe numerosos caballos y carros del rey y es recibido tres veces en un día. (Se trata del ascenso.)";
"hex.35.daxiang" = "La luz se eleva sobre la tierra: El Progreso. Así, la persona noble hace resplandecer su propia virtud luminosa.";
"hex.35.yao.0" = "Querer avanzar y encontrar rechazo. Perseverar en lo recto trae buena fortuna. Aún no se obtiene confianza; mantener la serenidad y la amplitud: sin culpa.";
"hex.35.yao.1" = "Querer avanzar con el corazón afligido. Perseverar en lo recto trae buena fortuna. La abuela concede una gran bendición (representa la dignidad de la quinta línea yin).";
"hex.35.yao.2" = "Todos confían y dan su aprobación. Desaparece el arrepentimiento.";
"hex.35.yao.3" = "Ascender como una gran rata (codiciosa y temerosa). Aun perseverando en lo recto, hay peligro.";
"hex.35.yao.4" = "Desaparece el arrepentimiento. No preocuparse por ganancias ni pérdidas. Avanzar trae buena fortuna; todo es favorable.";
"hex.35.yao.5" = "Ascender hasta la punta del cuerno (el extremo). Solo conviene atacar la propia ciudad (sofocar un conflicto interno). Hay peligro, pero buena fortuna y ninguna falta. Aun perseverando en lo recto, hay pesar.";
"hex.36.ci" = "Es favorable perseverar en lo recto entre dificultades. (La luz está herida.)";
"hex.36.daxiang" = "La luz se hunde en la tierra: El Oscurecimiento de la Luz. Así, la persona noble gobierna mostrando oscuridad por fuera y conservando lucidez por dentro.";
"hex.36.yao.0" = "Volar cuando la luz está herida, con las alas caídas. La persona noble parte con tanta urgencia que pasa tres días sin comer. Al llegar a su destino, el anfitrión la reprende.";
"hex.36.yao.1" = "La luz está herida; la herida alcanza el muslo izquierdo. Un caballo fuerte presta auxilio. Buena fortuna.";
"hex.36.yao.2" = "Cuando la luz está herida, emprender una campaña al sur y capturar al principal culpable. No apresurarse a corregir los males arraigados; avanzar gradualmente.";
"hex.36.yao.3" = "Entrar en el lado izquierdo del vientre (penetrar en el interior), descubrir la causa de la luz herida y salir por la puerta del patio (marcharse).";
"hex.36.yao.4" = "Como Jizi (tío del rey Zhou de Shang, que fingió locura para eludir la desgracia) en tiempos de luz herida. Es favorable perseverar en lo recto.";
"hex.36.yao.5" = "Sin luz, solo oscuridad. Primero ascender al cielo; después caer bajo tierra.";
"hex.37.ci" = "Es favorable que la mujer persevere en lo recto. (Se trata del gobierno del hogar.)";
"hex.37.daxiang" = "El viento nace del fuego (de dentro hacia fuera): El Clan. Así, la persona noble da fundamento a sus palabras y constancia a sus actos.";
"hex.37.yao.0" = "Establecer normas y resguardos en el hogar desde el comienzo (prevenir las faltas). Desaparece el arrepentimiento.";
"hex.37.yao.1" = "No decidir por cuenta propia; encargarse de la alimentación del hogar. Perseverar en lo recto trae buena fortuna.";
"hex.37.yao.2" = "Gobernar el hogar con severidad hasta provocar quejas (voces de rigor). Aunque haya arrepentimiento y peligro, buena fortuna. Si mujeres y niños ríen sin medida, al final hay pesar.";
"hex.37.yao.3" = "Hacer próspero el hogar. Gran fortuna.";
"hex.37.yao.4" = "El rey transforma a su familia mediante la virtud (la alcanza y la conmueve). No preocuparse. Buena fortuna.";
"hex.37.yao.5" = "Sinceridad acompañada de dignidad. Al final, buena fortuna.";
"hex.38.ci" = "Buena fortuna en asuntos pequeños. (Se trata de la divergencia y la oposición.)";
"hex.38.daxiang" = "Arriba el fuego, abajo el lago (de tendencias opuestas): El Antagonismo. Así, la persona noble busca lo común y conserva las diferencias.";
"hex.38.yao.0" = "Desaparece el arrepentimiento. No perseguir al caballo extraviado: volverá por sí mismo. Encontrarse con una persona malvada (sin rehusar el encuentro). Sin culpa.";
"hex.38.yao.1" = "Encontrar al señor en un callejón. Sin culpa.";
"hex.38.yao.2" = "Ver el carro retenido, el buey que lo tira frenado y al conductor castigado con la frente tatuada y la nariz cortada. El comienzo es adverso, pero el final es bueno.";
"hex.38.yao.3" = "Separado y solo, encontrar a un hombre de firmeza yang (la primera línea yang). Unirse con sinceridad. Hay peligro, pero sin culpa.";
"hex.38.yao.4" = "Desaparece el arrepentimiento. Unirse al pariente (la segunda línea yang) es tan fácil como morder carne tierna. ¿Qué falta puede haber en avanzar?";
"hex.38.yao.5" = "Separado y solo, creer ver un cerdo cubierto de barro y un carro lleno de espectros (visiones nacidas de la sospecha). Primero tensar el arco; después, bajarlo. No son bandidos, sino pretendientes. Avanzar y encontrar lluvia (armonía entre yin y yang) trae buena fortuna.";
"hex.39.ci" = "Es favorable ir al sudoeste (terreno llano), pero no al nordeste (terreno peligroso). Es favorable ver a una gran persona de virtud. Perseverar en lo recto trae buena fortuna. (Se trata de la dificultad para caminar.)";
"hex.39.daxiang" = "Sobre la montaña hay agua (peligros sucesivos): El Impedimento. Así, la persona noble se examina y cultiva su virtud.";
"hex.39.yao.0" = "Avanzar encuentra dificultades; regresar merece elogio.";
"hex.39.yao.1" = "El servidor del rey atraviesa dificultad tras dificultad (para prestar auxilio), sin buscar su propio beneficio.";
"hex.39.yao.2" = "Avanzar encuentra dificultades; regresar (para reunirse con las dos líneas yin inferiores).";
"hex.39.yao.3" = "Avanzar encuentra dificultades; regresar y unirse a los demás.";
"hex.39.yao.4" = "En medio de grandes dificultades, los amigos acuden en ayuda.";
"hex.39.yao.5" = "Avanzar encuentra dificultades; regresar permite grandes logros. Buena fortuna. Es favorable ver a una gran persona de virtud.";
"hex.40.ci" = "Es favorable ir al sudoeste. Si no hay nada por resolver, volver al lugar de origen trae buena fortuna. Si hay algo que emprender, actuar pronto trae buena fortuna. (Se trata de librarse del peligro.)";
"hex.40.daxiang" = "Se levantan el trueno y la lluvia: La Liberación. Así, la persona noble perdona las faltas y trata los delitos con clemencia.";
"hex.40.yao.0" = "Sin culpa.";
"hex.40.yao.1" = "En la caza se capturan tres zorros y se obtiene una flecha amarilla. Perseverar en lo recto trae buena fortuna. (Los zorros representan a las personas mezquinas; la flecha amarilla, el equilibrio y la rectitud.)";
"hex.40.yao.2" = "Llevar una carga a la espalda y viajar en un carro (una persona mezquina usurpa un cargo elevado) atrae a los bandidos. Aun perseverando en lo recto, hay pesar.";
"hex.40.yao.3" = "Liberar el dedo gordo del pie (desprenderse de las personas mezquinas que se aferran). Los amigos llegan y se tratan con sinceridad.";
"hex.40.yao.4" = "La persona noble logra librarse del peligro. Buena fortuna. Lo confirma la retirada de las personas mezquinas. (Aquí se trata de una verificación; según otra lectura, de ganarse su confianza.)";
"hex.40.yao.5" = "El príncipe dispara a un halcón en lo alto de la muralla y lo alcanza. Todo es favorable.";
"hex.41.ci" = "Con sinceridad, gran fortuna y ninguna falta. Se puede perseverar en lo recto; es favorable emprender el camino. ¿Qué ofrecer en el sacrificio? Bastan dos cuencos rituales de alimento sencillo (recipientes para mijo). (La merma significa disminución.)";
"hex.41.daxiang" = "Al pie de la montaña hay un lago (que mengua para aumentar la altura de la montaña): La Merma. Así, la persona noble refrena la ira y contiene los deseos.";
"hex.41.yao.0" = "Terminar los propios asuntos y acudir pronto (a ayudar a otros). Sin culpa. Ponderar cuánto se puede ceder de lo propio.";
"hex.41.yao.1" = "Es favorable perseverar en lo recto. Partir en campaña trae infortunio. Se puede beneficiar a otros sin menguar uno mismo.";
"hex.41.yao.2" = "Si tres caminan juntos, se pierde uno. Si uno camina solo, encuentra un amigo.";
"hex.41.yao.3" = "Reducir los propios males; una pronta mejoría trae alegría. Sin culpa.";
"hex.41.yao.4" = "Alguien le aporta un beneficio que ni una tortuga valiosa, de diez peng (antigua unidad monetaria), puede contradecir (los augurios son favorables). Gran fortuna.";
"hex.41.yao.5" = "Beneficiar a otros sin menguar uno mismo. Sin culpa. Perseverar en lo recto trae buena fortuna; es favorable emprender el camino. Se ganan servidores de todo el mundo (no de una sola casa).";
"hex.42.ci" = "Es favorable emprender el camino y cruzar el gran río (afrontar riesgos para llevar una empresa a término). (El aumento significa acrecentamiento.)";
"hex.42.daxiang" = "El viento y el trueno se ayudan: El Aumento. Así, la persona noble sigue el bien que ve y corrige sus propias faltas.";
"hex.42.yao.0" = "Es favorable emprender grandes obras. Gran fortuna, sin culpa.";
"hex.42.yao.1" = "Alguien le aporta un beneficio que ni una tortuga valiosa, de diez peng, puede contradecir. Perseverar largamente en lo recto trae buena fortuna. El rey lo emplea para ofrecer un sacrificio al Soberano del Cielo. Buena fortuna.";
"hex.42.yao.2" = "Dedicar los beneficios a socorrer en las calamidades. Sin culpa. Con sinceridad y conducta equilibrada y recta, informar al príncipe llevando una tablilla de jade.";
"hex.42.yao.3" = "Actuar con equilibrio y rectitud. Informar al príncipe y obtener su aprobación. Es favorable apoyarse en los superiores para trasladar la capital.";
"hex.42.yao.4" = "Con un corazón sincero y benévolo, no hace falta preguntar: gran fortuna. Todos reconocen sinceramente mis beneficios.";
"hex.42.yao.5" = "Nadie le aporta beneficio; alguien incluso lo ataca. Su propósito carece de constancia. Infortunio.";
"hex.43.ci" = "Proclamar públicamente en la corte real (las faltas de las personas mezquinas). Convocar a todos con sinceridad; aún hay peligro y se requiere vigilancia. Advertir primero a la propia ciudad. No es favorable recurrir de inmediato a las armas; es favorable emprender el camino. (Se trata de decidir y eliminar.)";
"hex.43.daxiang" = "El agua del lago asciende al cielo (para descender como lluvia): El Desbordamiento. Así, la persona noble distribuye beneficios al pueblo; acumularlos sin compartirlos suscita rechazo.";
"hex.43.yao.0" = "El poder se manifiesta en los dedos del pie que avanza. Avanzar sin poder vencer constituye una falta.";
"hex.43.yao.1" = "Dar la alarma con vigilancia. Aunque un enemigo ataque de noche, no hay por qué preocuparse.";
"hex.43.yao.2" = "El poder se manifiesta en los pómulos (la ira se muestra en el rostro). Hay infortunio. La persona noble avanza resueltamente, sola; encuentra lluvia, se moja y provoca enojo. Al final, sin culpa.";
"hex.43.yao.3" = "Las nalgas carecen de piel; caminar es penoso (vacilar sin avanzar). Conducir la oveja (seguir al rebaño) haría desaparecer el arrepentimiento, pero se oyen estas palabras sin creerlas.";
"hex.43.yao.4" = "Eliminar con resolución, como al arrancar xianlu (una hierba tierna y quebradiza que crece fácilmente). Seguir el camino del centro: sin culpa.";
"hex.43.yao.5" = "Ya no vale gritar (nadie acudirá en ayuda). Al final, infortunio.";
"hex.44.ci" = "La mujer es demasiado poderosa. No conviene tomar por esposa a una mujer así. (Se trata del encuentro.)";
"hex.44.daxiang" = "Bajo el cielo hay viento (que alcanza todas las cosas): Ir al Encuentro. Así, el soberano promulga mandatos y los anuncia en las cuatro direcciones.";
"hex.44.yao.0" = "Atado a un sólido freno metálico de carro. Perseverar en lo recto trae buena fortuna; avanzar trae infortunio. La cerda flaca ciertamente se agita sin descanso (imagen del yin recién surgido e inquieto).";
"hex.44.yao.1" = "Hay un pez en el envoltorio (según otra lectura, en la cocina). Sin culpa, pero no es favorable ofrecerlo a los huéspedes.";
"hex.44.yao.2" = "Las nalgas carecen de piel; caminar es penoso. Hay peligro, pero ninguna falta grave.";
"hex.44.yao.3" = "No hay pez en el envoltorio. Emprender la acción trae infortunio.";
"hex.44.yao.4" = "Envolver un melón con ramas y hojas del árbol qi (lo alto protege a lo bajo). Guardar la virtud en el interior; las bendiciones descienden del cielo.";
"hex.44.yao.5" = "Encontrarse en la punta del cuerno (el extremo). Pesar, pero sin culpa.";
"hex.45.ci" = "Éxito. El rey acude al templo ancestral para el sacrificio. Es favorable ver a una gran persona de virtud. Éxito; es favorable perseverar en lo recto. Sacrificar un animal grande trae buena fortuna. Es favorable emprender el camino. (Se trata de congregarse.)";
"hex.45.daxiang" = "El agua del lago se reúne sobre la tierra: La Reunión. Así, la persona noble pone en orden las armas y se prepara para lo imprevisto.";
"hex.45.yao.0" = "Hay sinceridad, pero no perdura; de ahí la confusión y una reunión desordenada. Si se pide ayuda a gritos, un apretón de manos transforma las lágrimas en risa. No preocuparse. Avanzar sin culpa.";
"hex.45.yao.1" = "Dejarse atraer a la reunión trae buena fortuna. Sin culpa. Con sinceridad, incluso el sencillo sacrificio yue (sacrificio de verano) es favorable.";
"hex.45.yao.2" = "Querer reunirse y suspirar sin cesar. Nada es favorable. Avanzar sin culpa, aunque con un poco de pesar.";
"hex.45.yao.3" = "Solo con gran fortuna se queda sin culpa.";
"hex.45.yao.4" = "Ocupar un puesto honorable en la reunión. Sin culpa. Si aún falta confianza, mantener la gran bondad y perseverar largamente en lo recto. Desaparece el arrepentimiento.";
"hex.45.yao.5" = "Suspirar y llorar (lágrimas y secreción nasal). Sin culpa.";
"hex.46.ci" = "Gran éxito. Conviene ver a una gran persona de virtud. No preocuparse. Partir en campaña hacia el sur trae buena fortuna. (Se trata de ascender.)";
"hex.46.daxiang" = "La madera crece dentro de la tierra: La Subida. Así, la persona noble sigue la virtud y acumula pequeños actos buenos para alcanzar lo elevado y grande.";
"hex.46.yao.0" = "Ascender gracias a la confianza recibida. Gran fortuna. (Según otra lectura, avanzar en el ascenso.)";
"hex.46.yao.1" = "Con sinceridad, incluso el sencillo sacrificio yue es favorable. Sin culpa.";
"hex.46.yao.2" = "Ascender y entrar en una ciudad vacía (sin obstáculos).";
"hex.46.yao.3" = "El rey ofrece un sacrificio en el monte Qi (donde surgió el pueblo Zhou). Buena fortuna, sin culpa.";
"hex.46.yao.4" = "Perseverar en lo recto trae buena fortuna. Ascender por los escalones.";
"hex.46.yao.5" = "Seguir ascendiendo a ciegas. Es favorable aplicar esa constancia a perseverar sin descanso en lo recto.";
"hex.47.ci" = "Éxito y perseverancia en lo recto. Para la gran persona de virtud, buena fortuna y ninguna falta. Se habla, pero no se obtiene crédito. (Se trata de la estrechez y la aflicción.)";
"hex.47.daxiang" = "El lago no tiene agua: La Desazón. Así, la persona noble entrega la vida para cumplir su propósito.";
"hex.47.yao.0" = "Las nalgas quedan oprimidas contra un tocón. Entrar en un valle oscuro y profundo; durante tres años no ver a nadie.";
"hex.47.yao.1" = "Oprimido entre vino y comida (según otra lectura, por su escasez). Se acerca quien lleva un delantal ceremonial rojo (una persona de alto rango). Es favorable ofrecer sacrificios. Partir en campaña trae infortunio. Sin culpa.";
"hex.47.yao.2" = "Oprimido por una roca y apoyado sobre abrojos. Volver a casa y no encontrar a la esposa. Infortunio.";
"hex.47.yao.3" = "Llegar lentamente, retenido por un carro adornado de metal (la segunda línea yang). Pesar, pero al final hay resultado.";
"hex.47.yao.4" = "Sufrir el corte de la nariz y los pies (opresión por arriba y por abajo), acosado por quienes llevan delantales ceremoniales rojos. Poco a poco llega la liberación. Es favorable ofrecer sacrificios.";
"hex.47.yao.5" = "Atrapado entre enredaderas, en un lugar inestable. Decirse al examinarse: «Si me muevo, me arrepentiré». Si hay verdadero arrepentimiento, partir en campaña trae buena fortuna.";
"hex.48.ci" = "La ciudad puede trasladarse; el pozo permanece. Sacar agua no lo mengua, ni dejar de sacarla lo aumenta. Quienes van y vienen se abastecen de él. La vasija casi llega al brocal, pero antes de salir choca y se rompe. Infortunio.";
"hex.48.daxiang" = "El cubo de madera se sumerge y eleva el agua: El Pozo de Agua. Así, la persona noble reconforta al pueblo y lo anima a ayudarse mutuamente.";
"hex.48.yao.0" = "El fondo del pozo está lleno de barro; su agua no se puede beber. Al viejo pozo abandonado ni los pájaros acuden.";
"hex.48.yao.1" = "En la hondonada del pozo solo se pueden capturar pececillos (según otra lectura, sapos). La vasija de sacar agua está rota y pierde: el pozo no cumple su función.";
"hex.48.yao.2" = "El pozo está limpio, pero nadie bebe de él; esto aflige mi corazón. Su agua puede sacarse. Si el rey es esclarecido, todos compartirán sus bendiciones.";
"hex.48.yao.3" = "Revestir las paredes del pozo con ladrillo y piedra. Sin culpa.";
"hex.48.yao.4" = "El agua del pozo es clara; el manantial fresco se puede beber.";
"hex.48.yao.5" = "Ya se extrae el agua. No tapar la boca del pozo (para que todos puedan servirse). Con sinceridad, gran fortuna.";
"hex.49.ci" = "Solo al llegar el día Ji (según otra lectura, el día en que se completa el cambio) se obtiene confianza. Gran éxito; es favorable perseverar en lo recto. Desaparece el arrepentimiento.";
"hex.49.daxiang" = "Dentro del lago hay fuego: La Revolución. Así, la persona noble ajusta el calendario y precisa las estaciones.";
"hex.49.yao.0" = "Atar firmemente con cuero de buey amarillo (mantener el equilibrio y la docilidad, sin actuar temerariamente).";
"hex.49.yao.1" = "Solo al llegar el día Ji se emprende el cambio. Avanzar trae buena fortuna. Sin culpa.";
"hex.49.yao.2" = "Avanzar con prisa trae infortunio; aferrarse a lo establecido también trae peligro. Cuando las propuestas de cambio se han debatido repetidamente y alcanzan una conclusión, se obtiene confianza.";
"hex.49.yao.3" = "Desaparece el arrepentimiento. Cambiar el mandato con sinceridad (reformar el antiguo orden) trae buena fortuna.";
"hex.49.yao.4" = "La gran persona de virtud transforma las cosas como el tigre que renueva su pelaje: sus dibujos resplandecen. Antes de consultar el oráculo, ya inspira confianza.";
"hex.49.yao.5" = "La persona noble cambia como el leopardo que renueva su pelaje. La persona mezquina cambia de semblante y acata el nuevo gobierno. Seguir avanzando precipitadamente trae infortunio; permanecer en lo recto, buena fortuna.";
"hex.50.ci" = "Gran fortuna y éxito.";
"hex.50.daxiang" = "Sobre la madera arde el fuego: El Caldero. Así, la persona noble ocupa rectamente su puesto y mantiene firme su misión.";
"hex.50.yao.0" = "Volcar el caldero con las patas hacia arriba permite sacar la suciedad acumulada. Como al tomar una concubina y obtener descendencia. Sin culpa.";
"hex.50.yao.1" = "El caldero está lleno de alimento. Mi pareja (según otra lectura, mi enemigo) está enferma y no puede acercarse a mí. Buena fortuna.";
"hex.50.yao.2" = "Las asas del caldero se deforman y se desprenden; no se puede mover ni comer el sabroso caldo de faisán. Cuando el yin y el yang se armonizan y llega la lluvia, disminuye el arrepentimiento. Al final, buena fortuna.";
"hex.50.yao.3" = "Se rompe una pata del caldero y se derrama la comida del príncipe. El caldero queda húmedo y sucio (según otra lectura, se sufre un castigo grave). Infortunio.";
"hex.50.yao.4" = "El caldero tiene asas amarillas y una barra de metal para levantarlo. Es favorable perseverar en lo recto.";
"hex.50.yao.5" = "El caldero tiene una barra de jade para levantarlo. Gran fortuna; todo es favorable.";
"hex.51.ci" = "Éxito. El trueno llega y hace mirar alrededor con temor; después se puede hablar y reír con calma. Estremece una extensión de cien li, pero el oficiante no deja caer el cucharón ni el vino aromático (utensilio y bebida del sacrificio).";
"hex.51.daxiang" = "El trueno llega una y otra vez: Lo Suscitativo, el Trueno. Así, la persona noble, con temor, se cultiva y se examina.";
"hex.51.yao.0" = "El trueno llega y causa temor; después se puede hablar y reír con calma. Buena fortuna.";
"hex.51.yao.1" = "El trueno llega con violencia y peligro. Se prevé perder las conchas (antigua moneda) y se busca refugio en altas colinas. No perseguir lo perdido: se recuperará en siete días.";
"hex.51.yao.2" = "El trueno turba el ánimo. Actuar movido por la vigilancia y el temor evita la calamidad.";
"hex.51.yao.3" = "El trueno sacude, pero se queda atrapado en el barro (sin poder recobrar el ánimo).";
"hex.51.yao.4" = "El trueno va y viene; hay peligro. Se prevé, sin embargo, que no habrá pérdidas y que se podrá conservar la tarea encomendada (según otra lectura, el sacrificio).";
"hex.51.yao.5" = "El trueno hace temblar y mirar con espanto. Avanzar trae infortunio. Estar alerta cuando aún alcanza al vecino y no al propio cuerpo: sin culpa. Habrá murmuraciones sobre el matrimonio.";
"hex.52.ci" = "Aquietar la espalda (sin dejarse arrastrar por lo que está ante los ojos), olvidando el propio cuerpo. Caminar por el patio sin verse unos a otros. Sin culpa.";
"hex.52.daxiang" = "Dos montañas se superponen: El Aquietamiento, la Montaña. Así, la persona noble no lleva sus pensamientos más allá de las responsabilidades de su puesto.";
"hex.52.yao.0" = "Aquietar los dedos de los pies. Sin culpa. Es favorable perseverar largamente en lo recto.";
"hex.52.yao.1" = "Aquietar las pantorrillas sin poder salvar a quien se sigue (ni detener sus actos temerarios). El corazón está descontento.";
"hex.52.yao.2" = "Aquietar la cintura y dejar rígida la espalda, como si se partiera. El peligro abrasa el corazón como humo y fuego.";
"hex.52.yao.3" = "Aquietar el torso. Sin culpa.";
"hex.52.yao.4" = "Aquietar las mejillas y hablar con orden. Desaparece el arrepentimiento.";
"hex.52.yao.5" = "Aquietarse con virtud sólida y generosa. Buena fortuna.";
"hex.53.ci" = "La joven se casa siguiendo gradualmente los ritos. Buena fortuna. Es favorable perseverar en lo recto.";
"hex.53.daxiang" = "Sobre la montaña crecen árboles: La Evolución. Así, la persona noble acumula virtud y mejora las costumbres.";
"hex.53.yao.0" = "El ganso silvestre avanza poco a poco hasta la orilla. El joven está en peligro y recibe reproches. Sin culpa.";
"hex.53.yao.1" = "El ganso silvestre avanza poco a poco hasta la gran roca. Comer y beber con serenidad y alegría. Buena fortuna.";
"hex.53.yao.2" = "El ganso silvestre avanza poco a poco hasta la meseta. El esposo parte en campaña y no vuelve; la esposa queda embarazada, pero no da a luz. Infortunio. Es favorable resistir a los invasores.";
"hex.53.yao.3" = "El ganso silvestre avanza poco a poco hasta el árbol; quizá encuentre una rama horizontal donde posarse. Sin culpa.";
"hex.53.yao.4" = "El ganso silvestre avanza poco a poco hasta la colina. La esposa no concibe durante tres años, pero al final nada puede vencer lo recto. Buena fortuna.";
"hex.53.yao.5" = "El ganso silvestre avanza poco a poco hasta las alturas (según otra lectura, el camino de las nubes). Sus plumas pueden usarse como adorno ceremonial. Buena fortuna.";
"hex.54.ci" = "La joven se casa sin ajustarse a los ritos. Avanzar trae infortunio. Nada es favorable.";
"hex.54.daxiang" = "Sobre el lago hay trueno: La Muchacha que se Casa. Así, la persona noble procura un buen final duradero y prevé los males que puedan surgir.";
"hex.54.yao.0" = "La joven se casa como hermana menor que acompaña a la novia. Como quien cojea, pero puede caminar. Avanzar trae buena fortuna.";
"hex.54.yao.1" = "Como quien tiene un solo ojo, pero puede ver. Es favorable que quien vive retirado persevere en lo recto.";
"hex.54.yao.2" = "La joven espera casarse confiando en su rango (según otra lectura, se alude a una hermana mayor o una concubina de bajo rango); al final se casa como hermana menor acompañante.";
"hex.54.yao.3" = "La joven deja pasar la fecha de boda. Retrasa el matrimonio a la espera del momento oportuno.";
"hex.54.yao.4" = "Di Yi (rey de la dinastía Shang) entrega a su hermana menor en matrimonio. El vestido de la esposa principal es menos espléndido que el de su acompañante. La luna está casi llena (sin llegar a la plenitud). Buena fortuna.";
"hex.54.yao.5" = "La mujer sostiene una cesta de bambú vacía. El hombre degüella una oveja, pero no sale sangre (el sacrificio no se cumple). Nada es favorable.";
"hex.55.ci" = "Éxito. El rey alcanza esta plenitud. No preocuparse. Conviene iluminar el mundo como el sol del mediodía.";
"hex.55.daxiang" = "El trueno y el relámpago llegan juntos: La Plenitud. Así, la persona noble juzga los casos y ejecuta las penas.";
"hex.55.yao.0" = "Encontrar a un señor afín. Aunque ambos sean iguales, sin culpa. Avanzar merece estima.";
"hex.55.yao.1" = "La estera que cubre es tan grande que al mediodía se ve la Osa Mayor. Avanzar suscita sospecha y rechazo. Conmover al otro con sinceridad trae buena fortuna.";
"hex.55.yao.2" = "La cortina que cubre es tan grande que al mediodía se ven estrellas pequeñas. Se rompe el brazo derecho. Sin culpa.";
"hex.55.yao.3" = "La estera que cubre es tan grande que al mediodía se ve la Osa Mayor. Encontrar a un señor de la misma virtud. Buena fortuna.";
"hex.55.yao.4" = "Atraer a personas de talento trae celebración y elogio. Buena fortuna.";
"hex.55.yao.5" = "Una casa grande, pero cerrada y oscurecida. Mirar por la puerta: silencio y nadie dentro. Durante tres años no se ve a nadie. Infortunio.";
"hex.56.ci" = "Un poco de éxito. Perseverar en lo recto durante el viaje trae buena fortuna.";
"hex.56.daxiang" = "Sobre la montaña hay fuego: El Andariego. Así, la persona noble aplica las penas con discernimiento y cautela, sin prolongar los procesos judiciales.";
"hex.56.yao.0" = "En tierra ajena, comportarse con mezquindad y bajeza atrae la propia calamidad.";
"hex.56.yao.1" = "En el viaje, encontrar una posada, llevar recursos consigo y obtener un joven servidor fiel.";
"hex.56.yao.2" = "En el viaje, arde la posada y se pierde al joven servidor. Permanecer en esa situación es peligroso.";
"hex.56.yao.3" = "En el viaje, hallar un refugio temporal y obtener dinero y un hacha (según otra lectura, recursos para el viaje). Pero mi corazón no está contento.";
"hex.56.yao.4" = "Disparar a un faisán y perder una flecha. Al final se obtienen elogios y un nombramiento honorífico.";
"hex.56.yao.5" = "El nido del pájaro arde. El viajero primero ríe y después llora amargamente. Pierde el buey en la frontera (según otras lecturas, en el estado de Youyi o por descuido). Infortunio.";
"hex.57.ci" = "Un poco de éxito. Es favorable emprender el camino y ver a una gran persona de virtud y alto rango.";
"hex.57.daxiang" = "El viento sopla una y otra vez: Lo Suave, el Viento. Así, la persona noble aclara los mandatos y lleva a cabo los asuntos de gobierno.";
"hex.57.yao.0" = "Vacilar entre avanzar y retroceder. Es favorable perseverar en lo recto con la resolución de un guerrero.";
"hex.57.yao.1" = "Postrarse humildemente bajo el lecho. Recurrir repetidamente a oficiantes y chamanes para expresar sinceridad ante los espíritus. Buena fortuna, sin culpa.";
"hex.57.yao.2" = "Mostrar una y otra vez una sumisión forzada. Pesar.";
"hex.57.yao.3" = "Desaparece el arrepentimiento. La caza proporciona presas diversas (para sacrificios, huéspedes y cocina).";
"hex.57.yao.4" = "Perseverar en lo recto trae buena fortuna; desaparece el arrepentimiento. Todo es favorable. El comienzo es adverso, pero el final es bueno. Promulgar órdenes tres días antes del día Geng y revisar sus efectos tres días después. Buena fortuna.";
"hex.57.yao.5" = "Postrarse bajo el lecho con humildad excesiva. Perder dinero y hacha (los medios y la capacidad de decidir). Persistir así trae infortunio.";
"hex.58.ci" = "Éxito. Es favorable perseverar en lo recto.";
"hex.58.daxiang" = "Dos lagos se unen: Lo Sereno, el Lago. Así, la persona noble conversa y estudia con sus amigos.";
"hex.58.yao.0" = "Alegrar a otros con una actitud armoniosa. Buena fortuna.";
"hex.58.yao.1" = "Alegrar a otros con sinceridad. Buena fortuna; desaparece el arrepentimiento.";
"hex.58.yao.2" = "Acudir en busca de agrado (con adulación). Infortunio.";
"hex.58.yao.3" = "Debatirse sin sosiego sobre a quién complacer. Apartar la influencia nociva del mal trae alegría.";
"hex.58.yao.4" = "Confiar en las personas mezquinas que erosionan la firmeza yang. Hay peligro.";
"hex.58.yao.5" = "Atraer a otros a la búsqueda del placer.";
"hex.59.ci" = "Éxito. El rey acude al templo ancestral para el sacrificio (reunir los corazones dispersos). Es favorable cruzar el gran río y perseverar en lo recto.";
"hex.59.daxiang" = "El viento recorre el agua: La Disolución. Así, los antiguos reyes ofrecían sacrificios al Soberano de lo Alto y erigían templos ancestrales (para unir los corazones).";
"hex.59.yao.0" = "Un caballo fuerte presta auxilio. Buena fortuna.";
"hex.59.yao.1" = "En la dispersión, correr hacia una mesa en la que apoyarse (encontrar sostén). Desaparece el arrepentimiento.";
"hex.59.yao.2" = "Disolver el propio egoísmo. Sin arrepentimiento.";
"hex.59.yao.3" = "Disolver las facciones privadas. Gran fortuna. De la dispersión surge una reunión tan grande como una colina, algo que la gente común no imagina.";
"hex.59.yao.4" = "En la dispersión, promulgar grandes órdenes como el sudor que se expande; distribuir las reservas del rey (según otra lectura, el rey ocupa su puesto recto y reúne los corazones). Sin culpa.";
"hex.59.yao.5" = "Disipar el daño sangriento y alejarse de él. Sin culpa.";
"hex.60.ci" = "Éxito. No se puede perseverar largamente en una restricción excesivamente amarga.";
"hex.60.daxiang" = "Sobre el lago hay agua: La Restricción. Así, la persona noble establece ritos y normas y examina la virtud y la conducta.";
"hex.60.yao.0" = "No salir del patio interior. Sin culpa.";
"hex.60.yao.1" = "No salir del patio exterior (cuando corresponde hacerlo). Infortunio.";
"hex.60.yao.2" = "No conocer la medida lleva a suspirar y arrepentirse. ¿A quién más se puede culpar? (Según otra lectura, reconocerlo con pesar deja sin culpa.)";
"hex.60.yao.3" = "Practicar la restricción con serenidad. Éxito.";
"hex.60.yao.4" = "Practicar la restricción de manera grata y moderada. Buena fortuna. Avanzar merece estima.";
"hex.60.yao.5" = "Restricción excesivamente amarga. Persistir trae infortunio. Reconocerlo y corregirse hace desaparecer el arrepentimiento.";
"hex.61.ci" = "La sinceridad alcanza incluso a lechones y peces (llega hasta los seres más humildes). Buena fortuna. Es favorable cruzar el gran río y perseverar en lo recto.";
"hex.61.daxiang" = "Sobre el lago hay viento: La Verdad Interior. Así, la persona noble examina con cuidado los procesos judiciales y aplaza las ejecuciones.";
"hex.61.yao.0" = "Mantenerse serenamente en el propio deber (según otra lectura, ponderar y prepararse). Buena fortuna. Buscar otra cosa impide la tranquilidad.";
"hex.61.yao.1" = "La grulla canta a la sombra y sus semejantes le responden. Tengo buen vino y quiero compartirlo contigo.";
"hex.61.yao.2" = "Encontrar a un adversario: unas veces tocar el tambor y atacar, otras descansar; unas veces llorar, otras cantar.";
"hex.61.yao.3" = "La luna está casi llena. El buen caballo pierde a su compañero. Sin culpa.";
"hex.61.yao.4" = "La sinceridad enlaza estrechamente a todos. Sin culpa.";
"hex.61.yao.5" = "El canto del gallo asciende al cielo (la fama excede la realidad). Persistir así trae infortunio.";
"hex.62.ci" = "Éxito. Es favorable perseverar en lo recto. Se pueden emprender asuntos pequeños, pero no grandes. El ave deja su canto (que desciende desde el cielo). No conviene volar hacia arriba, sino bajar y posarse. Gran fortuna.";
"hex.62.daxiang" = "Sobre la montaña hay trueno: La Preponderancia de lo Pequeño. Así, la persona noble excede un poco la medida en el respeto de su conducta, el dolor del duelo y la frugalidad del gasto.";
"hex.62.yao.0" = "El ave insiste en volar alto en vez de permanecer abajo y atrae el infortunio.";
"hex.62.yao.1" = "Pasar al abuelo y encontrar a la abuela. Sin sobrepasar al soberano, encontrar al ministro. Sin culpa.";
"hex.62.yao.2" = "No extremar la prevención y, en cambio, seguir sin cautela puede traer daño. Infortunio.";
"hex.62.yao.3" = "Sin culpa. Sin excederse en firmeza, se puede encontrar al otro. Avanzar es peligroso; hay que estar alerta. No aferrarse indefinidamente.";
"hex.62.yao.4" = "Nubes densas sin lluvia llegan desde nuestras afueras occidentales. El príncipe dispara una flecha atada a un cordel y captura la presa oculta en la cueva.";
"hex.62.yao.5" = "No encontrar al otro y pasarse de largo. Como un ave atrapada en la red. Infortunio: esto se llama calamidad.";
"hex.63.ci" = "Éxito, incluso en asuntos pequeños. Es favorable perseverar en lo recto. Al comienzo, buena fortuna; al final, desorden.";
"hex.63.daxiang" = "El agua está sobre el fuego: Después de la Consumación. Así, la persona noble considera las calamidades posibles y las previene.";
"hex.63.yao.0" = "Frenar las ruedas (para no avanzar con prisa). El zorro se moja la cola al cruzar el río. Sin culpa.";
"hex.63.yao.1" = "La mujer pierde la cortina de su carro. No perseguirla: se recuperará en siete días.";
"hex.63.yao.2" = "Gaozong (Wu Ding, rey de Shang) combatió a los Guifang (pueblo del norte) y tardó tres años en vencerlos. No se debe emplear a personas mezquinas.";
"hex.63.yao.3" = "Las vestiduras espléndidas se convertirán en harapos (según otra lectura, preparar trapos para tapar las vías de agua de la barca). Mantenerse alerta todo el día.";
"hex.63.yao.4" = "El estado vecino oriental sacrifica un buey, pero su gran ceremonia no iguala el sencillo sacrificio yue (ofrenda de verano) del estado vecino occidental, que recibe verdaderamente las bendiciones.";
"hex.63.yao.5" = "Mojarse la cabeza al cruzar el río. Peligro.";
"hex.64.ci" = "Éxito. El pequeño zorro casi ha cruzado el río, pero se moja la cola. Nada es favorable.";
"hex.64.daxiang" = "El fuego está sobre el agua: Antes de la Consumación. Así, la persona noble distingue cuidadosamente las cosas y sitúa cada una en su lugar apropiado.";
"hex.64.yao.0" = "Mojarse la cola. Pesar.";
"hex.64.yao.1" = "Frenar las ruedas (sin apresurarse a avanzar). Perseverar en lo recto trae buena fortuna.";
"hex.64.yao.2" = "Aún no se ha cruzado. Avanzar trae infortunio. Es favorable cruzar el gran río (según otra lectura, debería decir «no es favorable»).";
"hex.64.yao.3" = "Perseverar en lo recto trae buena fortuna; desaparece el arrepentimiento. Combatir a los Guifang con la fuerza del trueno. Al cabo de tres años, recibir recompensas del gran estado.";
"hex.64.yao.4" = "Perseverar en lo recto trae buena fortuna. Sin arrepentimiento. La luz de la persona noble reside en su sinceridad. Buena fortuna.";
"hex.64.yao.5" = "Beber vino con sinceridad y serenidad. Sin culpa. Si la embriaguez llega a mojar la cabeza, aun con sinceridad se pierde el camino recto.";
"hex.1.yong" = "Aparece un grupo de dragones; ninguno disputa el mando. Buena fortuna.";
"hex.2.yong" = "Es favorable perseverar siempre en lo recto.";
