/* English hexagram & trigram names and plain-language readings (King Wen order). */

"tri.1.k" = "Heaven"; "tri.1.nat" = "Heaven";
"tri.2.k" = "Lake"; "tri.2.nat" = "Lake";
"tri.3.k" = "Fire"; "tri.3.nat" = "Fire";
"tri.4.k" = "Thunder"; "tri.4.nat" = "Thunder";
"tri.5.k" = "Wind"; "tri.5.nat" = "Wind";
"tri.6.k" = "Water"; "tri.6.nat" = "Water";
"tri.7.k" = "Mountain"; "tri.7.nat" = "Mountain";
"tri.8.k" = "Earth"; "tri.8.nat" = "Earth";

"hex.1.name" = "The Creative"; "hex.1.full" = "The Creative";
"hex.1.bh" = "Heaven moves with tireless strength. Take the initiative and keep striving, but advance step by step — stay humble and don't rush.";
"hex.2.name" = "The Receptive"; "hex.2.full" = "The Receptive";
"hex.2.bh" = "The earth yields and supports all things. Go with the flow and support others rather than pushing to the front; stay steady and true, and all will be well.";
"hex.3.name" = "Initial Difficulty"; "hex.3.full" = "Difficulty at the Beginning";
"hex.3.bh" = "New life struggles to break through. Beginnings meet resistance — build a firm footing, seek help, and don't charge ahead.";
"hex.4.name" = "Youthful Folly"; "hex.4.full" = "Youthful Folly";
"hex.4.bh" = "Inexperience waiting to be taught. Ask with an open mind and focus on learning; don't consult the oracle again and again on the same question.";
"hex.5.name" = "Waiting"; "hex.5.full" = "Waiting";
"hex.5.bh" = "Wait for the right moment. Conditions aren't ripe yet — stay sincere and patient, and when the time comes the way will open.";
"hex.6.name" = "Conflict"; "hex.6.full" = "Conflict";
"hex.6.bh" = "A dispute is brewing. Settle early and know when to stop; fighting to the bitter end backfires. A fair third party can help.";
"hex.7.name" = "The Army"; "hex.7.full" = "The Army";
"hex.7.bh" = "Mobilizing many people. Big undertakings need firm discipline and the right people in the right roles, led by someone widely respected.";
"hex.8.name" = "Holding Together"; "hex.8.full" = "Holding Together";
"hex.8.bh" = "Drawing close to others. Form sincere bonds and join with good people — do it early, since hesitating on the sidelines means missing out.";
"hex.9.name" = "Small Taming"; "hex.9.full" = "The Taming Power of the Small";
"hex.9.bh" = "Small reserves, not yet enough strength. Things are still taking shape; build up your resources and cultivate your inner strength.";
"hex.10.name" = "Treading"; "hex.10.full" = "Treading";
"hex.10.bh" = "Like stepping on a tiger's tail — tread carefully. The situation carries risk, but with courtesy and caution you will pass through safely.";
"hex.11.name" = "Peace"; "hex.11.full" = "Peace";
"hex.11.bh" = "Heaven and earth meet; everything flows freely. Things go smoothly — seize the opportunity, while staying mindful of future risks.";
"hex.12.name" = "Standstill"; "hex.12.full" = "Standstill";
"hex.12.bh" = "Heaven and earth are out of touch; the way is blocked. Keep a low profile, hold to your principles, and wait for the turn.";
"hex.13.name" = "Fellowship with Men"; "hex.13.full" = "Fellowship with Men";
"hex.13.bh" = "Uniting with others. Reach out to like-minded people and cooperate openly, rather than keeping to a small private circle.";
"hex.14.name" = "Great Possession"; "hex.14.full" = "Possession in Great Measure";
"hex.14.bh" = "Great abundance, like the sun at noon. Promote the good and curb the bad, stay modest and hold on to what you've built, and your prosperity will last.";
"hex.15.name" = "Modesty"; "hex.15.full" = "Modesty";
"hex.15.bh" = "Humility and yielding. The more modest you are, the more help you receive — every line is favorable, and what you begin you will see through.";
"hex.16.name" = "Enthusiasm"; "hex.16.full" = "Enthusiasm";
"hex.16.bh" = "Harmony and ease; others rally to you. Plan ahead and act with the tide, but don't sink into comfort.";
"hex.17.name" = "Following"; "hex.17.full" = "Following";
"hex.17.bh" = "Move with the times and follow what is good. Adapt flexibly to circumstances while holding to what is right.";
"hex.18.name" = "Work on the Decayed"; "hex.18.full" = "Work on What Has Been Spoiled";
"hex.18.bh" = "Old problems need fixing. Set things in order and renew them; plan before you act and review afterward, and trouble can turn to safety.";
"hex.19.name" = "Approach"; "hex.19.full" = "Approach";
"hex.19.bh" = "Things are getting better and better. The trend is in your favor — act boldly, but guard against the decline that follows a peak.";
"hex.20.name" = "Contemplation"; "hex.20.full" = "Contemplation";
"hex.20.bh" = "Observe and set an example. Take in the whole picture calmly and reflect on yourself; win people over with sincerity, and don't rush to act.";
"hex.21.name" = "Biting Through"; "hex.21.full" = "Biting Through";
"hex.21.bh" = "Bite through the obstacle. Something stands in the way — deal with it decisively and tell right from wrong; once it's gone, the path is clear.";
"hex.22.name" = "Grace"; "hex.22.full" = "Grace";
"hex.22.bh" = "The beauty of adornment. A little polish helps, but don't trade substance for style — small matters go smoothly, while big ones need something real behind them.";
"hex.23.name" = "Splitting Apart"; "hex.23.full" = "Splitting Apart";
"hex.23.bh" = "Things are peeling away and declining. Conditions are against you — defend rather than attack, preserve your strength, and wait for the return.";
"hex.24.name" = "Return"; "hex.24.full" = "Return";
"hex.24.bh" = "Light returns; a fresh start. The low point is behind you — get back on the right path promptly and recover step by step.";
"hex.25.name" = "Innocence"; "hex.25.full" = "Innocence";
"hex.25.bh" = "Be genuine and free of pretense. Let things take their natural course without counting on luck; reckless action or grasping brings trouble.";
"hex.26.name" = "Great Taming"; "hex.26.full" = "The Taming Power of the Great";
"hex.26.bh" = "Great reserves. Build up deep knowledge and strength; when the time is ripe, go out and accomplish great things.";
"hex.27.name" = "Nourishment"; "hex.27.full" = "The Corners of the Mouth";
"hex.27.bh" = "The art of nourishment. Mind what you eat, how you live and what you say, and get what you need through your own honest effort.";
"hex.28.name" = "Great Excess"; "hex.28.full" = "Preponderance of the Great";
"hex.28.bh" = "The load is too heavy; the ridgepole sags. Extraordinary times call for extraordinary measures — take the responsibility on yourself, without fear.";
"hex.29.name" = "The Abysmal"; "hex.29.full" = "The Abysmal";
"hex.29.bh" = "Danger upon danger. In hard times keep your faith and persistence; like water that keeps flowing, you will find your way out.";
"hex.30.name" = "The Clinging"; "hex.30.full" = "The Clinging";
"hex.30.bh" = "Light that clings to its source. Attach yourself to what is right and to worthy people, stay gentle and modest, and your light will endure.";
"hex.31.name" = "Influence"; "hex.31.full" = "Influence";
"hex.31.bh" = "Mutual attraction. In relationships and love, connect through sincerity; meet others with an open heart and things will go well.";
"hex.32.name" = "Duration"; "hex.32.full" = "Duration";
"hex.32.bh" = "The way of endurance. Hold to the course you've set and persevere, rather than changing direction lightly.";
"hex.33.name" = "Retreat"; "hex.33.full" = "Retreat";
"hex.33.bh" = "Time to withdraw. The situation is against you — step back in good time to protect yourself; retreating now is how you advance later.";
"hex.34.name" = "The Power of the Great"; "hex.34.full" = "The Power of the Great";
"hex.34.bh" = "Great strength and momentum. When you're powerful, hold even more firmly to what's right and proper — never throw your weight around.";
"hex.35.name" = "Progress"; "hex.35.full" = "Progress";
"hex.35.bh" = "The sun is rising; advancement is at hand. Step forward and show your talent and character — recognition comes easily now.";
"hex.36.name" = "Darkening of the Light"; "hex.36.full" = "Darkening of the Light";
"hex.36.bh" = "The light is wounded. In dark surroundings keep a low profile — hold your light within and show a gentle face outside.";
"hex.37.name" = "The Family"; "hex.37.full" = "The Family";
"hex.37.bh" = "The way of the family. Let everyone keep to their role and let words and deeds be grounded; harmony at home makes everything go well.";
"hex.38.name" = "Opposition"; "hex.38.full" = "Opposition";
"hex.38.bh" = "Drifting apart. When views differ, seek common ground and respect differences; small things can succeed, while larger rifts take time to heal.";
"hex.39.name" = "Obstruction"; "hex.39.full" = "Obstruction";
"hex.39.bh" = "The road is hard going. There's a block ahead — look inward, seek out a benefactor, and hold off on advancing for now.";
"hex.40.name" = "Deliverance"; "hex.40.full" = "Deliverance";
"hex.40.bh" = "The difficulty is lifting. Be generous and forgiving, act promptly, let old grudges go, and restore order.";
"hex.41.name" = "Decrease"; "hex.41.full" = "Decrease";
"hex.41.bh" = "The way of letting go. Give up small gains and selfish wants, give sincerely — and you'll find you gain in return.";
"hex.42.name" = "Increase"; "hex.42.full" = "Increase";
"hex.42.bh" = "A time of gain. Good for expanding and pushing forward: learn from the good you see, correct your mistakes, and the rewards will come.";
"hex.43.name" = "Breakthrough"; "hex.43.full" = "Breakthrough";
"hex.43.bh" = "Time to decide. Be decisive when it's called for, but make your case openly and win people with integrity, not head-on force.";
"hex.44.name" = "Coming to Meet"; "hex.44.full" = "Coming to Meet";
"hex.44.bh" = "An unexpected encounter. A surprise meeting or opportunity arrives — see clearly who or what it is, and nip trouble in the bud.";
"hex.45.name" = "Gathering Together"; "hex.45.full" = "Gathering Together";
"hex.45.bh" = "Coming together. People and resources are gathering — unite hearts around a common purpose, and stay prepared for the unexpected.";
"hex.46.name" = "Pushing Upward"; "hex.46.full" = "Pushing Upward";
"hex.46.bh" = "Rising step by step. Like a growing tree, small gains add up; go with the upward trend and move forward boldly.";
"hex.47.name" = "Oppression"; "hex.47.full" = "Oppression";
"hex.47.bh" = "Hemmed in and exhausted. In adversity, talk less and do more; hold on to your aims and the way out will open.";
"hex.48.name" = "The Well"; "hex.48.full" = "The Well";
"hex.48.bh" = "The well that never runs dry. Keep your foundation solid and keep giving; what matters is upkeep and persistence — quitting just short of the goal is costly.";
"hex.49.name" = "Revolution"; "hex.49.full" = "Revolution";
"hex.49.bh" = "A time for change. Change needs the right moment and people's trust; in step with the times and with people's wishes, it will succeed.";
"hex.50.name" = "The Cauldron"; "hex.50.full" = "The Cauldron";
"hex.50.bh" = "A new order takes shape. Consolidate your position and put capable people to work — the new situation is now established.";
"hex.51.name" = "The Arousing"; "hex.51.full" = "The Arousing";
"hex.51.bh" = "A thunderclap shakes everything. Meet sudden upheaval calmly, stay alert and reflect on yourself — afterward, all will be at peace.";
"hex.52.name" = "Keeping Still"; "hex.52.full" = "Keeping Still";
"hex.52.bh" = "Stop and be still. Know when to stop, rein in your desires, and keep to your own role without overstepping.";
"hex.53.name" = "Development"; "hex.53.full" = "Development";
"hex.53.bh" = "Gradual progress. Like wild geese flying stage by stage, move forward one step at a time — don't try to hurry success.";
"hex.54.name" = "The Marrying Maiden"; "hex.54.full" = "The Marrying Maiden";
"hex.54.bh" = "Your standing isn't yet properly established. Be mindful of your role and of proper limits; pushing ahead rashly doesn't pay — keep to the ordinary course and bide your time.";
"hex.55.name" = "Abundance"; "hex.55.full" = "Abundance";
"hex.55.bh" = "Fullness and plenty. You're at your peak — make the most of the moment, and remember that the noon sun begins to set.";
"hex.56.name" = "The Wanderer"; "hex.56.full" = "The Wanderer";
"hex.56.bh" = "A traveler far from home. In unfamiliar surroundings stay modest, upright and careful; small matters can succeed.";
"hex.57.name" = "The Gentle"; "hex.57.full" = "The Gentle";
"hex.57.bh" = "Like wind that gets into everything — gentle and penetrating. Communicate softly, explain again and again, and ease your way in.";
"hex.58.name" = "The Joyous"; "hex.58.full" = "The Joyous";
"hex.58.bh" = "Joy and delight. Treat others sincerely and learn from one another; joy that comes from what is right brings success.";
"hex.59.name" = "Dispersion"; "hex.59.full" = "Dispersion";
"hex.59.bh" = "Scattering and dissolving. When people drift apart, rebuild common ground; knots that have built up can now be loosened.";
"hex.60.name" = "Limitation"; "hex.60.full" = "Limitation";
"hex.60.bh" = "Moderation in all things. Know when enough is enough and live within your means — but limits that are too harsh won't last either.";
"hex.61.name" = "Inner Truth"; "hex.61.full" = "Inner Truth";
"hex.61.bh" = "Sincerity at the core. Move others with genuine honesty; where sincerity reaches, even hard things can be done.";
"hex.62.name" = "Small Excess"; "hex.62.full" = "Preponderance of the Small";
"hex.62.bh" = "Small excess. Stick to small matters and keep a low profile; don't aim too high or reach too far.";
"hex.63.name" = "After Completion"; "hex.63.full" = "After Completion";
"hex.63.bh" = "The task is done. Success easily breeds complacency — stay alert in good times and guard against trouble before it starts.";
"hex.64.name" = "Before Completion"; "hex.64.full" = "Before Completion";
"hex.64.bh" = "Not finished yet. You're still in the middle of things — finish carefully and choose your direction wisely, and success will come in time.";
