/* English hexagram & trigram names and plain-language readings (King Wen order). */

"tri.1.k" = "Heaven"; "tri.1.nat" = "Heaven";
"tri.2.k" = "Lake"; "tri.2.nat" = "Lake";
"tri.3.k" = "Fire"; "tri.3.nat" = "Fire";
"tri.4.k" = "Thunder"; "tri.4.nat" = "Thunder";
"tri.5.k" = "Wind"; "tri.5.nat" = "Wind";
"tri.6.k" = "Water"; "tri.6.nat" = "Water";
"tri.7.k" = "Mountain"; "tri.7.nat" = "Mountain";
"tri.8.k" = "Earth"; "tri.8.nat" = "Earth";

"hex.1.name" = "The Creative"; "hex.1.full" = "The Creative";
"hex.1.bh" = "Heaven doubled, all six lines strong: the image of tireless creative power. The Judgment calls it \"great and originating\"; the lines trace a dragon hidden in the deep, appearing in the field, flying in the sky, and finally overreaching.";
"hex.2.name" = "The Receptive"; "hex.2.full" = "The Receptive";
"hex.2.bh" = "Earth doubled, all six lines yielding: the image of the earth that bears and supports all things. The Judgment compares its firmness to a mare's; the lines run from hoarfrost that heralds hard ice to dragons fighting in the open.";
"hex.3.name" = "Initial Difficulty"; "hex.3.full" = "Difficulty at the Beginning";
"hex.3.bh" = "Thunder below and clouds above: the image of a sprout pushing through the ground amid a storm. The text concerns the confusion of first beginnings; the lines show a halted horse and carriage, a suitor at first refused, and a hunter lost without a guide.";
"hex.4.name" = "Youthful Folly"; "hex.4.full" = "Youthful Folly";
"hex.4.bh" = "A spring issuing at the foot of a mountain: the image of youthful inexperience. The Judgment describes teacher and pupil: the young seek the teacher, and questions asked over and over go unanswered; the lines treat discipline, patience and the untaught youth.";
"hex.5.name" = "Waiting"; "hex.5.full" = "Waiting";
"hex.5.bh" = "Clouds rising in the sky before the rain falls: the image of waiting. The Judgment links waiting to sincerity and to crossing the great stream; the lines wait in the outskirts, on the sand, in the mud, at wine and food, and finally in a pit.";
"hex.6.name" = "Conflict"; "hex.6.full" = "Conflict";
"hex.6.bh" = "Heaven moving upward and water flowing down, drawing apart: the image of conflict and litigation. The Judgment contrasts halting a dispute midway with pressing it to the end; the lines depict quarrels dropped, a retreat home, and a leather belt of honour taken away three times in a day.";
"hex.7.name" = "The Army"; "hex.7.full" = "The Army";
"hex.7.bh" = "Water held within the earth: the image of a force drawn from among the people. The text concerns the discipline of an army and the need for an experienced leader; the lines move from setting out in order, through carts bearing corpses, to the ruler conferring rewards when the campaign ends.";
"hex.8.name" = "Holding Together"; "hex.8.full" = "Holding Together";
"hex.8.bh" = "Water flowing over the earth: the image of things drawing close and joining together. The Judgment speaks of those who come to unite and of the latecomer; the lines describe union grounded in sincerity, union from within and from without, and union without a head.";
"hex.9.name" = "Small Taming"; "hex.9.full" = "The Taming Power of the Small";
"hex.9.bh" = "Wind moving across the sky: the image of a gentle force that restrains for a time. The Judgment's \"dense clouds, but no rain\" from the western borders sets the theme; the lines show a return to one's own path, a carriage losing its spokes, and at last the rain falling.";
"hex.10.name" = "Treading"; "hex.10.full" = "Treading";
"hex.10.bh" = "Heaven above a marsh: the image of proper order between high and low. The Judgment's figure is treading on the tail of a tiger that does not bite; the lines trace simple conduct, a quiet level path, a one-eyed man who tries to see, and a final review of the steps taken.";
"hex.11.name" = "Peace"; "hex.11.full" = "Peace";
"hex.11.bh" = "Earth above and heaven below, their influences meeting: the image of heaven and earth in harmony. The Judgment speaks of \"the little gone and the great come\"; the lines move from rushes pulled up together, through \"no plain without a slope\", to a city wall falling back into its moat.";
"hex.12.name" = "Standstill"; "hex.12.full" = "Standstill";
"hex.12.bh" = "Heaven above and earth below, drawing apart without contact: the image of stagnation. The Judgment speaks of \"the great gone and the little come\"; the lines move from enduring a bad time, through a fate bound to a clump of mulberry trees, to the standstill finally overturned.";
"hex.13.name" = "Fellowship with Men"; "hex.13.full" = "Fellowship with Men";
"hex.13.bh" = "Heaven above fire, both reaching upward: the image of people united in common cause. The Judgment places fellowship out in the open country; the lines trace fellowship at the gate, within one clan, troops hidden in the thickets, and allies who first weep and later laugh.";
"hex.14.name" = "Great Possession"; "hex.14.full" = "Possession in Great Measure";
"hex.14.bh" = "Fire high in the heavens, shining on all below: the image of great possession. The Judgment speaks of \"great progress and success\"; the lines treat the responsibilities of wealth: a great wagon for loading, an offering to the Son of Heaven, and plenty held without excess.";
"hex.15.name" = "Modesty"; "hex.15.full" = "Modesty";
"hex.15.bh" = "A mountain hidden within the earth: the image of greatness that keeps itself low. The Judgment says the superior man carries things through to the end; the lines describe modesty in its forms: modesty about modesty, modesty that is voiced, and modesty joined with merit.";
"hex.16.name" = "Enthusiasm"; "hex.16.full" = "Enthusiasm";
"hex.16.bh" = "Thunder bursting from the earth: the image of energy released and stirring all things. The Great Image links it to the music the ancient kings composed; the lines contrast enthusiasm that is boastful or self-absorbed with a character firm as a rock.";
"hex.17.name" = "Following"; "hex.17.full" = "Following";
"hex.17.bh" = "Thunder resting within the marsh: the image of following the season and adapting to it. The Judgment links following to firmness and correctness; the lines show attachment to the small or the great, sincerity on the right path, and one bound fast in loyalty.";
"hex.18.name" = "Work on the Decayed"; "hex.18.full" = "Work on What Has Been Spoiled";
"hex.18.bh" = "Wind blowing at the foot of a mountain, where things stagnate: the image of decay to be set right. The Judgment speaks of three days before and three days after a new start; the lines deal with repairing what father and mother let decay, while the top line serves no king or lord.";
"hex.19.name" = "Approach"; "hex.19.full" = "Approach";
"hex.19.bh" = "Earth above a marsh: the image of the superior drawing near to those below. The Judgment adds a caution about the eighth month, when the cycle turns; the lines describe approach that is joint, easy, complete, wise and generous.";
"hex.20.name" = "Contemplation"; "hex.20.full" = "Contemplation";
"hex.20.bh" = "Wind moving over the earth: the image of viewing and being viewed. The Judgment's figure is a worshipper who has washed his hands but not yet made the offering; the lines widen from a boy's view and a glimpse through a door to contemplation of one's own life.";
"hex.21.name" = "Biting Through"; "hex.21.full" = "Biting Through";
"hex.21.bh" = "Thunder and lightning together: the image of an obstacle between the jaws to be bitten through. The text concerns the use of law and punishment; the lines move from feet in the stocks, through biting tender meat and dried meat, to a neck in the cangue.";
"hex.22.name" = "Grace"; "hex.22.full" = "Grace";
"hex.22.bh" = "Fire at the foot of a mountain, lighting it up: the image of grace and adornment. The Judgment allows only small matters; the lines move from adorned feet and beard, through a gleaming moistness and a white horse, to grace that has become simply white.";
"hex.23.name" = "Splitting Apart"; "hex.23.full" = "Splitting Apart";
"hex.23.bh" = "Five yielding lines beneath one strong line: a mountain resting on the earth and being worn away. The lines show a bed split apart from the legs, then the frame, then up to the skin; at the top a large fruit remains uneaten.";
"hex.24.name" = "Return"; "hex.24.full" = "Return";
"hex.24.bh" = "Thunder within the earth: the image of the light returning at the winter solstice. The Judgment speaks of a return within seven days; the lines distinguish a return made quickly, a quiet return, repeated returns, walking alone, and a return missed through confusion.";
"hex.25.name" = "Innocence"; "hex.25.full" = "Innocence";
"hex.25.bh" = "Thunder rolling under heaven: the image of things acting from their own nature, free of guile. The Judgment ties innocence to correctness; the lines include an ox tied up by one man and led off by a passer-by, and an illness that passes without medicine.";
"hex.26.name" = "Great Taming"; "hex.26.full" = "The Taming Power of the Great";
"hex.26.bh" = "Heaven held within the mountain: the image of great energy restrained and stored up. The Great Image speaks of storing up the words and deeds of earlier ages; the lines run from a carriage with its axle removed and a young bull's horn guarded to the way of heaven opening at the top.";
"hex.27.name" = "Nourishment"; "hex.27.full" = "The Corners of the Mouth";
"hex.27.bh" = "Thunder below a mountain, like jaws closing on food: the image of nourishment. The Judgment turns attention to what a person seeks to fill the mouth with; the lines contrast one who lets go his magic tortoise to gaze at others' food with nourishment drawn from proper sources.";
"hex.28.name" = "Great Excess"; "hex.28.full" = "Preponderance of the Great";
"hex.28.bh" = "The marsh rising over the trees: the image of a ridgepole sagging under too great a weight. The text concerns extraordinary times; the lines show a mat of white rushes, a withered willow putting out shoots, a sagging ridgepole, and a crossing where the water goes over the head.";
"hex.29.name" = "The Abysmal"; "hex.29.full" = "The Abysmal";
"hex.29.bh" = "Water doubled, flowing on through one ravine after another: the image of danger repeated. The Judgment holds up sincerity and an unclouded mind; the lines speak of a pit within a pit, wine and rice passed through a window, and a captive bound with cords.";
"hex.30.name" = "The Clinging"; "hex.30.full" = "The Clinging";
"hex.30.bh" = "Fire doubled, brightness upon brightness: the image of light clinging to what it illuminates. The Judgment adds the care of a cow; the lines move from confused footsteps, through yellow light and the setting sun, to sudden flame and a king's punitive expedition.";
"hex.31.name" = "Influence"; "hex.31.full" = "Influence";
"hex.31.bh" = "A marsh resting on a mountain: the image of mutual attraction between young man and young woman. The Judgment refers to taking a wife; the lines move up the body: the big toe, the calves, the thighs, the back, and finally the jaws and tongue.";
"hex.32.name" = "Duration"; "hex.32.full" = "Duration";
"hex.32.bh" = "Thunder and wind, always found together: the image of what endures. The Great Image pictures standing firm without changing one's method; the lines contrast seeking duration too hastily, an inconstant character, and a field where there is no game.";
"hex.33.name" = "Retreat"; "hex.33.full" = "Retreat";
"hex.33.bh" = "A mountain rising beneath heaven, which withdraws before it: the image of retreat. The Judgment concerns withdrawing in time as lesser forces advance; the lines range from the tail of a retreat and one held fast with yellow oxhide to a cheerful, unhurried withdrawal.";
"hex.34.name" = "The Power of the Great"; "hex.34.full" = "The Power of the Great";
"hex.34.bh" = "Thunder high in heaven: the image of great strength in motion. The Great Image ties power to propriety; the lines show a ram butting against a hedge and entangling its horns, and the hedge at last opening.";
"hex.35.name" = "Progress"; "hex.35.full" = "Progress";
"hex.35.bh" = "The sun rising over the earth: the image of rapid, easy progress. The Judgment pictures a prince honoured with many horses and received three times in a day; the lines contrast progress held back or grieved with that of a hamster and of one advancing with horns.";
"hex.36.name" = "Darkening of the Light"; "hex.36.full" = "Darkening of the Light";
"hex.36.bh" = "The sun sunk beneath the earth: the image of brightness wounded and hidden. The text is about concealing one's light in dark times, with the example of the Count of Ji; the lines include a pheasant flying with drooping wings and a hunt in the south.";
"hex.37.name" = "The Family"; "hex.37.full" = "The Family";
"hex.37.bh" = "Wind going out from fire: the image of the family, whose influence spreads outward from within. The Judgment stresses the role of the woman; the lines treat firm rules in the household, the preparing of meals, and the king's influence over his family.";
"hex.38.name" = "Opposition"; "hex.38.full" = "Opposition";
"hex.38.bh" = "Fire above a marsh, each moving away from the other: the image of opposition and estrangement. The Judgment allows small matters; the lines include a lost horse that returns of itself, meeting one's lord in a narrow lane, and a pig covered in mud.";
"hex.39.name" = "Obstruction"; "hex.39.full" = "Obstruction";
"hex.39.bh" = "Water on top of a mountain: the image of a dangerous path ahead. The Judgment contrasts the southwest with the northeast and speaks of meeting the great man; the lines alternate between going forward into obstruction and turning back to find support.";
"hex.40.name" = "Deliverance"; "hex.40.full" = "Deliverance";
"hex.40.bh" = "Thunder and rain releasing the tension of a storm: the image of deliverance. The Judgment speaks of returning early once the trouble is over; the lines include catching three foxes, a porter riding in a carriage, and shooting a hawk on a high wall.";
"hex.41.name" = "Decrease"; "hex.41.full" = "Decrease";
"hex.41.bh" = "A marsh at the foot of a mountain, its water rising to nourish the slope above: the image of decrease. The Judgment notes that two small bowls may serve for the sacrifice; the lines concern lessening below to increase above, and what is gained by what is given.";
"hex.42.name" = "Increase"; "hex.42.full" = "Increase";
"hex.42.bh" = "Wind and thunder strengthening each other: the image of increase. The text concerns the higher giving to the lower, and the Great Image ties it to moving toward the good; the lines include a gift of ten pairs of tortoise shells and a heart without constancy.";
"hex.43.name" = "Breakthrough"; "hex.43.full" = "Breakthrough";
"hex.43.bh" = "A marsh risen high above heaven: the image of a breakthrough. The Judgment speaks of proclaiming the matter at the king's court; the lines concern resolute action against wrongdoing: pressing forward too hastily, weeds uprooted, and a lone traveller drenched by rain.";
"hex.44.name" = "Coming to Meet"; "hex.44.full" = "Coming to Meet";
"hex.44.bh" = "Wind blowing beneath heaven: the image of a single yielding line coming to meet five strong ones. The Judgment advises against marrying such a woman; the lines include a fish in the tank, a melon covered with willow leaves, and meeting with horns.";
"hex.45.name" = "Gathering Together"; "hex.45.full" = "Gathering Together";
"hex.45.bh" = "A marsh rising above the earth: the image of waters collected and people assembling. The Judgment refers to the king approaching his temple and to large offerings; the lines treat gathering at the start, being drawn together, sighing over separation, and weeping.";
"hex.46.name" = "Pushing Upward"; "hex.46.full" = "Pushing Upward";
"hex.46.bh" = "Wood growing up within the earth: the image of steady upward growth. The Judgment refers to meeting the great man and setting out to the south; the lines trace an ascent into an empty city, the king's offering on Mount Qi, and climbing a stairway.";
"hex.47.name" = "Oppression"; "hex.47.full" = "Oppression";
"hex.47.bh" = "A marsh with the water drained from it: the image of exhaustion and adversity. The Judgment notes that words are not believed at such a time; the lines include oppression under a bare tree, at wine and food, among rocks and thorns, and by creeping vines.";
"hex.48.name" = "The Well"; "hex.48.full" = "The Well";
"hex.48.bh" = "Wood going down into water to draw it up: the image of a well, a source of nourishment that never runs dry. The Judgment notes that a town may move but its well does not; the lines move from a muddy, unused well to one left open for all.";
"hex.49.name" = "Revolution"; "hex.49.full" = "Revolution";
"hex.49.bh" = "Fire within a lake, each seeking to put out the other: the image of radical change. The Judgment says change is believed only on the day it is completed; the lines trace change bound in yellow oxhide, the great man changing like a tiger, and the superior man like a panther.";
"hex.50.name" = "The Cauldron"; "hex.50.full" = "The Cauldron";
"hex.50.bh" = "Wood beneath fire: the image of the ding, the bronze cauldron used to cook offerings and feasts. The Judgment speaks of great progress; the lines move from a cauldron overturned to empty it, through broken legs and altered handles, to carrying rings of gold and of jade.";
"hex.51.name" = "The Arousing"; "hex.51.full" = "The Arousing";
"hex.51.bh" = "Thunder doubled: the image of shock and fear. The Judgment pictures fright followed by laughter, and one who keeps hold of the sacrificial ladle and wine; the lines follow responses to shock, from losing treasure and climbing the nine hills to being stuck in the mud.";
"hex.52.name" = "Keeping Still"; "hex.52.full" = "Keeping Still";
"hex.52.bh" = "Mountain doubled: the image of stillness and rest. The Judgment pictures keeping the back still and walking in the courtyard without seeing anyone; the lines move up the body, through toes, calves, hips, trunk and jaws, to a noble stillness at the top.";
"hex.53.name" = "Development"; "hex.53.full" = "Development";
"hex.53.bh" = "A tree growing on a mountain: the image of gradual development. The Judgment uses the marriage of a maiden; the lines follow a wild goose advancing step by step from the shore to the rock, the plateau, the tree, the summit and the heights beyond.";
"hex.54.name" = "The Marrying Maiden"; "hex.54.full" = "The Marrying Maiden";
"hex.54.bh" = "Thunder over a marsh: the image of a younger sister married as a secondary wife. The Great Image reflects on knowing the end from the beginning; the lines include a lame man who walks, a one-eyed man who sees, a delayed marriage, and a bride's sleeves plainer than her bridesmaid's.";
"hex.55.name" = "Abundance"; "hex.55.full" = "Abundance";
"hex.55.bh" = "Thunder and lightning arriving together: the image of abundance at its peak. The Judgment compares the king to the sun at midday; the lines describe the sun screened so that stars are seen at noon, and a great house that stands empty.";
"hex.56.name" = "The Wanderer"; "hex.56.full" = "The Wanderer";
"hex.56.bh" = "Fire on a mountain, burning and moving on: the image of the traveller. The Judgment allows small matters; the lines describe a traveller at inns, with or without servants and goods, and a bird's nest burned as the wanderer first laughs and then weeps.";
"hex.57.name" = "The Gentle"; "hex.57.full" = "The Gentle";
"hex.57.bh" = "Wind doubled, penetrating everywhere: the image of the gentle and penetrating. The Judgment speaks of small success and seeing the great man; the lines include diviners and exorcists beneath the bed, game caught for three uses, and three days before and after a change.";
"hex.58.name" = "The Joyous"; "hex.58.full" = "The Joyous";
"hex.58.bh" = "Marsh doubled, two lakes feeding one another: the image of joy shared. The Great Image ties it to friends discussing and practising together; the lines contrast joy that is harmonious and sincere with joy that is sought, calculated or seductive.";
"hex.59.name" = "Dispersion"; "hex.59.full" = "Dispersion";
"hex.59.bh" = "Wind blowing over water: the image of dissolving what is rigid or divided. The Judgment refers to the king approaching his temple and crossing the great water; the lines include dispersing one's self, one's group, and a great cry spread like sweat.";
"hex.60.name" = "Limitation"; "hex.60.full" = "Limitation";
"hex.60.bh" = "Water above a lake, which can hold only so much: the image of limits and regulation. The Judgment says limits that are harsh and bitter cannot last; the lines contrast not going out of the courtyard, limits accepted with ease, and bitter limits.";
"hex.61.name" = "Inner Truth"; "hex.61.full" = "Inner Truth";
"hex.61.bh" = "Wind above a lake: the image of sincerity that reaches even pigs and fish. The lines include a crane calling in the shade and its young answering, a goblet of wine shared, a horse whose teammate goes off, and a cock trying to fly up to heaven.";
"hex.62.name" = "Small Excess"; "hex.62.full" = "Preponderance of the Small";
"hex.62.bh" = "Thunder above a mountain: the image of the small exceeding. The Judgment pictures a flying bird whose call is heard, and contrasts small affairs with great; the lines show a bird that flies too high and passing by the ancestor to meet the ancestress.";
"hex.63.name" = "After Completion"; "hex.63.full" = "After Completion";
"hex.63.bh" = "Water above fire, every line in its proper place: the image of things completed. The Judgment notes order at the start and disorder at the end; the lines include brakes on a wheel, a lost carriage screen, and a fox that gets its head wet.";
"hex.64.name" = "Before Completion"; "hex.64.full" = "Before Completion";
"hex.64.bh" = "Fire above water, no line in its proper place: the image of a transition not yet finished. The Judgment pictures a little fox that has nearly crossed the stream wetting its tail; the lines move from that unfinished crossing to wine drunk in confidence at the end.";
