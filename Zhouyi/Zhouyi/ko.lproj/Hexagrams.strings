/* Korean — hexagram names, full names, plain-language interpretations; trigrams in 先天 order */

"tri.1.k" = "건"; "tri.1.nat" = "하늘";
"tri.2.k" = "태"; "tri.2.nat" = "못";
"tri.3.k" = "리"; "tri.3.nat" = "불";
"tri.4.k" = "진"; "tri.4.nat" = "우레";
"tri.5.k" = "손"; "tri.5.nat" = "바람";
"tri.6.k" = "감"; "tri.6.nat" = "물";
"tri.7.k" = "간"; "tri.7.nat" = "산";
"tri.8.k" = "곤"; "tri.8.nat" = "땅";

"hex.1.name" = "중천건"; "hex.1.full" = "중천건";
"hex.1.bh" = "하늘의 도는 굳세게 쉼 없이 운행합니다. 주도적으로 나아가며 스스로 끊임없이 힘쓰되, 단계를 밟아 나아가고 교만과 조급함을 경계해야 합니다.";
"hex.2.name" = "중지곤"; "hex.2.full" = "중지곤";
"hex.2.bh" = "대지는 부드럽게 순응하며 만물을 떠받칩니다. 흐름을 따르고 남을 돕는 것이 좋으며, 앞장서서 나서기보다 바르게 지키며 안정을 구하면 길합니다.";
"hex.3.name" = "수뢰둔"; "hex.3.full" = "수뢰둔";
"hex.3.bh" = "만물이 처음 생겨나 어렵게 첫걸음을 뗍니다. 일의 시작에 걸림돌이 많으니 기반을 다지고 도움을 구해야 하며, 무리하게 밀어붙여서는 안 됩니다.";
"hex.4.name" = "산수몽"; "hex.4.full" = "산수몽";
"hex.4.bh" = "어리석음이 깨우침을 기다립니다. 겸허하게 가르침을 구하고 배움에 집중해야 하며, 같은 질문을 되풀이해 점치는 것은 좋지 않습니다.";
"hex.5.name" = "수천수"; "hex.5.full" = "수천수";
"hex.5.bh" = "때를 기다립니다. 조건이 아직 무르익지 않았으니 신의와 인내를 지켜야 합니다. 때가 이르면 자연히 뜻이 통합니다.";
"hex.6.name" = "천수송"; "hex.6.full" = "천수송";
"hex.6.bh" = "다툼과 송사의 형상입니다. 일찍 화해하고 적당한 선에서 멈추는 것이 좋으며, 끝까지 다투면 오히려 불리합니다. 공정한 제3자를 찾는 것도 방법입니다.";
"hex.7.name" = "지수사"; "hex.7.full" = "지수사";
"hex.7.bh" = "군사를 일으켜 많은 사람을 움직입니다. 큰일을 하려면 규율이 엄하고 사람을 제대로 써야 하며, 덕망 있는 사람이 이끌어야 성공합니다.";
"hex.8.name" = "수지비"; "hex.8.full" = "수지비";
"hex.8.bh" = "서로 가까이하고 의지합니다. 진심으로 사귀고 좋은 사람을 가려 따르며 일찍 합류하는 것이 좋습니다. 머뭇거리며 관망하면 기회를 놓칩니다.";
"hex.9.name" = "풍천소축"; "hex.9.full" = "풍천소축";
"hex.9.bh" = "조금 쌓였으나 힘이 아직 부족합니다. 일이 무르익는 중이라 아직 형태를 갖추지 못했으니, 실력을 쌓고 내면을 가꾸어야 합니다.";
"hex.10.name" = "천택리"; "hex.10.full" = "천택리";
"hex.10.bh" = "호랑이 꼬리를 밟듯 조심스럽게 나아갑니다. 처한 상황에 위험이 있으나 예를 지키고 신중하면 무사히 지나갈 수 있습니다.";
"hex.11.name" = "지천태"; "hex.11.full" = "지천태";
"hex.11.bh" = "하늘과 땅이 사귀어 위아래가 통합니다. 모든 일이 순조로우니 좋은 기회를 잡되, 편안할 때 위태로움을 생각해야 합니다.";
"hex.12.name" = "천지비"; "hex.12.full" = "천지비";
"hex.12.bh" = "하늘과 땅이 사귀지 않아 막히고 통하지 않습니다. 몸을 낮추고 원칙을 지키며 전환점을 기다려야 합니다.";
"hex.13.name" = "천화동인"; "hex.13.full" = "천화동인";
"hex.13.bh" = "사람들과 뜻을 함께합니다. 널리 동지를 모으고 열린 자세로 협력해야 하며, 사사로운 작은 무리에 얽매이지 않아야 합니다.";
"hex.14.name" = "화천대유"; "hex.14.full" = "화천대유";
"hex.14.bh" = "크게 거두니 해가 중천에 뜬 듯합니다. 선을 드러내고 악을 막으며 겸손하게 이룬 것을 지켜야 풍성함을 오래 누릴 수 있습니다.";
"hex.15.name" = "지산겸"; "hex.15.full" = "지산겸";
"hex.15.bh" = "겸손하게 물러나 양보합니다. 겸손할수록 남의 도움을 얻으며, 여섯 효가 모두 길하니 시작과 끝이 좋은 형상입니다.";
"hex.16.name" = "뇌지예"; "hex.16.full" = "뇌지예";
"hex.16.bh" = "즐겁고 순조로워 많은 사람이 호응합니다. 미리 계획하고 흐름을 타 행동하되, 편안함에 빠져서는 안 됩니다.";
"hex.17.name" = "택뢰수"; "hex.17.full" = "택뢰수";
"hex.17.bh" = "때에 맞춰 움직이고 좋은 것을 가려 따릅니다. 형세에 순응하며 유연하게 대처하되, 바른 길은 굳게 지켜야 합니다.";
"hex.18.name" = "산풍고"; "hex.18.full" = "산풍고";
"hex.18.bh" = "쌓인 폐단을 바로잡아야 합니다. 묵은 문제는 정비하고 혁신해야 하니, 일에 앞서 계획하고 마친 뒤에 점검하면 위기를 넘겨 안정을 찾을 수 있습니다.";
"hex.19.name" = "지택림"; "hex.19.full" = "지택림";
"hex.19.bh" = "위에서 아래를 굽어보며 점차 좋아집니다. 형세가 좋으니 적극적으로 나서되, 번성이 극에 달하면 쇠하기 마련이니 미리 대비해야 합니다.";
"hex.20.name" = "풍지관"; "hex.20.full" = "풍지관";
"hex.20.bh" = "살펴보고 본보기를 보입니다. 전체를 차분히 관찰하고 자신을 돌아보며, 정성으로 사람을 감화시키고 서둘러 행동하지 않아야 합니다.";
"hex.21.name" = "화뢰서합"; "hex.21.full" = "화뢰서합";
"hex.21.bh" = "깨물어 장애를 없앱니다. 중간에 걸림돌이 있으니 과감히 처리하고 옳고 그름을 분명히 가리면, 장애가 사라져 뜻이 통합니다.";
"hex.22.name" = "산화비"; "hex.22.full" = "산화비";
"hex.22.bh" = "꾸밈의 아름다움입니다. 적당한 꾸밈은 도움이 되지만 본질을 버리고 겉만 좇아서는 안 됩니다. 작은 일은 순조롭고 큰일은 실질을 중시해야 합니다.";
"hex.23.name" = "산지박"; "hex.23.full" = "산지박";
"hex.23.bh" = "깎여 나가며 쇠퇴합니다. 형세가 불리하니 공격보다 수비가 좋으며, 힘을 보존하고 회복의 때를 기다려야 합니다.";
"hex.24.name" = "지뢰복"; "hex.24.full" = "지뢰복";
"hex.24.bh" = "하나의 양이 돌아와 새로 시작합니다. 바닥은 지났으니 제때 바른 길로 돌아와 차근차근 회복해야 합니다.";
"hex.25.name" = "천뢰무망"; "hex.25.full" = "천뢰무망";
"hex.25.bh" = "진실하고 거짓이 없습니다. 자연스러움을 따르고 요행을 바라지 않으면 길하며, 함부로 움직이고 욕심내면 재앙이 따릅니다.";
"hex.26.name" = "산천대축"; "hex.26.full" = "산천대축";
"hex.26.bh" = "크게 쌓아 둡니다. 학식과 실력을 두텁게 쌓아야 하며, 때가 무르익으면 밖으로 나가 큰일을 이룰 수 있습니다.";
"hex.27.name" = "산뢰이"; "hex.27.full" = "산뢰이";
"hex.27.bh" = "기르고 돌보는 도입니다. 먹고 자는 생활과 말을 삼가며, 자신의 정당한 노력으로 필요한 것을 얻어야 합니다.";
"hex.28.name" = "택풍대과"; "hex.28.full" = "택풍대과";
"hex.28.bh" = "짐이 너무 무거워 대들보가 휩니다. 비상한 때에는 비상한 행동이 필요하니, 홀로 책임을 지고 두려워하지 않아야 합니다.";
"hex.29.name" = "중수감"; "hex.29.full" = "중수감";
"hex.29.bh" = "험난함이 겹겹이 이어집니다. 어려움 속에서도 믿음과 끈기를 지키고, 물처럼 꾸준히 흘러가면 결국 위험에서 벗어납니다.";
"hex.30.name" = "중화리"; "hex.30.full" = "중화리";
"hex.30.bh" = "밝음이 붙어 의지합니다. 바른 길과 현명한 사람에게 의지하고 부드럽고 겸손하게 처신해야 밝음이 오래갑니다.";
"hex.31.name" = "택산함"; "hex.31.full" = "택산함";
"hex.31.bh" = "서로 느끼고 감응합니다. 인간관계와 감정은 진심으로 통해야 하며, 마음을 비우고 사람을 대하면 관계가 순조롭습니다.";
"hex.32.name" = "뇌풍항"; "hex.32.full" = "뇌풍항";
"hex.32.bh" = "오래 변치 않는 도입니다. 정한 방향을 굳게 지키고 꾸준히 이어가며, 쉽게 바꾸지 않아야 합니다.";
"hex.33.name" = "천산둔"; "hex.33.full" = "천산둔";
"hex.33.bh" = "물러나 피할 때입니다. 형세가 자신에게 불리하니 적절히 물러나 자신을 지키고, 물러남으로써 나아갈 길을 엽니다.";
"hex.34.name" = "뇌천대장"; "hex.34.full" = "뇌천대장";
"hex.34.bh" = "기세가 크게 왕성합니다. 힘이 넘칠수록 바름과 예를 지켜야 하며, 힘만 믿고 함부로 움직이는 것은 금물입니다.";
"hex.35.name" = "화지진"; "hex.35.full" = "화지진";
"hex.35.bh" = "해가 동쪽에서 떠오르듯 승진하고 나아갑니다. 적극적으로 재능과 덕을 드러내면 인정받기 쉽습니다.";
"hex.36.name" = "지화명이"; "hex.36.full" = "지화명이";
"hex.36.bh" = "밝음이 상처를 입습니다. 환경이 어두울 때는 재능을 감추고 힘을 기르며, 안으로는 밝음을 지키고 겉으로는 유순하게 처신해야 합니다.";
"hex.37.name" = "풍화가인"; "hex.37.full" = "풍화가인";
"hex.37.bh" = "가정의 도입니다. 각자 제자리를 지키고 말과 행동에 근거가 있어야 하며, 안이 화목하면 모든 일이 순조롭습니다.";
"hex.38.name" = "화택규"; "hex.38.full" = "화택규";
"hex.38.bh" = "서로 어긋나 등을 돌립니다. 의견이 갈릴 때는 공통점을 찾고 차이는 인정해야 하며, 작은 일은 이루어지나 큰일은 서서히 간극을 좁혀야 합니다.";
"hex.39.name" = "수산건"; "hex.39.full" = "수산건";
"hex.39.bh" = "가는 길이 험난합니다. 앞에 장애가 있으니 자신을 돌아보고 귀인을 찾으며, 잠시 전진을 멈춰야 합니다.";
"hex.40.name" = "뇌수해"; "hex.40.full" = "뇌수해";
"hex.40.bh" = "어려움이 풀립니다. 너그럽게 일을 처리하고 일찍 행동하며, 묵은 원한을 풀고 질서를 회복해야 합니다.";
"hex.41.name" = "산택손"; "hex.41.full" = "산택손";
"hex.41.bh" = "덜어 내는 도입니다. 작은 이익을 버리고 사욕을 덜어 진심으로 베풀면 오히려 얻는 것이 있습니다.";
"hex.42.name" = "풍뢰익"; "hex.42.full" = "풍뢰익";
"hex.42.bh" = "더하고 늘어나는 때입니다. 새 길을 열고 나아가기에 좋으며, 좋은 것은 배우고 허물은 고치면 이로움을 기대할 수 있습니다.";
"hex.43.name" = "택천쾌"; "hex.43.full" = "택천쾌";
"hex.43.bh" = "결단할 때입니다. 끊어야 할 때는 끊되, 공개적으로 이치를 밝히고 덕으로 설득해야 하며 정면으로 부딪치는 것은 좋지 않습니다.";
"hex.44.name" = "천풍구"; "hex.44.full" = "천풍구";
"hex.44.bh" = "뜻밖에 만납니다. 예상치 못한 만남이나 기회가 있으나, 상대를 잘 가려보고 작은 조짐부터 경계해야 합니다.";
"hex.45.name" = "택지췌"; "hex.45.full" = "택지췌";
"hex.45.bh" = "모이고 합칩니다. 사람과 자원이 모여드는 때이니 마음을 하나로 모으되, 대비도 함께 해 두어야 합니다.";
"hex.46.name" = "지풍승"; "hex.46.full" = "지풍승";
"hex.46.bh" = "한 걸음씩 높이 오릅니다. 나무가 자라듯 작은 것을 쌓아 크게 이루니, 흐름을 타고 과감히 나아가도 좋습니다.";
"hex.47.name" = "택수곤"; "hex.47.full" = "택수곤";
"hex.47.bh" = "곤궁한 처지입니다. 역경 속에서는 말을 줄이고 행동으로 보이며, 뜻을 굳게 지키면 결국 곤경이 풀립니다.";
"hex.48.name" = "수풍정"; "hex.48.full" = "수풍정";
"hex.48.bh" = "우물은 마르지 않고 끝없이 사람을 기릅니다. 근본을 튼튼히 하고 꾸준히 베풀어야 하며, 고치고 가꾸며 끝까지 해내는 것이 중요하니 마지막 한 고비에서 그르치면 불리합니다.";
"hex.49.name" = "택화혁"; "hex.49.full" = "택화혁";
"hex.49.bh" = "변혁할 때입니다. 변화는 때가 무르익고 사람들의 신뢰를 얻어야 하며, 하늘과 사람의 뜻에 따르면 변혁이 성공합니다.";
"hex.50.name" = "화풍정"; "hex.50.full" = "화풍정";
"hex.50.bh" = "솥처럼 새롭게 자리를 잡습니다. 지위를 굳히고 현명한 인재를 써야 하며, 새로운 국면이 이미 자리 잡았습니다.";
"hex.51.name" = "중뢰진"; "hex.51.full" = "중뢰진";
"hex.51.bh" = "천둥이 울려 뒤흔듭니다. 갑작스러운 변고에도 침착함을 유지하고 경각심을 갖고 자신을 돌아보면, 지나고 나서 오히려 평안해집니다.";
"hex.52.name" = "중산간"; "hex.52.full" = "중산간";
"hex.52.bh" = "멈추어 움직이지 않습니다. 멈출 때를 알아 멈추고, 욕심을 다스리며 본분을 지켜 자리를 넘어서지 않아야 합니다.";
"hex.53.name" = "풍산점"; "hex.53.full" = "풍산점";
"hex.53.bh" = "차례대로 점진적으로 나아갑니다. 기러기가 점차 날아오르듯 순서를 밟아 추진해야 하며, 서둘러 이루려 해서는 안 됩니다.";
"hex.54.name" = "뇌택귀매"; "hex.54.full" = "뇌택귀매";
"hex.54.bh" = "명분이 바로 서지 않았습니다. 일을 할 때 자기 위치와 분수를 살펴야 하며, 섣불리 나아가면 불리하니 평소대로 지키며 때를 기다려야 합니다.";
"hex.55.name" = "뇌화풍"; "hex.55.full" = "뇌화풍";
"hex.55.bh" = "풍성하고 성대합니다. 한창 번성할 때이니 지금을 잘 잡되, 해도 중천에 오르면 기운다는 이치를 알아야 합니다.";
"hex.56.name" = "화산려"; "hex.56.full" = "화산려";
"hex.56.bh" = "객지를 떠돕니다. 낯선 환경에서는 겸손하고 바르게 처신하며 신중히 행동하면 작은 일은 이룰 수 있습니다.";
"hex.57.name" = "중풍손"; "hex.57.full" = "중풍손";
"hex.57.bh" = "바람이 스며들 듯 겸손하게 파고듭니다. 부드럽게 소통하고 거듭 뜻을 밝히며, 흐름을 따라 들어가야 합니다.";
"hex.58.name" = "중택태"; "hex.58.full" = "중택태";
"hex.58.bh" = "기쁘고 즐겁습니다. 진심으로 사람을 대하고 서로 배우며 갈고닦으니, 기쁨이 바른 길에서 나오면 형통합니다.";
"hex.59.name" = "풍수환"; "hex.59.full" = "풍수환";
"hex.59.bh" = "흩어지고 풀립니다. 사람들의 마음이 흩어질 때는 공감대를 모아야 하며, 맺힌 일은 이 기회에 풀어낼 수 있습니다.";
"hex.60.name" = "수택절"; "hex.60.full" = "수택절";
"hex.60.bh" = "알맞게 절제합니다. 모든 일을 적당한 선에서 멈추고 들어오는 만큼 써야 하지만, 지나치게 가혹한 절제도 오래가지 못합니다.";
"hex.61.name" = "풍택중부"; "hex.61.full" = "풍택중부";
"hex.61.bh" = "마음속에 진실한 믿음이 있습니다. 진심으로 남을 감화시키면, 정성이 닿는 곳에서는 어려운 일도 이룰 수 있습니다.";
"hex.62.name" = "뇌산소과"; "hex.62.full" = "뇌산소과";
"hex.62.bh" = "조금 지나칩니다. 작은 일을 하고 자세를 낮추는 것이 좋으며, 분에 넘치게 높은 것만 바라서는 안 됩니다.";
"hex.63.name" = "수화기제"; "hex.63.full" = "수화기제";
"hex.63.bh" = "일이 이미 이루어졌습니다. 성공한 뒤에는 느슨해지기 쉬우니, 편안할 때 위태로움을 생각하고 미리 화를 막아야 합니다.";
"hex.64.name" = "화수미제"; "hex.64.full" = "화수미제";
"hex.64.bh" = "일이 아직 완성되지 않았습니다. 아직 과정 중에 있으니 신중하게 마무리하고 방향을 잘 가리면, 결국 이룰 때가 옵니다.";
