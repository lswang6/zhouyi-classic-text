/* Korean — hexagram names, full names, plain-language interpretations; trigrams in 先天 order */

"tri.1.k" = "건"; "tri.1.nat" = "하늘";
"tri.2.k" = "태"; "tri.2.nat" = "못";
"tri.3.k" = "리"; "tri.3.nat" = "불";
"tri.4.k" = "진"; "tri.4.nat" = "우레";
"tri.5.k" = "손"; "tri.5.nat" = "바람";
"tri.6.k" = "감"; "tri.6.nat" = "물";
"tri.7.k" = "간"; "tri.7.nat" = "산";
"tri.8.k" = "곤"; "tri.8.nat" = "땅";

"hex.1.name" = "중천건"; "hex.1.full" = "중천건";
"hex.1.bh" = "하늘이 겹치고 여섯 효가 모두 양인 괘로, 쉼 없는 창조의 힘을 상징합니다. 괘사는 이를 ‘원형(元亨)’, 곧 크고 근원이 되는 것이라 부르며, 효사는 깊은 못에 잠긴 용이 밭에 나타나고 하늘을 날다가 마침내 너무 높이 오르는 데까지를 따라갑니다.";
"hex.2.name" = "중지곤"; "hex.2.full" = "중지곤";
"hex.2.bh" = "땅이 겹치고 여섯 효가 모두 음인 괘로, 만물을 싣고 떠받치는 대지를 상징합니다. 괘사는 그 굳건함을 암말에 비유하고, 효사는 단단한 얼음을 예고하는 서리에서 들판에서 싸우는 용들에 이르기까지 이어집니다.";
"hex.3.name" = "수뢰둔"; "hex.3.full" = "수뢰둔";
"hex.3.bh" = "아래에는 우레, 위에는 구름이 있어 폭풍 속에서 땅을 뚫고 나오는 새싹을 상징합니다. 본문은 처음 시작할 때의 혼란을 다루며, 효사에는 멈춰 선 말과 수레, 처음에는 거절당하는 구혼자, 안내자 없이 헤매는 사냥꾼이 나옵니다.";
"hex.4.name" = "산수몽"; "hex.4.full" = "산수몽";
"hex.4.bh" = "산기슭에서 솟아나는 샘으로, 어리고 미숙함을 상징합니다. 괘사는 스승과 제자를 그려, 어린이가 스승을 찾고 같은 물음을 거듭하면 답을 얻지 못한다고 말합니다. 효사는 규율과 인내, 배우지 못한 어린이를 다룹니다.";
"hex.5.name" = "수천수"; "hex.5.full" = "수천수";
"hex.5.bh" = "비가 내리기 전 하늘로 피어오르는 구름으로, 기다림을 상징합니다. 괘사는 기다림을 성실함 및 큰 내를 건너는 일과 연결하고, 효사는 교외에서, 모래밭에서, 진흙 속에서, 술과 음식 자리에서, 그리고 마침내 구덩이 속에서 기다리는 모습을 그립니다.";
"hex.6.name" = "천수송"; "hex.6.full" = "천수송";
"hex.6.bh" = "하늘은 위로 움직이고 물은 아래로 흘러 서로 멀어지니, 다툼과 송사를 상징합니다. 괘사는 다툼을 중도에 멈추는 것과 끝까지 밀어붙이는 것을 대비하고, 효사는 그만둔 다툼, 고향으로의 물러남, 하루에 세 번 빼앗기는 영예의 가죽 띠를 그립니다.";
"hex.7.name" = "지수사"; "hex.7.full" = "지수사";
"hex.7.bh" = "땅속에 담긴 물로, 백성 속에서 끌어낸 힘을 상징합니다. 본문은 군대의 규율과 노련한 지휘자의 필요를 다루며, 효사는 질서 있는 출정에서 시작해 시신을 실은 수레를 거쳐 전쟁이 끝나 군주가 상을 내리는 데까지 나아갑니다.";
"hex.8.name" = "수지비"; "hex.8.full" = "수지비";
"hex.8.bh" = "땅 위를 흐르는 물로, 서로 가까이하여 하나로 합치는 모습을 상징합니다. 괘사는 하나 되려고 오는 이들과 늦게 오는 이를 말하고, 효사는 성실함에 바탕을 둔 결합, 안에서의 결합과 밖에서의 결합, 그리고 머리 없는 결합을 그립니다.";
"hex.9.name" = "풍천소축"; "hex.9.full" = "풍천소축";
"hex.9.bh" = "하늘을 가로지르는 바람으로, 잠시 붙들어 두는 온화한 힘을 상징합니다. 괘사의 ‘서쪽 교외에서 짙은 구름이 일지만 비는 내리지 않는다’는 구절이 주제를 이루고, 효사는 자신의 도로 돌아옴, 바큇살이 빠진 수레, 그리고 마침내 내리는 비를 보여 줍니다.";
"hex.10.name" = "천택리"; "hex.10.full" = "천택리";
"hex.10.bh" = "못 위에 하늘이 있어 위아래의 올바른 질서를 상징합니다. 괘사는 물지 않는 호랑이의 꼬리를 밟는 모습을 들고, 효사는 소박한 행실, 조용하고 평탄한 도, 한쪽 눈으로 보려는 사람, 그리고 마지막으로 걸어온 발자취를 돌아봄을 따라갑니다.";
"hex.11.name" = "지천태"; "hex.11.full" = "지천태";
"hex.11.bh" = "위에는 땅, 아래에는 하늘이 있어 그 기(氣)가 서로 만나니, 하늘과 땅의 조화를 상징합니다. 괘사는 ‘작은 것이 가고 큰 것이 온다’고 말하고, 효사는 뿌리째 함께 뽑히는 띠풀에서 ‘평평하기만 하고 기울지 않는 것은 없다’를 거쳐 성벽이 다시 해자로 무너지는 데까지 나아갑니다.";
"hex.12.name" = "천지비"; "hex.12.full" = "천지비";
"hex.12.bh" = "위에는 하늘, 아래에는 땅이 있어 서로 멀어지고 닿지 않으니, 막힘을 상징합니다. 괘사는 ‘큰 것이 가고 작은 것이 온다’고 말하고, 효사는 나쁜 때를 견디는 데서 시작해 우거진 뽕나무 떨기에 존망을 매어 두는 단계를 거쳐 마침내 막힘이 뒤집히는 데까지 나아갑니다.";
"hex.13.name" = "천화동인"; "hex.13.full" = "천화동인";
"hex.13.bh" = "하늘 아래 불이 있어 둘 다 위로 향하니, 공동의 뜻으로 뭉친 사람들을 상징합니다. 괘사는 동지의 사귐을 탁 트인 들판에 두고, 효사는 문 앞에서의 사귐, 한 일족 안의 사귐, 수풀에 숨긴 군사, 처음에는 울부짖다가 나중에는 웃는 동지들을 따라갑니다.";
"hex.14.name" = "화천대유"; "hex.14.full" = "화천대유";
"hex.14.bh" = "하늘 높이 있어 아래의 모든 것을 비추는 불로, 크게 소유함을 상징합니다. 괘사는 ‘크게 형통한다(元亨)’고 말하고, 효사는 부에 따르는 책임을 다룹니다. 짐을 싣는 큰 수레, 천자에게 바치는 공물, 지나침 없이 지니는 풍요가 그것입니다.";
"hex.15.name" = "지산겸"; "hex.15.full" = "지산겸";
"hex.15.bh" = "땅속에 숨은 산으로, 스스로를 낮추는 위대함을 상징합니다. 괘사는 군자가 일을 끝까지 이룬다고 말하고, 효사는 겸손의 여러 모습을 그립니다. 겸손함에도 겸손한 것, 소리로 드러나는 겸손, 공로와 함께하는 겸손입니다.";
"hex.16.name" = "뇌지예"; "hex.16.full" = "뇌지예";
"hex.16.bh" = "땅에서 터져 나오는 우레로, 풀려나 만물을 움직이게 하는 힘을 상징합니다. 대상전은 이를 옛 왕들이 지은 음악과 연결하고, 효사는 자랑하거나 자기에 빠진 열광과 바위처럼 굳은 품성을 대비합니다.";
"hex.17.name" = "택뢰수"; "hex.17.full" = "택뢰수";
"hex.17.bh" = "못 속에 쉬는 우레로, 때를 따르고 그에 맞추어 가는 모습을 상징합니다. 괘사는 따름을 굳건함 및 올바름과 연결하고, 효사는 작은 것이나 큰 것에 매이는 일, 바른 도에서의 성실함, 충성으로 굳게 묶인 사람을 보여 줍니다.";
"hex.18.name" = "산풍고"; "hex.18.full" = "산풍고";
"hex.18.bh" = "사물이 정체되는 산기슭에 부는 바람으로, 바로잡아야 할 부패를 상징합니다. 괘사는 새로 시작하기 전 사흘과 후 사흘을 말하고, 효사는 아버지와 어머니가 썩게 내버려 둔 것을 바로잡는 일을 다루며, 맨 위 효는 왕이나 제후를 섬기지 않습니다.";
"hex.19.name" = "지택림"; "hex.19.full" = "지택림";
"hex.19.bh" = "못 위에 땅이 있어 윗사람이 아랫사람에게 다가가는 모습을 상징합니다. 괘사는 순환이 바뀌는 여덟째 달에 대한 경계를 덧붙이고, 효사는 함께 다가감, 손쉽게 다가감, 극진히 다가감, 지혜롭게 다가감, 너그럽게 다가감을 그립니다.";
"hex.20.name" = "풍지관"; "hex.20.full" = "풍지관";
"hex.20.bh" = "땅 위를 지나는 바람으로, 보는 것과 보이는 것을 상징합니다. 괘사는 손을 씻었으나 아직 제물을 올리지 않은 제사 드리는 이를 그리고, 효사는 어린아이의 봄과 문틈으로 엿봄에서 자신의 삶을 살핌으로 넓어집니다.";
"hex.21.name" = "화뢰서합"; "hex.21.full" = "화뢰서합";
"hex.21.bh" = "우레와 번개가 함께하니, 위아래 턱 사이에 끼어 깨물어 끊어야 할 장애를 상징합니다. 본문은 법과 형벌의 사용을 다루며, 효사는 차꼬에 채인 발에서 연한 고기와 말린 고기를 씹는 단계를 거쳐 칼을 쓴 목으로 나아갑니다.";
"hex.22.name" = "산화비"; "hex.22.full" = "산화비";
"hex.22.bh" = "산기슭에서 산을 밝히는 불로, 아름다움과 꾸밈을 상징합니다. 괘사는 작은 일만 허락하고, 효사는 꾸민 발과 수염에서 윤기 나는 촉촉함과 흰 말을 거쳐 그저 흰 바탕이 된 꾸밈으로 나아갑니다.";
"hex.23.name" = "산지박"; "hex.23.full" = "산지박";
"hex.23.bh" = "다섯 음효 위에 양효 하나가 있어, 땅 위에 놓여 깎여 나가는 산의 모습입니다. 효사는 침상이 다리부터, 다음에는 틀이, 그리고 살갗까지 깎이는 모습을 보여 주며, 맨 위에는 큰 과일이 먹히지 않은 채 남아 있습니다.";
"hex.24.name" = "지뢰복"; "hex.24.full" = "지뢰복";
"hex.24.bh" = "땅속의 우레로, 동지에 빛이 돌아오는 모습을 상징합니다. 괘사는 이레 만의 돌아옴을 말하고, 효사는 빠른 돌아옴, 조용한 돌아옴, 거듭된 돌아옴, 홀로 걸음, 그리고 혼미하여 놓친 돌아옴을 구별합니다.";
"hex.25.name" = "천뢰무망"; "hex.25.full" = "천뢰무망";
"hex.25.bh" = "하늘 아래 울리는 우레로, 거짓 없이 저마다의 본성에서 움직이는 모습을 상징합니다. 괘사는 무망(无妄)을 올바름과 연결하고, 효사에는 한 사람이 매어 둔 소를 지나가던 사람이 끌고 가는 이야기와 약 없이 낫는 병이 들어 있습니다.";
"hex.26.name" = "산천대축"; "hex.26.full" = "산천대축";
"hex.26.bh" = "산속에 품긴 하늘로, 큰 힘이 억제되고 쌓이는 모습을 상징합니다. 대상전은 옛 사람들의 말과 행실을 많이 쌓아 두는 일을 말하고, 효사는 굴대를 뺀 수레와 뿔에 가로나무를 댄 어린 소에서 시작해 맨 위에서 하늘의 도가 열리는 데까지 이어집니다.";
"hex.27.name" = "산뢰이"; "hex.27.full" = "산뢰이";
"hex.27.bh" = "산 아래 우레가 있어 음식을 무는 턱과 같으니, 양육을 상징합니다. 괘사는 사람이 무엇으로 입을 채우려 하는지에 주의를 돌리고, 효사는 자신의 신령한 거북을 버리고 남의 음식을 바라보는 이와 올바른 원천에서 얻는 양식을 대비합니다.";
"hex.28.name" = "택풍대과"; "hex.28.full" = "택풍대과";
"hex.28.bh" = "못이 나무 위까지 차오르니, 지나친 무게에 처지는 용마루를 상징합니다. 본문은 비상한 때를 다루며, 효사에는 흰 띠풀 자리, 새싹을 틔우는 마른 버들, 처진 용마루, 물이 머리 위로 넘치는 건넘이 나옵니다.";
"hex.29.name" = "중수감"; "hex.29.full" = "중수감";
"hex.29.bh" = "물이 겹쳐 골짜기에서 골짜기로 흘러가니, 거듭되는 위험을 상징합니다. 괘사는 성실함과 흐림 없는 마음을 내세우고, 효사는 구덩이 속의 구덩이, 창문으로 들여보내는 술과 밥, 노끈에 묶인 포로를 말합니다.";
"hex.30.name" = "중화리"; "hex.30.full" = "중화리";
"hex.30.bh" = "불이 겹쳐 밝음 위에 밝음이 있으니, 비추는 대상에 붙어 있는 빛을 상징합니다. 괘사는 암소를 기르는 일을 덧붙이고, 효사는 흐트러진 발걸음에서 누런 빛과 지는 해를 거쳐 갑자기 타오르는 불꽃과 왕의 정벌로 나아갑니다.";
"hex.31.name" = "택산함"; "hex.31.full" = "택산함";
"hex.31.bh" = "산 위에 놓인 못으로, 젊은 남녀가 서로 끌리는 모습을 상징합니다. 괘사는 아내를 맞는 일을 언급하고, 효사는 엄지발가락, 장딴지, 넓적다리, 등, 마지막으로 턱과 혀로 몸을 따라 올라갑니다.";
"hex.32.name" = "뇌풍항"; "hex.32.full" = "뇌풍항";
"hex.32.bh" = "늘 함께 있는 우레와 바람으로, 오래 지속되는 것을 상징합니다. 대상전은 방법을 바꾸지 않고 굳게 서 있는 모습을 그리고, 효사는 지속을 너무 서둘러 구함, 한결같지 않은 품성, 사냥감이 없는 밭을 대비합니다.";
"hex.33.name" = "천산둔"; "hex.33.full" = "천산둔";
"hex.33.bh" = "하늘 아래 솟은 산과 그 앞에서 물러나는 하늘로, 물러남을 상징합니다. 괘사는 작은 세력이 나아올 때 제때 물러나는 일을 다루며, 효사는 물러나는 행렬의 꼬리, 누런 소가죽으로 단단히 묶인 이에서 서두르지 않고 기꺼이 물러남까지 걸쳐 있습니다.";
"hex.34.name" = "뇌천대장"; "hex.34.full" = "뇌천대장";
"hex.34.bh" = "하늘 높이 울리는 우레로, 움직이는 큰 힘을 상징합니다. 대상전은 힘을 예(禮)와 연결하고, 효사는 울타리를 들이받아 뿔이 걸린 숫양과 마침내 열리는 울타리를 보여 줍니다.";
"hex.35.name" = "화지진"; "hex.35.full" = "화지진";
"hex.35.bh" = "땅 위로 떠오르는 해로, 빠르고 거침없는 나아감을 상징합니다. 괘사는 많은 말을 하사받고 하루에 세 번 접견받는 제후를 그리고, 효사는 가로막히거나 근심하는 나아감을 들쥐의 나아감, 뿔로 나아가는 이의 나아감과 대비합니다.";
"hex.36.name" = "지화명이"; "hex.36.full" = "지화명이";
"hex.36.bh" = "땅 아래로 진 해로, 상처 입고 감추어진 밝음을 상징합니다. 본문은 어둠의 시대에 자신의 빛을 감추는 일을 기자(箕子)의 예와 함께 말하며, 효사에는 날개를 늘어뜨리고 나는 꿩과 남쪽에서의 사냥이 들어 있습니다.";
"hex.37.name" = "풍화가인"; "hex.37.full" = "풍화가인";
"hex.37.bh" = "불에서 일어나는 바람으로, 안에서 밖으로 영향이 퍼져 나가는 가족을 상징합니다. 괘사는 여성의 역할을 강조하고, 효사는 집안의 엄격한 규칙, 식사 준비, 그리고 가족에 대한 왕의 감화를 다룹니다.";
"hex.38.name" = "화택규"; "hex.38.full" = "화택규";
"hex.38.bh" = "못 위의 불이 서로 멀어지니, 대립과 소원함을 상징합니다. 괘사는 작은 일을 허락하고, 효사에는 저절로 돌아오는 잃은 말, 좁은 골목에서 주군을 만남, 진흙을 뒤집어쓴 돼지가 들어 있습니다.";
"hex.39.name" = "수산건"; "hex.39.full" = "수산건";
"hex.39.bh" = "산 위의 물로, 앞에 놓인 위험한 행로를 상징합니다. 괘사는 서남과 동북을 대비하고 대인을 만나는 일을 말하며, 효사는 나아가 장애에 부딪히는 것과 돌아와 도움을 얻는 것을 번갈아 그립니다.";
"hex.40.name" = "뇌수해"; "hex.40.full" = "뇌수해";
"hex.40.bh" = "폭풍의 긴장을 풀어 주는 우레와 비로, 풀려남을 상징합니다. 괘사는 어려움이 지나가면 일찍 돌아오는 일을 말하고, 효사에는 여우 세 마리를 잡음, 수레를 탄 짐꾼, 높은 담 위의 매를 쏨이 들어 있습니다.";
"hex.41.name" = "산택손"; "hex.41.full" = "산택손";
"hex.41.bh" = "산기슭의 못에서 물이 올라가 위의 비탈을 적시니, 덜어냄을 상징합니다. 괘사는 두 개의 작은 그릇으로도 제사를 드릴 수 있다고 하고, 효사는 아래를 덜어 위를 더하는 일과 줌으로써 얻는 것을 다룹니다.";
"hex.42.name" = "풍뢰익"; "hex.42.full" = "풍뢰익";
"hex.42.bh" = "서로를 북돋는 바람과 우레로, 더함을 상징합니다. 본문은 위가 아래에 베푸는 일을 다루며, 대상전은 이를 선으로 나아가는 일과 연결합니다. 효사에는 열 쌍의 거북 등딱지 선물과 한결같지 않은 마음이 들어 있습니다.";
"hex.43.name" = "택천쾌"; "hex.43.full" = "택천쾌";
"hex.43.bh" = "하늘보다 높이 오른 못으로, 돌파를 상징합니다. 괘사는 왕의 조정에서 일을 드러내어 알리는 일을 말하고, 효사는 그릇됨에 맞서는 결연한 행동을 다룹니다. 너무 서둘러 나아감, 뽑혀 나가는 잡초, 비에 흠뻑 젖는 홀로 가는 나그네가 그것입니다.";
"hex.44.name" = "천풍구"; "hex.44.full" = "천풍구";
"hex.44.bh" = "하늘 아래 부는 바람으로, 하나의 음효가 다섯 양효를 만나러 오는 모습을 상징합니다. 괘사는 이러한 여자를 아내로 맞는 것을 경계하며, 효사에는 통 속의 물고기, 버들잎으로 덮은 참외, 뿔로 만남이 들어 있습니다.";
"hex.45.name" = "택지췌"; "hex.45.full" = "택지췌";
"hex.45.bh" = "땅 위로 차오른 못으로, 모인 물과 모여드는 사람들을 상징합니다. 괘사는 왕이 사당에 이르는 일과 큰 제물을 언급하고, 효사는 처음의 모임, 이끌려 모임, 헤어짐을 탄식함, 눈물 흘림을 다룹니다.";
"hex.46.name" = "지풍승"; "hex.46.full" = "지풍승";
"hex.46.bh" = "땅속에서 자라 오르는 나무로, 꾸준한 상승을 상징합니다. 괘사는 대인을 만나는 일과 남쪽으로 나아감을 언급하고, 효사는 빈 고을로 오름, 기산(岐山)에서 왕이 올리는 제사, 계단을 오름을 따라갑니다.";
"hex.47.name" = "택수곤"; "hex.47.full" = "택수곤";
"hex.47.bh" = "물이 빠져 버린 못으로, 곤궁과 역경을 상징합니다. 괘사는 그런 때에는 말이 믿어지지 않는다고 하고, 효사에는 잎 없는 나무 아래, 술과 음식 속, 바위와 가시덤불 사이, 뻗어 나가는 덩굴에 얽힌 곤궁이 들어 있습니다.";
"hex.48.name" = "수풍정"; "hex.48.full" = "수풍정";
"hex.48.bh" = "물속으로 내려가 물을 퍼 올리는 나무로, 마르지 않는 양식의 원천인 우물을 상징합니다. 괘사는 고을은 옮겨도 우물은 옮기지 않는다(改邑不改井)고 하며, 효사는 진흙으로 흐려져 쓰이지 않는 우물에서 모두에게 열려 있는 우물로 나아갑니다.";
"hex.49.name" = "택화혁"; "hex.49.full" = "택화혁";
"hex.49.bh" = "못 속의 불이 서로 끄려 하니, 근본적인 변혁을 상징합니다. 괘사는 변혁이 완성된 날에야 믿어진다고 말하고, 효사는 누런 소가죽으로 묶인 변혁, 호랑이처럼 변하는 대인, 표범처럼 변하는 군자를 따라갑니다.";
"hex.50.name" = "화풍정"; "hex.50.full" = "화풍정";
"hex.50.bh" = "나무 위의 불로, 제물과 잔치 음식을 삶는 청동 솥인 정(鼎)을 상징합니다. 괘사는 크게 형통함을 말하고, 효사는 엎어서 비우는 솥에서 부러진 다리와 바뀐 귀를 거쳐 금과 옥으로 된 고리로 나아갑니다.";
"hex.51.name" = "중뢰진"; "hex.51.full" = "중뢰진";
"hex.51.bh" = "우레가 겹친 괘로, 충격과 두려움을 상징합니다. 괘사는 놀람 뒤에 웃음이 따르는 모습과 제사의 숟가락과 술을 놓치지 않는 사람을 그리고, 효사는 재물을 잃고 아홉 언덕을 오르는 데서 진흙에 빠져 움직이지 못하는 데까지 충격에 대한 반응을 따라갑니다.";
"hex.52.name" = "중산간"; "hex.52.full" = "중산간";
"hex.52.bh" = "산이 겹친 괘로, 멈춤과 쉼을 상징합니다. 괘사는 등을 고요히 하고 뜰을 걸어도 아무도 보지 않는 모습을 그리고, 효사는 발가락, 장딴지, 허리, 몸통, 턱으로 몸을 따라 올라가 맨 위의 고결한 멈춤에 이릅니다.";
"hex.53.name" = "풍산점"; "hex.53.full" = "풍산점";
"hex.53.bh" = "산 위에서 자라는 나무로, 점진적인 발전을 상징합니다. 괘사는 처녀의 시집감을 예로 들고, 효사는 물가에서 바위, 고원, 나무, 산꼭대기, 그리고 그 너머 높은 곳으로 한 걸음씩 나아가는 기러기를 따라갑니다.";
"hex.54.name" = "뇌택귀매"; "hex.54.full" = "뇌택귀매";
"hex.54.bh" = "못 위의 우레로, 소실로 시집가는 누이동생을 상징합니다. 대상전은 처음에서 끝을 아는 일을 성찰하고, 효사에는 다리를 절면서도 걷는 이, 한쪽 눈으로 보는 이, 늦어지는 혼인, 들러리보다 수수한 신부의 소매가 들어 있습니다.";
"hex.55.name" = "뇌화풍"; "hex.55.full" = "뇌화풍";
"hex.55.bh" = "함께 이르는 우레와 번개로, 정점에 이른 풍요를 상징합니다. 괘사는 왕을 한낮의 해에 비유하고, 효사는 가려져 한낮에 별이 보이는 해와 텅 빈 채 서 있는 큰 집을 그립니다.";
"hex.56.name" = "화산려"; "hex.56.full" = "화산려";
"hex.56.bh" = "산 위의 불이 타면서 옮겨 가니, 나그네를 상징합니다. 괘사는 작은 일을 허락하고, 효사는 하인과 재물이 있거나 없는 채로 여관에 머무는 나그네와, 떠도는 이가 처음엔 웃다가 나중엔 우는 사이 불타는 새 둥지를 그립니다.";
"hex.57.name" = "중풍손"; "hex.57.full" = "중풍손";
"hex.57.bh" = "바람이 겹쳐 어디에나 스며드니, 온순하고 스며드는 것을 상징합니다. 괘사는 작은 형통과 대인을 만남을 말하고, 효사에는 침상 아래의 사관과 무당, 세 가지 쓰임을 위해 잡은 사냥감, 변화 전 사흘과 후 사흘이 들어 있습니다.";
"hex.58.name" = "중택태"; "hex.58.full" = "중택태";
"hex.58.bh" = "못이 겹쳐 두 호수가 서로를 적시니, 함께 나누는 기쁨을 상징합니다. 대상전은 이를 벗과 함께 강론하고 익히는 일과 연결하며, 효사는 조화롭고 진실한 기쁨을 구하거나 계산하거나 유혹하는 기쁨과 대비합니다.";
"hex.59.name" = "풍수환"; "hex.59.full" = "풍수환";
"hex.59.bh" = "물 위를 부는 바람으로, 굳거나 갈라진 것을 풀어 흩는 모습을 상징합니다. 괘사는 왕이 사당에 이르는 일과 큰 물을 건너는 일을 언급하고, 효사에는 자기를 흩음, 무리를 흩음, 땀처럼 퍼지는 큰 외침이 들어 있습니다.";
"hex.60.name" = "수택절"; "hex.60.full" = "수택절";
"hex.60.bh" = "일정한 양만 담을 수 있는 못 위의 물로, 한계와 절제를 상징합니다. 괘사는 가혹하고 쓴 절제는 오래갈 수 없다고 말하고, 효사는 뜰 밖으로 나가지 않음, 편안히 받아들이는 절제, 쓴 절제를 대비합니다.";
"hex.61.name" = "풍택중부"; "hex.61.full" = "풍택중부";
"hex.61.bh" = "못 위의 바람으로, 돼지와 물고기에까지 미치는 성실함을 상징합니다. 효사에는 그늘에서 우는 학과 이에 화답하는 새끼, 함께 나누는 술 한 잔, 짝 말이 떠나 버린 말, 하늘로 날아오르려는 닭이 들어 있습니다.";
"hex.62.name" = "뇌산소과"; "hex.62.full" = "뇌산소과";
"hex.62.bh" = "산 위의 우레로, 작은 것이 지나침을 상징합니다. 괘사는 울음소리가 들리는 나는 새를 그리며 작은 일과 큰 일을 대비하고, 효사는 너무 높이 나는 새와 할아버지를 지나쳐 할머니를 만남을 보여 줍니다.";
"hex.63.name" = "수화기제"; "hex.63.full" = "수화기제";
"hex.63.bh" = "불 위의 물로 모든 효가 제자리에 있으니, 완성된 것을 상징합니다. 괘사는 처음의 질서와 끝의 어지러움을 말하고, 효사에는 바퀴를 붙드는 제동, 잃어버린 수레 가리개, 머리를 적시는 여우가 들어 있습니다.";
"hex.64.name" = "화수미제"; "hex.64.full" = "화수미제";
"hex.64.bh" = "물 위의 불로 어느 효도 제자리에 있지 않으니, 아직 끝나지 않은 이행을 상징합니다. 괘사는 내를 거의 다 건넌 어린 여우가 꼬리를 적시는 모습을 그리고, 효사는 그 미완의 건넘에서 마지막에 믿음 속에 마시는 술로 나아갑니다.";
