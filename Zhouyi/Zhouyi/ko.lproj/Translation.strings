/* 周易 · ko · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: ko.json */
"hex.1.ci" = "일을 시작하고, 형통하게 하며, 조화롭게 이로움을 주고, 바른 도리를 굳게 지키는 네 가지 덕을 갖춘다.";
"hex.1.daxiang" = "하늘은 굳세게 쉬지 않고 움직인다. 군자는 이를 본받아 끊임없이 스스로 힘쓴다.";
"hex.1.yao.0" = "용이 물속에 숨어 있다. 아직은 행동에 나서지 않는 것이 좋다.";
"hex.1.yao.1" = "용이 들판에 나타난다. 덕이 높은 큰 인물을 만나면 이롭다.";
"hex.1.yao.2" = "군자가 온종일 부지런히 힘쓰고, 저녁에도 위험 속에 있듯 경계하고 두려워하면 허물이 없다.";
"hex.1.yao.3" = "용이 때에 따라 뛰어오르기도 하고 깊은 못으로 물러나기도 한다. 허물이 없다.";
"hex.1.yao.4" = "용이 하늘 높이 난다. 덕이 높은 큰 인물을 만나면 이롭다.";
"hex.1.yao.5" = "용이 너무 높이 날아 극점에 이르니 후회가 생긴다.";
"hex.2.ci" = "일을 시작하여 형통하다. 암말처럼 유순하게 바른 도리를 지키면 이롭다. 군자가 나아갈 때 앞서면 길을 잃고, 뒤따르면 주인을 만나 이롭다. 서남쪽에서는 벗을 얻고 동북쪽에서는 벗을 잃는다. 편안히 바른 도리를 지키면 길하다.";
"hex.2.daxiang" = "대지는 유순하고 넓고 두텁다. 군자는 이를 본받아 두터운 덕으로 만물을 받쳐 준다.";
"hex.2.yao.0" = "서리를 밟으면 단단한 얼음이 얼 때가 다가옴을 안다(작은 조짐이 보일 때 화를 막는다는 비유).";
"hex.2.yao.1" = "곧고 바르며 도량이 크다. 애써 익히지 않아도 이롭지 않은 것이 없다.";
"hex.2.yao.2" = "아름다운 덕을 품되 드러내지 않으니 바른 도리를 지킬 수 있다. 왕의 일을 돕더라도 공을 내세우지 않고 끝까지 완수한다.";
"hex.2.yao.3" = "자루의 입구를 단단히 묶는다(말을 삼가고 신중히 한다는 비유). 허물도 없고 칭찬도 없다.";
"hex.2.yao.4" = "노란 아랫옷을 입는다(노란색은 중앙의 색이고 아랫옷은 아래에 입으니, 중도를 지키고 겸손함을 뜻한다). 크게 길하다.";
"hex.2.yao.5" = "용이 들판에서 싸워 그 피에 검푸른색과 노란색이 섞인다(검푸른색은 하늘, 노란색은 땅의 색으로, 음양이 다투어 양쪽 다 상처 입는다는 비유).";
"hex.3.ci" = "일을 시작하여 형통하다. 바른 도리를 지키면 이롭다. 서둘러 나아가서는 안 된다. 제후를 세우면 이롭다(군주를 세우고 도움을 구한다는 비유).";
"hex.3.daxiang" = "위에 구름이 있고 아래에 우레가 있는 것이 수뢰둔이다. 군자는 이를 본받아 실을 정리하듯 천하를 다스릴 일을 계획한다.";
"hex.3.yao.0" = "머뭇거리며 나아가지 못한다. 머물러 바른 도리를 지키면 이롭고, 제후를 세우면 이롭다.";
"hex.3.yao.1" = "어려움 속에 머뭇거리며 말을 타고 맴돈다. 온 사람은 도적이 아니라 구혼자다. 여자는 바른 도리를 지켜 혼인을 거절하다가 십 년이 지나서야 허락한다.";
"hex.3.yao.2" = "우인(산림을 관리하는 벼슬아치)의 안내 없이 사슴을 쫓으면 숲에 빠질 뿐이다. 군자는 낌새를 알아차리고 그만두는 편이 낫다. 억지로 나아가면 아쉬움이 남는다.";
"hex.3.yao.3" = "말을 타고 머뭇거리지만 혼인을 청하러 나아가면 길하고, 이롭지 않은 것이 없다.";
"hex.3.yao.4" = "은혜가 쌓여 널리 베풀기 어렵다. 작은 일에서 바른 도리를 지키면 길하지만, 큰 일에서는 바른 도리를 지켜도 흉하다.";
"hex.3.yao.5" = "말을 타고 맴돌며 피눈물을 하염없이 흘린다.";
"hex.4.ci" = "형통하다. 내가 무지한 아이를 찾는 것이 아니라 아이가 내게 가르침을 구한다. 처음 점을 물으면 알려 주지만, 거듭 묻는 것은 모독이므로 더는 알려 주지 않는다. 바른 도리를 지키면 이롭다.";
"hex.4.daxiang" = "산 아래에서 샘이 솟는 것이 산수몽이다. 군자는 이를 본받아 과감하게 행동하고 덕을 기른다.";
"hex.4.yao.0" = "무지를 깨우치려면 형벌로 사람을 바로잡아 속박에서 벗어나게 하면 이롭다. 형벌만 계속 쓰면 아쉬움이 남는다.";
"hex.4.yao.1" = "무지한 이를 포용하면 길하고, 아내를 맞으면 길하다. 아들이 집안을 꾸려 나갈 수 있다.";
"hex.4.yao.2" = "부유한 남자를 보면 몸가짐을 돌보지 않는 여자를 아내로 맞아서는 안 된다. 이로울 것이 없다.";
"hex.4.yao.3" = "무지에 갇혀 있으니 아쉬움이 남는다.";
"hex.4.yao.4" = "아이처럼 순박하게 가르침을 구하면 길하다.";
"hex.4.yao.5" = "무지를 엄하게 바로잡는다. 도적처럼 지나치게 해서는 이롭지 않고, 침해를 막는 것이 이롭다.";
"hex.5.ci" = "진실한 믿음을 품으면 밝게 형통하고, 바른 도리를 지키면 길하다. 큰 강을 건너면 이롭다(위험을 무릅쓰고 일을 이룬다는 비유).";
"hex.5.daxiang" = "구름이 하늘로 오르는 것(비 내릴 때를 기다림)이 수천수이다. 군자는 이를 본받아 먹고 마시며 잔치를 즐기고, 편안히 때를 기다린다.";
"hex.5.yao.0" = "먼 들에서 기다린다. 한결같은 태도를 지키면 이롭고 허물이 없다.";
"hex.5.yao.1" = "모래밭에서 기다린다. 말다툼이 조금 있으나 끝내 길하다.";
"hex.5.yao.2" = "진흙 속에서 기다리다가 도적을 불러들인다.";
"hex.5.yao.3" = "피 속에서 기다리지만(해를 입는 곳에 있다는 비유), 구덩이에서 빠져나올 수 있다.";
"hex.5.yao.4" = "술과 음식을 즐기며 편안히 기다린다. 바른 도리를 지키면 길하다.";
"hex.5.yao.5" = "구덩이에 빠진다. 청하지 않은 손님 세 사람이 오지만, 공손히 대하면 끝내 길하다.";
"hex.6.ci" = "진실한 믿음을 품어도 가로막힌다. 경계하며 알맞은 선에서 멈추면 길하지만, 끝까지 다투면 흉하다. 덕이 높은 큰 인물을 만나면 이롭다(공정한 판결을 구한다는 뜻). 큰 강을 건너는 것은 이롭지 않다.";
"hex.6.daxiang" = "하늘은 위로, 물은 아래로 서로 어긋나게 움직이는 것이 천수송이다. 군자는 이를 본받아 일을 시작할 때부터 빈틈없이 계획한다(다툼을 막기 위해서다).";
"hex.6.yao.0" = "송사를 오래 끌지 않는다. 말다툼이 조금 있으나 끝내 길하다.";
"hex.6.yao.1" = "송사에서 이기지 못해 돌아와 몸을 피한다. 그 영지는 삼백 가구에 불과하니 재앙이 없다.";
"hex.6.yao.2" = "예전부터 받은 녹봉과 은혜에 만족하며 바른 도리를 지켜 위험에 대비하면 끝내 길하다. 왕의 일을 돕더라도 공을 내세우지 않는다.";
"hex.6.yao.3" = "송사에서 이기지 못해 돌아와 올바른 이치를 따른다. 처음 뜻을 바꾸고 편안히 바른 도리를 지키면 길하다.";
"hex.6.yao.4" = "송사를 주관한다(공정하게 판결한다). 크게 길하다.";
"hex.6.yao.5" = "송사로 화려한 허리띠를 하사받더라도 하루 안에 세 번이나 빼앗긴다.";
"hex.7.ci" = "바른 도리를 지키고 덕망 높은 어른이 이끌면 길하고 허물이 없다.";
"hex.7.daxiang" = "땅속에 물이 있는 것이 지수사이다. 군자는 이를 본받아 백성을 포용하고 기른다.";
"hex.7.yao.0" = "군대가 출정할 때는 기율로 다스려야 한다. 기율이 바르지 않으면 흉하다.";
"hex.7.yao.1" = "군대의 중심에서 지휘하면 길하고 허물이 없다. 왕이 여러 차례 포상하는 명을 내린다.";
"hex.7.yao.2" = "군대가 시신을 싣고 돌아오게 될 수 있다. 흉하다.";
"hex.7.yao.3" = "군대가 물러나 주둔한다. 허물이 없다.";
"hex.7.yao.4" = "밭에 짐승이 있다(적이 침입했다는 비유). 죄를 묻고 사로잡으면 이로우며 허물이 없다. 맏아들이 군대를 이끌어야 한다. 덕 없는 젊은이에게 맡기면 시신을 싣고 돌아오니, 바른 도리를 지켜도 흉하다.";
"hex.7.yao.5" = "천자가 명을 내려 공신을 포상하고, 나라를 세워 제후가 되게 하거나 가문을 이어 경대부가 되게 한다. 소인은 등용해서는 안 된다.";
"hex.8.ci" = "길하다. 점의 본뜻을 살펴, 일을 시작하고 오래 지속하며 바른 도리를 지키는 덕을 갖추면 허물이 없다. 불안한 나라들이 귀의해 오지만, 뒤늦게 오는 자는 흉하다.";
"hex.8.daxiang" = "땅 위에 물이 있는 것(물과 땅이 긴밀함)이 수지비이다. 옛 왕은 이를 본받아 여러 나라를 세우고 제후들과 가까이 지냈다.";
"hex.8.yao.0" = "진실한 믿음으로 남과 가까이하면 허물이 없다. 진실한 믿음이 좋은 술처럼 질그릇에 가득 차면, 끝내 뜻밖의 얻음도 있어 길하다.";
"hex.8.yao.1" = "마음속에서 우러나 가까이한다. 바른 도리를 지키면 길하다.";
"hex.8.yao.2" = "가까이해서는 안 될 사람과 가까이한다.";
"hex.8.yao.3" = "밖의 어진 이와 가까이한다. 바른 도리를 지키면 길하다.";
"hex.8.yao.4" = "공명정대하게 사람들과 가까이한다. 왕은 사냥할 때 세 방향에서 몰고 한쪽은 열어 두어 앞의 짐승이 달아나게 한다. 고을 사람들도 서로 경계할 필요가 없다. 길하다.";
"hex.8.yao.5" = "남과 가까이하려 해도 일찍 앞서지 못한다(좋은 시작이 없다는 해석도 있다). 흉하다.";
"hex.9.ci" = "형통하다. 우리의 서쪽 들에서 짙은 구름이 피어나 가득하지만 비는 내리지 않는다.";
"hex.9.daxiang" = "바람이 하늘 위로 부는 것이 풍천소축이다. 군자는 이를 본받아 교양과 덕을 아름답게 닦는다.";
"hex.9.yao.0" = "자신의 바른 길로 돌아온다. 무슨 허물이 있겠는가. 길하다.";
"hex.9.yao.1" = "이끌려 함께 바른 길로 돌아온다. 길하다.";
"hex.9.yao.2" = "수레바퀴의 바퀴살이 빠지고 부부가 반목한다.";
"hex.9.yao.3" = "진실한 믿음을 품으면 근심과 두려움이 사라지고 허물이 없다.";
"hex.9.yao.4" = "진실한 믿음으로 사람들을 맺어 주고 이웃과 함께 부유해진다.";
"hex.9.yao.5" = "비가 내리고 양도 억제되어 편안히 머문다. 덕을 쌓는 일을 숭상한 결과다. 여자는 바른 도리를 지켜도 위태롭다. 달이 보름에 가깝다(음이 성하여 양에 맞서려 한다는 비유). 군자가 출정하면 흉하다.";
"hex.10.ci" = "호랑이 꼬리를 밟아도 호랑이가 사람을 물지 않는다. 형통하다.";
"hex.10.daxiang" = "위에 하늘, 아래에 못이 있는 것이 천택리이다. 군자는 이를 본받아 위아래의 질서를 분명히 하고 백성의 마음을 안정시킨다.";
"hex.10.yao.0" = "꾸밈없는 본모습으로 행동한다. 나아가도 허물이 없다.";
"hex.10.yao.1" = "걸어가는 길이 평탄하고 넓다. 조용히 은거하는 사람이 바른 도리를 지키면 길하다.";
"hex.10.yao.2" = "한쪽 눈이 어두운데도 잘 볼 수 있다 여기고, 다리를 저는 데도 멀리 갈 수 있다 여긴다. 호랑이 꼬리를 밟아 물리니 흉하다. 무인이 분수없이 군주가 되려는 것과 같다.";
"hex.10.yao.3" = "호랑이 꼬리를 밟아도 두려워하며 조심하면 끝내 길하다.";
"hex.10.yao.4" = "단호하고 강하게 행동한다. 바른 도리를 지켜도 위태롭다.";
"hex.10.yao.5" = "지나온 길을 돌아보며 화복의 징조를 살핀다. 두루 온전하게 마무리할 수 있으면 크게 길하다.";
"hex.11.ci" = "작은 것이 가고 큰 것이 온다(음이 가고 양이 온다). 길하고 형통하다.";
"hex.11.daxiang" = "하늘과 땅이 교류하는 것이 지천태이다. 군주는 이를 본받아 천지 운행의 이치에 맞게 일을 마련하고, 천지가 만물을 기르는 데 알맞도록 도와 백성을 보살핀다.";
"hex.11.yao.0" = "띠풀을 뽑으면 얽힌 뿌리가 함께 딸려 나온다. 같은 무리와 함께 출정하면 길하다.";
"hex.11.yao.1" = "거칠고 더러운 것도 포용하고, 맨몸으로 강을 건널 용기를 낸다. 먼 곳의 어진 이도 버리지 않고 사사로이 무리를 짓지 않으면 중도를 행하는 덕을 존중받는다.";
"hex.11.yao.2" = "평평하기만 하고 기울지 않는 것은 없으며, 가기만 하고 돌아오지 않는 것도 없다. 어려움 속에서 바른 도리를 지키면 허물이 없다. 신뢰를 얻을지 걱정하지 않아도 복록을 누린다.";
"hex.11.yao.3" = "가볍게 훨훨 내려온다. 재물에 기대지 않고 이웃과 마음을 모으며, 서로 경계하지 않고 진실하게 대한다.";
"hex.11.yao.4" = "제을(상나라 왕)이 누이동생을 시집보낸다. 그로써 복을 얻으니 크게 길하다.";
"hex.11.yao.5" = "성벽이 무너져 해자로 돌아간다. 군대를 써서는 안 된다. 자기 고을에서 명을 내리지만, 바른 도리를 지켜도 아쉬움이 남는다.";
"hex.12.ci" = "막혀 통하지 않는 것은 정상적인 사람의 도리가 아니다(소인이 막힌 세상을 만든다는 해석도 있다). 군자가 바른 도리를 지키기에 이롭지 않다. 큰 것이 가고 작은 것이 온다(양이 가고 음이 온다).";
"hex.12.daxiang" = "하늘과 땅이 교류하지 않는 것이 천지비이다. 군자는 이를 본받아 덕을 드러내지 않고 재난을 피하며, 영화와 녹봉과 지위를 탐하지 않는다.";
"hex.12.yao.0" = "띠풀을 뽑으면 얽힌 뿌리가 함께 딸려 나온다. 같은 무리와 함께 바른 도리를 지키면 길하고 형통하다.";
"hex.12.yao.1" = "윗사람을 포용하고 따르는 것은 소인에게 길하다. 덕이 높은 큰 인물은 막힌 때에도 차분히 지켜야 형통하다.";
"hex.12.yao.2" = "수치를 속에 품고 감춘다.";
"hex.12.yao.3" = "천명을 따르면 허물이 없다. 같은 무리가 모여 복을 함께 누린다.";
"hex.12.yao.4" = "막힘을 그치게 하니 덕이 높은 큰 인물에게 길하다. 늘 '망할 수 있다, 망할 수 있다' 하고 경계하면, 무성한 뽕나무에 묶어 놓은 듯 단단해진다.";
"hex.12.yao.5" = "막힘을 뒤엎는다. 처음에는 막히지만 나중에는 기쁨이 있다.";
"hex.13.ci" = "넓은 들에서 사람들과 화합하면 형통하다. 큰 강을 건너면 이롭고(위험을 무릅쓰고 일을 이룬다는 비유), 군자가 바른 도리를 굳게 지키면 이롭다.";
"hex.13.daxiang" = "하늘과 불이 서로 어울리는 것이 천화동인이다. 군자는 이를 본받아 사람들을 부류에 따라 나누고 사물을 분별하여, 공통점을 찾으며 차이를 밝힌다.";
"hex.13.yao.0" = "집 문을 나서자마자 사람들과 화합한다. 허물이 없다.";
"hex.13.yao.1" = "일족 안에서만 화합하니 아쉬움이 남는다.";
"hex.13.yao.2" = "풀숲에 군사를 숨기고 높은 언덕에 올라 살핀다. 삼 년이 지나도 감히 군사를 일으키지 못한다.";
"hex.13.yao.3" = "상대의 성벽에 올랐으나 끝내 공격하지 않는다. 길하다.";
"hex.13.yao.4" = "사람들과 화합한다. 처음에는 통곡하다가 나중에는 웃는다. 대군이 적을 이긴 뒤 서로 만난다.";
"hex.13.yao.5" = "성 밖 가까운 들에서 사람들과 화합한다. 후회는 없다(먼 들에서 널리 화합하는 데에는 이르지 못했지만).";
"hex.14.ci" = "크게 형통하다.";
"hex.14.daxiang" = "불이 하늘 위에서 두루 비추는 것이 화천대유이다. 군자는 이를 본받아 악을 막고 선을 드높이며, 하늘의 좋은 명을 따른다.";
"hex.14.yao.0" = "해로운 것과 사귀지 않으면 허물을 부르지 않는다. 늘 어려움을 생각하며 스스로 경계하면 허물이 없다.";
"hex.14.yao.1" = "큰 수레에 재물을 싣고 나아간다. 허물이 없다.";
"hex.14.yao.2" = "공후가 천자에게 예물을 바치고 조공한다(천자의 잔치에 초대받는다는 해석도 있다). 소인은 이를 해내지 못한다.";
"hex.14.yao.3" = "자신의 성대함을 지나치게 뽐내지 않으면 허물이 없다.";
"hex.14.yao.4" = "진실한 믿음으로 위아래 사람들과 사귀며 위엄도 갖추니 길하다.";
"hex.14.yao.5" = "하늘이 돕는다. 길하고 이롭지 않은 것이 없다.";
"hex.15.ci" = "형통하다. 군자는 좋은 결말을 맞을 수 있다.";
"hex.15.daxiang" = "땅속에 산이 있는 것이 지산겸이다. 군자는 이를 본받아 많은 것을 덜어 적은 것을 보태고, 사물을 헤아려 공평하게 베푼다.";
"hex.15.yao.0" = "거듭 겸손한 군자는 그 덕으로 큰 강을 건널 수 있다(위험을 넘어 일을 이룬다는 비유). 길하다.";
"hex.15.yao.1" = "겸손하다는 이름이 널리 알려진다. 바른 도리를 지키면 길하다.";
"hex.15.yao.2" = "공로가 있어도 겸손한 군자는 끝내 길하다.";
"hex.15.yao.3" = "이롭지 않은 것이 없다. 겸손한 덕을 발휘한다('휘'는 펼치고 드높인다는 뜻).";
"hex.15.yao.4" = "자신의 부에 기대지 않고 이웃의 따름을 얻는다. 복종하지 않는 자를 정벌하면 이롭고, 이롭지 않은 것이 없다.";
"hex.15.yao.5" = "겸손하다는 이름이 널리 알려진다. 군대를 일으켜 고을과 나라(자기 영내)를 정벌하면 이롭다.";
"hex.16.ci" = "제후를 봉하고 군대를 내어 싸우면 이롭다.";
"hex.16.daxiang" = "우레가 땅속에서 힘차게 나오는 것이 뇌지예이다. 옛 왕은 이를 본받아 음악을 만들고 덕을 숭상하며, 하늘의 상제에게 성대한 제사를 올리고 조상도 함께 모셨다.";
"hex.16.yao.0" = "총애를 받았다고 즐거움을 드러내며 우쭐대니 흉하다.";
"hex.16.yao.1" = "바위처럼 굳고 바르며, 하루가 다 가기 전에 기미를 알아차려 행동한다. 바른 도리를 지키면 길하다.";
"hex.16.yao.2" = "윗사람의 눈치를 보며 비위를 맞춰 안락을 구하면 후회가 있다. 깨닫는 것이 늦어도 후회가 있다.";
"hex.16.yao.3" = "사람들이 그를 통해 안락을 얻으니 얻는 바가 크다. 의심하지 않으면 벗들이 머리카락이 비녀에 모이듯 모여든다.";
"hex.16.yao.4" = "바른 도리를 지켜도 병이 있으나, 오래도록 죽음에 이르지는 않는다.";
"hex.16.yao.5" = "향락에 빠져 어두워졌어도 고칠 수 있으면 허물이 없다.";
"hex.17.ci" = "크게 형통하다. 바른 도리를 지키면 이롭고 허물이 없다.";
"hex.17.daxiang" = "못 속에 우레가 있는 것(우레가 숨어 쉼)이 택뢰수이다. 군자는 이를 본받아 날이 저물면 방에 들어가 쉰다.";
"hex.17.yao.0" = "맡은 일에 변화가 있다(생각이 바뀐다는 해석도 있다). 바른 도리를 지키면 길하다. 문을 나서 사람들과 사귀면 성과가 있다.";
"hex.17.yao.1" = "어린 사내에게 매이면 성숙한 사내를 잃는다.";
"hex.17.yao.2" = "성숙한 사내에게 매이면 어린 사내를 잃는다. 남을 따르며 구하면 얻는 바가 있다. 편안히 머물며 바른 도리를 지키면 이롭다.";
"hex.17.yao.3" = "따르는 이가 많고 얻는 바가 있어도 바른 도리를 지키는 것만으로는 흉할 수 있다. 진실한 믿음을 품고 바른 길에 맞으며 이치를 밝게 알면 무슨 허물이 있겠는가.";
"hex.17.yao.4" = "선한 사람을 진실한 믿음으로 대하니 길하다.";
"hex.17.yao.5" = "붙잡아 묶고 다시 밧줄로 단단히 매어 따르게 한다. 왕은 이로써 서산(기산)에서 제사를 지낸다.";
"hex.18.ci" = "크게 형통하다. 큰 강을 건너면 이롭다(위험을 무릅쓰고 일을 이룬다는 비유). 갑일 사흘 전(신일)에 미리 계획하고, 갑일 사흘 뒤(정일)에 살펴 반성한다.";
"hex.18.daxiang" = "산 아래에 바람이 있는 것이 산풍고이다. 군자는 이를 본받아 백성을 일으켜 돕고 덕을 기른다.";
"hex.18.yao.0" = "아버지가 남긴 폐단과 혼란을 바로잡는다. 이런 아들이 있으면 돌아가신 아버지에게 허물이 없다. 위태롭지만 끝내 길하다.";
"hex.18.yao.1" = "어머니가 남긴 폐단과 혼란을 바로잡는다. 지나치게 강직하게 고집해서는 안 된다(완곡하게 해야 한다).";
"hex.18.yao.2" = "아버지가 남긴 폐단과 혼란을 바로잡는다. 조금 후회가 있으나 큰 허물은 없다.";
"hex.18.yao.3" = "아버지가 남긴 폐단과 혼란을 너그럽게 보아 방치한다. 계속하면 아쉬움이 남는다.";
"hex.18.yao.4" = "아버지가 남긴 폐단과 혼란을 바로잡아 칭송을 얻는다.";
"hex.18.yao.5" = "왕과 제후를 섬기지 않고 자신의 뜻과 행실을 고상하게 지킨다.";
"hex.19.ci" = "크게 형통하다. 바른 도리를 지키면 이롭다. 팔월이 되면 흉함이 있다.";
"hex.19.daxiang" = "못 위에 땅이 있는 것이 지택림이다. 군자는 이를 본받아 백성을 가르칠 일을 끝없이 생각하고, 한없이 포용하며 보호한다.";
"hex.19.yao.0" = "감화로 백성을 대한다('함'은 감응한다는 뜻). 바른 도리를 지키면 길하다.";
"hex.19.yao.1" = "감화로 백성을 대한다. 길하고 이롭지 않은 것이 없다.";
"hex.19.yao.2" = "달콤한 말로 백성을 대하면 이로울 것이 없다. 이를 걱정하여 고치면 허물이 없다.";
"hex.19.yao.3" = "몸소 백성 가까이 다가가 대한다. 허물이 없다.";
"hex.19.yao.4" = "지혜로 백성을 대한다. 위대한 군주에게 마땅한 일이니 길하다.";
"hex.19.yao.5" = "돈후한 덕으로 백성을 대한다. 길하고 허물이 없다.";
"hex.20.ci" = "제사에서 손을 씻고 술을 부은 뒤 아직 제물을 올리기 전이다(가장 경건한 순간이다). 진실한 믿음과 엄숙한 몸가짐으로 사람들의 우러름을 받는다.";
"hex.20.daxiang" = "바람이 땅 위로 부는 것이 풍지관이다. 옛 왕은 이를 본받아 사방을 돌아보고 백성의 사정을 살펴 가르침을 베풀었다.";
"hex.20.yao.0" = "아이처럼 얕게 본다. 소인에게는 허물이 없으나 군자에게는 아쉬움이 남는다.";
"hex.20.yao.1" = "문틈으로 엿본다. 여자가 바른 도리를 지키면 이롭다.";
"hex.20.yao.2" = "자신의 행위를 살펴 나아갈지 물러날지 정한다.";
"hex.20.yao.3" = "나라의 빛나는 다스림을 살핀다. 빈객으로 왕을 만나면 이롭다(벼슬에 나아가 보좌한다는 뜻).";
"hex.20.yao.4" = "자신의 행위를 살핀다. 군자에게 허물이 없다.";
"hex.20.yao.5" = "남의 행위를 살핀다(자신의 행위를 남이 살핀다는 해석도 있다). 군자에게 허물이 없다.";
"hex.21.ci" = "형통하다. 형벌과 재판을 시행하면 이롭다.";
"hex.21.daxiang" = "우레와 번개가 어우러지는 것이 화뢰서합이다. 옛 왕은 이를 본받아 형벌을 엄정하고 분명하게 하며 법령을 정비했다.";
"hex.21.yao.0" = "발에 형틀을 채워 발가락이 가려진다. 허물이 없다(작은 벌로 크게 경계하게 한다).";
"hex.21.yao.1" = "부드러운 고기를 깨물어 코까지 파묻힌다. 허물이 없다.";
"hex.21.yao.2" = "딱딱한 말린 고기를 깨물다가 독을 만난다. 조금 아쉬움이 있으나 허물이 없다.";
"hex.21.yao.3" = "뼈 붙은 말린 고기를 깨물어 쇠 화살촉을 얻는다(굳세고 곧다는 비유). 어려움 속에서 바른 도리를 지키면 이롭고 길하다.";
"hex.21.yao.4" = "말린 고기를 깨물어 황금을 얻는다(중도를 지키며 굳세다는 비유). 바른 도리를 지켜 위험에 대비하면 허물이 없다.";
"hex.21.yao.5" = "어깨에 형틀을 메어 귀가 가려진다. 흉하다.";
"hex.22.ci" = "형통하다. 나아가면 조금 이롭다.";
"hex.22.daxiang" = "산 아래에 불이 있는 것(빛이 미치는 범위가 제한됨)이 산화비이다. 군자는 이를 본받아 여러 정무를 밝게 다스리되, 함부로 송사를 판결하지 않는다.";
"hex.22.yao.0" = "자기 발끝을 꾸민다. 수레를 버리고 걸어간다.";
"hex.22.yao.1" = "자기 수염을 꾸민다.";
"hex.22.yao.2" = "꾸밈이 아름답고 윤택하게 빛난다. 오래 바른 도리를 지키면 길하다.";
"hex.22.yao.3" = "희고 소박하게 꾸미고 백마가 날듯이 달린다. 온 사람은 도적이 아니라 구혼자다.";
"hex.22.yao.4" = "언덕의 동산을 꾸민다(소박한 현자를 숭상한다는 비유). 바치는 비단 한 묶음이 적어 아쉬움이 있으나 끝내 길하다.";
"hex.22.yao.5" = "희고 소박한 것으로 꾸민다. 허물이 없다.";
"hex.23.ci" = "나아가는 것은 이롭지 않다.";
"hex.23.daxiang" = "산이 땅에 의지하는 것이 산지박이다. 윗사람은 이를 본받아 아랫사람을 후하게 대하고 집안을 안정시킨다.";
"hex.23.yao.0" = "침상이 다리부터 깎여 나간다. 바른 도리가 무너지니 흉하다.";
"hex.23.yao.1" = "침상이 깎여 다리와 몸체가 맞닿는 곳까지 이른다('변'은 침상의 틀). 바른 도리가 무너지니 흉하다.";
"hex.23.yao.2" = "벗겨져 무너지는 때에 있다(홀로 맨 위 양효와 호응한다). 허물이 없다.";
"hex.23.yao.3" = "침상이 깎여 사람의 살갗에까지 이른다. 흉하다.";
"hex.23.yao.4" = "물고기를 꿰듯 여러 음을 차례로 이끌어, 궁인처럼 왕의 총애를 받는다. 이롭지 않은 것이 없다.";
"hex.23.yao.5" = "큰 열매가 먹히지 않고 남는다. 군자는 수레를 얻고(백성의 지지를 받음), 소인은 자기 집을 허문다.";
"hex.24.ci" = "형통하다. 드나듦에 병이 없고 벗이 와도 허물이 없다. 오가는 순환에는 일정한 이치가 있어 칠 일이면 돌아온다. 나아가면 이롭다.";
"hex.24.daxiang" = "우레가 땅속에 있는 것이 지뢰복이다. 옛 왕은 이를 본받아 동짓날 관문을 닫아 상인과 나그네가 다니지 않게 하고, 군주도 사방을 순찰하지 않았다.";
"hex.24.yao.0" = "멀리 가기 전에 바른 길로 돌아온다. 큰 후회가 없으니 크게 길하다.";
"hex.24.yao.1" = "아름답게 바른 길로 돌아온다. 길하다.";
"hex.24.yao.2" = "거듭 바른 길로 돌아온다(눈살을 찌푸리며 근심하여 돌아온다는 해석도 있다). 위태롭지만 허물이 없다.";
"hex.24.yao.3" = "여러 음 가운데를 가면서 홀로 바른 길로 돌아온다.";
"hex.24.yao.4" = "돈후한 마음으로 바른 길로 돌아온다. 후회는 없다.";
"hex.24.yao.5" = "길을 잃고 돌아올 줄 모른다. 흉하고 재앙이 있다. 이대로 군대를 내면 끝내 크게 패하고 국왕에게도 화가 미쳐, 십 년 동안 출정할 수 없게 된다.";
"hex.25.ci" = "크게 형통하다. 바른 도리를 지키면 이롭다. 바른 도리를 지키지 않으면 재앙이 있으니 나아가는 것은 이롭지 않다.";
"hex.25.daxiang" = "하늘 아래 우레가 움직이니 만물이 감히 망령되게 행동하지 않는다. 옛 왕은 이를 본받아 하늘의 때에 힘써 맞추고 만물을 길렀다.";
"hex.25.yao.0" = "망령되게 행동하지 않고 나아가면 길하다.";
"hex.25.yao.1" = "밭을 갈면서 수확을 미리 바라지 않고, 개간하면서 익은 밭을 미리 바라지 않는다(자연스러운 흐름을 따르며 결과를 앞서 기대하지 않는다). 그러면 나아감이 이롭다.";
"hex.25.yao.2" = "뜻밖의 재앙이다. 누군가 매어 둔 소를 지나가던 사람이 끌고 가고, 고을 사람이 의심을 받아 화를 입는다.";
"hex.25.yao.3" = "바른 도리를 굳게 지킬 수 있다. 허물이 없다.";
"hex.25.yao.4" = "망령된 행동 때문에 생긴 병이 아니다. 약을 쓰지 않아도 저절로 나아 기쁨이 있다.";
"hex.25.yao.5" = "망령되게 행동하지 않아도 움직이면 재앙이 있다(때가 이미 극에 이르렀기 때문이다). 이로울 것이 없다.";
"hex.26.ci" = "바른 도리를 지키면 이롭다. 집에서 스스로 먹고살지 않고 조정에서 녹을 받으면 길하다. 큰 강을 건너면 이롭다(위험을 무릅쓰고 일을 이룬다는 비유).";
"hex.26.daxiang" = "하늘이 산속에 담긴 것이 산천대축이다. 군자는 이를 본받아 옛 현인의 말과 성인의 행실을 널리 배워 자신의 덕을 기른다.";
"hex.26.yao.0" = "위험이 있다. 멈추는 것이 이롭다.";
"hex.26.yao.1" = "수레 몸체가 차축의 받침목(복)에서 떨어져 나가 앞으로 갈 수 없다.";
"hex.26.yao.2" = "좋은 말들이 달리며 서로 뒤쫓는다. 어려움 속에서 바른 도리를 지키면 이롭다. 날마다 수레 몰기와 방어를 익히면 나아감이 이롭다.";
"hex.26.yao.3" = "송아지 뿔에 가로막대(곡)를 묶어 사람을 들이받지 못하게 한다. 크게 길하다.";
"hex.26.yao.4" = "거세한 돼지는 엄니가 있어도 사람을 해치지 않는다. 길하다.";
"hex.26.yao.5" = "하늘의 큰길이 얼마나 탁 트였는가. 형통하다('하'를 짊어진다는 뜻으로 읽어 하늘의 큰길을 받아들인다고 풀이하기도 한다).";
"hex.27.ci" = "바른 도리를 지키면 길하다. 기르는 도리를 살피고, 그 사람이 스스로 먹을 것을 구하는 방식을 본다.";
"hex.27.daxiang" = "산 아래에 우레가 있는 것이 산뢰이이다. 군자는 이를 본받아 말을 삼가고 음식을 절제한다.";
"hex.27.yao.0" = "신령한 거북처럼 스스로를 기르는 바탕(먹지 않고도 자신을 기르는 힘)을 버리고, 내가 볼을 움직여 먹는 모습을 보며 군침을 흘린다. 흉하다.";
"hex.27.yao.1" = "거꾸로 아랫사람에게 부양을 구하여 상도에 어긋난다. 다시 높은 언덕(맨 위 양효)에 부양을 구하러 나아가면 흉하다.";
"hex.27.yao.2" = "기르는 바른 도리를 어긴다. 바른 도리를 지키려 해도 흉하고, 십 년 동안 능력을 펼칠 수 없다. 이로울 것이 없다.";
"hex.27.yao.3" = "거꾸로 아랫사람에게 부양을 구한다(천하를 기르기 위해서다). 길하다. 호랑이처럼 아래를 집중해 바라보며 끊임없이 구하면 허물이 없다.";
"hex.27.yao.4" = "상도에 어긋나 맨 위 양효의 부양에 의지한다. 편안히 머물며 바른 도리를 지키면 길하다. 큰 강을 건너서는 안 된다(위험을 무릅쓰지 말라는 뜻).";
"hex.27.yao.5" = "천하가 그에게 의지하여 길러진다. 위태롭지만 길하다. 큰 강을 건너면 이롭다(위험을 무릅쓰고 일을 이룬다는 비유).";
"hex.28.ci" = "마룻대가 휜다. 나아가면 이롭고 형통하다.";
"hex.28.daxiang" = "못물이 나무를 덮는 것이 택풍대과이다. 군자는 이를 본받아 홀로 서도 두려워하지 않고, 세상을 피해 숨어 살아도 답답해하지 않는다.";
"hex.28.yao.0" = "깨끗한 흰 띠풀을 밑에 깐다(제물을 놓기 위해서다). 허물이 없다.";
"hex.28.yao.1" = "마른 포플러에 새싹이 나고 늙은 남자가 젊은 아내를 얻는다. 이롭지 않은 것이 없다.";
"hex.28.yao.2" = "마룻대가 휜다. 흉하다.";
"hex.28.yao.3" = "마룻대가 높이 받쳐진다(튼튼하여 휘지 않는다). 길하다. 다른 것에 얽매이면 아쉬움이 남는다.";
"hex.28.yao.4" = "마른 포플러에 꽃이 피고 늙은 여자가 젊은 남편을 얻는다. 허물도 없고 칭찬도 없다.";
"hex.28.yao.5" = "너무 깊은 물을 건너다 머리까지 잠긴다. 흉하지만 허물은 없다(의를 위해 한 일이므로 탓할 수 없다).";
"hex.29.ci" = "위험이 거듭된다. 진실한 믿음을 품고 마음이 형통하면 행동이 존중받는다.";
"hex.29.daxiang" = "물이 잇달아 흘러오는 것이 중수감이다. 군자는 이를 본받아 덕행을 한결같이 지키고 정치와 교화의 일을 거듭 익힌다.";
"hex.29.yao.0" = "겹겹의 위험 속에서 다시 깊은 구덩이에 빠진다. 흉하다.";
"hex.29.yao.1" = "험한 구덩이 속에 여전히 위험이 있다. 작은 얻음만 구한다.";
"hex.29.yao.2" = "오고 가는 길이 모두 험하다. 앞은 위험하고 뒤도 의지하기 어려워 깊은 구덩이에 빠진다. 행동에 나서서는 안 된다.";
"hex.29.yao.3" = "술 한 통과 밥 두 그릇을 질그릇에 담아, 창으로 소박한 신의의 징표를 들인다(진실한 마음으로 맺는다는 비유). 끝내 허물이 없다.";
"hex.29.yao.4" = "구덩이의 물이 넘치지는 않지만 둑과 높이가 같아졌다('지'는 작은 언덕을 뜻하는 말과 통하며, '다만'으로 풀이하기도 한다). 허물이 없다.";
"hex.29.yao.5" = "밧줄로 묶여 가시덤불 속에 갇히고 삼 년이 지나도 풀려나지 못한다. 흉하다.";
"hex.30.ci" = "바른 도리를 지키면 이롭고 형통하다. 암소를 기르면 길하다(유순한 덕의 비유).";
"hex.30.daxiang" = "밝은 빛이 두 번 잇달아 솟는 것이 중화리이다. 덕이 높은 큰 인물은 이를 본받아 밝음을 끊임없이 이어 사방을 비춘다.";
"hex.30.yao.0" = "발걸음이 어지럽게 얽힌다. 공손하고 신중하면 허물이 없다.";
"hex.30.yao.1" = "노란빛으로 밝게 빛난다(노란색은 중앙의 색). 크게 길하다.";
"hex.30.yao.2" = "해가 서쪽으로 기울 때의 남은 빛이다. 질그릇을 두드리며 노래하지 않으면(때맞춰 즐기지 않으면) 늙음을 탄식하게 된다. 흉하다.";
"hex.30.yao.3" = "갑자기 닥쳐와 불타오르고, 끝내 죽음에 이르러 버려진다.";
"hex.30.yao.4" = "눈물을 하염없이 흘리며 슬퍼하고 탄식한다. 길하다.";
"hex.30.yao.5" = "왕이 출정을 명하여 훌륭한 공을 세운다. 적의 우두머리를 베고, 단지 뒤따른 무리는 잡지 않는다(우두머리 악인만 벌한다). 허물이 없다.";
"hex.31.ci" = "형통하다. 바른 도리를 지키면 이롭고, 아내를 맞으면 길하다(택산함은 감응을 뜻하며 젊은 남녀가 서로 마음을 통하는 모습을 나타낸다).";
"hex.31.daxiang" = "산 위에 못이 있는 모습(산이 빈 곳으로 물을 받아들임)은 감응을 상징한다. 군자는 이를 본받아 마음을 비우고 남을 받아들인다.";
"hex.31.yao.0" = "엄지발가락에 감응이 일어난다(감응이 막 시작되어 얕지만 마음은 이미 밖을 향한다).";
"hex.31.yao.1" = "장딴지에 감응이 일어난다. 조급하게 함부로 움직이면 흉하지만, 머물러 움직이지 않으면 길하다.";
"hex.31.yao.2" = "넓적다리에 감응이 일어난다. 고집스레 남을 따라 움직이려 하니, 이대로 나아가면 아쉬움이 남는다.";
"hex.31.yao.3" = "바른 도리를 지키면 길하고 후회가 사라진다. 마음이 정해지지 않아 자꾸 오가면 같은 무리의 벗만 네 생각을 따른다(감응이 좁아 널리 미치지 못한다).";
"hex.31.yao.4" = "등살에 감응이 일어난다. 후회는 없다('매'는 등살이다. 감응이 마음까지 미치지 못하며, 감응이 아주 얕다는 해석도 있다).";
"hex.31.yao.5" = "잇몸과 볼과 혀에 감응이 일어난다(말로만 서로 마음을 움직인다).";
"hex.32.ci" = "형통하고 허물이 없다. 바른 도리를 지키면 이롭고 나아가면 이롭다(뇌풍항은 오래 지속함을 뜻한다).";
"hex.32.daxiang" = "우레와 바람이 함께하는 모습은 영속을 상징한다. 군자는 이를 본받아 바른 도리에 서서 함부로 방향을 바꾸지 않는다.";
"hex.32.yao.0" = "처음부터 깊이 파고들어 영속을 구한다('준'은 깊이 판다는 뜻). 바른 도리를 지켜도 흉하고 이로울 것이 없다.";
"hex.32.yao.1" = "후회가 사라진다(아래에서 둘째 양효는 유한 자리에 있으나 가운데를 얻어 오래 중도를 지킬 수 있다).";
"hex.32.yao.2" = "자신의 덕을 한결같이 지키지 못하면 수치를 면하기 어렵다. 바른 도리를 지켜도 아쉬움이 남는다.";
"hex.32.yao.3" = "사냥을 해도 짐승을 잡지 못한다(맞지 않는 자리에 오래 머물러 헛수고만 한다는 비유).";
"hex.32.yao.4" = "유순한 덕을 오래 유지하며 바른 도리를 지킨다. 여자에게는 길하지만 남자에게는 흉하다.";
"hex.32.yao.5" = "흔들리며 영속을 구한다('진'은 불안하게 흔들린다는 뜻). 흉하다.";
"hex.33.ci" = "물러나면 형통하다. 작은 일에서 바른 도리를 지키면 이롭다(천산둔은 물러나 피함을 뜻한다).";
"hex.33.daxiang" = "하늘 아래 산이 있는 모습(산이 높아도 하늘은 멀리 떨어짐)은 물러남을 상징한다. 군자는 이를 본받아 소인을 멀리하되 미움을 드러내지 않고 엄정한 태도를 지킨다.";
"hex.33.yao.0" = "물러나는 데 맨 뒤로 처진다. 위태로우니 나아가서는 안 된다.";
"hex.33.yao.1" = "누런 소가죽 끈으로 단단히 묶어 아무도 풀지 못한다(뜻이 굳다는 비유이며, 현자를 붙잡아 둔다는 해석도 있다).";
"hex.33.yao.2" = "마음이 얽매여 물러나지 못하니 병든 듯 위태롭다. 하인과 시녀를 거느려 기르는 데에는 길하다.";
"hex.33.yao.3" = "좋아하는 것이 있어도 의연히 물러난다. 군자에게는 길하지만 소인은 그렇게 하지 못한다.";
"hex.33.yao.4" = "때에 맞게 훌륭히 물러난다. 바른 도리를 지키면 길하다.";
"hex.33.yao.5" = "여유롭게 물러난다('비'는 여유롭다는 뜻이며, 높이 날아 멀리 물러난다는 해석도 있다). 이롭지 않은 것이 없다.";
"hex.34.ci" = "바른 도리를 지키면 이롭다(뇌천대장은 양의 굳센 힘이 성함을 뜻한다).";
"hex.34.daxiang" = "우레가 하늘 위에 있는 것(위세가 강함)이 뇌천대장의 모습이다. 군자는 이를 본받아 예에 맞지 않는 일은 결코 하지 않는다.";
"hex.34.yao.0" = "강한 기세가 발가락에 나타나 앞으로 나가기를 서두른다. 출정하면 흉하다. 이는 확실하다(여기서 '부'는 확실하다는 뜻).";
"hex.34.yao.1" = "바른 도리를 지키면 길하다.";
"hex.34.yao.2" = "소인은 힘에 기대지만 군자는 그렇게 하지 않는다('망'은 없다는 뜻이며, 그물을 쓴다는 해석도 있다). 바른 도리를 지켜도 위태롭다. 숫양이 울타리를 들이받아 뿔이 얽힌다.";
"hex.34.yao.3" = "바른 도리를 지키면 길하고 후회가 사라진다. 울타리가 터져 뿔이 얽히지 않고, 큰 수레의 차축과 몸체를 잇는 받침이 튼튼하다(무거운 짐을 싣고 나아갈 수 있다는 비유).";
"hex.34.yao.4" = "평탄한 곳에서 자신도 모르게 양을 잃는다. 후회는 없다('이'를 밭의 경계라는 뜻으로 풀이하기도 한다).";
"hex.34.yao.5" = "숫양이 울타리를 들이받아 물러날 수도 나아갈 수도 없다. 이로울 것이 없다. 어려움을 알고 바른 도리를 지키면 길하다.";
"hex.35.ci" = "강후(나라를 안정시키는 제후이며, 주나라 무왕의 아우 강숙이라는 해석도 있다)가 왕에게 많은 수레와 말을 받고 하루에 세 번 접견된다(화지진은 나아가 오름을 뜻한다).";
"hex.35.daxiang" = "빛이 땅 위로 솟는 모습은 화지진의 전진을 상징한다. 군자는 이를 본받아 스스로 밝은 덕을 드러낸다.";
"hex.35.yao.0" = "나아가려 하나 억눌린다. 바른 도리를 지키면 길하다. 신임을 얻지 못해도 여유를 지키면 허물이 없다.";
"hex.35.yao.1" = "나아가려 하나 근심이 가득하다. 바른 도리를 지키면 길하다. 할머니에게서 큰 복을 받는다('왕모'는 할머니로, 다섯째 음효의 높은 자리를 뜻한다).";
"hex.35.yao.2" = "사람들이 믿고 인정한다. 후회가 사라진다.";
"hex.35.yao.3" = "쥐처럼 올라간다(탐욕스럽고 겁에 질려 움츠러든다). 바른 도리를 지켜도 위태롭다.";
"hex.35.yao.4" = "후회가 사라진다. 얻고 잃음을 걱정하지 않아도 된다. 나아가면 길하고 이롭지 않은 것이 없다.";
"hex.35.yao.5" = "뿔 끝(극점)까지 올랐다. 자기 고을을 치는 일(내란 진압)에만 힘을 써야 한다. 위태롭지만 길하고 허물이 없다. 바른 도리를 지켜도 아쉬움이 남는다.";
"hex.36.ci" = "어려움 속에서 바른 도리를 굳게 지키면 이롭다(지화명이는 밝음이 상처 입음을 뜻한다).";
"hex.36.daxiang" = "밝음이 땅속으로 들어가는 것이 지화명이의 모습이다. 군자는 이를 본받아 사람들을 다스릴 때 겉으로는 어둡게 보이되 속으로는 밝은 통찰을 간직한다.";
"hex.36.yao.0" = "밝음이 상처 입은 때에 날아가며 날개를 늘어뜨린다. 군자는 서둘러 길을 떠나 사흘 동안 먹을 겨를도 없다. 가는 곳에서 주인의 책망을 듣는다.";
"hex.36.yao.1" = "밝음이 상처 입고 왼쪽 넓적다리를 다친다. 튼튼한 말의 도움으로 구해지니 길하다.";
"hex.36.yao.2" = "밝음이 상처 입은 때에 남쪽으로 정벌하여 우두머리 악인을 잡는다. 쌓인 폐단을 성급히 바로잡으려 해서는 안 되며 차츰 나아가야 한다.";
"hex.36.yao.3" = "왼쪽 배로 들어간다(내부 깊이 들어간다). 밝음이 상처 입은 속사정을 알아내고 문을 나선다(떠난다).";
"hex.36.yao.4" = "기자(은나라 주왕의 숙부로, 미친 척하여 화를 피했다)처럼 밝음이 상처 입은 때에 처한다. 바른 도리를 지키면 이롭다.";
"hex.36.yao.5" = "빛을 밝히지 않고 오히려 어두워진다. 처음에는 하늘에 오르나 나중에는 땅속으로 떨어진다.";
"hex.37.ci" = "여자가 바른 도리를 지키면 이롭다(풍화가인은 집안을 다스리는 도리다).";
"hex.37.daxiang" = "불에서 바람이 생기는 것(안에서 밖으로 미침)이 풍화가인의 모습이다. 군자는 이를 본받아 말에 실질적인 근거를 담고 행동을 한결같이 한다.";
"hex.37.yao.0" = "처음부터 집안에 규칙을 세워 잘못을 막는다('한'은 미리 막는다는 뜻). 후회가 사라진다.";
"hex.37.yao.1" = "제멋대로 일을 처리하지 않고 집안의 음식을 맡는다(중궤). 바른 도리를 지키면 길하다.";
"hex.37.yao.2" = "집안을 엄하게 다스려 가족이 원망하며 탄식한다('학학'은 엄한 소리). 후회와 위험이 있어도 끝내 길하다. 부녀자와 아이들이 절도 없이 웃고 즐기면 끝내 아쉬움이 남는다.";
"hex.37.yao.3" = "집안을 부유하게 한다. 크게 길하다.";
"hex.37.yao.4" = "왕이 덕으로 집안을 감화한다('가'는 이르러 마음을 움직인다는 뜻). 걱정할 것 없이 길하다.";
"hex.37.yao.5" = "진실한 믿음과 위엄이 있으면 끝내 길하다.";
"hex.38.ci" = "작은 일에는 길하다(화택규는 어긋나고 서로 등짐을 뜻한다).";
"hex.38.daxiang" = "위에는 불, 아래에는 못이 있는 것(성향이 서로 어긋남)이 화택규의 모습이다. 군자는 이를 본받아 큰 공통점을 추구하면서 작은 차이는 남겨 둔다.";
"hex.38.yao.0" = "후회가 사라진다. 말을 잃어도 쫓지 않아도 된다. 저절로 돌아온다. 악인을 만난다(만남을 거절하지 않는다). 허물이 없다.";
"hex.38.yao.1" = "골목에서 주인을 만난다. 허물이 없다.";
"hex.38.yao.2" = "수레가 끌려 붙잡히고 끄는 소도 가로막히며, 모는 사람은 이마에 문신을 새기는 형벌(천)과 코를 베는 형벌(의)을 받는다. 처음에는 순조롭지 않으나 끝에는 좋은 결과가 있다.";
"hex.38.yao.3" = "어긋나 홀로 있다가 굳센 사내(맨 아래 양효)를 만나 진실한 믿음으로 사귄다. 위태롭지만 허물이 없다.";
"hex.38.yao.4" = "후회가 사라진다. 종친(아래에서 둘째 양효)과 부드러운 고기를 깨물듯 쉽게 화합한다. 나아간들 무슨 허물이 있겠는가.";
"hex.38.yao.5" = "어긋나 홀로 있으니 진흙 묻은 돼지와 귀신이 가득한 수레가 보이는 듯하다(의심이 허상을 만든다). 처음에는 활을 당기지만 뒤에는 내려놓는다. 온 사람은 도적이 아니라 구혼자였다. 나아가 비를 만나면(음양이 조화되면) 길하다.";
"hex.39.ci" = "서남쪽의 평탄한 곳으로 가면 이롭고, 동북쪽의 험한 곳으로 가면 이롭지 않다. 덕이 높은 큰 인물을 만나면 이롭다. 바른 도리를 지키면 길하다(수산건은 걷기 어려움을 뜻한다).";
"hex.39.daxiang" = "산 위에 물이 있는 모습(험난함이 겹침)은 수산건의 어려움을 상징한다. 군자는 이를 본받아 자신을 돌아보고 덕을 닦는다.";
"hex.39.yao.0" = "나아가면 어려움을 만나고 돌아오면 칭찬을 얻는다.";
"hex.39.yao.1" = "왕의 신하가 온갖 어려움을 겪는다(위난을 구하려 뛰어다닌다). 자신을 위해서가 아니다.";
"hex.39.yao.2" = "나아가면 어려움을 만나 돌아온다(아래의 두 음효와 모인다).";
"hex.39.yao.3" = "나아가면 어려움을 만난다. 돌아와 사람들과 힘을 합친다.";
"hex.39.yao.4" = "큰 어려움 속에 벗이 도우러 온다.";
"hex.39.yao.5" = "나아가면 어려움을 만나지만, 돌아오면 큰 공을 이룰 수 있어 길하다. 덕이 높은 큰 인물을 만나면 이롭다.";
"hex.40.ci" = "서남쪽으로 가면 이롭다. 해결하러 갈 일이 없으면 제자리로 돌아오는 것이 길하다. 나아가 할 일이 있으면 일찍 행동하는 것이 길하다(뇌수해는 위난을 푼다는 뜻).";
"hex.40.daxiang" = "우레와 비가 일어나는 모습은 풀림을 상징한다. 군자는 이를 본받아 잘못을 용서하고 죄를 너그럽게 다룬다.";
"hex.40.yao.0" = "허물이 없다.";
"hex.40.yao.1" = "사냥에서 여우 세 마리를 잡고 노란 화살을 얻는다. 바른 도리를 지키면 길하다(여우는 소인, 노란 화살은 중도와 곧은 도리의 비유).";
"hex.40.yao.2" = "짐을 등에 진 사람이 수레까지 탄다(소인이 높은 자리를 차지한다는 비유). 도적을 불러들이니 바른 도리를 지켜도 아쉬움이 남는다.";
"hex.40.yao.3" = "엄지발가락의 매임을 푼다(달라붙은 소인을 떨쳐 낸다). 벗이 와서 진실하게 대한다.";
"hex.40.yao.4" = "군자가 위난을 풀면 길하다. 소인이 물러나는 것이 그 증거다('부'는 입증한다는 뜻이며, 소인에게 신뢰를 얻는다는 해석도 있다).";
"hex.40.yao.5" = "왕공이 높은 성벽 위의 매를 쏘아 잡는다. 이롭지 않은 것이 없다.";
"hex.41.ci" = "진실한 믿음을 품으면 크게 길하고 허물이 없다. 바른 도리를 지킬 수 있고 나아가면 이롭다. 무엇으로 제사를 지내는가. 두 개의 궤(곡식을 담는 제기)에 담은 소박한 음식이면 된다(산택손은 덜어 냄을 뜻한다).";
"hex.41.daxiang" = "산 아래에 못이 있는 모습(못이 스스로를 덜어 산을 높임)은 덜어 냄을 상징한다. 군자는 이를 본받아 분노를 억제하고 욕망을 막는다.";
"hex.41.yao.0" = "자기 일을 마치면 서둘러 간다(남을 돕기 위해서다). 허물이 없다. 다만 자신에게서 얼마나 덜어 낼지는 헤아려야 한다.";
"hex.41.yao.1" = "바른 도리를 지키면 이롭다. 출정하면 흉하다. 자신에게서 덜지 않고도 남을 이롭게 할 수 있다.";
"hex.41.yao.2" = "세 사람이 함께 가면 한 사람이 줄고, 한 사람이 홀로 가면 벗을 얻는다.";
"hex.41.yao.3" = "자신의 병폐를 줄여 빨리 나아지게 하면 기쁨이 있다. 허물이 없다.";
"hex.41.yao.4" = "누군가 그를 돕는다. 십 붕(붕은 옛 화폐 단위) 값어치의 귀한 거북으로 점쳐도 어긋나는 결과가 없다(점이 모두 길하다). 크게 길하다.";
"hex.41.yao.5" = "자신에게서 덜지 않고 남을 이롭게 한다. 허물이 없고 바른 도리를 지키면 길하며, 나아가면 이롭다. 천하에서 귀의하는 신민을 얻는다(한 집안에 한정되지 않는다).";
"hex.42.ci" = "나아가면 이롭고 큰 강을 건너면 이롭다(위험을 무릅쓰고 일을 이룬다는 비유. 풍뢰익은 더해 줌을 뜻한다).";
"hex.42.daxiang" = "바람과 우레가 서로 돕는 모습은 더함을 상징한다. 군자는 이를 본받아 선한 행실을 보면 따르고, 잘못이 있으면 고친다.";
"hex.42.yao.0" = "큰일을 하면 이롭다. 크게 길하고 허물이 없다.";
"hex.42.yao.1" = "누군가 그를 돕는다. 십 붕 값어치의 귀한 거북으로 점쳐도 어긋나는 결과가 없다. 오래 바른 도리를 지키면 길하다. 왕이 그를 써서 하늘의 상제에게 제사 지내면 길하다.";
"hex.42.yao.2" = "더해 받은 것을 재난 구제에 쓰면 허물이 없다. 진실한 믿음으로 중정하게 행동하며 옥으로 만든 홀을 들고 왕공에게 아뢴다.";
"hex.42.yao.3" = "중정하게 행동하여 왕공에게 아뢰니 받아들여진다. 윗사람에게 의지하여 도읍을 옮기면 이롭다.";
"hex.42.yao.4" = "진실한 믿음으로 남에게 은혜를 베풀면 묻지 않아도 크게 길하다. 천하 사람들이 진심으로 나의 은덕에 감사한다.";
"hex.42.yao.5" = "돕는 사람이 없고 오히려 공격하는 사람이 있다. 마음가짐이 한결같지 못하니 흉하다.";
"hex.43.ci" = "왕의 뜰에서 소인의 죄를 공개하고 진실한 마음으로 사람들에게 호령한다. 여전히 위험이 있으니 경계한다. 먼저 자기 고을에 알리고, 곧바로 무력을 쓰는 것은 이롭지 않다. 나아가면 이롭다(택천쾌는 결단하여 제거함을 뜻한다).";
"hex.43.daxiang" = "못물이 하늘에 오르는 것(비가 되어 아래로 베풀어지려 함)이 택천쾌의 모습이다. 군자는 이를 본받아 아랫백성에게 은혜와 녹을 베푼다. 은덕을 쌓아 두기만 하고 베풀지 않으면 꺼림을 받는다.";
"hex.43.yao.0" = "강한 기세가 앞으로 내딛는 발가락에 나타난다. 나아가도 이기지 못해 오히려 허물이 된다.";
"hex.43.yao.1" = "경계하며 외친다. 한밤중에 적군이 쳐들어와도 걱정할 것 없다.";
"hex.43.yao.2" = "강한 기세가 광대뼈에 나타난다(분노가 얼굴에 드러난다). 흉하다. 군자가 결연히 홀로 나아가다 비에 젖어 남의 노여움을 사더라도 끝내 허물이 없다.";
"hex.43.yao.3" = "엉덩이에 살갗과 살이 없어 걷기 어렵다(나아가거나 물러나지 못한다). 양을 끌듯 가면(무리를 따르면) 후회가 사라지지만, 이 말을 듣고도 믿지 않는다.";
"hex.43.yao.4" = "현륙(연하고 잘 꺾이며 쉽게 자라는 풀)을 뽑듯 단호하게 제거한다. 중도를 행하면 허물이 없다.";
"hex.43.yao.5" = "더 외칠 필요가 없다(구해 줄 사람이 없다). 끝내 흉하다.";
"hex.44.ci" = "여자의 기세가 지나치게 강하다. 이런 여자를 아내로 맞는 것은 좋지 않다(천풍구는 만남을 뜻한다).";
"hex.44.daxiang" = "하늘 아래 바람이 있는 모습(만물에 두루 붊)은 만남을 상징한다. 군주는 이를 본받아 명령을 내리고 사방에 알린다.";
"hex.44.yao.0" = "튼튼한 쇠 수레 멈춤장치에 매어 둔다. 바른 도리를 지키면 길하다. 나아가면 흉함을 만난다. 여윈 암퇘지가 반드시 들썩이는 것과 같다(막 생겨난 음이 들썩인다는 비유).";
"hex.44.yao.1" = "꾸러미에 물고기가 있다('포'는 꾸러미이며, 부엌이라는 해석도 있다). 허물은 없으나 손님을 대접하는 데 쓰기에는 이롭지 않다.";
"hex.44.yao.2" = "엉덩이에 살갗과 살이 없어 걷기 어렵다. 위태롭지만 큰 허물은 없다.";
"hex.44.yao.3" = "꾸러미에 물고기가 없다. 일어나 행동하면 흉하다.";
"hex.44.yao.4" = "기나무의 가지와 잎으로 오이를 감싼다(높은 이가 아래를 보호한다는 비유). 아름다운 덕을 안에 품으면 하늘에서 복이 내린다.";
"hex.44.yao.5" = "뿔 끝(극점)에서 만난다. 아쉬움은 있으나 허물은 없다.";
"hex.45.ci" = "형통하다. 왕이 종묘에 이르러 제사를 지낸다. 덕이 높은 큰 인물을 만나면 이롭고, 형통하며 바른 도리를 지키면 이롭다. 큰 가축을 제물로 바치면 길하다. 나아가면 이롭다(택지췌는 모임을 뜻한다).";
"hex.45.daxiang" = "못물이 땅 위에 모이는 모습은 모임을 상징한다. 군자는 이를 본받아 무기를 정비하고 뜻밖의 일에 대비한다.";
"hex.45.yao.0" = "진실한 믿음을 끝까지 지키지 못해 마음이 어지럽고 함부로 모인다. 외쳐 호응을 구하고 손을 맞잡으면 울다가도 웃게 된다. 걱정할 것 없다. 나아가도 허물이 없다.";
"hex.45.yao.1" = "이끌려 모이면 길하고 허물이 없다. 진실한 믿음을 품으면 소박한 약제(여름 제사)라도 이롭다.";
"hex.45.yao.2" = "모이려 하면서 탄식만 한다. 이로울 것이 없다. 나아가면 허물은 없고 작은 아쉬움만 남는다.";
"hex.45.yao.3" = "크게 길해야 허물이 없다.";
"hex.45.yao.4" = "모임에서 높은 자리에 있으니 허물이 없다. 아직 믿지 않는 이가 있으면 큰 선을 굳게 지키고 오래 바른 도리를 지켜야 후회가 사라진다.";
"hex.45.yao.5" = "탄식하며 눈물과 콧물을 흘린다('체'는 눈물이고 '이'는 콧물이다). 허물이 없다.";
"hex.46.ci" = "크게 형통하다. 덕이 높은 큰 인물을 만나면 좋다. 걱정할 것 없다. 남쪽으로 출정하면 길하다(지풍승은 올라감을 뜻한다).";
"hex.46.daxiang" = "땅속에서 나무가 자라는 모습은 상승을 상징한다. 군자는 이를 본받아 아름다운 덕을 따르며 작은 선을 쌓아 높고 큰 덕을 이룬다.";
"hex.46.yao.0" = "신임을 받아 올라간다. 크게 길하다('윤'은 믿음이며, 나아간다는 해석도 있다).";
"hex.46.yao.1" = "진실한 믿음을 품으면 소박한 약제라도 이롭다. 허물이 없다.";
"hex.46.yao.2" = "텅 빈 고을로 올라 들어간다(막힘없이 나아간다).";
"hex.46.yao.3" = "왕이 기산(주나라가 일어난 곳)에서 제사를 지낸다. 길하고 허물이 없다.";
"hex.46.yao.4" = "바른 도리를 지키면 길하다. 계단을 따라 올라간다.";
"hex.46.yao.5" = "어두운 가운데서도 한결같이 오르려 한다. 그 힘을 쉬지 않고 바른 도리를 지키는 데 쓰면 이롭다.";
"hex.47.ci" = "형통하다. 바른 도리를 지키면 덕이 높은 큰 인물에게 길하고 허물이 없다. 하지만 말을 해도 믿어 주지 않는다(택수곤은 곤궁함을 뜻한다).";
"hex.47.daxiang" = "못에 물이 없는 모습은 곤궁함을 상징한다. 군자는 이를 본받아 목숨을 바쳐 뜻을 이룬다.";
"hex.47.yao.0" = "그루터기에 엉덩이가 눌려 괴롭고, 깊은 골짜기로 들어가 삼 년 동안 사람을 보지 못한다.";
"hex.47.yao.1" = "술과 음식 때문에 곤란하다(술과 음식이 부족하다는 해석도 있다). 붉은 폐슬을 두른 존귀한 이가 오려 한다. 제사를 지내면 이롭다. 출정하면 흉하지만 허물은 없다.";
"hex.47.yao.2" = "돌에 막히고 가시풀에 몸을 의지한다. 집에 돌아와도 아내가 보이지 않는다. 흉하다.";
"hex.47.yao.3" = "더디게 온다. 금속으로 장식한 수레(아래에서 둘째 양효)에 막혀 아쉬움이 있으나 끝내 결실이 있다.";
"hex.47.yao.4" = "코를 베이고 발을 잘린다(위아래로 곤란을 겪는다는 비유). 붉은 폐슬을 두른 자에게 시달리다가 차츰 풀려난다. 제사를 지내면 이롭다.";
"hex.47.yao.5" = "칡넝쿨에 얽혀 흔들리는 불안한 곳에 있다. '움직이면 후회한다'고 돌아보고 참으로 뉘우치면 출정해도 길하다.";
"hex.48.ci" = "고을은 옮겨도 우물은 옮기지 않는다. 물을 길어도 줄지 않고 긷지 않아도 늘지 않으며, 사람들은 오가며 우물에서 물을 얻는다. 물동이가 우물 입구에 거의 닿았으나 미처 꺼내기 전에 부딪쳐 깨지니 흉하다.";
"hex.48.daxiang" = "나무 두레박을 물에 넣어 길어 올리는 것이 수풍정의 모습이다. 군자는 이를 본받아 백성을 위로하고 서로 돕도록 권한다.";
"hex.48.yao.0" = "우물에 진흙이 쌓여 물을 마실 수 없다. 버려진 옛 우물에는 새조차 물을 마시러 오지 않는다.";
"hex.48.yao.1" = "우물 바닥의 움푹한 곳에서는 작은 물고기나 쏘아 잡을 뿐이다(두꺼비라는 해석도 있다). 물 긷는 항아리도 낡아 새니 우물의 구실을 하지 못한다.";
"hex.48.yao.2" = "우물을 깨끗이 쳤는데도 마시는 사람이 없어 내 마음이 슬프다. 이 물은 길어 쓸 수 있다. 왕이 밝고 어질면 위아래가 함께 복을 받는다.";
"hex.48.yao.3" = "벽돌과 돌로 우물 벽을 고친다. 허물이 없다.";
"hex.48.yao.4" = "우물물이 맑아 시원한 샘물을 마실 수 있다.";
"hex.48.yao.5" = "우물물을 길어 올렸다. 입구를 덮지 말아야 한다(모두가 쓰게 한다). 진실한 믿음을 품으면 크게 길하다.";
"hex.49.ci" = "기일이 되어야 사람들의 신뢰를 얻는다('이일', 곧 변혁이 끝난 날이라는 해석도 있다). 크게 형통하고 바른 도리를 지키면 이롭다. 후회가 사라진다.";
"hex.49.daxiang" = "못 속에 불이 있는 것이 택화혁이다. 군자는 이를 본받아 역법을 정비하고 사계절의 절기를 밝힌다.";
"hex.49.yao.0" = "누런 소가죽으로 단단히 묶는다(중도와 유순함을 굳게 지키며 함부로 움직이지 않는다는 비유).";
"hex.49.yao.1" = "기일이 된 뒤에 변혁을 시작한다. 나아가면 길하고 허물이 없다.";
"hex.49.yao.2" = "서둘러 나아가면 흉하지만 고수해도 위태롭다. 변혁을 거듭 의논하여 결론이 나면 신뢰를 얻는다.";
"hex.49.yao.3" = "후회가 사라진다. 진실한 믿음으로 천명을 바꾸면(낡은 제도를 개혁하면) 길하다.";
"hex.49.yao.4" = "덕이 높은 큰 인물이 호랑이가 털갈이하듯 변혁하여 무늬가 새롭게 빛난다. 점을 묻기 전부터 신뢰를 얻는다.";
"hex.49.yao.5" = "군자는 표범이 털갈이하듯 변하고 소인도 얼굴을 바꾸어 새 정치를 따른다. 다시 무리하게 나아가면 흉하다. 편안히 머물며 바른 도리를 지키면 길하다.";
"hex.50.ci" = "크게 길하고 형통하다.";
"hex.50.daxiang" = "나무 위에 불이 타는 것이 화풍정이다. 군자는 이를 본받아 자신의 자리를 바로 하고 사명을 굳게 지킨다.";
"hex.50.yao.0" = "솥을 뒤집어 발을 위로 향하게 하니 쌓인 찌꺼기를 쏟아 내기에 좋다. 첩을 맞아 자식을 얻는 것과 같으니 허물이 없다.";
"hex.50.yao.1" = "솥에 음식이 가득하다. 내 배우자(원수라는 해석도 있다)가 병들어 내게 다가오지 못한다. 길하다.";
"hex.50.yao.2" = "솥의 귀가 떨어져 변형되어 옮길 수 없고 맛있는 꿩국도 먹지 못한다. 음양이 조화되어 비가 내리면 후회가 줄고 끝내 길하다.";
"hex.50.yao.3" = "솥의 발이 부러져 왕공의 음식을 엎고 몸체가 젖어 더러워진다(무거운 형벌을 받는다는 해석도 있다). 흉하다.";
"hex.50.yao.4" = "솥에 노란 귀와 쇠로 만든 운반 막대가 갖추어져 있다. 바른 도리를 지키면 이롭다.";
"hex.50.yao.5" = "솥에 옥으로 만든 운반 막대가 갖추어져 있다. 크게 길하고 이롭지 않은 것이 없다.";
"hex.51.ci" = "형통하다. 우레가 닥쳐 두려워하며 사방을 살피지만 이내 태연히 웃고 이야기한다. 우레가 백 리를 놀라게 해도 제사를 주관하는 이는 숟가락과 향기로운 술을 놓치지 않는다(숟가락은 제물을 뜨고, 술은 제사에 쓴다).";
"hex.51.daxiang" = "우레가 잇달아 오는 것이 중뢰진이다. 군자는 이를 본받아 두려움을 품고 자신을 닦으며 돌아본다.";
"hex.51.yao.0" = "우레가 닥쳐 두렵고 불안하지만 뒤에는 태연히 웃고 이야기한다. 길하다.";
"hex.51.yao.1" = "거센 우레가 닥쳐 위태롭다. 재물을 잃을 것으로 헤아리고 높은 언덕으로 피한다(조개는 옛 화폐다). 쫓아 찾지 않아도 칠 일 뒤에 되찾는다.";
"hex.51.yao.2" = "우레에 마음이 어지럽다. 경계하고 두려워하여 행동하면 재앙이 없다.";
"hex.51.yao.3" = "우레에 흔들려도 진창에 빠진다(떨쳐 일어나지 못한다).";
"hex.51.yao.4" = "우레가 끊임없이 오가니 위태롭다. 그러나 잃는 것 없이 해야 할 일을 지킬 수 있으리라 헤아린다(제사에 관한 일이라는 해석도 있다).";
"hex.51.yao.5" = "우레에 숨이 떨리고 눈빛이 두려워 흔들린다. 나아가면 흉하다. 우레가 아직 자신에게 미치지 않고 이웃에게 미쳤을 때 경계하면 허물이 없다. 다만 혼인에는 뒷말이 있다.";
"hex.52.ci" = "등을 멈추어 두고(눈앞의 것에 마음이 끌리지 않고) 자신에게도 얽매이지 않는다. 뜰을 걸어도 서로의 모습이 눈에 들어오지 않는다. 허물이 없다.";
"hex.52.daxiang" = "두 산이 겹친 것이 중산간이다. 군자는 이를 본받아 생각이 자신의 직분을 벗어나지 않게 한다.";
"hex.52.yao.0" = "발가락을 멈추어 움직이지 않는다. 허물이 없다. 오래 바른 도리를 지키면 이롭다.";
"hex.52.yao.1" = "장딴지를 멈추어도 따르는 사람을 구하지 못하니(그의 망령된 행동을 막지 못하니) 마음이 불쾌하다.";
"hex.52.yao.2" = "허리를 멈추어 등뼈가 위아래로 갈라지듯 굳어진다. 위험이 연기와 불처럼 마음을 태운다.";
"hex.52.yao.3" = "윗몸을 멈춘다. 허물이 없다.";
"hex.52.yao.4" = "입과 볼을 함부로 움직이지 않고 조리 있게 말한다. 후회가 사라진다.";
"hex.52.yao.5" = "돈후하고 성실한 덕으로 멈춘다. 길하다.";
"hex.53.ci" = "여자가 예에 따라 차례를 밟아 시집가면 길하다. 바른 도리를 지키면 이롭다.";
"hex.53.daxiang" = "산 위에 나무가 자라는 것이 풍산점이다. 군자는 이를 본받아 어진 덕을 쌓고 풍속을 개선한다.";
"hex.53.yao.0" = "기러기가 차츰 물가로 나아간다. 젊은이는 위태롭고 말로 비난받지만 허물은 없다.";
"hex.53.yao.1" = "기러기가 차츰 큰 바위로 나아가 화목하고 편안히 먹고 마신다. 길하다.";
"hex.53.yao.2" = "기러기가 차츰 높고 평평한 땅으로 나아간다. 남편은 출정하여 돌아오지 않고 아내는 임신해도 낳지 못한다. 흉하다. 외적을 막으면 이롭다.";
"hex.53.yao.3" = "기러기가 차츰 나무로 나아가 평평한 가지를 찾아 쉴 수도 있다. 허물이 없다.";
"hex.53.yao.4" = "기러기가 차츰 언덕으로 나아간다. 아내가 삼 년 동안 임신하지 못하지만, 끝내 바른 도리를 이길 것은 없으니 길하다.";
"hex.53.yao.5" = "기러기가 차츰 높은 곳으로 나아간다('육'을 구름길을 뜻하는 '규'로 보기도 한다). 그 깃털을 의례의 장식으로 쓸 수 있으니 길하다.";
"hex.54.ci" = "소녀가 시집간다(바른 예에 맞지 않는다). 나아가면 흉하고 이로울 것이 없다.";
"hex.54.daxiang" = "못 위에 우레가 있는 것이 뇌택귀매이다. 군자는 이를 본받아 오래 지속되어 좋은 끝을 맺도록 하고, 생길 수 있는 폐단을 미리 안다.";
"hex.54.yao.0" = "소녀가 언니를 따라가는 동생의 신분으로 시집간다. 다리를 절어도 걸을 수 있는 것과 같으니 나아가면 길하다.";
"hex.54.yao.1" = "한쪽 눈이 어두워도 볼 수 있는 것과 같다. 조용히 은거하는 사람이 바른 도리를 지키면 이롭다.";
"hex.54.yao.2" = "소녀가 신분을 믿고 혼인을 기다린다('수'는 기다림이며, 언니나 천한 첩이라는 해석도 있다). 결국 도리어 따라가는 동생의 신분으로 시집간다.";
"hex.54.yao.3" = "소녀의 혼기가 늦어진다. 늦게 시집가는 것은 알맞은 때를 기다리기 때문이다.";
"hex.54.yao.4" = "제을(상나라 왕)이 누이동생을 시집보낸다. 정실의 옷이 오히려 따라온 이의 옷보다 화려하지 않다. 달이 보름에 가깝지만 아직 완전히 차지는 않았다. 길하다.";
"hex.54.yao.5" = "여자가 대바구니를 받들어도 속이 비었고, 남자가 양을 찔러도 피가 나지 않는다(제사가 이루어지지 않는다). 이로울 것이 없다.";
"hex.55.ci" = "형통하다. 왕이 이 성대한 경지에 이른다. 걱정할 것 없이 정오의 해처럼 천하를 두루 비추면 좋다.";
"hex.55.daxiang" = "우레와 번개가 함께 오는 것이 뇌화풍이다. 군자는 이를 본받아 사건을 심판하고 형벌을 집행한다.";
"hex.55.yao.0" = "자신과 짝이 되는 주인을 만난다. 서로 대등해도 허물이 없다. 나아가면 존중받는다.";
"hex.55.yao.1" = "가리는 거적이 커서 한낮에도 북두칠성이 보일 만큼 어둡다. 나아가면 의심받고 미움을 사지만, 진실한 믿음으로 상대를 감화하면 길하다.";
"hex.55.yao.2" = "가리는 장막이 커서 한낮에도 작은 별이 보일 만큼 어둡다. 오른팔이 부러지지만 허물은 없다.";
"hex.55.yao.3" = "가리는 거적이 커서 한낮에도 북두칠성이 보일 만큼 어둡다. 같은 덕을 지닌 주인을 만나면 길하다.";
"hex.55.yao.4" = "재능 있는 사람을 불러들인다. 경사와 칭송이 있으니 길하다.";
"hex.55.yao.5" = "집을 크게 짓고도 빈틈없이 가려 버린다. 문으로 엿보아도 고요히 아무도 없고 삼 년 동안 사람 그림자도 보이지 않는다. 흉하다.";
"hex.56.ci" = "조금 형통하다. 나그네로 밖에 머물며 바른 도리를 굳게 지키면 길하다.";
"hex.56.daxiang" = "산 위에 불이 있는 것이 화산려이다. 군자는 이를 본받아 밝게 살피고 신중하게 형벌을 쓰며 송사와 구금을 지체하지 않는다.";
"hex.56.yao.0" = "나그네로 지내며 비루하고 옹졸하게 행동한다. 스스로 재앙을 부르는 것이다.";
"hex.56.yao.1" = "여행 중 여관에 들어 재물을 지니고 충실한 어린 종을 얻는다.";
"hex.56.yao.2" = "여행 중 숙소가 불타고 어린 종을 잃는다. 이런 처지에 머무르면 위태롭다.";
"hex.56.yao.3" = "여행 중 잠시 머물 곳과 재물과 도끼를 얻는다('자부'는 여비라는 해석도 있다). 그러나 내 마음은 즐겁지 않다.";
"hex.56.yao.4" = "꿩을 쏘아 화살 하나를 잃지만 끝내 칭송과 작위를 받는다.";
"hex.56.yao.5" = "새 둥지가 불탄다. 나그네는 처음에는 웃다가 나중에는 통곡한다. 경계에서 소를 잃는다('역'은 유역국이나 방심을 뜻한다는 해석도 있다). 흉하다.";
"hex.57.ci" = "조금 형통하다. 나아가면 이롭고 덕이 높고 지위가 존귀한 큰 인물을 만나면 이롭다.";
"hex.57.daxiang" = "바람이 잇달아 부는 것이 중풍손이다. 군자는 이를 본받아 명령을 거듭 밝히고 정무를 시행한다.";
"hex.57.yao.0" = "나아갈지 물러날지 망설인다. 무인처럼 과감히 결단하여 바른 도리를 지키면 이롭다.";
"hex.57.yao.1" = "겸손히 침상 아래 엎드려 제관과 무당의 도움으로 거듭 신명에게 정성을 전한다. 길하고 허물이 없다.";
"hex.57.yao.2" = "거듭 억지로 순종하는 모습을 보인다. 아쉬움이 남는다.";
"hex.57.yao.3" = "후회가 사라진다. 사냥에서 여러 사냥감을 얻는다(삼품은 제사, 손님 접대, 일상 음식이라는 세 용도).";
"hex.57.yao.4" = "바른 도리를 지키면 길하고 후회가 사라지며 이롭지 않은 것이 없다. 처음에는 순조롭지 않아도 끝에는 좋은 결과가 있다. 경일 사흘 전에 명을 내리고 사흘 뒤에 성과를 살피면 길하다.";
"hex.57.yao.5" = "지나치게 낮추어 침상 아래 엎드리고 재물과 도끼를 잃는다(결단력과 의지할 것을 잃는다는 비유). 이대로 고집하면 흉하다.";
"hex.58.ci" = "형통하다. 바른 도리를 지키면 이롭다.";
"hex.58.daxiang" = "두 못이 이어진 것이 중택태이다. 군자는 이를 본받아 벗과 학문을 토론하고 도리를 익힌다.";
"hex.58.yao.0" = "온화한 태도로 남을 기쁘게 한다. 길하다.";
"hex.58.yao.1" = "진실한 믿음으로 남을 기쁘게 한다. 길하고 후회가 사라진다.";
"hex.58.yao.2" = "스스로 다가와 기쁨을 구한다(아첨하며 비위를 맞춘다). 흉하다.";
"hex.58.yao.3" = "누구를 기쁘게 해야 할지 거듭 헤아리며 마음이 불안하다. 사악한 병폐를 끊어 내면 기쁨이 있다.";
"hex.58.yao.4" = "양의 굳센 힘을 깎아 내리는 소인을 믿는다. 위태롭다.";
"hex.58.yao.5" = "남을 꾀어 함께 기쁨을 구한다.";
"hex.59.ci" = "형통하다. 왕이 종묘에 이르러 제사를 지낸다(흩어진 민심을 모으기 위해서다). 큰 강을 건너면 이롭고 바른 도리를 지키면 이롭다.";
"hex.59.daxiang" = "바람이 물 위로 부는 것이 풍수환이다. 옛 왕은 이를 본받아 하늘의 상제에게 제사하고 종묘를 세웠다(민심을 모으기 위해서다).";
"hex.59.yao.0" = "튼튼한 말의 도움으로 구하니 길하다.";
"hex.59.yao.1" = "흩어지는 때에 의지할 수 있는 책상으로 달려간다(의지할 곳을 얻는다는 비유). 후회가 사라진다.";
"hex.59.yao.2" = "자신의 사사로운 마음을 흩어 버린다. 후회는 없다.";
"hex.59.yao.3" = "사사로이 맺은 무리를 해체하면 크게 길하다. 흩어 놓음으로써 언덕 같은 큰 무리를 이루니 보통 사람은 생각하기 어렵다.";
"hex.59.yao.4" = "흩어지는 때에 땀이 퍼지듯 큰 명령을 널리 내리고 왕의 비축물을 나누어 준다(왕이 바른 자리에 있어 민심을 모은다는 해석도 있다). 허물이 없다.";
"hex.59.yao.5" = "피 흘리는 해를 흩어 없애고 멀리 떠난다. 허물이 없다.";
"hex.60.ci" = "형통하다. 지나치게 가혹한 절제는 오래 고집해서는 안 된다.";
"hex.60.daxiang" = "못 위에 물이 있는 것이 수택절이다. 군자는 이를 본받아 예절과 법도를 정하고 사람의 덕행을 논한다.";
"hex.60.yao.0" = "방문 밖 안뜰을 벗어나지 않는다. 허물이 없다.";
"hex.60.yao.1" = "대문 밖 뜰로 나가지 않는다(나가야 할 때 나가지 않는다). 흉하다.";
"hex.60.yao.2" = "절제할 줄 모르면 탄식하고 후회한다. 누구를 탓하겠는가(스스로 탄식하며 뉘우치면 허물이 없다는 해석도 있다).";
"hex.60.yao.3" = "편안히 절제한다. 형통하다.";
"hex.60.yao.4" = "즐겁고 알맞게 절제한다. 길하다. 나아가면 존중받는다.";
"hex.60.yao.5" = "지나치게 가혹한 절제를 고집하면 흉하다. 다만 뉘우쳐 고치면 후회가 사라진다.";
"hex.61.ci" = "진실한 믿음이 새끼 돼지와 물고기까지 감화하니 길하다(하찮은 생물에게까지 진실함이 미친다는 비유). 큰 강을 건너면 이롭고 바른 도리를 지키면 이롭다.";
"hex.61.daxiang" = "못 위에 바람이 있는 것이 풍택중부이다. 군자는 이를 본받아 송사를 신중히 심의하고 사형 집행을 늦춘다.";
"hex.61.yao.0" = "편안히 본분을 지키면 길하다('우'는 헤아림이나 준비라는 해석도 있다). 다른 것을 구하면 편안하지 못하다.";
"hex.61.yao.1" = "학이 나무 그늘에서 울면 같은 무리가 화답한다. 내게 좋은 술이 있으니 그대와 함께 마시며 즐기려 한다.";
"hex.61.yao.2" = "상대를 만나 때로는 북을 치며 공격하고 때로는 싸움을 쉬며, 울기도 하고 노래하기도 한다.";
"hex.61.yao.3" = "달이 보름에 가깝다. 좋은 말이 짝을 잃지만 허물은 없다.";
"hex.61.yao.4" = "진실한 믿음으로 사람들을 굳게 맺어 준다. 허물이 없다.";
"hex.61.yao.5" = "닭 울음소리가 하늘까지 오른다(이름이 실상보다 지나치다는 비유). 이대로 고집하면 흉하다.";
"hex.62.ci" = "형통하다. 바른 도리를 지키면 이롭다. 작은 일은 할 수 있으나 큰일은 해서는 안 된다. 나는 새가 울음소리를 남긴다(아래로 전해진다). 높이 오르기보다 아래로 내려와 쉬면 좋으니 크게 길하다.";
"hex.62.daxiang" = "산 위에 우레가 있는 것이 뇌산소과이다. 군자는 이를 본받아 행동은 조금 더 공손하게, 상례는 조금 더 슬프게, 씀씀이는 조금 더 검소하게 한다.";
"hex.62.yao.0" = "새가 날아 흉함을 부른다(낮은 곳에 머물지 않고 억지로 높이 날려 한다).";
"hex.62.yao.1" = "할아버지를 지나 할머니를 만난다. 군주를 넘지 않고 신하를 만난다. 허물이 없다.";
"hex.62.yao.2" = "넉넉히 경계하려 하지 않고 도리어 상대가 따라오도록 내버려 두면 해를 입을 수 있다. 흉하다.";
"hex.62.yao.3" = "허물이 없다. 지나치게 강하게 나가지 않아도 상대와 만날 수 있다. 나아가면 위태로우니 반드시 경계해야 한다. 오래 고집해서는 안 된다.";
"hex.62.yao.4" = "우리 서쪽 들에서 짙은 구름이 몰려오지만 비는 내리지 않는다. 왕공이 줄 달린 화살로 굴속에 숨은 사냥감을 쏘아 잡는다.";
"hex.62.yao.5" = "만나지 못하고 도리어 지나쳐 버린다. 새가 그물에 걸리듯 흉하다. 이를 재앙이라 한다.";
"hex.63.ci" = "형통하고 작은 일도 순조롭다. 바른 도리를 지키면 이롭다. 처음에는 길하지만 끝내 혼란에 빠진다.";
"hex.63.daxiang" = "물이 불 위에 있는 것이 수화기제이다. 군자는 이를 본받아 생길 수 있는 재앙을 생각하고 미리 대비한다.";
"hex.63.yao.0" = "수레바퀴를 끌어 잡는다(서둘러 나아가지 않게 한다). 강을 건너는 여우가 꼬리를 적신다. 허물이 없다.";
"hex.63.yao.1" = "여자가 수레의 가림막을 잃는다. 쫓아 찾지 않아도 칠 일 뒤에 되찾는다.";
"hex.63.yao.2" = "고종(상나라 왕 무정)이 귀방(북방 부족)을 정벌하여 삼 년 만에 이긴다. 소인은 등용해서는 안 된다.";
"hex.63.yao.3" = "화려한 옷도 헝겊 조각이 된다(배가 샐 때 막을 헝겊을 준비한다는 해석도 있다). 온종일 경계해야 한다.";
"hex.63.yao.4" = "동쪽 이웃 나라가 소를 잡아 성대한 제사를 지내도 서쪽 이웃 나라의 소박한 약제(여름의 간소한 제사)만 못하다. 후자가 참으로 복을 받는다.";
"hex.63.yao.5" = "강을 건너다 머리까지 젖는다. 위태롭다.";
"hex.64.ci" = "형통하다. 어린 여우가 강을 거의 건넜을 때 꼬리를 적시니 이로울 것이 없다.";
"hex.64.daxiang" = "불이 물 위에 있는 것이 화수미제이다. 군자는 이를 본받아 사물을 신중히 분별하여 저마다 알맞은 자리에 둔다.";
"hex.64.yao.0" = "꼬리를 적시니 아쉬움이 남는다.";
"hex.64.yao.1" = "수레바퀴를 끌어 잡는다(나아가기를 서두르지 않는다). 바른 도리를 지키면 길하다.";
"hex.64.yao.2" = "아직 건너지 못했다. 나아가면 흉하다. 큰 강을 건너면 이롭다('이롭다' 앞에 부정어가 빠졌다는 해석도 있다).";
"hex.64.yao.3" = "바른 도리를 지키면 길하고 후회가 사라진다. 우레 같은 기세로 귀방을 정벌하여 삼 년 뒤 큰 나라에서 포상을 받는다.";
"hex.64.yao.4" = "바른 도리를 지키면 길하고 후회가 없다. 군자의 빛은 진실한 믿음에 있으니 길하다.";
"hex.64.yao.5" = "진실한 믿음으로 편안히 술을 마시면 허물이 없다. 그러나 술에 빠져 머리까지 젖으면 진실한 믿음이 있어도 바른 도리를 잃는다.";
"hex.1.yong" = "여러 용이 나타나 모두 우두머리가 되려고 다투지 않는다. 길하다.";
"hex.2.yong" = "영원히 바른 도리를 굳게 지키면 이롭다.";
