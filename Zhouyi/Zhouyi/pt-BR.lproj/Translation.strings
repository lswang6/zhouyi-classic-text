/* 周易 · pt-BR · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: pt-BR.json */
"hex.1.ci" = "Iniciativa criadora, êxito, harmonia favorável e perseverança no que é correto.";
"hex.1.daxiang" = "O céu se move com vigor incessante. Assim, a pessoa nobre se fortalece sem descanso.";
"hex.1.yao.0" = "O dragão permanece oculto sob a água. Ainda não é tempo de agir.";
"hex.1.yao.1" = "O dragão aparece no campo. É favorável encontrar uma grande pessoa de virtude.";
"hex.1.yao.2" = "A pessoa nobre se empenha sem descanso o dia inteiro e, ao anoitecer, permanece alerta, como diante de um perigo. Sem culpa.";
"hex.1.yao.3" = "O dragão pode saltar para o alto ou se recolher ao abismo, conforme o momento. Sem culpa.";
"hex.1.yao.4" = "O dragão voa no céu. É favorável encontrar uma grande pessoa de virtude.";
"hex.1.yao.5" = "O dragão voa alto demais. Há arrependimento.";
"hex.2.ci" = "Iniciativa criadora e êxito. É favorável perseverar no que é correto com a docilidade de uma égua. A pessoa nobre segue seu caminho: se toma a dianteira, se perde; se acompanha, encontra quem a guie. É favorável. A sudoeste encontra amigos; a nordeste os perde. Repousar no que é correto traz boa fortuna.";
"hex.2.daxiang" = "A terra é dócil, ampla e profunda. Assim, a pessoa nobre sustenta todas as coisas com a profundidade de sua virtude.";
"hex.2.yao.0" = "Ao pisar na geada, anuncia-se o gelo firme (imagem de prevenir o mal desde seus primeiros sinais).";
"hex.2.yao.1" = "Retidão, integridade e amplitude: mesmo sem cultivo deliberado, tudo é favorável.";
"hex.2.yao.2" = "Guardar a virtude sem ostentá-la permite perseverar no que é correto. Ao servir ao rei, levar a tarefa até o fim sem reivindicar o mérito.";
"hex.2.yao.3" = "Atar a boca do saco (imagem do silêncio prudente). Sem culpa nem elogio.";
"hex.2.yao.4" = "Uma saia amarela (o amarelo representa o centro; a veste inferior, a humildade). Grande fortuna.";
"hex.2.yao.5" = "Os dragões combatem no campo. Seu sangue mistura negro azulado e amarelo (cores do céu e da terra: na luta entre yin e yang, ambos saem feridos).";
"hex.3.ci" = "Iniciativa criadora e êxito. É favorável perseverar no que é correto. Não se apressar em partir. É favorável estabelecer senhores feudais (instituir um soberano e buscar auxílio).";
"hex.3.daxiang" = "Nuvens acima e trovão abaixo: A Dificuldade Inicial. Assim, a pessoa nobre organiza e governa o mundo como quem ordena os fios de um tecido.";
"hex.3.yao.0" = "Hesitar sem avançar. É favorável permanecer no que é correto; é favorável estabelecer senhores feudais.";
"hex.3.yao.1" = "Avançar com dificuldade e hesitação; os cavalos giram sem progredir. Não são bandidos, mas pretendentes. A jovem persevera no que é correto e não aceita se casar; só após dez anos aceita.";
"hex.3.yao.2" = "Perseguir o cervo sem um guarda-florestal (oficial encarregado dos montes e bosques) só leva a se perder na mata. A pessoa nobre percebe os sinais: melhor desistir. Avançar traz pesar.";
"hex.3.yao.3" = "Os cavalos giram sem avançar. Buscar uma união matrimonial: partir traz boa fortuna. Tudo é favorável.";
"hex.3.yao.4" = "Os benefícios se acumulam sem poder ser distribuídos. Perseverar no que é correto em assuntos pequenos traz boa fortuna; em assuntos grandes, infortúnio.";
"hex.3.yao.5" = "Os cavalos giram sem avançar. Correm lágrimas de sangue.";
"hex.4.ci" = "Êxito. Não sou eu quem procura o jovem inexperiente; ele me procura. Na primeira consulta, respondo. Repeti-la sem cessar é irreverência; diante da irreverência, não respondo. É favorável perseverar no que é correto.";
"hex.4.daxiang" = "Ao pé da montanha brota uma fonte: A Insensatez Juvenil. Assim, a pessoa nobre age com resolução e cultiva sua virtude.";
"hex.4.yao.0" = "Dissipar a ignorância. É favorável empregar o castigo para disciplinar as pessoas e libertá-las dos grilhões. Persistir apenas em castigar traz pesar.";
"hex.4.yao.1" = "Acolher o ignorante traz boa fortuna. Tomar esposa traz boa fortuna. O filho pode cuidar do lar.";
"hex.4.yao.2" = "Não tomar por esposa uma mulher que, ao ver um homem rico, se entrega sem resguardo. Nada é favorável.";
"hex.4.yao.3" = "Ficar preso à ignorância. Pesar.";
"hex.4.yao.4" = "Buscar ensinamento com a simplicidade de uma criança. Boa fortuna.";
"hex.4.yao.5" = "Combater com firmeza a ignorância. Não é favorável se exceder como um bandido; é favorável se defender de agressões.";
"hex.5.ci" = "Sinceridade, clareza e êxito. Perseverar no que é correto traz boa fortuna. É favorável atravessar o grande rio (enfrentar riscos para realizar uma tarefa).";
"hex.5.daxiang" = "As nuvens sobem ao céu (aguardando o momento de chover): A Espera. Assim, a pessoa nobre come, bebe e celebra, aguardando serenamente seu momento.";
"hex.5.yao.0" = "Esperar nos arredores distantes. É favorável manter a constância. Sem culpa.";
"hex.5.yao.1" = "Esperar na areia. Há pequenas disputas verbais; ao final, boa fortuna.";
"hex.5.yao.2" = "Esperar na lama atrai os bandidos.";
"hex.5.yao.3" = "Esperar em meio ao sangue (num lugar onde se sofre dano). Consegue-se sair da caverna.";
"hex.5.yao.4" = "Esperar serenamente entre vinho e comida. Perseverar no que é correto traz boa fortuna.";
"hex.5.yao.5" = "Cair na caverna. Chegam três hóspedes sem convite. Tratá-los com respeito traz, ao final, boa fortuna.";
"hex.6.ci" = "A sinceridade encontra obstáculos. Permanecer alerta e parar a meio caminho traz boa fortuna; levar o litígio ao extremo, infortúnio. É favorável encontrar uma grande pessoa de virtude (para obter um julgamento justo). Não é favorável atravessar o grande rio.";
"hex.6.daxiang" = "O céu sobe e a água desce em direções opostas: O Conflito. Assim, a pessoa nobre planeja seus atos desde o início (para evitar disputas).";
"hex.6.yao.0" = "Não prolongar o litígio. Há pequenas disputas verbais; ao final, boa fortuna.";
"hex.6.yao.1" = "Não vencer o litígio; voltar e se retirar. O feudo tem apenas trezentas famílias. Não há calamidade.";
"hex.6.yao.2" = "Viver das antigas mercês. Perseverar no que é correto para se precaver do perigo. Ao final, boa fortuna. Ao servir ao rei, não reivindicar o mérito.";
"hex.6.yao.3" = "Não vencer o litígio. Voltar ao que é justo, mudar de intenção e repousar no que é correto. Boa fortuna.";
"hex.6.yao.4" = "Resolver o litígio (com um julgamento justo). Grande fortuna.";
"hex.6.yao.5" = "Mesmo que se receba um luxuoso cinturão pelo litígio, ele é retirado três vezes num só dia.";
"hex.7.ci" = "Perseverança no que é correto. Sob o comando de um ancião de grande virtude e prestígio, boa fortuna. Sem culpa.";
"hex.7.daxiang" = "Dentro da terra há água: O Exército. Assim, a pessoa nobre acolhe e sustenta o povo.";
"hex.7.yao.0" = "O exército parte para a campanha sujeito à disciplina. Se a disciplina falha, infortúnio.";
"hex.7.yao.1" = "Ocupar o centro e comandar o exército. Boa fortuna, sem culpa. O rei concede repetidamente honrarias por decreto.";
"hex.7.yao.2" = "O exército pode voltar transportando cadáveres. Infortúnio.";
"hex.7.yao.3" = "O exército recua e acampa. Sem culpa.";
"hex.7.yao.4" = "Há animais no campo (imagem de uma invasão inimiga). É favorável denunciá-los e capturá-los. Sem culpa. O filho mais velho deve comandar o exército; se um jovem sem virtude assume o comando, voltará com cadáveres. Mesmo perseverando no que é correto, infortúnio.";
"hex.7.yao.5" = "O soberano emite seu mandato e recompensa os méritos: uns recebem estados como senhores feudais; outros, casas como altos dignitários. Não se deve empregar pessoas mesquinhas.";
"hex.8.ci" = "Boa fortuna. Examinar o sentido da consulta: com iniciativa criadora, constância e perseverança no que é correto, sem culpa. Os estados inquietos vêm se unir. Quem chega tarde encontra infortúnio.";
"hex.8.daxiang" = "Sobre a terra há água (intimamente unidas): A Solidariedade. Assim, os antigos reis fundavam os estados e estreitavam seus laços com os senhores feudais.";
"hex.8.yao.0" = "Unir-se aos outros com sinceridade. Sem culpa. A sinceridade transborda como bom vinho numa vasilha de barro. Ao final chegam benefícios inesperados. Boa fortuna.";
"hex.8.yao.1" = "Unir-se de coração. Perseverar no que é correto traz boa fortuna.";
"hex.8.yao.2" = "Unir-se a quem não se deve.";
"hex.8.yao.3" = "Unir-se a pessoas virtuosas fora do próprio círculo. Perseverar no que é correto traz boa fortuna.";
"hex.8.yao.4" = "Unir-se a todos de maneira franca. Na caça, o rei faz os batedores avançarem por três lados e deixa um aberto, permitindo que os animais à frente escapem. Os habitantes também não precisam desconfiar uns dos outros. Boa fortuna.";
"hex.8.yao.5" = "Unir-se sem fazê-lo a tempo (segundo outra leitura, sem um bom começo). Infortúnio.";
"hex.9.ci" = "Êxito. Nuvens densas sem chuva se levantam dos nossos arredores ocidentais.";
"hex.9.daxiang" = "O vento percorre o céu: O Poder de Domar do Pequeno. Assim, a pessoa nobre aprimora sua cultura e sua virtude.";
"hex.9.yao.0" = "Voltar ao próprio caminho correto. Que culpa pode haver? Boa fortuna.";
"hex.9.yao.1" = "Deixar-se conduzir de volta, junto com outros, ao caminho correto. Boa fortuna.";
"hex.9.yao.2" = "Os raios da roda do carro se soltam. Marido e mulher se desentendem.";
"hex.9.yao.3" = "Com sinceridade, as aflições se afastam e o temor desaparece. Sem culpa.";
"hex.9.yao.4" = "A sinceridade une a todos. Compartilhar a prosperidade com os vizinhos.";
"hex.9.yao.5" = "Já choveu e o yang foi contido e repousa, graças ao cultivo da virtude. Para a mulher, mesmo perseverando no que é correto, há perigo. A lua está quase cheia (o yin cresce até rivalizar com o yang). Se a pessoa nobre parte em campanha, infortúnio.";
"hex.10.ci" = "Pisar atrás da cauda do tigre sem que ele morda. Êxito.";
"hex.10.daxiang" = "Acima o céu, abaixo o lago: A Conduta. Assim, a pessoa nobre distingue as posições superiores e inferiores e dá estabilidade ao ânimo do povo.";
"hex.10.yao.0" = "Agir com simplicidade natural. Avançar sem culpa.";
"hex.10.yao.1" = "O caminho é plano e amplo. Para quem vive recolhido e sereno, perseverar no que é correto traz boa fortuna.";
"hex.10.yao.2" = "Quem enxerga mal julga ver com clareza; quem manca julga poder ir longe. Pisa na cauda do tigre e é mordido. Infortúnio. Assim é o guerreiro que pretende ser soberano.";
"hex.10.yao.3" = "Pisar na cauda do tigre com temor e cautela. Ao final, boa fortuna.";
"hex.10.yao.4" = "Agir com firme resolução. Mesmo perseverando no que é correto, há perigo.";
"hex.10.yao.5" = "Rever o caminho percorrido e examinar seus sinais de felicidade e desventura. Se tudo se cumpre plenamente, grande fortuna.";
"hex.11.ci" = "O pequeno se vai e o grande chega (o yin se retira e o yang avança). Boa fortuna e êxito.";
"hex.11.daxiang" = "O céu e a terra se comunicam: A Paz. Assim, o soberano ordena a atividade humana segundo seus ciclos e favorece sua ação fecunda para ajudar o povo.";
"hex.11.yao.0" = "Ao arrancar o capim, suas raízes entrelaçadas puxam outros do mesmo grupo. Partir juntos em campanha traz boa fortuna.";
"hex.11.yao.1" = "Acolher o inculto, ousar vadear o rio, não esquecer as pessoas capazes que vivem longe nem formar facções por interesse. Assim se merece estima por seguir o caminho do centro.";
"hex.11.yao.2" = "Não há planície sem declive nem partida sem retorno. Perseverar no que é correto nas dificuldades: sem culpa. Não se preocupar em ganhar a confiança alheia; haverá sustento e bênçãos.";
"hex.11.yao.3" = "Descer com leveza. Unir-se aos vizinhos sem recorrer à riqueza; tratar-se com sinceridade, sem desconfiança.";
"hex.11.yao.4" = "Di Yi (rei da dinastia Shang) entrega sua irmã mais nova em casamento. Disso vêm bênçãos e grande fortuna.";
"hex.11.yao.5" = "A muralha desaba no fosso. Não empregar o exército; proclamar as ordens na própria cidade. Mesmo perseverando no que é correto, há pesar.";
"hex.12.ci" = "A obstrução contraria a ordem humana normal (segundo outra leitura, é causada pelas pessoas mesquinhas). Não favorece a perseverança da pessoa nobre no que é correto. O grande se vai e o pequeno chega (o yang se retira e o yin avança).";
"hex.12.daxiang" = "O céu e a terra não se comunicam: A Estagnação. Assim, a pessoa nobre resguarda sua virtude para evitar calamidades e não cobiça honrarias nem cargos remunerados.";
"hex.12.yao.0" = "Ao arrancar o capim, suas raízes entrelaçadas puxam outros do mesmo grupo. Junto com os afins, perseverar no que é correto traz boa fortuna e êxito.";
"hex.12.yao.1" = "Acolher e obedecer aos superiores traz boa fortuna à pessoa mesquinha. A grande pessoa de virtude alcança êxito mantendo-se firme na estagnação.";
"hex.12.yao.2" = "Abrigar vergonha.";
"hex.12.yao.3" = "Cumprir o mandato do céu. Sem culpa. Os afins se unem e compartilham as bênçãos.";
"hex.12.yao.4" = "Pôr fim à estagnação. Boa fortuna para a grande pessoa de virtude. Lembrar sempre: «A ruína se aproxima, a ruína se aproxima!». Assim se estará tão firme quanto amarrado a um conjunto de amoreiras.";
"hex.12.yao.5" = "Derrubar a estagnação. Primeiro, obstrução; depois, alegria.";
"hex.13.ci" = "Unir-se aos demais em campo aberto. Êxito. É favorável atravessar o grande rio (enfrentar riscos para realizar uma tarefa). É favorável que a pessoa nobre persevere no que é correto.";
"hex.13.daxiang" = "O céu e o fogo se unem: A Comunidade com os Homens. Assim, a pessoa nobre classifica os grupos humanos e distingue as coisas, buscando o que têm em comum e reconhecendo as diferenças.";
"hex.13.yao.0" = "Unir-se aos outros ao sair de casa. Sem culpa.";
"hex.13.yao.1" = "Unir-se apenas dentro da própria linhagem. Pesar.";
"hex.13.yao.2" = "Ocultar tropas no mato e subir a uma colina para observar. Durante três anos não se ousa iniciar a luta.";
"hex.13.yao.3" = "Subir à muralha do adversário, mas por fim desistir do ataque. Boa fortuna.";
"hex.13.yao.4" = "Unir-se aos outros: primeiro, choro amargo; depois, risos. Após a vitória do grande exército, podem se reunir.";
"hex.13.yao.5" = "Unir-se aos outros nas proximidades da cidade. Sem arrependimento (embora a união ainda não abranja o campo aberto).";
"hex.14.ci" = "Grande êxito.";
"hex.14.daxiang" = "O fogo ilumina do alto do céu: Grandes Posses. Assim, a pessoa nobre contém o mal e promove o bem, seguindo o benéfico mandato do céu.";
"hex.14.yao.0" = "Não se relacionar com o que é nocivo evita a culpa. Permanecer alerta diante das dificuldades: sem culpa.";
"hex.14.yao.1" = "Carregar os bens num grande carro e seguir caminho. Sem culpa.";
"hex.14.yao.2" = "O senhor feudal oferece tributo ao Filho do Céu (segundo outra leitura, participa de seu banquete). A pessoa mesquinha não é capaz disso.";
"hex.14.yao.3" = "Não ostentar em excesso a própria grandeza. Sem culpa.";
"hex.14.yao.4" = "Relacionar-se com superiores e inferiores com sinceridade e dignidade. Boa fortuna.";
"hex.14.yao.5" = "O céu oferece sua proteção. Boa fortuna; tudo é favorável.";
"hex.15.ci" = "Êxito. A pessoa nobre leva as coisas a bom termo.";
"hex.15.daxiang" = "Dentro da terra há uma montanha: A Modéstia. Assim, a pessoa nobre reduz o excessivo e aumenta o escasso, ponderando as coisas para distribuir com equidade.";
"hex.15.yao.0" = "A pessoa nobre, humilde entre os humildes, pode atravessar o grande rio (enfrentar riscos para realizar uma tarefa). Boa fortuna.";
"hex.15.yao.1" = "A fama da modéstia se espalha. Perseverar no que é correto traz boa fortuna.";
"hex.15.yao.2" = "A pessoa nobre tem méritos e conserva a modéstia. Ao final, boa fortuna.";
"hex.15.yao.3" = "Tudo é favorável. Pôr em prática a modéstia (manifestar e cultivar essa virtude).";
"hex.15.yao.4" = "Obter o apoio dos vizinhos sem se apoiar na riqueza. É favorável empreender uma campanha contra os insubmissos. Tudo é favorável.";
"hex.15.yao.5" = "A fama da modéstia se espalha. É favorável mobilizar o exército e submeter as cidades e estados (do próprio território).";
"hex.16.ci" = "É favorável estabelecer senhores feudais e mobilizar o exército.";
"hex.16.daxiang" = "O trovão irrompe com força da terra: O Entusiasmo. Assim, os antigos reis criavam música para honrar a virtude e a ofereciam solenemente ao Soberano do Alto, associando seus antepassados ao sacrifício.";
"hex.16.yao.0" = "Ostentar alegria e satisfação pelo favor recebido. Infortúnio.";
"hex.16.yao.1" = "Firme como uma rocha, perceber o momento e agir antes que o dia termine. Perseverar no que é correto traz boa fortuna.";
"hex.16.yao.2" = "Olhar para cima e adular para obter prazer traz arrependimento. Demorar a compreender também traz arrependimento.";
"hex.16.yao.3" = "Por meio dele os outros encontram bem-estar. Grandes ganhos. Não duvidar: os amigos se reúnem como o cabelo em torno de um grampo.";
"hex.16.yao.4" = "Perseverar no que é correto, embora haja doença. Ela se prolonga, mas a morte não chega.";
"hex.16.yao.5" = "Mergulhar nos prazeres até perder a lucidez. Se houver mudança, sem culpa.";
"hex.17.ci" = "Grande êxito. É favorável perseverar no que é correto. Sem culpa.";
"hex.17.daxiang" = "Dentro do lago há trovão (que ali se recolhe para descansar): Seguir. Assim, a pessoa nobre se retira para descansar ao cair da tarde.";
"hex.17.yao.0" = "Mudam os assuntos sob a própria responsabilidade (segundo outra leitura, as ideias). Perseverar no que é correto traz boa fortuna. Sair e se relacionar com outros dá frutos.";
"hex.17.yao.1" = "Unir-se ao jovem é perder o homem maduro.";
"hex.17.yao.2" = "Unir-se ao homem maduro é perder o jovem. Ao seguir os outros, obtém-se o que se busca. É favorável permanecer no que é correto.";
"hex.17.yao.3" = "Seguir traz muitos ganhos, mas mesmo perseverando no que é correto há infortúnio. Com sinceridade, fidelidade ao caminho correto e compreensão clara, que culpa pode haver?";
"hex.17.yao.4" = "Tratar com sinceridade as pessoas boas e virtuosas. Boa fortuna.";
"hex.17.yao.5" = "Detê-lo e amarrá-lo, prendê-lo firmemente com cordas para que siga. O rei oferece um sacrifício na montanha ocidental (o monte Qi).";
"hex.18.ci" = "Grande êxito. É favorável atravessar o grande rio (enfrentar riscos para realizar uma tarefa). Planejar três dias antes do dia Jia (dia Xin) e revisar três dias depois (dia Ding).";
"hex.18.daxiang" = "Ao pé da montanha há vento: O Trabalho sobre o que se Deteriorou. Assim, a pessoa nobre anima e auxilia o povo e cultiva a virtude.";
"hex.18.yao.0" = "Corrigir a deterioração deixada pelo pai. Com um filho assim, o pai falecido fica sem culpa. Há perigo; ao final, boa fortuna.";
"hex.18.yao.1" = "Corrigir a deterioração deixada pela mãe. Não ser excessivamente rígido nem obstinado (proceder com tato).";
"hex.18.yao.2" = "Corrigir a deterioração deixada pelo pai. Há um pouco de arrependimento, mas nenhuma culpa grave.";
"hex.18.yao.3" = "Tolerar e deixar crescer a deterioração deixada pelo pai. Continuar assim traz pesar.";
"hex.18.yao.4" = "Corrigir a deterioração deixada pelo pai merece elogio.";
"hex.18.yao.5" = "Não servir a reis nem senhores. Manter elevados os próprios propósitos e a conduta.";
"hex.19.ci" = "Grande êxito. É favorável perseverar no que é correto. Ao chegar o oitavo mês, haverá infortúnio.";
"hex.19.daxiang" = "Sobre o lago há terra: A Aproximação. Assim, a pessoa nobre pensa sem cessar no ensino e acolhe e protege o povo sem limites.";
"hex.19.yao.0" = "Aproximar-se do povo pela influência moral (tocando seu ânimo). Perseverar no que é correto traz boa fortuna.";
"hex.19.yao.1" = "Aproximar-se do povo pela influência moral. Boa fortuna; tudo é favorável.";
"hex.19.yao.2" = "Aproximar-se do povo com palavras doces. Nada é favorável. Reconhecer o problema com preocupação e corrigi-lo: sem culpa.";
"hex.19.yao.3" = "Aproximar-se do povo pessoalmente e de perto. Sem culpa.";
"hex.19.yao.4" = "Aproximar-se do povo com sabedoria, como convém a um grande soberano. Boa fortuna.";
"hex.19.yao.5" = "Aproximar-se do povo com virtude generosa. Boa fortuna, sem culpa.";
"hex.20.ci" = "No sacrifício, após lavar as mãos e verter o vinho, ainda não se apresenta a oferenda (o momento de maior recolhimento). Há sinceridade e uma solenidade que inspira respeito.";
"hex.20.daxiang" = "O vento percorre a terra: A Contemplação. Assim, os antigos reis percorriam as regiões, observavam os costumes do povo e estabeleciam o ensino.";
"hex.20.yao.0" = "Observar com o olhar limitado de uma criança. Para a pessoa mesquinha, sem culpa; para a pessoa nobre, pesar.";
"hex.20.yao.1" = "Olhar por uma fresta da porta. É favorável que a mulher persevere no que é correto.";
"hex.20.yao.2" = "Observar os próprios atos para decidir se deve avançar ou recuar.";
"hex.20.yao.3" = "Contemplar o esplendor do bom governo do país. É favorável ser recebido como hóspede pelo rei (para entrar a seu serviço e auxiliá-lo).";
"hex.20.yao.4" = "Observar os próprios atos. A pessoa nobre fica sem culpa.";
"hex.20.yao.5" = "Observar os atos alheios (segundo outra leitura, ser observado por outros). A pessoa nobre fica sem culpa.";
"hex.21.ci" = "Êxito. É favorável aplicar a justiça penal.";
"hex.21.daxiang" = "O trovão e o relâmpago se unem: Morder. Assim, os antigos reis esclareciam as penas e punham em ordem as leis.";
"hex.21.yao.0" = "Os pés levam grilhões que ocultam os dedos. Sem culpa (um castigo leve serve de séria advertência).";
"hex.21.yao.1" = "Morder carne macia até afundar nela o nariz. Sem culpa.";
"hex.21.yao.2" = "Morder carne seca e dura e encontrar veneno. Um pouco de pesar, sem culpa.";
"hex.21.yao.3" = "Morder carne seca com osso e encontrar uma ponta de flecha de metal (imagem de firmeza e retidão). É favorável perseverar no que é correto nas dificuldades. Boa fortuna.";
"hex.21.yao.4" = "Morder carne seca e encontrar ouro (imagem de equilíbrio e firmeza). Perseverar no que é correto para se precaver do perigo. Sem culpa.";
"hex.21.yao.5" = "Levar uma canga sobre os ombros que oculta as orelhas. Infortúnio.";
"hex.22.ci" = "Êxito. Seguir caminho é ligeiramente favorável.";
"hex.22.daxiang" = "Ao pé da montanha há fogo (cuja luz tem alcance limitado): A Graciosidade. Assim, a pessoa nobre esclarece os assuntos de governo, mas não ousa julgar litígios levianamente.";
"hex.22.yao.0" = "Adornar os dedos dos pés. Deixar o carro e caminhar.";
"hex.22.yao.1" = "Adornar a barba.";
"hex.22.yao.2" = "Adorno esplêndido, úmido e brilhante. Perseverar por longo tempo no que é correto traz boa fortuna.";
"hex.22.yao.3" = "Adorno branco e simples. Um cavalo branco corre como se voasse. Quem chega não é um bandido, mas um pretendente.";
"hex.22.yao.4" = "Adornar as colinas e os jardins (honrar as pessoas virtuosas que prezam a simplicidade). O feixe de seda oferecido é modesto. Pesar; ao final, boa fortuna.";
"hex.22.yao.5" = "A brancura simples como adorno. Sem culpa.";
"hex.23.ci" = "Não é favorável seguir caminho.";
"hex.23.daxiang" = "A montanha se apoia na terra: A Desintegração. Assim, os que estão acima tratam com generosidade os que estão abaixo e firmam sua morada.";
"hex.23.yao.0" = "O leito se desintegra a partir dos pés. Destruir o que é correto traz infortúnio.";
"hex.23.yao.1" = "O leito se desintegra até a união da armação com os pés (a estrutura do leito). Destruir o que é correto traz infortúnio.";
"hex.23.yao.2" = "Em meio à desintegração (em correspondência apenas com a linha yang superior). Sem culpa.";
"hex.23.yao.3" = "A desintegração do leito já alcança a pele. Infortúnio.";
"hex.23.yao.4" = "Conduzir as forças yin em ordem, como peixes enfiados num cordão. Receber o favor do rei como as mulheres do palácio. Tudo é favorável.";
"hex.23.yao.5" = "O grande fruto permanece sem ser comido. A pessoa nobre recebe um carro (o apoio do povo); a pessoa mesquinha destrói a própria casa.";
"hex.24.ci" = "Êxito. Sair e entrar sem doença; chegam amigos, sem culpa. O ir e vir segue seu ciclo: após sete dias vem o retorno. É favorável seguir caminho.";
"hex.24.daxiang" = "O trovão está dentro da terra: O Retorno. Assim, os antigos reis fechavam as passagens no solstício de inverno; mercadores e viajantes não partiam, e o soberano não percorria as regiões.";
"hex.24.yao.0" = "Voltar ao caminho correto antes de se afastar muito. Sem grande arrependimento. Grande fortuna.";
"hex.24.yao.1" = "Voltar de boa maneira ao caminho correto. Boa fortuna.";
"hex.24.yao.2" = "Voltar repetidamente ao caminho correto (segundo outra leitura, com a testa franzida pela aflição). Há perigo, mas sem culpa.";
"hex.24.yao.3" = "Avançar entre as forças yin e voltar sozinho ao caminho correto.";
"hex.24.yao.4" = "Voltar ao caminho correto com um coração generoso. Sem arrependimento.";
"hex.24.yao.5" = "Perder-se sem saber voltar. Infortúnio e calamidades. Mobilizar o exército leva a uma grande derrota e atinge o soberano com o infortúnio. Durante dez anos não será possível empreender uma campanha.";
"hex.25.ci" = "Grande êxito. É favorável perseverar no que é correto. Afastar-se do que é correto traz calamidades; não é favorável seguir caminho.";
"hex.25.daxiang" = "O trovão percorre tudo sob o céu, e nada se afasta de sua natureza: A Inocência. Assim, os antigos reis se empenhavam em acompanhar as estações e nutrir todos os seres.";
"hex.25.yao.0" = "Agir sem falsidade nem temeridade. Avançar traz boa fortuna.";
"hex.25.yao.1" = "Cultivar sem antecipar a colheita; desbravar sem antecipar o campo fértil (seguir o natural, sem expectativas). Assim é favorável seguir caminho.";
"hex.25.yao.2" = "Uma calamidade inesperada: alguém amarra um boi, um passante o leva e os moradores do lugar sofrem as suspeitas.";
"hex.25.yao.3" = "Poder perseverar no que é correto. Sem culpa.";
"hex.25.yao.4" = "Uma doença que não provém de uma conduta indevida. Sem tomar remédios, haverá cura e alegria.";
"hex.25.yao.5" = "Mesmo sem agir indevidamente, avançar traz calamidade (o momento chegou ao limite). Nada é favorável.";
"hex.26.ci" = "É favorável perseverar no que é correto. Alimentar-se fora do lar (a serviço da corte) traz boa fortuna. É favorável atravessar o grande rio (enfrentar riscos para realizar uma tarefa).";
"hex.26.daxiang" = "O céu está contido na montanha: O Poder de Domar do Grande. Assim, a pessoa nobre aprende muitas palavras e ações dos sábios antigos para ampliar sua virtude.";
"hex.26.yao.0" = "Há perigo. É favorável parar.";
"hex.26.yao.1" = "A caixa do carro se desprende do suporte do eixo e não pode avançar.";
"hex.26.yao.2" = "Bons cavalos correm em perseguição. É favorável perseverar no que é correto nas dificuldades. Praticar diariamente a condução do carro e a defesa. É favorável seguir caminho.";
"hex.26.yao.3" = "Atar uma travessa aos chifres de um bezerro para impedir que ataque com eles. Grande fortuna.";
"hex.26.yao.4" = "As presas do porco castrado: embora permaneçam, já não ferem. Boa fortuna.";
"hex.26.yao.5" = "Como é ampla e aberta a estrada do céu! Êxito. (Segundo outra leitura, recebe-se ou sustenta-se essa estrada.)";
"hex.27.ci" = "Perseverar no que é correto traz boa fortuna. Observar como se obtém o sustento e de que maneira cada um busca seu alimento.";
"hex.27.daxiang" = "Ao pé da montanha há trovão: A Nutrição. Assim, a pessoa nobre cuida de suas palavras e modera a comida e a bebida.";
"hex.27.yao.0" = "Você abandona sua valiosa condição de tartaruga espiritual (capaz de se sustentar sem comer) e me observa mastigar, cheio de desejo. Infortúnio.";
"hex.27.yao.1" = "Buscar sustento abaixo, invertendo a ordem habitual; depois, buscá-lo na colina (a linha yang superior). Avançar traz infortúnio.";
"hex.27.yao.2" = "Afastar-se do caminho correto do sustento. Mesmo perseverando no que é correto, infortúnio. Durante dez anos não se poderá agir. Nada é favorável.";
"hex.27.yao.3" = "Buscar sustento abaixo, invertendo a ordem (para nutrir o mundo). Boa fortuna. Olhar para baixo com a atenção de um tigre, buscando sem cessar. Sem culpa.";
"hex.27.yao.4" = "Afastar-se da ordem habitual (depender do sustento da linha yang superior). Permanecer no que é correto traz boa fortuna. Não atravessar o grande rio (não enfrentar riscos).";
"hex.27.yao.5" = "Dele depende o sustento do mundo. Há perigo e boa fortuna. É favorável atravessar o grande rio (enfrentar riscos para realizar uma tarefa).";
"hex.28.ci" = "A viga mestra se curva. É favorável seguir caminho. Êxito.";
"hex.28.daxiang" = "As águas do lago cobrem as árvores: A Preponderância do Grande. Assim, a pessoa nobre permanece só sem temor e se retira do mundo sem aflição.";
"hex.28.yao.0" = "Pôr capim branco e limpo por baixo (das oferendas). Sem culpa.";
"hex.28.yao.1" = "O álamo ressecado dá brotos novos. Um ancião toma uma esposa jovem. Tudo é favorável.";
"hex.28.yao.2" = "A viga mestra se curva. Infortúnio.";
"hex.28.yao.3" = "A viga mestra se ergue firme, sem se curvar. Boa fortuna. Se houver outros vínculos, pesar.";
"hex.28.yao.4" = "O álamo ressecado floresce. Uma anciã toma um esposo jovem. Sem culpa nem elogio.";
"hex.28.yao.5" = "Vadear águas profundas demais até ficar inteiramente submerso. Infortúnio, mas sem culpa (agir por justiça não merece censura).";
"hex.29.ci" = "Perigos sucessivos. Com sinceridade, se o coração mantém sua abertura, a ação merece estima.";
"hex.29.daxiang" = "A água chega sem cessar: O Abismal. Assim, a pessoa nobre mantém constante sua virtude e pratica repetidamente as tarefas de governo e ensino.";
"hex.29.yao.0" = "Entre perigos sucessivos, cair no fundo do poço. Infortúnio.";
"hex.29.yao.1" = "No abismo ainda há perigo. Buscar apenas pequenos ganhos.";
"hex.29.yao.2" = "Ao ir e ao vir, perigos. À frente há risco; atrás, nenhum apoio seguro. Cair no fundo do poço. Não agir.";
"hex.29.yao.3" = "Uma jarra de vinho e duas tigelas de arroz, servidos em vasilhas de barro. Entregar pela janela um simples sinal de confiança (unir-se com sinceridade). Ao final, sem culpa.";
"hex.29.yao.4" = "A água do poço não transborda, mas já alcança o nível da margem (zhi pode ser lido como di, «montículo», ou como «apenas»). Sem culpa.";
"hex.29.yao.5" = "Amarrado com cordas e preso entre espinhos, sem libertação durante três anos. Infortúnio.";
"hex.30.ci" = "É favorável perseverar no que é correto. Êxito. Criar uma vaca (imagem da virtude dócil) traz boa fortuna.";
"hex.30.daxiang" = "A luz se levanta duas vezes seguidas: Aderir, o Fogo. Assim, a grande pessoa de virtude prolonga a claridade e ilumina as quatro direções.";
"hex.30.yao.0" = "Os passos se cruzam em desordem. Agir com respeito e cautela: sem culpa.";
"hex.30.yao.1" = "Uma luz aderente amarela (o amarelo é a cor do centro). Grande fortuna.";
"hex.30.yao.2" = "A luz do sol declinante. Se não se canta batendo numa vasilha de barro (alegrando-se no tempo oportuno), virão os lamentos da velhice. Infortúnio.";
"hex.30.yao.3" = "Chegar de repente, arder como fogo, morrer e ser abandonado.";
"hex.30.yao.4" = "Derramar lágrimas abundantes, afligir-se e suspirar. Boa fortuna.";
"hex.30.yao.5" = "O rei o envia em campanha. Obtém um mérito digno de elogio: decapita o chefe inimigo e não captura indiscriminadamente seus seguidores (castiga apenas o principal culpado). Sem culpa.";
"hex.31.ci" = "Êxito. É favorável perseverar no que é correto. Tomar esposa traz boa fortuna. (A influência é a resposta mútua, representada pela atração entre um rapaz e uma moça.)";
"hex.31.daxiang" = "Sobre a montanha há um lago (a montanha o acolhe em sua concavidade): A Influência. Assim, a pessoa nobre acolhe os demais com o espírito aberto.";
"hex.31.yao.0" = "A influência alcança o dedão do pé. (Apenas começa e é leve; a intenção já se dirige para fora.)";
"hex.31.yao.1" = "A influência alcança a panturrilha. Mover-se com precipitação traz infortúnio; permanecer quieto, boa fortuna.";
"hex.31.yao.2" = "A influência alcança a coxa. Insistir em acompanhar os movimentos dos outros. Avançar assim traz pesar.";
"hex.31.yao.3" = "Perseverar no que é correto traz boa fortuna; desaparece o arrependimento. Se há idas e vindas com ânimo indeciso, apenas os amigos afins acompanham os próprios pensamentos. (A influência é limitada.)";
"hex.31.yao.4" = "A influência alcança a carne junto à coluna. Sem arrependimento. (Não chega ao coração; segundo outra leitura, é uma influência superficial.)";
"hex.31.yao.5" = "A influência alcança as gengivas, as bochechas e a língua. (Influenciar apenas por palavras.)";
"hex.32.ci" = "Êxito, sem culpa. É favorável perseverar no que é correto e seguir caminho. (A duração significa constância.)";
"hex.32.daxiang" = "O trovão e o vento se acompanham: A Duração. Assim, a pessoa nobre se mantém no que é correto e não muda de rumo levianamente.";
"hex.32.yao.0" = "Exigir desde o início uma constância profunda (como cavar fundo). Mesmo perseverando no que é correto, infortúnio. Nada é favorável.";
"hex.32.yao.1" = "Desaparece o arrependimento. (A segunda linha, yang em posição yin e central, pode se manter no caminho do centro.)";
"hex.32.yao.2" = "Não manter constante a própria virtude leva à humilhação. Mesmo perseverando no que é correto, há pesar.";
"hex.32.yao.3" = "Caçar sem obter presa. (Permanecer muito tempo num lugar inadequado é se esforçar em vão.)";
"hex.32.yao.4" = "Manter constante a virtude (da docilidade) e perseverar no que é correto: para a mulher, boa fortuna; para o homem, infortúnio.";
"hex.32.yao.5" = "Buscar constância em meio à agitação (inquietação incessante). Infortúnio.";
"hex.33.ci" = "Retirar-se traz êxito. Em assuntos pequenos é favorável perseverar no que é correto. (Trata-se de se afastar.)";
"hex.33.daxiang" = "Sob o céu há uma montanha (por mais alta que seja, o céu se mantém distante): A Retirada. Assim, a pessoa nobre se afasta das pessoas mesquinhas, sem mostrar ódio, mas com firmeza.";
"hex.33.yao.0" = "Ficar por último na retirada. Há perigo. Não é favorável seguir caminho.";
"hex.33.yao.1" = "Amarrá-lo firmemente com uma correia de couro de boi amarelo; ninguém consegue se soltar. (Imagem de uma vontade firme; segundo outra leitura, de reter uma pessoa virtuosa.)";
"hex.33.yao.2" = "Os apegos impedem a retirada: é como uma doença, e há perigo. Manter servidores e concubinas traz boa fortuna.";
"hex.33.yao.3" = "Retirar-se com resolução apesar dos afetos. Para a pessoa nobre, boa fortuna; a pessoa mesquinha não é capaz disso.";
"hex.33.yao.4" = "Retirar-se de boa maneira e no momento oportuno. Perseverar no que é correto traz boa fortuna.";
"hex.33.yao.5" = "Retirar-se com tranquilidade e sem entraves (segundo outra leitura, voar alto e se retirar para longe). Tudo é favorável.";
"hex.34.ci" = "É favorável perseverar no que é correto. (O poder do grande é o vigor crescente do yang.)";
"hex.34.daxiang" = "O trovão está sobre o céu (com grande poder sonoro): O Poder do Grande. Assim, a pessoa nobre nada faz que contrarie os ritos.";
"hex.34.yao.0" = "O poder se manifesta nos dedos do pé (pressa em avançar). Partir em campanha traz infortúnio; é certo. (Aqui, fu indica certeza.)";
"hex.34.yao.1" = "Perseverar no que é correto traz boa fortuna.";
"hex.34.yao.2" = "A pessoa mesquinha se vale da força; a pessoa nobre se abstém (segundo outra leitura, emprega uma rede). Mesmo perseverando no que é correto, há perigo. O carneiro investe contra a cerca e seus chifres ficam presos.";
"hex.34.yao.3" = "Perseverar no que é correto traz boa fortuna; desaparece o arrependimento. A cerca se abre e os chifres ficam livres. O poder está no suporte do eixo do grande carro (a união com a caixa, firme para avançar com carga).";
"hex.34.yao.4" = "Perder sem perceber uma ovelha em terreno plano. Sem arrependimento. (Segundo outra leitura, na divisa de um campo.)";
"hex.34.yao.5" = "O carneiro investe contra a cerca. Não pode recuar nem avançar. Nada é favorável. Reconhecer a dificuldade e perseverar no que é correto traz boa fortuna.";
"hex.35.ci" = "O senhor Kang (senhor que pacifica o país; segundo outra leitura, Kang Shu, irmão do rei Wu de Zhou) recebe muitos cavalos e carros do rei e é recebido três vezes num dia. (Trata-se da ascensão.)";
"hex.35.daxiang" = "A luz se eleva sobre a terra: O Progresso. Assim, a pessoa nobre faz resplandecer sua própria virtude luminosa.";
"hex.35.yao.0" = "Querer avançar e encontrar rejeição. Perseverar no que é correto traz boa fortuna. Ainda não se obtém confiança; manter a serenidade e a abertura: sem culpa.";
"hex.35.yao.1" = "Querer avançar com o coração aflito. Perseverar no que é correto traz boa fortuna. A avó concede uma grande bênção (representa a dignidade da quinta linha yin).";
"hex.35.yao.2" = "Todos confiam e dão sua aprovação. Desaparece o arrependimento.";
"hex.35.yao.3" = "Ascender como um grande rato (ganancioso e temeroso). Mesmo perseverando no que é correto, há perigo.";
"hex.35.yao.4" = "Desaparece o arrependimento. Não se preocupar com ganhos nem perdas. Avançar traz boa fortuna; tudo é favorável.";
"hex.35.yao.5" = "Ascender até a ponta do chifre (o extremo). Só convém atacar a própria cidade (conter um conflito interno). Há perigo, mas boa fortuna e nenhuma culpa. Mesmo perseverando no que é correto, há pesar.";
"hex.36.ci" = "É favorável perseverar no que é correto nas dificuldades. (A luz está ferida.)";
"hex.36.daxiang" = "A luz se afunda na terra: O Obscurecimento da Luz. Assim, a pessoa nobre governa mostrando obscuridade por fora e conservando lucidez por dentro.";
"hex.36.yao.0" = "Voar quando a luz está ferida, com as asas caídas. A pessoa nobre parte com tanta urgência que passa três dias sem comer. Ao chegar ao destino, o anfitrião a repreende.";
"hex.36.yao.1" = "A luz está ferida; a ferida alcança a coxa esquerda. Um cavalo forte presta auxílio. Boa fortuna.";
"hex.36.yao.2" = "Quando a luz está ferida, empreender uma campanha ao sul e capturar o principal culpado. Não se apressar em corrigir os males arraigados; avançar gradualmente.";
"hex.36.yao.3" = "Entrar no lado esquerdo do ventre (penetrar no interior), descobrir a causa da luz ferida e sair pelo portão do pátio (partir).";
"hex.36.yao.4" = "Como Jizi (tio do rei Zhou de Shang, que fingiu loucura para escapar à desgraça) em tempos de luz ferida. É favorável perseverar no que é correto.";
"hex.36.yao.5" = "Sem luz, apenas escuridão. Primeiro subir ao céu; depois cair sob a terra.";
"hex.37.ci" = "É favorável que a mulher persevere no que é correto. (Trata-se do governo do lar.)";
"hex.37.daxiang" = "O vento nasce do fogo (de dentro para fora): A Família. Assim, a pessoa nobre dá fundamento às suas palavras e constância aos seus atos.";
"hex.37.yao.0" = "Estabelecer regras e resguardos no lar desde o início (prevenir as faltas). Desaparece o arrependimento.";
"hex.37.yao.1" = "Não decidir por conta própria; encarregar-se da alimentação do lar. Perseverar no que é correto traz boa fortuna.";
"hex.37.yao.2" = "Governar o lar com severidade até provocar queixas (vozes de rigor). Embora haja arrependimento e perigo, boa fortuna. Se mulheres e crianças riem sem medida, ao final há pesar.";
"hex.37.yao.3" = "Tornar o lar próspero. Grande fortuna.";
"hex.37.yao.4" = "O rei transforma sua família pela virtude (alcança e comove seus membros). Não se preocupar. Boa fortuna.";
"hex.37.yao.5" = "Sinceridade acompanhada de dignidade. Ao final, boa fortuna.";
"hex.38.ci" = "Boa fortuna em assuntos pequenos. (Trata-se da divergência e da oposição.)";
"hex.38.daxiang" = "Acima o fogo, abaixo o lago (de tendências opostas): A Oposição. Assim, a pessoa nobre busca o que é comum e preserva as diferenças.";
"hex.38.yao.0" = "Desaparece o arrependimento. Não perseguir o cavalo perdido: ele voltará por si mesmo. Encontrar uma pessoa má (sem recusar o encontro). Sem culpa.";
"hex.38.yao.1" = "Encontrar o senhor numa viela. Sem culpa.";
"hex.38.yao.2" = "Ver o carro retido, o boi que o puxa impedido e o condutor castigado com a testa tatuada e o nariz cortado. O início é adverso, mas o final é bom.";
"hex.38.yao.3" = "Separado e só, encontrar um homem de firmeza yang (a primeira linha yang). Unir-se com sinceridade. Há perigo, mas sem culpa.";
"hex.38.yao.4" = "Desaparece o arrependimento. Unir-se ao parente (a segunda linha yang) é tão fácil quanto morder carne macia. Que culpa pode haver em avançar?";
"hex.38.yao.5" = "Separado e só, julgar ver um porco coberto de lama e um carro cheio de espectros (visões nascidas da suspeita). Primeiro tensionar o arco; depois, baixá-lo. Não são bandidos, mas pretendentes. Avançar e encontrar chuva (harmonia entre yin e yang) traz boa fortuna.";
"hex.39.ci" = "É favorável ir ao sudoeste (terreno plano), mas não ao nordeste (terreno perigoso). É favorável encontrar uma grande pessoa de virtude. Perseverar no que é correto traz boa fortuna. (Trata-se da dificuldade para caminhar.)";
"hex.39.daxiang" = "Sobre a montanha há água (perigos sucessivos): O Obstáculo. Assim, a pessoa nobre examina a si mesma e cultiva sua virtude.";
"hex.39.yao.0" = "Avançar encontra dificuldades; voltar merece elogio.";
"hex.39.yao.1" = "O servidor do rei atravessa dificuldade após dificuldade (para prestar auxílio), sem buscar benefício próprio.";
"hex.39.yao.2" = "Avançar encontra dificuldades; voltar (para se reunir às duas linhas yin inferiores).";
"hex.39.yao.3" = "Avançar encontra dificuldades; voltar e se unir aos demais.";
"hex.39.yao.4" = "Em meio a grandes dificuldades, os amigos vêm ajudar.";
"hex.39.yao.5" = "Avançar encontra dificuldades; voltar permite grandes realizações. Boa fortuna. É favorável encontrar uma grande pessoa de virtude.";
"hex.40.ci" = "É favorável ir ao sudoeste. Se não há nada a resolver, voltar ao lugar de origem traz boa fortuna. Se há algo a empreender, agir cedo traz boa fortuna. (Trata-se de se livrar do perigo.)";
"hex.40.daxiang" = "Surgem o trovão e a chuva: A Liberação. Assim, a pessoa nobre perdoa as faltas e trata os delitos com clemência.";
"hex.40.yao.0" = "Sem culpa.";
"hex.40.yao.1" = "Na caça, capturam-se três raposas e obtém-se uma flecha amarela. Perseverar no que é correto traz boa fortuna. (As raposas representam as pessoas mesquinhas; a flecha amarela, o equilíbrio e a retidão.)";
"hex.40.yao.2" = "Levar uma carga às costas e viajar num carro (uma pessoa mesquinha usurpa um cargo elevado) atrai os bandidos. Mesmo perseverando no que é correto, há pesar.";
"hex.40.yao.3" = "Libertar o dedão do pé (livrar-se das pessoas mesquinhas que se apegam). Os amigos chegam e se tratam com sinceridade.";
"hex.40.yao.4" = "A pessoa nobre consegue se livrar do perigo. Boa fortuna. A retirada das pessoas mesquinhas confirma isso. (Aqui se trata de verificação; segundo outra leitura, de ganhar sua confiança.)";
"hex.40.yao.5" = "O príncipe atira num falcão no alto da muralha e o atinge. Tudo é favorável.";
"hex.41.ci" = "Com sinceridade, grande fortuna e nenhuma culpa. Pode-se perseverar no que é correto; é favorável seguir caminho. O que oferecer no sacrifício? Bastam duas tigelas rituais de alimento simples (recipientes para painço). (Trata-se de reduzir.)";
"hex.41.daxiang" = "Ao pé da montanha há um lago (que diminui para aumentar a altura da montanha): A Diminuição. Assim, a pessoa nobre refreia a ira e contém os desejos.";
"hex.41.yao.0" = "Terminar os próprios assuntos e acudir depressa (para ajudar os outros). Sem culpa. Ponderar quanto se pode ceder do que é próprio.";
"hex.41.yao.1" = "É favorável perseverar no que é correto. Partir em campanha traz infortúnio. Pode-se beneficiar os outros sem diminuir a si mesmo.";
"hex.41.yao.2" = "Se três caminham juntos, perde-se um. Se um caminha só, encontra um amigo.";
"hex.41.yao.3" = "Reduzir os próprios males; uma melhora rápida traz alegria. Sem culpa.";
"hex.41.yao.4" = "Alguém lhe traz um benefício que nem uma tartaruga valiosa, de dez peng (antiga unidade monetária), pode contradizer (os augúrios são favoráveis). Grande fortuna.";
"hex.41.yao.5" = "Beneficiar os outros sem diminuir a si mesmo. Sem culpa. Perseverar no que é correto traz boa fortuna; é favorável seguir caminho. Ganham-se servidores de todo o mundo (não de uma única casa).";
"hex.42.ci" = "É favorável seguir caminho e atravessar o grande rio (enfrentar riscos para realizar uma tarefa). (O aumento significa acréscimo.)";
"hex.42.daxiang" = "O vento e o trovão se ajudam: O Aumento. Assim, a pessoa nobre segue o bem que vê e corrige as próprias faltas.";
"hex.42.yao.0" = "É favorável empreender grandes obras. Grande fortuna, sem culpa.";
"hex.42.yao.1" = "Alguém lhe traz um benefício que nem uma tartaruga valiosa, de dez peng, pode contradizer. Perseverar por longo tempo no que é correto traz boa fortuna. O rei o emprega para oferecer um sacrifício ao Soberano do Céu. Boa fortuna.";
"hex.42.yao.2" = "Dedicar os benefícios ao socorro nas calamidades. Sem culpa. Com sinceridade e conduta equilibrada e correta, informar ao príncipe levando uma tabuleta de jade.";
"hex.42.yao.3" = "Agir com equilíbrio e retidão. Informar ao príncipe e obter sua aprovação. É favorável apoiar-se nos superiores para transferir a capital.";
"hex.42.yao.4" = "Com um coração sincero e benevolente, não é preciso perguntar: grande fortuna. Todos reconhecem sinceramente meus benefícios.";
"hex.42.yao.5" = "Ninguém lhe traz benefício; alguém até o ataca. Seu propósito carece de constância. Infortúnio.";
"hex.43.ci" = "Proclamar publicamente na corte real (as faltas das pessoas mesquinhas). Convocar a todos com sinceridade; ainda há perigo e é preciso vigilância. Advertir primeiro a própria cidade. Não é favorável recorrer de imediato às armas; é favorável seguir caminho. (Trata-se de decidir e eliminar.)";
"hex.43.daxiang" = "A água do lago sobe ao céu (para descer como chuva): O Avanço. Assim, a pessoa nobre distribui benefícios ao povo; acumulá-los sem compartilhar provoca rejeição.";
"hex.43.yao.0" = "O poder se manifesta nos dedos do pé que avança. Avançar sem poder vencer constitui uma falta.";
"hex.43.yao.1" = "Dar o alarme com vigilância. Mesmo que um inimigo ataque à noite, não há por que se preocupar.";
"hex.43.yao.2" = "O poder se manifesta nas maçãs do rosto (a ira aparece na face). Há infortúnio. A pessoa nobre avança resolutamente, só; encontra chuva, se molha e provoca irritação. Ao final, sem culpa.";
"hex.43.yao.3" = "As nádegas estão sem pele; caminhar é penoso (hesitar sem avançar). Conduzir a ovelha (seguir o rebanho) faria desaparecer o arrependimento, mas essas palavras são ouvidas sem crédito.";
"hex.43.yao.4" = "Eliminar com resolução, como ao arrancar xianlu (uma erva tenra e quebradiça que cresce facilmente). Seguir o caminho do centro: sem culpa.";
"hex.43.yao.5" = "Já não adianta gritar (ninguém virá ajudar). Ao final, infortúnio.";
"hex.44.ci" = "A mulher é poderosa demais. Não convém tomar por esposa uma mulher assim. (Trata-se do encontro.)";
"hex.44.daxiang" = "Sob o céu há vento (que alcança todas as coisas): Vir ao Encontro. Assim, o soberano promulga mandatos e os anuncia nas quatro direções.";
"hex.44.yao.0" = "Amarrado a um sólido freio metálico de carro. Perseverar no que é correto traz boa fortuna; avançar traz infortúnio. A porca magra certamente se agita sem descanso (imagem do yin recém-surgido e inquieto).";
"hex.44.yao.1" = "Há um peixe no embrulho (segundo outra leitura, na cozinha). Sem culpa, mas não é favorável oferecê-lo aos hóspedes.";
"hex.44.yao.2" = "As nádegas estão sem pele; caminhar é penoso. Há perigo, mas nenhuma culpa grave.";
"hex.44.yao.3" = "Não há peixe no embrulho. Empreender a ação traz infortúnio.";
"hex.44.yao.4" = "Envolver um melão com ramos e folhas da árvore qi (o alto protege o baixo). Guardar a virtude no interior; as bênçãos descem do céu.";
"hex.44.yao.5" = "Encontrar-se na ponta do chifre (o extremo). Pesar, mas sem culpa.";
"hex.45.ci" = "Êxito. O rei vai ao templo ancestral para o sacrifício. É favorável encontrar uma grande pessoa de virtude. Êxito; é favorável perseverar no que é correto. Sacrificar um animal grande traz boa fortuna. É favorável seguir caminho. (Trata-se de congregar.)";
"hex.45.daxiang" = "A água do lago se reúne sobre a terra: A Reunião. Assim, a pessoa nobre põe em ordem as armas e se prepara para o imprevisto.";
"hex.45.yao.0" = "Há sinceridade, mas ela não perdura; daí a confusão e uma reunião desordenada. Se se pede ajuda aos gritos, um aperto de mãos transforma as lágrimas em riso. Não se preocupar. Avançar sem culpa.";
"hex.45.yao.1" = "Deixar-se atrair à reunião traz boa fortuna. Sem culpa. Com sinceridade, até o simples sacrifício yue (sacrifício de verão) é favorável.";
"hex.45.yao.2" = "Querer se reunir e suspirar sem cessar. Nada é favorável. Avançar sem culpa, embora com um pouco de pesar.";
"hex.45.yao.3" = "Só com grande fortuna se fica sem culpa.";
"hex.45.yao.4" = "Ocupar uma posição honrosa na reunião. Sem culpa. Se ainda falta confiança, manter a grande bondade e perseverar por longo tempo no que é correto. Desaparece o arrependimento.";
"hex.45.yao.5" = "Suspirar e chorar (lágrimas e secreção nasal). Sem culpa.";
"hex.46.ci" = "Grande êxito. Convém encontrar uma grande pessoa de virtude. Não se preocupar. Partir em campanha para o sul traz boa fortuna. (Trata-se de ascender.)";
"hex.46.daxiang" = "A madeira cresce dentro da terra: A Ascensão. Assim, a pessoa nobre segue a virtude e acumula pequenos atos bons para alcançar o elevado e grandioso.";
"hex.46.yao.0" = "Ascender graças à confiança recebida. Grande fortuna. (Segundo outra leitura, avançar na ascensão.)";
"hex.46.yao.1" = "Com sinceridade, até o simples sacrifício yue é favorável. Sem culpa.";
"hex.46.yao.2" = "Ascender e entrar numa cidade vazia (sem obstáculos).";
"hex.46.yao.3" = "O rei oferece um sacrifício no monte Qi (onde surgiu o povo Zhou). Boa fortuna, sem culpa.";
"hex.46.yao.4" = "Perseverar no que é correto traz boa fortuna. Subir pelos degraus.";
"hex.46.yao.5" = "Continuar a subir às cegas. É favorável aplicar essa constância a perseverar sem descanso no que é correto.";
"hex.47.ci" = "Êxito e perseverança no que é correto. Para a grande pessoa de virtude, boa fortuna e nenhuma culpa. Fala-se, mas não se obtém crédito. (Trata-se da privação e da aflição.)";
"hex.47.daxiang" = "O lago não tem água: A Opressão. Assim, a pessoa nobre entrega a vida para cumprir seu propósito.";
"hex.47.yao.0" = "As nádegas ficam oprimidas contra um toco de árvore. Entrar num vale escuro e profundo; durante três anos não ver ninguém.";
"hex.47.yao.1" = "Oprimido entre vinho e comida (segundo outra leitura, pela escassez deles). Aproxima-se quem usa um avental cerimonial vermelho (uma pessoa de alta posição). É favorável oferecer sacrifícios. Partir em campanha traz infortúnio. Sem culpa.";
"hex.47.yao.2" = "Oprimido por uma pedra e apoiado em abrolhos. Voltar para casa e não encontrar a esposa. Infortúnio.";
"hex.47.yao.3" = "Chegar lentamente, retido por um carro adornado de metal (a segunda linha yang). Pesar, mas ao final há resultado.";
"hex.47.yao.4" = "Sofrer o corte do nariz e dos pés (opressão por cima e por baixo), acuado por quem usa aventais cerimoniais vermelhos. Aos poucos vem a libertação. É favorável oferecer sacrifícios.";
"hex.47.yao.5" = "Preso entre trepadeiras, num lugar instável. Dizer a si mesmo ao se examinar: «Se eu me mover, vou me arrepender». Se houver verdadeiro arrependimento, partir em campanha traz boa fortuna.";
"hex.48.ci" = "A cidade pode mudar de lugar; o poço permanece. Tirar água não o diminui, nem deixar de tirá-la o aumenta. Quem vai e vem se abastece nele. A vasilha quase chega à borda, mas antes de sair bate e se quebra. Infortúnio.";
"hex.48.daxiang" = "O balde de madeira mergulha e eleva a água: O Poço. Assim, a pessoa nobre conforta o povo e o anima a se ajudar mutuamente.";
"hex.48.yao.0" = "O fundo do poço está cheio de lama; sua água não pode ser bebida. Ao velho poço abandonado nem os pássaros vêm.";
"hex.48.yao.1" = "Na parte funda do poço só se podem capturar peixinhos (segundo outra leitura, sapos). A vasilha de tirar água está quebrada e vaza: o poço não cumpre sua função.";
"hex.48.yao.2" = "O poço está limpo, mas ninguém bebe dele; isso aflige meu coração. Sua água pode ser tirada. Se o rei for esclarecido, todos compartilharão suas bênçãos.";
"hex.48.yao.3" = "Revestir as paredes do poço com tijolos e pedras. Sem culpa.";
"hex.48.yao.4" = "A água do poço é clara; a fonte fresca pode ser bebida.";
"hex.48.yao.5" = "Já se tira a água. Não cobrir a boca do poço (para que todos possam se servir). Com sinceridade, grande fortuna.";
"hex.49.ci" = "Só ao chegar o dia Ji (segundo outra leitura, o dia em que a mudança se completa) se obtém confiança. Grande êxito; é favorável perseverar no que é correto. Desaparece o arrependimento.";
"hex.49.daxiang" = "Dentro do lago há fogo: A Revolução. Assim, a pessoa nobre ajusta o calendário e define as estações.";
"hex.49.yao.0" = "Amarrar firmemente com couro de boi amarelo (manter o equilíbrio e a docilidade, sem agir temerariamente).";
"hex.49.yao.1" = "Só ao chegar o dia Ji se empreende a mudança. Avançar traz boa fortuna. Sem culpa.";
"hex.49.yao.2" = "Avançar com pressa traz infortúnio; apegar-se ao que está estabelecido também traz perigo. Quando as propostas de mudança foram debatidas repetidamente e chegam a uma conclusão, obtém-se confiança.";
"hex.49.yao.3" = "Desaparece o arrependimento. Mudar o mandato com sinceridade (reformar a antiga ordem) traz boa fortuna.";
"hex.49.yao.4" = "A grande pessoa de virtude transforma as coisas como o tigre que renova a pelagem: seus desenhos resplandecem. Antes de consultar o oráculo, já inspira confiança.";
"hex.49.yao.5" = "A pessoa nobre muda como o leopardo que renova a pelagem. A pessoa mesquinha muda de semblante e acata o novo governo. Continuar a avançar precipitadamente traz infortúnio; permanecer no que é correto, boa fortuna.";
"hex.50.ci" = "Grande fortuna e êxito.";
"hex.50.daxiang" = "Sobre a madeira arde o fogo: O Caldeirão. Assim, a pessoa nobre ocupa corretamente seu posto e mantém firme sua missão.";
"hex.50.yao.0" = "Virar o caldeirão com os pés para cima permite despejar a sujeira acumulada. Como ao tomar uma concubina e obter descendência. Sem culpa.";
"hex.50.yao.1" = "O caldeirão está cheio de alimento. Meu cônjuge (segundo outra leitura, meu inimigo) está doente e não pode se aproximar de mim. Boa fortuna.";
"hex.50.yao.2" = "As alças do caldeirão se deformam e se soltam; não se pode movê-lo nem comer o saboroso caldo de faisão. Quando yin e yang se harmonizam e vem a chuva, o arrependimento diminui. Ao final, boa fortuna.";
"hex.50.yao.3" = "Um pé do caldeirão se quebra e a comida do príncipe se derrama. O caldeirão fica molhado e sujo (segundo outra leitura, sofre-se um castigo grave). Infortúnio.";
"hex.50.yao.4" = "O caldeirão tem alças amarelas e uma barra de metal para erguê-lo. É favorável perseverar no que é correto.";
"hex.50.yao.5" = "O caldeirão tem uma barra de jade para erguê-lo. Grande fortuna; tudo é favorável.";
"hex.51.ci" = "Êxito. O trovão chega e faz olhar ao redor com temor; depois se pode falar e rir com calma. Abala uma extensão de cem li, mas o oficiante não deixa cair a concha nem o vinho aromático (utensílio e bebida do sacrifício).";
"hex.51.daxiang" = "O trovão chega repetidamente: O Incitar. Assim, a pessoa nobre, com temor, cultiva a si mesma e se examina.";
"hex.51.yao.0" = "O trovão chega e causa temor; depois se pode falar e rir com calma. Boa fortuna.";
"hex.51.yao.1" = "O trovão chega com violência e perigo. Prevê-se perder as conchas (antiga moeda) e busca-se abrigo em altas colinas. Não perseguir o que se perdeu: será recuperado em sete dias.";
"hex.51.yao.2" = "O trovão perturba o ânimo. Agir movido pela vigilância e pelo temor evita a calamidade.";
"hex.51.yao.3" = "O trovão sacode, mas fica-se preso na lama (sem poder recuperar o ânimo).";
"hex.51.yao.4" = "O trovão vai e vem; há perigo. Prevê-se, porém, que não haverá perdas e que será possível conservar a tarefa confiada (segundo outra leitura, o sacrifício).";
"hex.51.yao.5" = "O trovão faz tremer e olhar com espanto. Avançar traz infortúnio. Estar alerta quando ainda atinge o vizinho e não o próprio corpo: sem culpa. Haverá murmúrios sobre o casamento.";
"hex.52.ci" = "Aquietar as costas (sem se deixar levar pelo que está diante dos olhos), esquecendo o próprio corpo. Caminhar pelo pátio sem ver uns aos outros. Sem culpa.";
"hex.52.daxiang" = "Duas montanhas se sobrepõem: A Quietude. Assim, a pessoa nobre não leva seus pensamentos além das responsabilidades de seu posto.";
"hex.52.yao.0" = "Aquietar os dedos dos pés. Sem culpa. É favorável perseverar por longo tempo no que é correto.";
"hex.52.yao.1" = "Aquietar as panturrilhas sem poder salvar quem se segue (nem deter seus atos temerários). O coração está descontente.";
"hex.52.yao.2" = "Aquietar a cintura e deixar rígidas as costas, como se partissem. O perigo queima o coração como fumaça e fogo.";
"hex.52.yao.3" = "Aquietar o tronco. Sem culpa.";
"hex.52.yao.4" = "Aquietar as faces e falar com ordem. Desaparece o arrependimento.";
"hex.52.yao.5" = "Aquietar-se com virtude sólida e generosa. Boa fortuna.";
"hex.53.ci" = "A jovem se casa seguindo gradualmente os ritos. Boa fortuna. É favorável perseverar no que é correto.";
"hex.53.daxiang" = "Sobre a montanha crescem árvores: O Desenvolvimento. Assim, a pessoa nobre acumula virtude e melhora os costumes.";
"hex.53.yao.0" = "O ganso selvagem avança aos poucos até a margem. O jovem está em perigo e recebe censuras. Sem culpa.";
"hex.53.yao.1" = "O ganso selvagem avança aos poucos até a grande rocha. Comer e beber com serenidade e alegria. Boa fortuna.";
"hex.53.yao.2" = "O ganso selvagem avança aos poucos até o planalto. O esposo parte em campanha e não volta; a esposa engravida, mas não dá à luz. Infortúnio. É favorável resistir aos invasores.";
"hex.53.yao.3" = "O ganso selvagem avança aos poucos até a árvore; talvez encontre um ramo horizontal onde pousar. Sem culpa.";
"hex.53.yao.4" = "O ganso selvagem avança aos poucos até a colina. A esposa não concebe durante três anos, mas ao final nada pode vencer o que é correto. Boa fortuna.";
"hex.53.yao.5" = "O ganso selvagem avança aos poucos até as alturas (segundo outra leitura, o caminho das nuvens). Suas penas podem ser usadas como adorno cerimonial. Boa fortuna.";
"hex.54.ci" = "A jovem se casa sem seguir os ritos. Avançar traz infortúnio. Nada é favorável.";
"hex.54.daxiang" = "Sobre o lago há trovão: A Jovem que se Casa. Assim, a pessoa nobre procura um bom final duradouro e prevê os males que possam surgir.";
"hex.54.yao.0" = "A jovem se casa como irmã mais nova que acompanha a noiva. Como quem manca, mas pode caminhar. Avançar traz boa fortuna.";
"hex.54.yao.1" = "Como quem tem apenas um olho, mas pode enxergar. É favorável que quem vive recolhido persevere no que é correto.";
"hex.54.yao.2" = "A jovem espera se casar confiando em sua posição (segundo outra leitura, alude-se a uma irmã mais velha ou uma concubina de baixa posição); ao final se casa como irmã mais nova acompanhante.";
"hex.54.yao.3" = "A jovem deixa passar a data do casamento. Adia a união à espera do momento oportuno.";
"hex.54.yao.4" = "Di Yi (rei da dinastia Shang) entrega sua irmã mais nova em casamento. O vestido da esposa principal é menos esplêndido que o de sua acompanhante. A lua está quase cheia (sem chegar à plenitude). Boa fortuna.";
"hex.54.yao.5" = "A mulher segura uma cesta de bambu vazia. O homem degola uma ovelha, mas não sai sangue (o sacrifício não se realiza). Nada é favorável.";
"hex.55.ci" = "Êxito. O rei alcança essa abundância. Não se preocupar. Convém iluminar o mundo como o sol do meio-dia.";
"hex.55.daxiang" = "O trovão e o relâmpago chegam juntos: A Abundância. Assim, a pessoa nobre julga os casos e executa as penas.";
"hex.55.yao.0" = "Encontrar um senhor afim. Embora ambos sejam iguais, sem culpa. Avançar merece estima.";
"hex.55.yao.1" = "A esteira que cobre é tão grande que ao meio-dia se vê a Ursa Maior. Avançar provoca suspeita e rejeição. Comover o outro com sinceridade traz boa fortuna.";
"hex.55.yao.2" = "A cortina que cobre é tão grande que ao meio-dia se veem estrelas pequenas. O braço direito se quebra. Sem culpa.";
"hex.55.yao.3" = "A esteira que cobre é tão grande que ao meio-dia se vê a Ursa Maior. Encontrar um senhor da mesma virtude. Boa fortuna.";
"hex.55.yao.4" = "Atrair pessoas de talento traz celebração e elogio. Boa fortuna.";
"hex.55.yao.5" = "Uma casa grande, mas fechada e escurecida. Olhar pela porta: silêncio e ninguém dentro. Durante três anos não se vê ninguém. Infortúnio.";
"hex.56.ci" = "Um pouco de êxito. Perseverar no que é correto durante a viagem traz boa fortuna.";
"hex.56.daxiang" = "Sobre a montanha há fogo: O Viajante. Assim, a pessoa nobre aplica as penas com discernimento e cautela, sem prolongar os processos judiciais.";
"hex.56.yao.0" = "Em terra alheia, agir com mesquinhez e baixeza atrai a própria calamidade.";
"hex.56.yao.1" = "Na viagem, encontrar uma hospedaria, levar recursos consigo e obter um jovem servidor fiel.";
"hex.56.yao.2" = "Na viagem, a hospedaria arde e perde-se o jovem servidor. Permanecer nessa situação é perigoso.";
"hex.56.yao.3" = "Na viagem, encontrar um abrigo temporário e obter dinheiro e um machado (segundo outra leitura, recursos para a viagem). Mas meu coração não está contente.";
"hex.56.yao.4" = "Atirar num faisão e perder uma flecha. Ao final se obtêm elogios e uma nomeação honorífica.";
"hex.56.yao.5" = "O ninho do pássaro arde. O viajante primeiro ri e depois chora amargamente. Perde o boi na fronteira (segundo outras leituras, no estado de Youyi ou por descuido). Infortúnio.";
"hex.57.ci" = "Um pouco de êxito. É favorável seguir caminho e encontrar uma grande pessoa de virtude e alta posição.";
"hex.57.daxiang" = "O vento sopra repetidamente: A Suavidade. Assim, a pessoa nobre esclarece os mandatos e executa os assuntos de governo.";
"hex.57.yao.0" = "Hesitar entre avançar e recuar. É favorável perseverar no que é correto com a resolução de um guerreiro.";
"hex.57.yao.1" = "Prostrar-se humildemente sob o leito. Recorrer repetidamente a oficiantes e xamãs para expressar sinceridade diante dos espíritos. Boa fortuna, sem culpa.";
"hex.57.yao.2" = "Mostrar repetidamente uma submissão forçada. Pesar.";
"hex.57.yao.3" = "Desaparece o arrependimento. A caça fornece presas diversas (para sacrifícios, hóspedes e cozinha).";
"hex.57.yao.4" = "Perseverar no que é correto traz boa fortuna; desaparece o arrependimento. Tudo é favorável. O início é adverso, mas o final é bom. Promulgar ordens três dias antes do dia Geng e revisar seus efeitos três dias depois. Boa fortuna.";
"hex.57.yao.5" = "Prostrar-se sob o leito com humildade excessiva. Perder dinheiro e machado (os meios e a capacidade de decidir). Persistir assim traz infortúnio.";
"hex.58.ci" = "Êxito. É favorável perseverar no que é correto.";
"hex.58.daxiang" = "Dois lagos se unem: A Alegria. Assim, a pessoa nobre conversa e estuda com seus amigos.";
"hex.58.yao.0" = "Alegrar os outros com uma atitude harmoniosa. Boa fortuna.";
"hex.58.yao.1" = "Alegrar os outros com sinceridade. Boa fortuna; desaparece o arrependimento.";
"hex.58.yao.2" = "Vir em busca de agrado (com adulação). Infortúnio.";
"hex.58.yao.3" = "Debater-se sem sossego sobre a quem agradar. Afastar a influência nociva do mal traz alegria.";
"hex.58.yao.4" = "Confiar nas pessoas mesquinhas que corroem a firmeza yang. Há perigo.";
"hex.58.yao.5" = "Atrair os outros à busca do prazer.";
"hex.59.ci" = "Êxito. O rei vai ao templo ancestral para o sacrifício (reunir os corações dispersos). É favorável atravessar o grande rio e perseverar no que é correto.";
"hex.59.daxiang" = "O vento percorre a água: A Dispersão. Assim, os antigos reis ofereciam sacrifícios ao Soberano do Alto e erguiam templos ancestrais (para unir os corações).";
"hex.59.yao.0" = "Um cavalo forte presta auxílio. Boa fortuna.";
"hex.59.yao.1" = "Na dispersão, correr para uma mesa na qual se apoiar (encontrar sustentação). Desaparece o arrependimento.";
"hex.59.yao.2" = "Dissolver o próprio egoísmo. Sem arrependimento.";
"hex.59.yao.3" = "Dissolver as facções privadas. Grande fortuna. Da dispersão surge uma reunião tão grande quanto uma colina, algo que as pessoas comuns não imaginam.";
"hex.59.yao.4" = "Na dispersão, promulgar grandes ordens como o suor que se espalha; distribuir as reservas do rei (segundo outra leitura, o rei ocupa seu posto correto e reúne os corações). Sem culpa.";
"hex.59.yao.5" = "Dissipar o dano sangrento e se afastar dele. Sem culpa.";
"hex.60.ci" = "Êxito. Não se pode perseverar por longo tempo numa limitação excessivamente amarga.";
"hex.60.daxiang" = "Sobre o lago há água: A Limitação. Assim, a pessoa nobre estabelece ritos e normas e examina a virtude e a conduta.";
"hex.60.yao.0" = "Não sair do pátio interior. Sem culpa.";
"hex.60.yao.1" = "Não sair do pátio exterior (quando é preciso fazê-lo). Infortúnio.";
"hex.60.yao.2" = "Não conhecer a medida leva a suspirar e se arrepender. A quem mais se pode culpar? (Segundo outra leitura, reconhecê-lo com pesar deixa sem culpa.)";
"hex.60.yao.3" = "Praticar a limitação com serenidade. Êxito.";
"hex.60.yao.4" = "Praticar a limitação de maneira agradável e moderada. Boa fortuna. Avançar merece estima.";
"hex.60.yao.5" = "Limitação excessivamente amarga. Persistir traz infortúnio. Reconhecer isso e se corrigir faz desaparecer o arrependimento.";
"hex.61.ci" = "A sinceridade alcança até leitões e peixes (chega aos seres mais humildes). Boa fortuna. É favorável atravessar o grande rio e perseverar no que é correto.";
"hex.61.daxiang" = "Sobre o lago há vento: A Verdade Interior. Assim, a pessoa nobre examina com cuidado os processos judiciais e adia as execuções.";
"hex.61.yao.0" = "Manter-se serenamente no próprio dever (segundo outra leitura, ponderar e se preparar). Boa fortuna. Buscar outra coisa impede a tranquilidade.";
"hex.61.yao.1" = "O grou canta à sombra e seus semelhantes respondem. Tenho bom vinho e quero compartilhá-lo com você.";
"hex.61.yao.2" = "Encontrar um adversário: ora tocar o tambor e atacar, ora descansar; ora chorar, ora cantar.";
"hex.61.yao.3" = "A lua está quase cheia. O bom cavalo perde seu companheiro. Sem culpa.";
"hex.61.yao.4" = "A sinceridade liga estreitamente a todos. Sem culpa.";
"hex.61.yao.5" = "O canto do galo sobe ao céu (a fama excede a realidade). Persistir assim traz infortúnio.";
"hex.62.ci" = "Êxito. É favorável perseverar no que é correto. Podem-se empreender assuntos pequenos, mas não grandes. A ave deixa seu canto (que desce do céu). Não convém voar para cima, mas descer e pousar. Grande fortuna.";
"hex.62.daxiang" = "Sobre a montanha há trovão: A Preponderância do Pequeno. Assim, a pessoa nobre excede um pouco a medida no respeito de sua conduta, na dor do luto e na frugalidade dos gastos.";
"hex.62.yao.0" = "A ave insiste em voar alto em vez de permanecer abaixo e atrai o infortúnio.";
"hex.62.yao.1" = "Passar pelo avô e encontrar a avó. Sem ultrapassar o soberano, encontrar o ministro. Sem culpa.";
"hex.62.yao.2" = "Não redobrar a prevenção e, em vez disso, seguir sem cautela pode trazer dano. Infortúnio.";
"hex.62.yao.3" = "Sem culpa. Sem se exceder em firmeza, pode-se encontrar o outro. Avançar é perigoso; é preciso estar alerta. Não se apegar indefinidamente.";
"hex.62.yao.4" = "Nuvens densas sem chuva vêm dos nossos arredores ocidentais. O príncipe dispara uma flecha presa a um cordão e captura a presa oculta na caverna.";
"hex.62.yao.5" = "Não encontrar o outro e passar além. Como uma ave presa na rede. Infortúnio: isso se chama calamidade.";
"hex.63.ci" = "Êxito, mesmo em assuntos pequenos. É favorável perseverar no que é correto. No início, boa fortuna; ao final, desordem.";
"hex.63.daxiang" = "A água está sobre o fogo: Após a Conclusão. Assim, a pessoa nobre considera as calamidades possíveis e as previne.";
"hex.63.yao.0" = "Frear as rodas (para não avançar com pressa). A raposa molha a cauda ao atravessar o rio. Sem culpa.";
"hex.63.yao.1" = "A mulher perde a cortina de seu carro. Não persegui-la: será recuperada em sete dias.";
"hex.63.yao.2" = "Gaozong (Wu Ding, rei de Shang) combateu os Guifang (povo do norte) e levou três anos para vencê-los. Não se deve empregar pessoas mesquinhas.";
"hex.63.yao.3" = "As vestes esplêndidas se tornarão trapos (segundo outra leitura, preparar panos para tapar os vazamentos do barco). Permanecer alerta o dia inteiro.";
"hex.63.yao.4" = "O estado vizinho oriental sacrifica um boi, mas sua grande cerimônia não iguala o simples sacrifício yue (oferenda de verão) do estado vizinho ocidental, que recebe verdadeiramente as bênçãos.";
"hex.63.yao.5" = "Molhar a cabeça ao atravessar o rio. Perigo.";
"hex.64.ci" = "Êxito. A pequena raposa quase atravessou o rio, mas molha a cauda. Nada é favorável.";
"hex.64.daxiang" = "O fogo está sobre a água: Antes da Conclusão. Assim, a pessoa nobre distingue cuidadosamente as coisas e coloca cada uma no lugar adequado.";
"hex.64.yao.0" = "Molhar a cauda. Pesar.";
"hex.64.yao.1" = "Frear as rodas (sem se apressar em avançar). Perseverar no que é correto traz boa fortuna.";
"hex.64.yao.2" = "Ainda não se atravessou. Avançar traz infortúnio. É favorável atravessar o grande rio (segundo outra leitura, deveria constar «não é favorável»).";
"hex.64.yao.3" = "Perseverar no que é correto traz boa fortuna; desaparece o arrependimento. Combater os Guifang com a força do trovão. Após três anos, receber recompensas do grande estado.";
"hex.64.yao.4" = "Perseverar no que é correto traz boa fortuna. Sem arrependimento. A luz da pessoa nobre está em sua sinceridade. Boa fortuna.";
"hex.64.yao.5" = "Beber vinho com sinceridade e serenidade. Sem culpa. Se a embriaguez chega a molhar a cabeça, mesmo com sinceridade se perde o caminho correto.";
"hex.1.yong" = "Aparece um grupo de dragões; nenhum disputa a liderança. Boa fortuna.";
"hex.2.yong" = "É favorável perseverar sempre no que é correto.";
