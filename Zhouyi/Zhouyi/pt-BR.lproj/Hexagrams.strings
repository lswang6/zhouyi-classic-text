/* pt-BR: hexagramas (ordem do Rei Wen) e trigramas (ordem pré-celestial) */
"hex.1.name" = "Qián";
"hex.1.full" = "O Criativo";
"hex.1.bh" = "A força do Céu age sem cessar. Tome a iniciativa e persevere com firmeza, mas avance passo a passo, sem arrogância nem pressa.";
"hex.2.name" = "Kūn";
"hex.2.full" = "O Receptivo";
"hex.2.bh" = "A Terra acolhe e sustenta tudo. Siga o fluxo e apoie os outros; não tente ir à frente. Mantendo-se correto e estável, haverá boa sorte.";
"hex.3.name" = "Zhūn";
"hex.3.full" = "A Dificuldade Inicial";
"hex.3.bh" = "Tudo está nascendo, e o começo é difícil. Há muitos obstáculos no início: consolide suas bases, busque ajuda e não avance de forma precipitada.";
"hex.4.name" = "Méng";
"hex.4.full" = "A Insensatez Juvenil";
"hex.4.bh" = "A ignorância espera ser esclarecida. Aprenda com humildade e dedicação; não consulte o oráculo repetidas vezes sobre a mesma questão.";
"hex.5.name" = "Xū";
"hex.5.full" = "A Espera";
"hex.5.bh" = "É hora de esperar. As condições ainda não estão maduras; mantenha a sinceridade e a paciência, e no momento certo o caminho se abrirá.";
"hex.6.name" = "Sòng";
"hex.6.full" = "O Conflito";
"hex.6.bh" = "Sinal de disputa. Busque um acordo cedo e saiba parar a tempo; levar a briga até o fim só traz prejuízo. Recorra a um terceiro imparcial.";
"hex.7.name" = "Shī";
"hex.7.full" = "O Exército";
"hex.7.bh" = "Mobilizar muitas forças. Grandes empreitadas exigem disciplina rigorosa e as pessoas certas nos lugares certos; só sob a liderança de alguém respeitado haverá sucesso.";
"hex.8.name" = "Bǐ";
"hex.8.full" = "A Solidariedade";
"hex.8.bh" = "Aproximar-se e unir-se. Faça alianças sinceras e escolha bem com quem se juntar; aproxime-se logo, pois hesitar faz perder a oportunidade.";
"hex.9.name" = "Xiǎo Chù";
"hex.9.full" = "O Poder de Domar do Pequeno";
"hex.9.bh" = "Pequenas reservas, força ainda insuficiente. As coisas ainda estão amadurecendo; acumule recursos e cultive seu interior.";
"hex.10.name" = "Lǚ";
"hex.10.full" = "A Conduta";
"hex.10.bh" = "Como pisar na cauda de um tigre: avance com cautela. A situação tem riscos, mas com boas maneiras e cuidado você passará em segurança.";
"hex.11.name" = "Tài";
"hex.11.full" = "A Paz";
"hex.11.bh" = "Céu e Terra se unem, tudo flui. As coisas vão bem: aproveite a boa fase, mas lembre-se de se precaver mesmo em tempos de tranquilidade.";
"hex.12.name" = "Pǐ";
"hex.12.full" = "A Estagnação";
"hex.12.bh" = "Céu e Terra não se comunicam, tudo está bloqueado. Seja discreto, mantenha seus princípios e espere a virada.";
"hex.13.name" = "Tóng Rén";
"hex.13.full" = "A Comunidade com os Homens";
"hex.13.bh" = "Harmonia com os outros. Reúna pessoas com os mesmos ideais e coopere abertamente, sem se fechar em pequenos grupos.";
"hex.14.name" = "Dà Yǒu";
"hex.14.full" = "Grandes Posses";
"hex.14.bh" = "Grande colheita, como o sol a pino. Promova o bem, contenha o mal e mantenha-se humilde para conservar a prosperidade por muito tempo.";
"hex.15.name" = "Qiān";
"hex.15.full" = "A Modéstia";
"hex.15.bh" = "Humildade e discrição. Quanto mais modesto você for, mais apoio receberá; todas as linhas são favoráveis, sinal de algo que começa e termina bem.";
"hex.16.name" = "Yù";
"hex.16.full" = "O Entusiasmo";
"hex.16.bh" = "Alegria e fluidez, todos respondem. Planeje com antecedência e aja a favor da maré, mas não se acomode no conforto.";
"hex.17.name" = "Suí";
"hex.17.full" = "Seguir";
"hex.17.bh" = "Mover-se conforme o momento e seguir o que é bom. Adapte-se às circunstâncias com flexibilidade, sem abandonar o caminho correto.";
"hex.18.name" = "Gǔ";
"hex.18.full" = "O Trabalho sobre o que se Deteriorou";
"hex.18.bh" = "Problemas acumulados pedem conserto. Velhas questões precisam ser reorganizadas e renovadas; planeje antes e revise depois, e o perigo se transformará em segurança.";
"hex.19.name" = "Lín";
"hex.19.full" = "A Aproximação";
"hex.19.bh" = "Quem está no alto se aproxima dos de baixo; as coisas vão melhorando. A situação é favorável: aja com energia, mas previna-se contra o declínio que segue o auge.";
"hex.20.name" = "Guān";
"hex.20.full" = "A Contemplação";
"hex.20.bh" = "Observar e dar o exemplo. Observe o quadro geral com calma, reflita sobre si mesmo e conquiste os outros pela sinceridade, sem pressa para agir.";
"hex.21.name" = "Shì Kè";
"hex.21.full" = "Morder";
"hex.21.bh" = "Morder para remover o obstáculo. Há algo no meio do caminho: resolva com firmeza e distinga o certo do errado; removido o obstáculo, tudo flui.";
"hex.22.name" = "Bì";
"hex.22.full" = "A Graciosidade";
"hex.22.bh" = "A beleza do adorno. Um pouco de enfeite ajuda, mas não troque o essencial pelo acessório; coisas pequenas vão bem, as grandes pedem substância.";
"hex.23.name" = "Bō";
"hex.23.full" = "A Desintegração";
"hex.23.bh" = "Desgaste e declínio. A situação é desfavorável: defenda-se em vez de atacar, preserve suas forças e espere a virada.";
"hex.24.name" = "Fù";
"hex.24.full" = "O Retorno";
"hex.24.bh" = "A luz retorna, um novo começo. O pior já passou: volte logo ao caminho certo e recupere-se gradualmente.";
"hex.25.name" = "Wú Wàng";
"hex.25.full" = "A Inocência";
"hex.25.bh" = "Autenticidade, sem falsidade. Deixe as coisas seguirem seu curso natural e não conte com a sorte; agir ou desejar sem critério traz problemas.";
"hex.26.name" = "Dà Chù";
"hex.26.full" = "O Poder de Domar do Grande";
"hex.26.bh" = "Grandes reservas. Acumule conhecimento e força; quando o momento amadurecer, saia e realize grandes feitos.";
"hex.27.name" = "Yí";
"hex.27.full" = "A Nutrição";
"hex.27.bh" = "O caminho de nutrir. Cuide da alimentação, da rotina e das palavras; obtenha o que precisa por meio do seu próprio esforço honesto.";
"hex.28.name" = "Dà Guò";
"hex.28.full" = "A Preponderância do Grande";
"hex.28.bh" = "Carga excessiva, a viga se curva. Tempos extraordinários pedem medidas extraordinárias: assuma a responsabilidade sozinho e sem medo.";
"hex.29.name" = "Kǎn";
"hex.29.full" = "O Abismal";
"hex.29.bh" = "Perigos em série. Em meio às dificuldades, mantenha a fé e a constância; como a água que continua fluindo, você acabará saindo do perigo.";
"hex.30.name" = "Lí";
"hex.30.full" = "Aderir, o Fogo";
"hex.30.bh" = "A luz que se apoia em algo. Apegue-se ao caminho certo e a pessoas sábias, mantendo a suavidade e a modéstia, para que a luz dure.";
"hex.31.name" = "Xián";
"hex.31.full" = "A Influência";
"hex.31.bh" = "Influência mútua. Nas relações e no amor, toque o outro com sinceridade; tratando as pessoas com abertura, tudo corre bem.";
"hex.32.name" = "Héng";
"hex.32.full" = "A Duração";
"hex.32.bh" = "O caminho da constância. Mantenha a direção escolhida, persevere e não mude de rumo com facilidade.";
"hex.33.name" = "Dùn";
"hex.33.full" = "A Retirada";
"hex.33.bh" = "Hora de recuar. A situação não lhe é favorável: retire-se a tempo para se proteger, recuando para depois avançar.";
"hex.34.name" = "Dà Zhuàng";
"hex.34.full" = "O Poder do Grande";
"hex.34.bh" = "Força e vigor em alta. Quando se tem muito poder, é preciso ainda mais retidão e respeito; nunca aja por impulso confiando na força.";
"hex.35.name" = "Jìn";
"hex.35.full" = "O Progresso";
"hex.35.bh" = "O sol nasce no horizonte, é tempo de progresso e promoção. Mostre seu talento e seu caráter; o reconhecimento virá com facilidade.";
"hex.36.name" = "Míng Yí";
"hex.36.full" = "O Obscurecimento da Luz";
"hex.36.bh" = "A luz está ferida. Em tempos sombrios, esconda seu brilho e espere: mantenha a clareza por dentro e mostre suavidade por fora.";
"hex.37.name" = "Jiā Rén";
"hex.37.full" = "A Família";
"hex.37.bh" = "O caminho da família. Cada um em seu papel, com palavras e atos coerentes; havendo harmonia em casa, tudo corre bem.";
"hex.38.name" = "Kuí";
"hex.38.full" = "A Oposição";
"hex.38.bh" = "Divergência e afastamento. Diante de opiniões diferentes, busque o que há em comum e respeite as diferenças; coisas pequenas dão certo, as grandes pedem tempo para desfazer as barreiras.";
"hex.39.name" = "Jiǎn";
"hex.39.full" = "O Obstáculo";
"hex.39.bh" = "Caminho difícil. Há bloqueios à frente: reflita sobre si mesmo, busque quem possa ajudar e adie o avanço por enquanto.";
"hex.40.name" = "Xiè";
"hex.40.full" = "A Liberação";
"hex.40.bh" = "As dificuldades se desfazem. Seja tolerante, aja logo, dissolva velhos ressentimentos e restabeleça a ordem.";
"hex.41.name" = "Sǔn";
"hex.41.full" = "A Diminuição";
"hex.41.bh" = "O caminho de diminuir. Abra mão de pequenos ganhos e de interesses egoístas, doe-se com sinceridade e, no fim, você ganhará.";
"hex.42.name" = "Yì";
"hex.42.full" = "O Aumento";
"hex.42.bh" = "Tempo de crescimento. Favorável para expandir e avançar: aprenda com o que é bom e corrija seus erros, e os ganhos virão.";
"hex.43.name" = "Guài";
"hex.43.full" = "O Avanço";
"hex.43.bh" = "Hora de decidir. Quando for preciso cortar, corte, mas argumente abertamente e convença pelo exemplo, sem partir para o confronto direto.";
"hex.44.name" = "Gòu";
"hex.44.full" = "Vir ao Encontro";
"hex.44.bh" = "Encontro inesperado. Surgem encontros ou oportunidades imprevistas, mas avalie bem quem chega e corte os problemas pela raiz.";
"hex.45.name" = "Cuì";
"hex.45.full" = "A Reunião";
"hex.45.bh" = "Reunião e convergência. Pessoas e recursos se juntam: fortaleça a união do grupo e, ao mesmo tempo, esteja preparado para imprevistos.";
"hex.46.name" = "Shēng";
"hex.46.full" = "A Ascensão";
"hex.46.bh" = "Subir passo a passo. Como uma árvore que cresce, o pequeno se torna grande; siga a tendência de alta e avance com coragem.";
"hex.47.name" = "Kùn";
"hex.47.full" = "A Opressão";
"hex.47.bh" = "Situação de aperto. Na adversidade, fale menos e faça mais, mantenha seus ideais, e a saída acabará se abrindo.";
"hex.48.name" = "Jǐng";
"hex.48.full" = "O Poço";
"hex.48.bh" = "O poço que nunca se esgota. Com bases sólidas, continue se doando; o valor está em cuidar e persistir, pois desistir perto do fim põe tudo a perder.";
"hex.49.name" = "Gé";
"hex.49.full" = "A Revolução";
"hex.49.bh" = "Tempo de mudança. A transformação exige o momento certo e a confiança das pessoas; em sintonia com o tempo e com os outros, ela terá sucesso.";
"hex.50.name" = "Dǐng";
"hex.50.full" = "O Caldeirão";
"hex.50.bh" = "Renovação e estabilidade. Consolide sua posição e confie em pessoas capazes; uma nova situação já está estabelecida.";
"hex.51.name" = "Zhèn";
"hex.51.full" = "O Incitar";
"hex.51.bh" = "O trovão sacode. Diante de imprevistos, mantenha a calma, fique alerta e reflita; depois, tudo voltará a ficar em paz.";
"hex.52.name" = "Gèn";
"hex.52.full" = "A Quietude";
"hex.52.bh" = "Parar e não se mover. Saiba quando parar, controle os desejos, cumpra o seu papel e não passe dos limites.";
"hex.53.name" = "Jiàn";
"hex.53.full" = "O Desenvolvimento";
"hex.53.bh" = "Avanço gradual. Como o ganso selvagem que voa por etapas, avance passo a passo, sem querer resultados apressados.";
"hex.54.name" = "Guī Mèi";
"hex.54.full" = "A Jovem que se Casa";
"hex.54.bh" = "A posição ainda não está definida. Cuide do seu papel e da medida certa; avançar de forma precipitada é desfavorável, mantenha a rotina e espere.";
"hex.55.name" = "Fēng";
"hex.55.full" = "A Abundância";
"hex.55.bh" = "Plenitude e grandeza. Você está no auge: aproveite o presente, mas lembre-se de que o sol, depois do meio-dia, começa a declinar.";
"hex.56.name" = "Lǚ";
"hex.56.full" = "O Viajante";
"hex.56.bh" = "Em viagem, longe de casa. Em um ambiente desconhecido, seja cordial e correto e aja com cautela; coisas pequenas dão certo.";
"hex.57.name" = "Xùn";
"hex.57.full" = "A Suavidade";
"hex.57.bh" = "Como o vento que penetra em tudo, a humildade abre caminho. Comunique-se com suavidade, repita sua mensagem com clareza e avance acompanhando a corrente.";
"hex.58.name" = "Duì";
"hex.58.full" = "A Alegria";
"hex.58.bh" = "Alegria e harmonia. Trate os outros com sinceridade e troque experiências com eles; quando a alegria nasce do caminho certo, tudo flui.";
"hex.59.name" = "Huàn";
"hex.59.full" = "A Dispersão";
"hex.59.bh" = "Dispersão e dissolução. Quando as pessoas se afastam, construa consensos; o que estava travado pode ser desfeito aproveitando a ocasião.";
"hex.60.name" = "Jié";
"hex.60.full" = "A Limitação";
"hex.60.bh" = "Moderação na medida certa. Saiba parar a tempo e gaste conforme ganha, mas rigor excessivo também não se sustenta.";
"hex.61.name" = "Zhōng Fú";
"hex.61.full" = "A Verdade Interior";
"hex.61.bh" = "Sinceridade no coração. Toque os outros com autenticidade; onde chega a sinceridade, até o difícil se realiza.";
"hex.62.name" = "Xiǎo Guò";
"hex.62.full" = "A Preponderância do Pequeno";
"hex.62.bh" = "Pequenos excessos. Dedique-se a coisas pequenas e mantenha a humildade; não mire alto demais.";
"hex.63.name" = "Jì Jì";
"hex.63.full" = "Após a Conclusão";
"hex.63.bh" = "A missão foi cumprida. Depois do sucesso é fácil relaxar: mantenha a vigilância nos bons tempos e previna problemas antes que surjam.";
"hex.64.name" = "Wèi Jì";
"hex.64.full" = "Antes da Conclusão";
"hex.64.bh" = "Ainda não terminou. Você está no meio do processo: finalize com cuidado e escolha bem a direção, e o sucesso chegará.";
