/* Arabic (MSA) hexagram & trigram names and plain-language readings (King Wen order). */

"tri.1.k" = "تشيان"; "tri.1.nat" = "السماء";
"tri.2.k" = "دوي"; "tri.2.nat" = "البحيرة";
"tri.3.k" = "لي"; "tri.3.nat" = "النار";
"tri.4.k" = "تشن"; "tri.4.nat" = "الرعد";
"tri.5.k" = "شون"; "tri.5.nat" = "الريح";
"tri.6.k" = "كان"; "tri.6.nat" = "الماء";
"tri.7.k" = "غن"; "tri.7.nat" = "الجبل";
"tri.8.k" = "كون"; "tri.8.nat" = "الأرض";

"hex.1.name" = "الخلّاق"; "hex.1.full" = "الخلّاق";
"hex.1.bh" = "السماء تمضي بقوة لا تكلّ. بادِر واجتهد دون انقطاع، لكن تقدّم خطوة خطوة، وتجنّب الغرور والعجلة.";
"hex.2.name" = "المتلقّي"; "hex.2.full" = "المتلقّي";
"hex.2.bh" = "الأرض ليّنة تحمل كل شيء. سِر مع مجرى الأمور وساند غيرك بدل أن تتصدّر؛ الثبات على الاستقامة يجلب الخير.";
"hex.3.name" = "صعوبة البداية"; "hex.3.full" = "صعوبة البداية";
"hex.3.bh" = "الحياة الجديدة تشقّ طريقها بعناء. البدايات تلقى مقاومة كثيرة؛ ثبّت أساسك واطلب العون، ولا تندفع متهوّرًا.";
"hex.4.name" = "حماقة الشباب"; "hex.4.full" = "حماقة الشباب";
"hex.4.bh" = "جهلٌ ينتظر من يعلّمه. اسأل بتواضع وركّز على التعلّم، ولا تكرّر السؤال نفسه مرة بعد مرة.";
"hex.5.name" = "الانتظار"; "hex.5.full" = "الانتظار";
"hex.5.bh" = "انتظر اللحظة المناسبة. الظروف لم تنضج بعد؛ حافظ على الصدق والصبر، وحين يحين الوقت ينفتح الطريق من تلقاء نفسه.";
"hex.6.name" = "النزاع"; "hex.6.full" = "النزاع";
"hex.6.bh" = "خصومة تلوح في الأفق. سارع إلى الصلح واعرف متى تتوقف، فالمضيّ في النزاع إلى النهاية يضرّك؛ ويمكنك الاستعانة بطرف ثالث عادل.";
"hex.7.name" = "الجيش"; "hex.7.full" = "الجيش";
"hex.7.bh" = "حشد الناس لعمل كبير. المشاريع العظيمة تحتاج انضباطًا صارمًا ووضع الشخص المناسب في مكانه، ولا تنجح إلا بقيادة من يحظى بالفضل والاحترام.";
"hex.8.name" = "التآزر"; "hex.8.full" = "التآزر";
"hex.8.bh" = "التقارب مع الآخرين. ابنِ علاقات صادقة وانضمّ إلى أهل الخير مبكرًا، فالتردّد والوقوف على الهامش يضيّع الفرصة.";
"hex.9.name" = "ترويض الصغير"; "hex.9.full" = "ترويض الصغير";
"hex.9.bh" = "مدّخرات قليلة وقوة لم تكتمل بعد. الأمور ما زالت تتشكّل؛ راكِم مواردك واعتنِ بتهذيب نفسك من الداخل.";
"hex.10.name" = "الخطو الحذر"; "hex.10.full" = "الخطو الحذر";
"hex.10.bh" = "كمن يطأ ذيل نمر، فامضِ بحذر. الموقف محفوف بالمخاطر، لكن بالأدب والحيطة تعبره بسلام.";
"hex.11.name" = "السلام"; "hex.11.full" = "السلام";
"hex.11.bh" = "السماء والأرض تتلاقيان، والتواصل سالك بين الأعلى والأدنى. الأمور تسير بيسر؛ اغتنم الفرصة، وتذكّر الحذر حتى في أوقات الرخاء.";
"hex.12.name" = "الركود"; "hex.12.full" = "الركود";
"hex.12.bh" = "السماء والأرض لا تتلاقيان، والطرق مسدودة. التزم التواضع والهدوء، وتمسّك بمبادئك، وانتظر تحوّل الأحوال.";
"hex.13.name" = "الرفقة مع الناس"; "hex.13.full" = "الرفقة مع الناس";
"hex.13.bh" = "الوئام مع الآخرين. وسّع دائرة من يشاركونك الهدف، وتعاون بانفتاح وعلانية، ولا تنغلق في جماعات ضيقة.";
"hex.14.name" = "الامتلاك العظيم"; "hex.14.full" = "الامتلاك العظيم";
"hex.14.bh" = "حصاد وفير كشمس الظهيرة. انصر الخير واكبح الشر، والزم التواضع وحافظ على ما أنجزت، تدم لك الوفرة طويلًا.";
"hex.15.name" = "التواضع"; "hex.15.full" = "التواضع";
"hex.15.bh" = "التواضع والتنازل. كلما ازددت لينًا وتواضعًا نلت عون الناس أكثر؛ كل الخطوط هنا مباركة، وهي علامة على بداية حسنة ونهاية حسنة.";
"hex.16.name" = "الحماس"; "hex.16.full" = "الحماس";
"hex.16.bh" = "بهجة وانسجام، والناس يستجيبون لك. خطّط مسبقًا وتحرّك مع التيار، لكن لا تستسلم للراحة والدعة.";
"hex.17.name" = "الاتّباع"; "hex.17.full" = "الاتّباع";
"hex.17.bh" = "تحرّك مع الزمن واتبع الخير. تكيّف مع الظروف وكن مرنًا، مع التمسّك بالطريق القويم.";
"hex.18.name" = "إصلاح الفاسد"; "hex.18.full" = "إصلاح الفاسد";
"hex.18.bh" = "عيوب متراكمة تنتظر العلاج. المشكلات القديمة تحتاج إلى إصلاح وتجديد؛ خطّط قبل العمل وراجع بعده، فتتحوّل الأزمة إلى أمان.";
"hex.19.name" = "الاقتراب"; "hex.19.full" = "الاقتراب";
"hex.19.bh" = "الأعلى يقترب من الأدنى، والأحوال تتحسّن تدريجيًا. الوضع يميل إلى الأفضل فبادر بالعمل، واحذر في الوقت نفسه أن يعقب الذروةَ انحدار.";
"hex.20.name" = "التأمّل"; "hex.20.full" = "التأمّل";
"hex.20.bh" = "المراقبة وضرب المثل. تأمّل الصورة كاملة بهدوء وراجع نفسك، وأثّر في الآخرين بصدقك، ولا تستعجل الفعل.";
"hex.21.name" = "العضّ النافذ"; "hex.21.full" = "العضّ النافذ";
"hex.21.bh" = "عضٌّ يزيل العائق. في الطريق عقبة؛ تعامل معها بحزم وميّز الحق من الباطل، فإذا زالت انفتح الطريق.";
"hex.22.name" = "الزينة"; "hex.22.full" = "الزينة";
"hex.22.bh" = "جمال الزخرفة. التجميل المعتدل مفيد، لكن لا تقدّم المظهر على الجوهر؛ الأمور الصغيرة تنجح، والكبيرة تحتاج إلى مضمون حقيقي.";
"hex.23.name" = "التفكّك"; "hex.23.full" = "التفكّك";
"hex.23.bh" = "تآكل وتراجع. الظروف غير مواتية؛ الزم الدفاع لا الهجوم، واحفظ قوتك، وانتظر عودة الأحوال.";
"hex.24.name" = "العودة"; "hex.24.full" = "العودة";
"hex.24.bh" = "عودة النور وبداية جديدة. القاع قد مضى؛ عُد إلى الطريق القويم في الوقت المناسب، واستعد عافيتك خطوة خطوة.";
"hex.25.name" = "البراءة"; "hex.25.full" = "البراءة";
"hex.25.bh" = "الصدق بلا زيف. اتبع الطبيعة ولا تعتمد على الحظ فيكون الخير؛ أمّا التصرّف المتهوّر والطمع فيجلبان المصائب.";
"hex.26.name" = "ترويض العظيم"; "hex.26.full" = "ترويض العظيم";
"hex.26.bh" = "مخزون عظيم. راكِم العلم والقدرات بعمق، وحين تنضج الفرصة انطلق لتحقيق إنجاز كبير.";
"hex.27.name" = "التغذية"; "hex.27.full" = "التغذية";
"hex.27.bh" = "طريق الرعاية والتغذية. انتبه لطعامك ونمط حياتك وكلامك، واحصل على ما تحتاجه بجهدك المشروع.";
"hex.28.name" = "غلبة العظيم"; "hex.28.full" = "غلبة العظيم";
"hex.28.bh" = "حمل ثقيل يُحني العارضة. الأوقات الاستثنائية تتطلّب إجراءات استثنائية؛ تحمّل المسؤولية وحدك بلا خوف.";
"hex.29.name" = "الهاوية"; "hex.29.full" = "الهاوية";
"hex.29.bh" = "مخاطر متتالية. في الشدّة تمسّك بإيمانك وثباتك، وكن كالماء الذي يواصل الجريان، فتخرج من الخطر في النهاية.";
"hex.30.name" = "المتشبّث"; "hex.30.full" = "المتشبّث";
"hex.30.bh" = "النور يحتاج إلى ما يتشبّث به. تمسّك بالطريق القويم وبأهل الحكمة، وكن لينًا متواضعًا، ليدوم النور.";
"hex.31.name" = "التأثير المتبادل"; "hex.31.full" = "التأثير المتبادل";
"hex.31.bh" = "تجاوب متبادل. في العلاقات والعواطف يتأثّر الناس بالصدق؛ عامل الآخرين بقلب منفتح تَسِر علاقاتك بيسر.";
"hex.32.name" = "الدوام"; "hex.32.full" = "الدوام";
"hex.32.bh" = "طريق الثبات والاستمرار. تمسّك بالاتجاه الذي اخترته وواظب عليه، ولا تغيّره بسهولة.";
"hex.33.name" = "الانسحاب"; "hex.33.full" = "الانسحاب";
"hex.33.bh" = "وقت التراجع. الظروف ليست في صالحك؛ انسحب في الوقت المناسب لتحمي نفسك، فالتراجع أحيانًا طريق إلى التقدّم.";
"hex.34.name" = "قوة العظيم"; "hex.34.full" = "قوة العظيم";
"hex.34.bh" = "قوة وزخم كبيران. حين تمتلك القوة فالتزم الاستقامة واللياقة أكثر، وإياك أن تتصرّف بتهوّر اعتمادًا على قوتك.";
"hex.35.name" = "التقدّم"; "hex.35.full" = "التقدّم";
"hex.35.bh" = "شمس تشرق، وترقٍّ وتقدّم. أظهر نشاطك وقدراتك وفضائلك، فمن السهل أن تنال التقدير.";
"hex.36.name" = "إظلام النور"; "hex.36.full" = "إظلام النور";
"hex.36.bh" = "النور مجروح. حين يكون المحيط مظلمًا أخفِ مواهبك وانتظر، واحفظ نورك في داخلك مع إظهار اللين في الخارج.";
"hex.37.name" = "العائلة"; "hex.37.full" = "العائلة";
"hex.37.bh" = "طريق الأسرة. ليلتزم كلٌّ بدوره، ولتكن الأقوال والأفعال على أساس؛ إذا ساد الوئام في الداخل سارت الأمور كلها بيسر.";
"hex.38.name" = "التعارض"; "hex.38.full" = "التعارض";
"hex.38.bh" = "تنافر وتباعد. عند اختلاف الآراء ابحث عن المشترك واحترم الاختلاف؛ الأمور الصغيرة تنجح، أمّا الكبيرة فتحتاج إلى إذابة الجفاء ببطء.";
"hex.39.name" = "العائق"; "hex.39.full" = "العائق";
"hex.39.bh" = "طريق شاق. أمامك عقبات؛ راجع نفسك واطلب عون أهل الفضل، وتمهّل في التقدّم مؤقتًا.";
"hex.40.name" = "الانفراج"; "hex.40.full" = "الانفراج";
"hex.40.bh" = "زوال الصعاب. تعامل بتسامح وبادر مبكرًا، وصفِّ الضغائن القديمة، وأعِد النظام إلى مكانه.";
"hex.41.name" = "النقصان"; "hex.41.full" = "النقصان";
"hex.41.bh" = "طريق التخلّي. تنازل عن المكاسب الصغيرة وتخلّص من الأنانية، وأعطِ بإخلاص، فتجني في المقابل.";
"hex.42.name" = "الزيادة"; "hex.42.full" = "الزيادة";
"hex.42.bh" = "وقت النماء. مناسب للتوسّع والتقدّم؛ تعلّم من كل خير تراه، وأصلح أخطاءك، والمكاسب منتظرة.";
"hex.43.name" = "الحسم"; "hex.43.full" = "الحسم";
"hex.43.bh" = "وقت اتخاذ القرار. احسم حين يجب الحسم، لكن بالحجة العلنية وكسب القلوب بالفضيلة، لا بالمواجهة العنيفة.";
"hex.44.name" = "اللقاء"; "hex.44.full" = "اللقاء";
"hex.44.bh" = "لقاء غير متوقّع. قد تأتيك مصادفة أو فرصة مفاجئة، لكن تبيّن حقيقة القادم، وعالج المشكلات وهي صغيرة.";
"hex.45.name" = "التجمّع"; "hex.45.full" = "التجمّع";
"hex.45.bh" = "اجتماع وتلاقٍ. حين يتجمّع الناس والموارد، وحّد القلوب، واستعدّ في الوقت نفسه لما قد يطرأ.";
"hex.46.name" = "الصعود"; "hex.46.full" = "الصعود";
"hex.46.bh" = "صعود خطوة بعد خطوة. كالشجرة التي تنمو، يتراكم القليل ليصبح كثيرًا؛ اصعد مع التيار وتقدّم بجرأة.";
"hex.47.name" = "الضيق"; "hex.47.full" = "الضيق";
"hex.47.bh" = "حال من الضيق والشدّة. في المحنة أقِلَّ الكلام وأكثِر العمل، وتمسّك بطموحك، فالأزمة ستنفرج في النهاية.";
"hex.48.name" = "البئر"; "hex.48.full" = "البئر";
"hex.48.bh" = "البئر يعطي بلا نفاد. الأساس متين والعطاء مستمر؛ العبرة بالصيانة والمثابرة، والتوقّف قبل بلوغ الغاية يضرّ.";
"hex.49.name" = "الثورة"; "hex.49.full" = "الثورة";
"hex.49.bh" = "وقت التغيير. يحتاج التغيير إلى نضج الظروف وكسب ثقة الناس؛ إذا وافق الزمنَ وإرادة الناس نجح.";
"hex.50.name" = "القِدر"; "hex.50.full" = "القِدر";
"hex.50.bh" = "تجديد وتثبيت للمكانة. رسّخ موقعك واستعن بالأكفاء، فالوضع الجديد قد استقرّ.";
"hex.51.name" = "المُثير"; "hex.51.full" = "المُثير";
"hex.51.bh" = "رعد يهزّ المكان. أمام الطوارئ المفاجئة حافظ على هدوئك وكن يقظًا وراجع نفسك، فتجد نفسك بعدها في أمان.";
"hex.52.name" = "السكون"; "hex.52.full" = "السكون";
"hex.52.bh" = "التوقّف والثبات. اعرف متى تتوقف فتوقّف، واضبط رغباتك، والزم حدودك، ولا تتجاوز موقعك.";
"hex.53.name" = "التطوّر التدريجي"; "hex.53.full" = "التطوّر التدريجي";
"hex.53.bh" = "التقدّم بالتدريج. كالإوزّ البري يعلو في طيرانه شيئًا فشيئًا، امضِ خطوة بخطوة ولا تستعجل النتائج.";
"hex.54.name" = "الفتاة المُزوَّجة"; "hex.54.full" = "الفتاة المُزوَّجة";
"hex.54.bh" = "المكانة لم تستقم بعد. انتبه لموقعك وحدودك فيما تفعل؛ التقدّم المتسرّع لا ينفع، فالزم المألوف وانتظر الوقت المناسب.";
"hex.55.name" = "الوفرة"; "hex.55.full" = "الوفرة";
"hex.55.bh" = "وفرة وازدهار. أنت في الذروة؛ اغتنم الحاضر، وتذكّر أن الشمس بعد الظهيرة تميل إلى المغيب.";
"hex.56.name" = "المسافر"; "hex.56.full" = "المسافر";
"hex.56.bh" = "غريب في سفر. في مكان غير مألوف كن متواضعًا مستقيمًا وتصرّف بحذر؛ الأمور الصغيرة تنجح.";
"hex.57.name" = "اللطيف"; "hex.57.full" = "اللطيف";
"hex.57.bh" = "كالريح تتسلّل إلى كل شيء، بلين وتواضع. تواصل بلطف وكرّر رسالتك بوضوح، وادخل مع مجرى الأمور.";
"hex.58.name" = "البهيج"; "hex.58.full" = "البهيج";
"hex.58.bh" = "فرح وانسجام. عامل الناس بصدق وتبادلوا المعرفة؛ إذا نبع الفرح من الطريق القويم سارت الأمور بنجاح.";
"hex.59.name" = "التبدّد"; "hex.59.full" = "التبدّد";
"hex.59.bh" = "تفرّق وانحلال. حين تتفرّق القلوب اعمل على جمعها حول رأي مشترك؛ وما تعقّد من أمور يمكن حلّه باغتنام الفرصة.";
"hex.60.name" = "التقييد"; "hex.60.full" = "التقييد";
"hex.60.bh" = "الاعتدال بمقدار. توقّف عند الحد المناسب وأنفق على قدر دخلك، لكن الشدّة المفرطة لا تدوم أيضًا.";
"hex.61.name" = "الصدق الباطن"; "hex.61.full" = "الصدق الباطن";
"hex.61.bh" = "الصدق في القلب. أثّر في الآخرين بإخلاصك، فحيثما بلغ الصدق أمكن إنجاز حتى الأمور الصعبة.";
"hex.62.name" = "غلبة الصغير"; "hex.62.full" = "غلبة الصغير";
"hex.62.bh" = "تجاوز بسيط للحد. اهتم بالأمور الصغيرة وتواضع، ولا تطمح إلى ما هو أبعد من قدرتك.";
"hex.63.name" = "بعد الإتمام"; "hex.63.full" = "بعد الإتمام";
"hex.63.bh" = "الأمر قد تمّ بنجاح. بعد النجاح يسهل التراخي؛ فكّر في المخاطر وأنت في أمان، واتّقِ المشكلات قبل وقوعها.";
"hex.64.name" = "قبل الإتمام"; "hex.64.full" = "قبل الإتمام";
"hex.64.bh" = "الأمر لم يكتمل بعد. ما زلت في منتصف الطريق؛ أنهِ بحذر وتبيّن الاتجاه جيدًا، وسيأتي وقت النجاح.";
