"tri.1.k" = "تشيان"; "tri.1.nat" = "السماء";
"tri.2.k" = "دوي"; "tri.2.nat" = "البحيرة";
"tri.3.k" = "لي"; "tri.3.nat" = "النار";
"tri.4.k" = "تشن"; "tri.4.nat" = "الرعد";
"tri.5.k" = "شون"; "tri.5.nat" = "الريح";
"tri.6.k" = "كان"; "tri.6.nat" = "الماء";
"tri.7.k" = "غن"; "tri.7.nat" = "الجبل";
"tri.8.k" = "كون"; "tri.8.nat" = "الأرض";

"hex.1.name" = "الخلّاق"; "hex.1.full" = "الخلّاق";
"hex.1.bh" = "السماء مضاعفة، وخطوطها الستة كلها صلبة: صورة القوة الخلّاقة التي لا تكلّ. يصفها الحكم بأنها «عظيمة وأصيلة البدء»؛ وتتتبّع الخطوط تنّينًا كامنًا في الأعماق، ثم ظاهرًا في الحقل، ثم طائرًا في السماء، وأخيرًا متجاوزًا حدّه.";
"hex.2.name" = "المتلقّي"; "hex.2.full" = "المتلقّي";
"hex.2.bh" = "الأرض مضاعفة، وخطوطها الستة كلها ليّنة: صورة الأرض التي تحمل الأشياء كلها وتسندها. يشبّه الحكم ثباتها بثبات الفرس؛ وتمتدّ الخطوط من الصقيع الذي يُنذر بالجليد الصلب إلى تنانين تتقاتل في العراء.";
"hex.3.name" = "صعوبة البداية"; "hex.3.full" = "صعوبة البداية";
"hex.3.bh" = "الرعد في الأسفل والسحب في الأعلى: صورة برعم يشقّ الأرض وسط العاصفة. يتناول النص ارتباك البدايات الأولى؛ وتُظهر الخطوط حصانًا وعربة متوقّفين، وخاطبًا يُرَدّ أول الأمر، وصيّادًا يضلّ طريقه بلا دليل.";
"hex.4.name" = "حماقة الشباب"; "hex.4.full" = "حماقة الشباب";
"hex.4.bh" = "نبع ينبثق عند سفح جبل: صورة حماقة الشباب وقلّة خبرته. يصف الحكم المعلّم والتلميذ: فالفتى هو من يسعى إلى المعلّم، والأسئلة التي تتكرّر مرة بعد مرة لا تلقى جوابًا؛ وتتناول الخطوط التأديب والصبر والشباب الذي لم يتعلّم.";
"hex.5.name" = "الانتظار"; "hex.5.full" = "الانتظار";
"hex.5.bh" = "سحب ترتفع في السماء قبل أن يهطل المطر: صورة الانتظار. يربط الحكم الانتظار بالصدق وبعبور النهر العظيم؛ وتنتظر الخطوط في الضواحي، وعلى الرمل، وفي الوحل، وعند الخمر والطعام، وأخيرًا في حفرة.";
"hex.6.name" = "النزاع"; "hex.6.full" = "النزاع";
"hex.6.bh" = "السماء تتّجه إلى الأعلى والماء ينساب إلى الأسفل فيتباعدان: صورة النزاع والتقاضي. يقابل الحكم بين نزاع يُوقَف في منتصفه ونزاع يُدفَع إلى نهايته؛ وتصوّر الخطوط خصومات تُترك، وعودة إلى البيت، وحزامًا جلديًا للتكريم يُنتزع ثلاث مرات في يوم واحد.";
"hex.7.name" = "الجيش"; "hex.7.full" = "الجيش";
"hex.7.bh" = "ماء محتجز في باطن الأرض: صورة قوّة تُستمدّ من بين الناس. يتناول النص انضباط الجيش والحاجة إلى قائد متمرّس؛ وتنتقل الخطوط من الخروج بانتظام، مرورًا بعربات تحمل الجثث، إلى الحاكم وهو يمنح المكافآت عند انتهاء الحملة.";
"hex.8.name" = "التآزر"; "hex.8.full" = "التآزر";
"hex.8.bh" = "ماء يجري فوق الأرض: صورة أشياء تتقارب وتتآزر. يتحدّث الحكم عمّن يأتون للاتحاد وعن المتأخّر؛ وتصف الخطوط تآزرًا قائمًا على الصدق، وتآزرًا من الداخل ومن الخارج، وتآزرًا بلا رأس.";
"hex.9.name" = "ترويض الصغير"; "hex.9.full" = "ترويض الصغير";
"hex.9.bh" = "ريح تجري في السماء: صورة قوّة لطيفة تكبح إلى حين. يحدّد الحكم الموضوع بعبارة «سحب كثيفة ولا مطر» آتية من التخوم الغربية؛ وتُظهر الخطوط العودة إلى الطريق الخاص، وعربة تفقد أشعّة عجلاتها، وأخيرًا هطول المطر.";
"hex.10.name" = "الخطو الحذر"; "hex.10.full" = "الخطو الحذر";
"hex.10.bh" = "السماء فوق بحيرة: صورة النظام اللائق بين الأعلى والأدنى. صورة الحكم هي الخطو على ذيل نمر لا يعضّ؛ وتتتبّع الخطوط السلوك البسيط، وطريقًا مستويًا هادئًا، ورجلًا أعور يحاول أن يرى، ومراجعة أخيرة للخطوات التي قُطعت.";
"hex.11.name" = "السلام"; "hex.11.full" = "السلام";
"hex.11.bh" = "الأرض في الأعلى والسماء في الأسفل، وتأثيراتهما تلتقي: صورة السماء والأرض في انسجام. يتحدّث الحكم عن «ذهاب الصغير ومجيء الكبير»؛ وتنتقل الخطوط من نبات الأسل يُقتلع معًا، مرورًا بعبارة «لا سهل بلا منحدر»، إلى سور المدينة يتهاوى عائدًا إلى خندقه.";
"hex.12.name" = "الركود"; "hex.12.full" = "الركود";
"hex.12.bh" = "السماء في الأعلى والأرض في الأسفل، تتباعدان بلا تماسّ: صورة الركود. يتحدّث الحكم عن «ذهاب الكبير ومجيء الصغير»؛ وتنتقل الخطوط من احتمال زمن سيّئ، مرورًا بمصير معلّق بأجمة من أشجار التوت، إلى الركود وقد انقلب في النهاية.";
"hex.13.name" = "الرفقة مع الناس"; "hex.13.full" = "الرفقة مع الناس";
"hex.13.bh" = "السماء فوق النار، وكلتاهما تمتدّ إلى الأعلى: صورة أناس يجمعهم هدف مشترك. يضع الحكم الرفقة مع الناس في البرّية المفتوحة؛ وتتتبّع الخطوط الرفقة عند البوّابة، وداخل عشيرة واحدة، وجنودًا مختبئين في الأدغال، وحلفاء يبكون أولًا ثم يضحكون.";
"hex.14.name" = "الامتلاك العظيم"; "hex.14.full" = "الامتلاك العظيم";
"hex.14.bh" = "نار عالية في السماء تضيء كل ما تحتها: صورة الامتلاك العظيم. يتحدّث الحكم عن «تقدّم عظيم»؛ وتتناول الخطوط مسؤوليات الثروة: عربة كبيرة للحمل، وقربانًا لابن السماء، ووفرة تُصان بلا إفراط.";
"hex.15.name" = "التواضع"; "hex.15.full" = "التواضع";
"hex.15.bh" = "جبل مختبئ في باطن الأرض: صورة عظمة تُبقي نفسها في الأسفل. يقول الحكم إن الرجل النبيل يمضي بالأمور إلى نهايتها؛ وتصف الخطوط التواضع في صوره المختلفة: التواضع في التواضع نفسه، والتواضع الذي يُعبَّر عنه، والتواضع المقترن بالجدارة.";
"hex.16.name" = "الحماس"; "hex.16.full" = "الحماس";
"hex.16.bh" = "رعد ينبثق من الأرض: صورة طاقة تنطلق فتحرّك الأشياء كلها. تربطها الصورة الكبرى بالموسيقى التي ألّفها الملوك القدماء؛ وتقابل الخطوط بين حماس متباهٍ أو منغلق على ذاته وطبع ثابت كالصخر.";
"hex.17.name" = "الاتّباع"; "hex.17.full" = "الاتّباع";
"hex.17.bh" = "رعد يستقرّ داخل البحيرة: صورة اتّباع الموسم والتكيّف معه. يربط الحكم الاتّباع بالثبات والاستقامة؛ وتُظهر الخطوط التعلّق بالصغير أو بالكبير، والصدق على الطريق القويم، ومن هو مشدود بإحكام إلى الولاء.";
"hex.18.name" = "إصلاح الفاسد"; "hex.18.full" = "إصلاح الفاسد";
"hex.18.bh" = "ريح تهبّ عند سفح جبل حيث تركد الأشياء: صورة فساد ينبغي إصلاحه. يتحدّث الحكم عن ثلاثة أيام قبل بداية جديدة وثلاثة أيام بعدها؛ وتتناول الخطوط إصلاح ما تركه الأب والأم يفسد، أما الخط الأعلى فلا يخدم ملكًا ولا أميرًا.";
"hex.19.name" = "الاقتراب"; "hex.19.full" = "الاقتراب";
"hex.19.bh" = "الأرض فوق بحيرة: صورة الأعلى يقترب ممّن هم دونه. يضيف الحكم تنبيهًا بشأن الشهر الثامن حين تنعطف الدورة؛ وتصف الخطوط اقترابًا مشتركًا، ويسيرًا، وتامًّا، وحكيمًا، وكريمًا.";
"hex.20.name" = "التأمّل"; "hex.20.full" = "التأمّل";
"hex.20.bh" = "ريح تجري فوق الأرض: صورة التأمّل، أن ينظر المرء وأن يُنظَر إليه. صورة الحكم متعبّد غسل يديه ولم يقدّم القربان بعد؛ وتتّسع الخطوط من نظرة صبيّ ولمحة من خلال باب إلى تأمّل المرء في حياته.";
"hex.21.name" = "العضّ النافذ"; "hex.21.full" = "العضّ النافذ";
"hex.21.bh" = "الرعد والبرق معًا: صورة عائق بين الفكّين ينبغي العضّ عليه حتى ينفذ. يتناول النص تطبيق القانون والعقوبة؛ وتنتقل الخطوط من قدمين في المِقطرة، مرورًا بعضّ لحم طريّ ولحم مجفّف، إلى عنق في الغُلّ.";
"hex.22.name" = "الزينة"; "hex.22.full" = "الزينة";
"hex.22.bh" = "نار عند سفح جبل تضيئه: صورة الرقّة والزينة. يجيز الحكم الأمور الصغيرة وحدها؛ وتنتقل الخطوط من قدمين ولحية مزيّنتين، مرورًا ببريق نديّ وحصان أبيض، إلى زينة صارت بيضاء خالصة.";
"hex.23.name" = "التفكّك"; "hex.23.full" = "التفكّك";
"hex.23.bh" = "خمسة خطوط ليّنة تحت خطّ صلب واحد: جبل قائم على الأرض يتآكل. تُظهر الخطوط سريرًا يتفكّك من قوائمه، ثم من إطاره، ثم حتى الجلد؛ وفي الأعلى تبقى ثمرة كبيرة لم تُؤكل.";
"hex.24.name" = "العودة"; "hex.24.full" = "العودة";
"hex.24.bh" = "رعد في باطن الأرض: صورة النور العائد عند الانقلاب الشتوي. يتحدّث الحكم عن عودة في غضون سبعة أيام؛ وتميّز الخطوط بين عودة سريعة، وعودة هادئة، وعودات متكرّرة، وسير منفرد، وعودة فاتت بسبب الارتباك.";
"hex.25.name" = "البراءة"; "hex.25.full" = "البراءة";
"hex.25.bh" = "رعد يدوّي تحت السماء: صورة أشياء تتصرّف وفق طبيعتها الخاصة، بلا خداع. يربط الحكم البراءة بالاستقامة؛ ومن بين الخطوط ثور يربطه رجل ويقوده عابر سبيل، ومرض يزول بلا دواء.";
"hex.26.name" = "ترويض العظيم"; "hex.26.full" = "ترويض العظيم";
"hex.26.bh" = "السماء محتواة داخل الجبل: صورة طاقة عظيمة مكبوحة ومدّخرة. تتحدّث الصورة الكبرى عن ادّخار أقوال العصور السابقة وأفعالها؛ وتمتدّ الخطوط من عربة نُزع محورها وقرن عجل صغير مصون إلى طريق السماء ينفتح في الأعلى.";
"hex.27.name" = "التغذية"; "hex.27.full" = "التغذية";
"hex.27.bh" = "رعد تحت جبل، كفكّين ينطبقان على الطعام: صورة التغذية. يوجّه الحكم الانتباه إلى ما يسعى المرء إلى ملء فمه به؛ وتقابل الخطوط بين من يترك سلحفاته العجيبة ليحدّق في طعام غيره وبين غذاء مستمدّ من مصادر لائقة.";
"hex.28.name" = "غلبة العظيم"; "hex.28.full" = "غلبة العظيم";
"hex.28.bh" = "البحيرة ترتفع فوق الأشجار: صورة عارضة سقف تنحني تحت ثقل يفوق طاقتها. يتناول النص الأزمنة الاستثنائية؛ وتُظهر الخطوط حصيرًا من الأسل الأبيض، وصفصافة ذابلة تُخرج براعم، وعارضة سقف مقوّسة، وعبورًا يغمر فيه الماء الرأس.";
"hex.29.name" = "الهاوية"; "hex.29.full" = "الهاوية";
"hex.29.bh" = "الماء مضاعف، يجري من وادٍ إلى آخر: صورة الهاوية والخطر المتكرّر. يُعلي الحكم من شأن الصدق والعقل الصافي؛ وتتحدّث الخطوط عن حفرة داخل حفرة، وعن خمر وأرزّ يُناولان من نافذة، وعن أسير مقيّد بالحبال.";
"hex.30.name" = "المتشبّث"; "hex.30.full" = "المتشبّث";
"hex.30.bh" = "النار مضاعفة، ضياء فوق ضياء: صورة النور المتشبّث بما يضيئه. يضيف الحكم العناية ببقرة؛ وتنتقل الخطوط من خطى مضطربة، مرورًا بالضوء الأصفر والشمس الغاربة، إلى لهب مفاجئ وحملة تأديبية يقودها ملك.";
"hex.31.name" = "التأثير المتبادل"; "hex.31.full" = "التأثير المتبادل";
"hex.31.bh" = "بحيرة مستقرّة على جبل: صورة الانجذاب المتبادل بين شابّ وشابّة. يشير الحكم إلى اتّخاذ زوجة؛ وتصعد الخطوط في الجسد: إبهام القدم، ثم الساقان، ثم الفخذان، ثم الظهر، وأخيرًا الفكّان واللسان.";
"hex.32.name" = "الدوام"; "hex.32.full" = "الدوام";
"hex.32.bh" = "الرعد والريح، يوجدان معًا على الدوام: صورة ما يدوم. ترسم الصورة الكبرى ثباتًا دون تغيير المسلك؛ وتقابل الخطوط بين طلب الدوام بتعجّل، وطبع متقلّب، وحقل لا صيد فيه.";
"hex.33.name" = "الانسحاب"; "hex.33.full" = "الانسحاب";
"hex.33.bh" = "جبل يرتفع تحت السماء، والسماء تنسحب أمامه: صورة الانسحاب. يتناول الحكم الانسحاب في الوقت المناسب حين تتقدّم القوى الأدنى؛ وتتراوح الخطوط بين ذيل الانسحاب، ومن يُشدّ بإحكام بجلد ثور أصفر، وانسحاب بشوش غير متعجّل.";
"hex.34.name" = "قوة العظيم"; "hex.34.full" = "قوة العظيم";
"hex.34.bh" = "رعد عالٍ في السماء: صورة قوة عظيمة في حركة. تربط الصورة الكبرى القوة باللياقة؛ وتُظهر الخطوط كبشًا ينطح سياجًا فتعلق قرناه به، ثم السياج وقد انفتح في النهاية.";
"hex.35.name" = "التقدّم"; "hex.35.full" = "التقدّم";
"hex.35.bh" = "الشمس تشرق فوق الأرض: صورة تقدّم سريع ويسير. يصوّر الحكم أميرًا يُكرَّم بخيول كثيرة ويُستقبَل ثلاث مرات في يوم واحد؛ وتقابل الخطوط بين تقدّم معوَّق أو حزين وتقدّم الهامستر وتقدّم من يتقدّم بقرنيه.";
"hex.36.name" = "إظلام النور"; "hex.36.full" = "إظلام النور";
"hex.36.bh" = "الشمس غارت تحت الأرض: صورة إظلام النور، ضياء جريح ومحجوب. يتناول النص إخفاء المرء نوره في الأزمنة المظلمة، ويضرب مثلًا بالأمير جي؛ ومن بين الخطوط تدرُج يطير بجناحين متدلّيين، وصيد في الجنوب.";
"hex.37.name" = "العائلة"; "hex.37.full" = "العائلة";
"hex.37.bh" = "ريح تخرج من النار: صورة العائلة التي يمتدّ تأثيرها من الداخل إلى الخارج. يؤكّد الحكم دور المرأة؛ وتتناول الخطوط القواعد الثابتة في البيت، وإعداد الطعام، وتأثير الملك في أسرته.";
"hex.38.name" = "التعارض"; "hex.38.full" = "التعارض";
"hex.38.bh" = "نار فوق بحيرة، كلّ منهما يبتعد عن الآخر: صورة التعارض والجفاء. يجيز الحكم الأمور الصغيرة؛ ومن بين الخطوط حصان ضائع يعود من تلقاء نفسه، ولقاء المرء سيّده في زقاق ضيّق، وخنزير مغطّى بالوحل.";
"hex.39.name" = "العائق"; "hex.39.full" = "العائق";
"hex.39.bh" = "ماء على قمّة جبل: صورة طريق خطر في الأمام. يقابل الحكم بين الجنوب الغربي والشمال الشرقي ويتحدّث عن لقاء الرجل العظيم؛ وتتناوب الخطوط بين المضيّ قُدُمًا نحو العائق والرجوع لطلب السند.";
"hex.40.name" = "الانفراج"; "hex.40.full" = "الانفراج";
"hex.40.bh" = "رعد ومطر يفكّان توتّر العاصفة: صورة الانفراج. يتحدّث الحكم عن العودة مبكرًا متى زالت الشدّة؛ ومن بين الخطوط اصطياد ثلاثة ثعالب، وحمّال يركب عربة، ورمي صقر على سور عالٍ.";
"hex.41.name" = "النقصان"; "hex.41.full" = "النقصان";
"hex.41.bh" = "بحيرة عند سفح جبل، يصعد ماؤها ليغذّي المنحدر فوقها: صورة النقصان. يذكر الحكم أن وعاءين صغيرين قد يكفيان للقربان؛ وتتناول الخطوط الإنقاص في الأسفل لزيادة الأعلى، وما يُكتسب بما يُعطى.";
"hex.42.name" = "الزيادة"; "hex.42.full" = "الزيادة";
"hex.42.bh" = "الريح والرعد يقوّي كلّ منهما الآخر: صورة الزيادة. يتناول النص عطاء الأعلى للأدنى، وتربطه الصورة الكبرى بالتوجّه نحو الخير؛ ومن بين الخطوط هديّة من عشرة أزواج من أصداف السلاحف، وقلب بلا ثبات.";
"hex.43.name" = "الحسم"; "hex.43.full" = "الحسم";
"hex.43.bh" = "بحيرة ارتفعت عاليًا فوق السماء: صورة الحسم والاختراق. يتحدّث الحكم عن إعلان الأمر في بلاط الملك؛ وتتناول الخطوط الفعل الحازم في مواجهة الخطأ: الاندفاع بتعجّل مفرط، وأعشابًا ضارّة تُقتلع، ومسافرًا وحيدًا يبلّله المطر.";
"hex.44.name" = "اللقاء"; "hex.44.full" = "اللقاء";
"hex.44.bh" = "ريح تهبّ تحت السماء: صورة خطّ ليّن واحد يأتي للقاء خمسة خطوط صلبة. ينصح الحكم بعدم الزواج من مثل هذه المرأة؛ ومن بين الخطوط سمكة في الحوض، وبطّيخة مغطّاة بأوراق الصفصاف، ولقاء بالقرون.";
"hex.45.name" = "التجمّع"; "hex.45.full" = "التجمّع";
"hex.45.bh" = "بحيرة ترتفع فوق الأرض: صورة مياه مجتمعة وناس يتجمّعون. يشير الحكم إلى الملك يقترب من معبده وإلى قرابين كبيرة؛ وتتناول الخطوط التجمّع في البداية، والانجذاب معًا، والتنهّد على الفراق، والبكاء.";
"hex.46.name" = "الصعود"; "hex.46.full" = "الصعود";
"hex.46.bh" = "خشب ينمو صاعدًا في باطن الأرض: صورة نموّ ثابت إلى الأعلى. يشير الحكم إلى لقاء الرجل العظيم والانطلاق نحو الجنوب؛ وتتتبّع الخطوط الصعود إلى مدينة خالية، وقربان الملك على جبل تشي، وارتقاء درج.";
"hex.47.name" = "الضيق"; "hex.47.full" = "الضيق";
"hex.47.bh" = "بحيرة جفّ ماؤها: صورة الإنهاك والضيق. يذكر الحكم أن الكلام لا يُصدَّق في مثل هذا الوقت؛ ومن بين الخطوط ضيق تحت شجرة جرداء، وعند الخمر والطعام، وبين الصخور والأشواك، وبين النباتات المتسلّقة.";
"hex.48.name" = "البئر"; "hex.48.full" = "البئر";
"hex.48.bh" = "خشب ينزل في الماء ليرفعه: صورة البئر، مصدر غذاء لا ينضب أبدًا. يذكر الحكم أن البلدة قد تنتقل أما بئرها فلا؛ وتنتقل الخطوط من بئر موحلة مهجورة إلى بئر مفتوحة للجميع.";
"hex.49.name" = "الثورة"; "hex.49.full" = "الثورة";
"hex.49.bh" = "نار داخل بحيرة، كلّ منهما يسعى إلى إطفاء الآخر: صورة الثورة والتغيير الجذري. يقول الحكم إن التغيير لا يُصدَّق إلا في اليوم الذي يكتمل فيه؛ وتتتبّع الخطوط تغييرًا مشدودًا بجلد ثور أصفر، والرجل العظيم يتغيّر كما يتغيّر النمر، والرجل النبيل كما يتغيّر الفهد.";
"hex.50.name" = "القِدر"; "hex.50.full" = "القِدر";
"hex.50.bh" = "خشب تحت النار: صورة القِدر «دينغ»، الوعاء البرونزي الذي تُطهى فيه القرابين والولائم. يتحدّث الحكم عن تقدّم عظيم؛ وتنتقل الخطوط من قِدر يُقلب لإفراغه، مرورًا بقوائم مكسورة ومقابض متبدّلة، إلى حلقات حمل من ذهب ومن يشب.";
"hex.51.name" = "المُثير"; "hex.51.full" = "المُثير";
"hex.51.bh" = "الرعد مضاعف: صورة الصدمة والخوف. يصوّر الحكم فزعًا يعقبه ضحك، ومن يظلّ ممسكًا بمغرفة القربان والخمر؛ وتتتبّع الخطوط ردود الفعل على الصدمة، من فقدان الكنوز وصعود التلال التسعة إلى العلوق في الوحل.";
"hex.52.name" = "السكون"; "hex.52.full" = "السكون";
"hex.52.bh" = "الجبل مضاعف: صورة السكون والراحة. يصوّر الحكم من يُبقي ظهره ساكنًا ويمشي في الفناء دون أن يرى أحدًا؛ وتصعد الخطوط في الجسد، عبر أصابع القدمين والساقين والوركين والجذع والفكّين، إلى سكون نبيل في القمّة.";
"hex.53.name" = "التطوّر التدريجي"; "hex.53.full" = "التطوّر التدريجي";
"hex.53.bh" = "شجرة تنمو على جبل: صورة التطوّر التدريجي. يتّخذ الحكم زواج فتاة مثالًا؛ وتتبع الخطوط إوزّة برّية تتقدّم خطوة خطوة من الشاطئ إلى الصخرة، ثم الهضبة، ثم الشجرة، ثم القمّة، ثم المرتفعات وراءها.";
"hex.54.name" = "الفتاة المُزوَّجة"; "hex.54.full" = "الفتاة المُزوَّجة";
"hex.54.bh" = "رعد فوق بحيرة: صورة أخت صغرى تُزوَّج زوجةً ثانية. تتأمّل الصورة الكبرى في معرفة النهاية من البداية؛ ومن بين الخطوط أعرج يمشي، وأعور يرى، وزواج مؤجَّل، وأكمام عروس أبسط من أكمام وصيفتها.";
"hex.55.name" = "الوفرة"; "hex.55.full" = "الوفرة";
"hex.55.bh" = "الرعد والبرق يصلان معًا: صورة الوفرة في ذروتها. يشبّه الحكم الملك بالشمس في منتصف النهار؛ وتصف الخطوط شمسًا محجوبة حتى تُرى النجوم عند الظهيرة، وبيتًا كبيرًا قائمًا خاليًا.";
"hex.56.name" = "المسافر"; "hex.56.full" = "المسافر";
"hex.56.bh" = "نار على جبل تشتعل ثم تمضي: صورة المسافر. يجيز الحكم الأمور الصغيرة؛ وتصف الخطوط مسافرًا في النُّزُل، مع خدم ومتاع أو بدونهما، وعشّ طائر يحترق بينما يضحك المرتحل أولًا ثم يبكي.";
"hex.57.name" = "اللطيف"; "hex.57.full" = "اللطيف";
"hex.57.bh" = "الريح مضاعفة، تنفذ إلى كل مكان: صورة اللطيف النافذ. يتحدّث الحكم عن تقدّم في الأمور الصغيرة وعن لقاء الرجل العظيم؛ ومن بين الخطوط عرّافون وطاردو أرواح تحت السرير، وطرائد تُصاد لثلاثة أغراض، وثلاثة أيام قبل التغيير وبعده.";
"hex.58.name" = "البهيج"; "hex.58.full" = "البهيج";
"hex.58.bh" = "البحيرة مضاعفة، بحيرتان تغذّي إحداهما الأخرى: صورة البهجة المشتركة. تربطها الصورة الكبرى بأصدقاء يتدارسون ويتمرّنون معًا؛ وتقابل الخطوط بين بهجة متناغمة صادقة وبهجة مطلوبة أو محسوبة أو مغوية.";
"hex.59.name" = "التبدّد"; "hex.59.full" = "التبدّد";
"hex.59.bh" = "ريح تهبّ فوق الماء: صورة تبديد ما هو متصلّب أو منقسم. يشير الحكم إلى الملك يقترب من معبده وإلى عبور الماء العظيم؛ ومن بين الخطوط تبديد الذات، وتبديد الجماعة، وصيحة عظيمة تنتشر كالعرق.";
"hex.60.name" = "التقييد"; "hex.60.full" = "التقييد";
"hex.60.bh" = "ماء فوق بحيرة لا تتّسع إلا لقدر محدود: صورة الحدود والتنظيم. يقول الحكم إن التقييد القاسي المرير لا يدوم؛ وتقابل الخطوط بين عدم الخروج من الفناء، وتقييد يُتقبَّل بيسر، وتقييد مرير.";
"hex.61.name" = "الصدق الباطن"; "hex.61.full" = "الصدق الباطن";
"hex.61.bh" = "ريح فوق بحيرة: صورة صدق باطن يبلغ حتى الخنازير والأسماك. ومن بين الخطوط كركيّ ينادي في الظلّ وصغاره تجيبه، وكأس خمر مشتركة، وحصان يمضي رفيقه في الطقم بعيدًا، وديك يحاول الطيران إلى السماء.";
"hex.62.name" = "غلبة الصغير"; "hex.62.full" = "غلبة الصغير";
"hex.62.bh" = "رعد فوق جبل: صورة غلبة الصغير. يصوّر الحكم طائرًا محلّقًا يُسمع صوته، ويقابل بين الأمور الصغيرة والكبيرة؛ وتُظهر الخطوط طائرًا يحلّق عاليًا أكثر مما ينبغي، والمرور بالجدّ للقاء الجدّة.";
"hex.63.name" = "بعد الإتمام"; "hex.63.full" = "بعد الإتمام";
"hex.63.bh" = "ماء فوق نار، وكل خطّ في موضعه الصحيح: صورة الأشياء المكتملة. يذكر الحكم النظام في البداية والفوضى في النهاية؛ ومن بين الخطوط مكابح على عجلة، وستار عربة مفقود، وثعلب يبتلّ رأسه.";
"hex.64.name" = "قبل الإتمام"; "hex.64.full" = "قبل الإتمام";
"hex.64.bh" = "نار فوق ماء، ولا خطّ في موضعه الصحيح: صورة انتقال لم يكتمل بعد. يصوّر الحكم ثعلبًا صغيرًا كاد يعبر النهر فابتلّ ذيله؛ وتنتقل الخطوط من ذلك العبور غير المكتمل إلى خمر تُشرب بثقة في النهاية.";
