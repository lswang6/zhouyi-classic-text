/* 周易 · ar · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: ar.json */
"hex.1.ci" = "أربع فضائل: الإبداع، والنجاح، والنفع المنسجم، والثبات على الاستقامة.";
"hex.1.daxiang" = "حركة السماء قوية لا تنقطع؛ هكذا يقوّي الرجل النبيل نفسه بلا كلل.";
"hex.1.yao.0" = "التنين كامن تحت الماء؛ لا ينبغي العمل بعد.";
"hex.1.yao.1" = "يظهر التنين في الحقل. ينفع لقاء الرجل العظيم الفاضل.";
"hex.1.yao.2" = "يجدّ الرجل النبيل طوال النهار بلا فتور، ويظل في المساء يقظا حذرا كأنه في خطر. لا لوم.";
"hex.1.yao.3" = "قد يثب التنين صاعدا، وقد يتراجع إلى الغور، بحسب الوقت. لا لوم.";
"hex.1.yao.4" = "التنين يحلّق عاليا في السماء. ينفع لقاء الرجل العظيم الفاضل.";
"hex.1.yao.5" = "ارتفع التنين حتى جاوز الحد؛ يعقبه ندم.";
"hex.2.ci" = "إبداع ونجاح. ينفع الثبات على الاستقامة بلين الفرس الأنثى. إذا قصد الرجل النبيل وجهة، ضلّ إن تقدم، ووجد سيدا إن اتبع؛ وذلك نافع. في الجنوب الغربي يكسب أصدقاء، وفي الشمال الشرقي يفقدهم. الطمأنينة مع الثبات على الاستقامة خير.";
"hex.2.daxiang" = "الأرض لينة واسعة عميقة؛ هكذا يحمل الرجل النبيل الكائنات بفضيلته الراسخة.";
"hex.2.yao.0" = "حين تطأ الصقيع، تعلم أن الجليد الصلب مقبل (مثل لتدارك الشر عند أول بوادره).";
"hex.2.yao.1" = "استقامة وانضباط وسعة؛ كل شيء نافع من غير تكلّف التدرّب.";
"hex.2.yao.2" = "إضمار الفضائل دون إظهارها يتيح الثبات على الاستقامة. وقد يخدم المرء الملك؛ فلا ينسب الإنجاز لنفسه، لكنه يتمّ العمل.";
"hex.2.yao.3" = "شدّ فم الكيس (مثل للصمت والحذر). لا لوم ولا ثناء.";
"hex.2.yao.4" = "لباس سفلي أصفر (الأصفر لون الوسط، واللباس السفلي رمز للاعتدال والتواضع). خير عظيم.";
"hex.2.yao.5" = "تتقاتل التنانين في البرية، ويمتزج في دمها الداكن والأصفر (الداكن المزرق لون السماء، والأصفر لون الأرض؛ رمز لتنازع الين واليانغ وتضرر كليهما).";
"hex.3.ci" = "إبداع ونجاح. ينفع الثبات على الاستقامة. لا تعجل بالمضي؛ ينفع تنصيب الأمراء (رمز لإقامة حاكم وطلب الأعوان).";
"hex.3.daxiang" = "سحاب في الأعلى ورعد في الأسفل: «صعوبة البداية». هكذا يخطط الرجل النبيل لشؤون العالم ويدبرها كمن ينظّم خيوط الحرير.";
"hex.3.yao.0" = "تردد دون تقدم. ينفع البقاء مع الثبات على الاستقامة، وينفع تنصيب الأمراء.";
"hex.3.yao.1" = "عسر وتردد؛ والخيل تدور دون تقدم. القادمون ليسوا لصوصا، بل خاطبون. تحفظ الفتاة استقامتها وترفض الزواج؛ وبعد عشر سنوات تقبل.";
"hex.3.yao.2" = "مطاردة الأيل بلا دليل (المسؤول عن الغابات) لا تفضي إلا إلى الضياع في الغابة. يدرك الرجل النبيل البوادر، فالأولى أن يترك المطاردة؛ والإصرار على المضي يورث الأسف.";
"hex.3.yao.3" = "الخيل تدور دون تقدم. طلب الزواج والمضي إليه خير؛ وكل شيء نافع.";
"hex.3.yao.4" = "تتراكم النعم ويعسر نشرها. الثبات على الاستقامة في صغار الأمور خير، وفي كبارها سوء.";
"hex.3.yao.5" = "الخيل تدور دون تقدم؛ ودموع الدم تنهمر.";
"hex.4.ci" = "نجاح. لست أنا من يطلب الفتى الجاهل، بل هو من يطلبني. أجيبه عند أول استفتاء؛ أما التكرار مرة بعد مرة فاستخفاف، ولا أجيب المستخف. ينفع الثبات على الاستقامة.";
"hex.4.daxiang" = "ينبع الماء من تحت الجبل: «حماقة الشباب». هكذا يحسم الرجل النبيل أفعاله وينمّي فضيلته.";
"hex.4.yao.0" = "لإزالة الجهل ينفع تقويم الناس بالعقوبة، كي يتحرروا من القيود. أما الاستمرار في العقاب بلا انقطاع فيورث الأسف.";
"hex.4.yao.1" = "احتواء الجاهل خير، والزواج خير؛ والابن قادر على تدبير البيت.";
"hex.4.yao.2" = "لا تتزوج مثل هذه المرأة؛ إذا رأت رجلا غنيا أسلمت نفسها له دون تحفظ. لا نفع في ذلك.";
"hex.4.yao.3" = "الوقوع في أسر الجهل يورث الأسف.";
"hex.4.yao.4" = "طلب التعليم ببراءة الطفل خير.";
"hex.4.yao.5" = "صدّ الجهل بشدة. لا ينفع الإفراط كفعل اللصوص؛ وينفع دفع الاعتداء.";
"hex.5.ci" = "صدق في القلب، ونجاح مشرق. الثبات على الاستقامة خير. ينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر).";
"hex.5.daxiang" = "يرتفع السحاب في السماء (منتظرا أوان المطر): «الانتظار». هكذا يأكل الرجل النبيل ويشرب ويحتفل، منتظرا أوانه مطمئنا.";
"hex.5.yao.0" = "الانتظار في الأطراف البعيدة. ينفع الثبات على الدوام؛ لا لوم.";
"hex.5.yao.1" = "الانتظار على الرمل. قليل من الجدال؛ والخاتمة خير.";
"hex.5.yao.2" = "الانتظار في الوحل يجلب اللصوص.";
"hex.5.yao.3" = "الانتظار وسط الدماء (رمز لموضع الأذى)؛ ويمكن الخروج من الحفرة.";
"hex.5.yao.4" = "الانتظار مطمئنا مع الشراب والطعام. الثبات على الاستقامة خير.";
"hex.5.yao.5" = "الوقوع في حفرة. يأتي ثلاثة ضيوف بلا دعوة؛ إكرامهم يجعل الخاتمة خيرا.";
"hex.6.ci" = "صدق تعترضه العوائق. اليقظة والحذر، والتوقف عند الحد المعتدل، خير؛ ومواصلة النزاع حتى النهاية سوء. ينفع لقاء الرجل العظيم الفاضل (طلبا لحكم عادل)، ولا ينفع عبور النهر الكبير.";
"hex.6.daxiang" = "تصعد السماء وينزل الماء، فيسيران في اتجاهين متعاكسين: «النزاع». هكذا يحكم الرجل النبيل تدبير الأمر من بدايته (لمنع الخصام).";
"hex.6.yao.0" = "لا تطل أمد النزاع. قليل من الجدال؛ والخاتمة خير.";
"hex.6.yao.1" = "لا يظفر في النزاع، فيرجع ويحتمي؛ وفي إقطاعه ثلاثمائة أسرة فقط. لا نازلة.";
"hex.6.yao.2" = "الانتفاع بالعطايا والمخصصات القديمة، والثبات على الاستقامة اتقاء للخطر؛ والخاتمة خير. وقد يخدم المرء الملك، فلا ينسب الإنجاز لنفسه.";
"hex.6.yao.3" = "لا يظفر في النزاع، فيرجع إلى الحق، ويغيّر قصده، ويطمئن إلى الثبات على الاستقامة. خير.";
"hex.6.yao.4" = "الفصل في النزاع (بحكم عادل). خير عظيم.";
"hex.6.yao.5" = "قد يُمنح حزاما فاخرا بسبب النزاع، لكنه يُنزع منه ثلاث مرات في يوم واحد.";
"hex.7.ci" = "الثبات على الاستقامة. قيادة شيخ جليل ذي فضيلة خير؛ لا لوم.";
"hex.7.daxiang" = "في باطن الأرض ماء: «الجيش». هكذا يحتضن الرجل النبيل الشعب ويرعاه.";
"hex.7.yao.0" = "يخرج الجيش منضبطا بالقواعد؛ وسوء الانضباط يجلب السوء.";
"hex.7.yao.1" = "قيادة الجيش باعتدال. خير ولا لوم؛ ويكرر الملك أوامر التكريم والمكافأة.";
"hex.7.yao.2" = "قد يعود الجيش حاملا الجثث على العربات. سوء.";
"hex.7.yao.3" = "يتراجع الجيش ويعسكر. لا لوم.";
"hex.7.yao.4" = "في الحقل طرائد (رمز لغزو العدو). ينفع إعلان إدانتها والإمساك بها؛ لا لوم. ليقد الجيش الابن الأكبر؛ فإن تولى أمره صغير عديم الفضيلة، عاد بالجثث، وكان السوء حتى مع الثبات على الاستقامة.";
"hex.7.yao.5" = "يصدر الملك العظيم أمره بمكافأة أهل الفضل: يمنح بعضهم إمارات، وبعضهم بيوت إقطاع لكبار رجال الدولة. لا يولّي الوضيعين.";
"hex.8.ci" = "خير. تأمل أصل معنى الاستفتاء: من اتصف بالإبداع والدوام والثبات على الاستقامة فلا لوم عليه. تأتي البلاد المضطربة لتنضم؛ ومن يتأخر فله سوء.";
"hex.8.daxiang" = "على الأرض ماء (والماء والأرض وثيقا الصلة): «التآزر». هكذا أقام الملوك الأوائل البلاد وتقربوا إلى الأمراء.";
"hex.8.yao.0" = "التآزر مع الآخرين بصدق؛ لا لوم. يفيض الصدق كما تفيض الخمر من جرة فخارية؛ وفي النهاية يأتي كسب غير متوقع. خير.";
"hex.8.yao.1" = "التآزر النابع من القلب. الثبات على الاستقامة خير.";
"hex.8.yao.2" = "التآزر مع من لا يستحقه.";
"hex.8.yao.3" = "التآزر مع الفاضل من خارج الدائرة. الثبات على الاستقامة خير.";
"hex.8.yao.4" = "التآزر مع الناس بوضوح ونزاهة. يدفع الملك الطرائد من ثلاث جهات ويترك جهة مفتوحة، فتفلت الطرائد أمامه. ولا يحتاج أهل البلدة إلى الحذر بعضهم من بعض. خير.";
"hex.8.yao.5" = "التأخر عن المبادرة إلى التآزر (وقيل: افتقاره إلى بداية حسنة). سوء.";
"hex.9.ci" = "نجاح. سحب كثيفة بلا مطر، تصعد من ضواحينا الغربية.";
"hex.9.daxiang" = "تهب الريح في السماء: «ترويض الصغير». هكذا يهذب الرجل النبيل ثقافته وفضيلته.";
"hex.9.yao.0" = "العودة إلى الطريق القويم؛ فأي لوم في ذلك؟ خير.";
"hex.9.yao.1" = "الرجوع إلى الطريق القويم مع الآخرين مسترشدا بهم. خير.";
"hex.9.yao.2" = "تسقط أسلاك عجلة العربة؛ ويتنافر الزوجان.";
"hex.9.yao.3" = "صدق في القلب؛ فتزول المحن وينقشع الخوف. لا لوم.";
"hex.9.yao.4" = "صدق يجمع الناس؛ ورخاء يشترك فيه الجيران.";
"hex.9.yao.5" = "نزل المطر واستقرت قوة اليانغ بعد كبحها، بفضل تعظيم الفضيلة وتراكمها. حتى ثبات المرأة على الاستقامة فيه خطر. القمر يكاد يكتمل (رمز لازدياد الين حتى ينازع اليانغ)؛ وخروج الرجل النبيل في حملة سوء.";
"hex.10.ci" = "وطء ذيل الببر دون أن يعضّ. نجاح.";
"hex.10.daxiang" = "السماء فوق والبحيرة تحت: «الخطو الحذر». هكذا يميّز الرجل النبيل مراتب الأعلى والأدنى، ويطمئن قلوب الشعب.";
"hex.10.yao.0" = "السير على السجية البسيطة. لا لوم في المضي.";
"hex.10.yao.1" = "الطريق مستو واسع؛ وثبات المعتزل الهادئ على الاستقامة خير.";
"hex.10.yao.2" = "ضعيف البصر يحسب أنه يرى بوضوح، والأعرج يحسب أنه يستطيع السفر بعيدا. يطأ ذيل الببر فيعضّه؛ سوء. كمثل محارب يتوهم أنه أهل للملك.";
"hex.10.yao.3" = "وطء ذيل الببر مع الخوف والحذر؛ والخاتمة خير.";
"hex.10.yao.4" = "التصرف بحزم وصلابة؛ وفيه خطر حتى مع الثبات على الاستقامة.";
"hex.10.yao.5" = "راجع الطريق الذي سلكته، وتأمل دلائل الخير والشر فيه؛ فإن تمّ على وجه سليم، فخير عظيم.";
"hex.11.ci" = "يذهب الصغير ويأتي العظيم (ينصرف الين ويقبل اليانغ). خير ونجاح.";
"hex.11.daxiang" = "تتواصل السماء والأرض: «السلام». هكذا ينظم الحاكم الأمور وفق سننهما، ويساعد ما يلائم إنماءهما للحياة، ليعين الشعب.";
"hex.11.yao.0" = "اقتلاع العشب يجرّ جذوره المتشابكة؛ والخروج مع أمثالك خير.";
"hex.11.yao.1" = "احتواء المهمل، والجرأة على خوض النهر، وعدم إغفال الفضلاء البعيدين، واجتناب التحزب للمصلحة الخاصة؛ بذلك ينال المرء التقدير باتباع طريق الاعتدال.";
"hex.11.yao.2" = "لا استواء بلا انحدار، ولا ذهاب بلا إياب. الثبات على الاستقامة في الشدائد لا لوم فيه. لا تقلق بشأن ثقة الناس؛ فلك نصيب من الرزق والنعمة.";
"hex.11.yao.3" = "هبوط خفيف رشيق؛ والتآلف مع الجيران دون الاستناد إلى الثروة، والتعامل بصدق دون تحاذر.";
"hex.11.yao.4" = "دي يي (ملك من أسرة شانغ) يزوّج أخته الصغرى؛ فينال البركة. خير عظيم.";
"hex.11.yao.5" = "ينهار سور المدينة في خندقها. لا تستخدم الجيش؛ أصدر الأوامر في مدينتك. حتى مع الثبات على الاستقامة يبقى الأسف.";
"hex.12.ci" = "الانسداد يخالف النظام الإنساني السوي (وقيل: إن الوضيعين هم سبب زمن الركود). لا يواتي ثبات الرجل النبيل على الاستقامة. يذهب العظيم ويأتي الصغير (ينصرف اليانغ ويقبل الين).";
"hex.12.daxiang" = "لا تتواصل السماء والأرض: «الركود». هكذا يكتم الرجل النبيل فضيلته اتقاء للبلاء؛ ولا يغريه المجد ولا المنصب وراتبه.";
"hex.12.yao.0" = "اقتلاع العشب يجرّ جذوره المتشابكة؛ والثبات على الاستقامة مع أمثالك خير ونجاح.";
"hex.12.yao.1" = "احتواء الأعلى مرتبة وطاعته خير للوضيع؛ أما الرجل العظيم الفاضل فينجح بتحمل الركود في ثبات.";
"hex.12.yao.2" = "إضمار العار.";
"hex.12.yao.3" = "امتثال أمر السماء لا لوم فيه؛ ويلتحق الأمثال بعضهم ببعض ويتقاسمون النعمة.";
"hex.12.yao.4" = "إيقاف الركود خير للرجل العظيم الفاضل. اليقظة الدائمة: «الهلاك قريب، الهلاك قريب!» تجعل الثبات كالتوثق بجذور توت متكاثفة.";
"hex.12.yao.5" = "قلب الركود وإزالته؛ ركود أولا، ثم فرح.";
"hex.13.ci" = "الائتلاف مع الناس في البرية الواسعة نجاح. ينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر)، وينفع ثبات الرجل النبيل على الاستقامة.";
"hex.13.daxiang" = "السماء والنار متآلفتان: «الرفقة مع الناس». هكذا يميّز الرجل النبيل فئات الناس وأنواع الأشياء، طالبا المشترك ومدركا الفروق.";
"hex.13.yao.0" = "الائتلاف مع الناس بمجرد الخروج من باب الدار. لا لوم.";
"hex.13.yao.1" = "قصر الائتلاف على العشيرة يورث الأسف.";
"hex.13.yao.2" = "إخفاء الجنود في الأحراش، وصعود تل مرتفع للترقب؛ وثلاث سنوات دون جرأة على القتال.";
"hex.13.yao.3" = "صعود سور الخصم، ثم الامتناع عن الهجوم. خير.";
"hex.13.yao.4" = "الائتلاف مع الناس: بكاء ونحيب أولا، ثم ضحك. يتيح انتصار الجيش الكبير اللقاء.";
"hex.13.yao.5" = "الائتلاف مع الناس في الضواحي القريبة؛ لا ندم (وإن لم يبلغ الائتلاف الواسع في البرية).";
"hex.14.ci" = "نجاح عظيم.";
"hex.14.daxiang" = "النار فوق السماء تضيء الجميع: «الامتلاك العظيم». هكذا يكبح الرجل النبيل الشر ويشيد بالخير، ممتثلا أمر السماء الحسن.";
"hex.14.yao.0" = "اجتناب الصلة بما يضر يمنع اللوم؛ والتيقظ الدائم للمشقة لا لوم فيه.";
"hex.14.yao.1" = "عربة كبيرة تحمل المتاع؛ والمضي إلى وجهة لا لوم فيه.";
"hex.14.yao.2" = "يقدّم الأمير الهدايا والجزية لابن السماء (وقيل: يحضر مأدبته)؛ ولا يقدر الوضيع على ذلك.";
"hex.14.yao.3" = "عدم المبالغة في التباهي بالعظمة. لا لوم.";
"hex.14.yao.4" = "التعامل بصدق مع الأعلى والأدنى، مع الحفاظ على الهيبة. خير.";
"hex.14.yao.5" = "عناية من السماء. خير، وكل شيء نافع.";
"hex.15.ci" = "نجاح؛ ويبلغ الرجل النبيل خاتمة حسنة.";
"hex.15.daxiang" = "في الأرض جبل: «التواضع». هكذا ينقص الرجل النبيل من الكثير ويزيد القليل، ويزن الأشياء ليعدل في العطاء.";
"hex.15.yao.0" = "الرجل النبيل المتواضع غاية التواضع يستطيع بذلك عبور النهر الكبير (رمز لاجتياز الأخطار وإنجاز الأمر). خير.";
"hex.15.yao.1" = "يشتهر التواضع بعيدا؛ والثبات على الاستقامة خير.";
"hex.15.yao.2" = "الرجل النبيل المتواضع مع ما له من مآثر، خاتمته خير.";
"hex.15.yao.3" = "كل شيء نافع. إظهار فضيلة التواضع (أي ممارستها وتنميتها).";
"hex.15.yao.4" = "استمالة الجيران دون الاتكال على الثروة. ينفع قتال العصاة؛ وكل شيء نافع.";
"hex.15.yao.5" = "يشتهر التواضع بعيدا. ينفع تحريك الجيش لإخضاع المدن والبلاد (التابعة للمرء نفسه).";
"hex.16.ci" = "ينفع تنصيب الأمراء وإخراج الجيش للقتال.";
"hex.16.daxiang" = "ينبعث الرعد بقوة من الأرض: «الحماس». هكذا أنشأ الملوك الأوائل الموسيقى وعظّموا الفضيلة، وقدموا القرابين الجليلة للحاكم الأعلى، وأشركوا أسلافهم في التكريم.";
"hex.16.yao.0" = "التباهي بالفرح والرضا عن النفس بسبب الحظوة. سوء.";
"hex.16.yao.1" = "ثبات كالصخر؛ وإدراك الفرصة والعمل قبل انقضاء اليوم. الثبات على الاستقامة خير.";
"hex.16.yao.2" = "التطلع إلى الأعلى والتملق طلبا للراحة يورث الندم؛ والتأخر في الإفاقة يورث ندما آخر.";
"hex.16.yao.3" = "به ينعم الناس بالسرور؛ ومكسبه عظيم. لا ترتب؛ يجتمع الأصدقاء كما يجمع دبوس الشعر الخصل.";
"hex.16.yao.4" = "ثبات على الاستقامة مع مرض، لكنه لا يفضي إلى الموت طويلا.";
"hex.16.yao.5" = "الغرق في المتعة حتى الغفلة؛ فإن حدث التغيير فلا لوم.";
"hex.17.ci" = "نجاح عظيم. ينفع الثبات على الاستقامة؛ لا لوم.";
"hex.17.daxiang" = "في البحيرة رعد (محتجب فيها ليستريح): «الاتّباع». هكذا يدخل الرجل النبيل بيته عند اقتراب المساء ليستريح.";
"hex.17.yao.0" = "يتغير الأمر الذي يتولاه المرء (وقيل: تتغير أفكاره). الثبات على الاستقامة خير؛ والخروج لمخالطة الناس مثمر.";
"hex.17.yao.1" = "التعلق بالفتى يفقدك الرجل الناضج.";
"hex.17.yao.2" = "التعلق بالرجل الناضج يفقدك الفتى. بالاتّباع يُنال المطلوب؛ وينفع الاستقرار مع الثبات على الاستقامة.";
"hex.17.yao.3" = "في الاتّباع مكاسب كثيرة، لكن فيه سوءا حتى مع الثبات على الاستقامة. فإذا كان القلب صادقا، والسلوك قويما، والفهم واضحا، فأي لوم؟";
"hex.17.yao.4" = "الصدق مع أهل الخير والفضيلة. خير.";
"hex.17.yao.5" = "يُقبض عليه ويُوثق، ثم يُشد بالحبال ليتبع. ويقيم الملك قربانا في الجبل الغربي (جبل تشي).";
"hex.18.ci" = "نجاح عظيم. ينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر). قبل يوم جيا بثلاثة أيام (يوم شين) يكون التدبير المسبق، وبعده بثلاثة أيام (يوم دينغ) تكون المراجعة والتأمل.";
"hex.18.daxiang" = "تحت الجبل ريح: «إصلاح الفاسد». هكذا ينهض الرجل النبيل بالشعب ويعينه وينمّي الفضيلة.";
"hex.18.yao.0" = "إصلاح الفساد الذي خلّفه الأب. بمثل هذا الابن لا لوم على الأب الراحل. ثمة خطر، لكن الخاتمة خير.";
"hex.18.yao.1" = "إصلاح الفساد الذي خلّفته الأم. لا تفرط في الصلابة والعناد (بل تلطّف).";
"hex.18.yao.2" = "إصلاح الفساد الذي خلّفه الأب. ندم قليل، ولا لوم كبير.";
"hex.18.yao.3" = "التساهل مع الفساد الذي خلّفه الأب؛ والاستمرار يورث الأسف.";
"hex.18.yao.4" = "إصلاح الفساد الذي خلّفه الأب يكسب الثناء.";
"hex.18.yao.5" = "عدم خدمة الملوك والأمراء، وتعظيم المقصد والسلوك الشخصي.";
"hex.19.ci" = "نجاح عظيم. ينفع الثبات على الاستقامة. عند حلول الشهر الثامن يكون السوء.";
"hex.19.daxiang" = "فوق البحيرة أرض: «الاقتراب». هكذا لا ينفد فكر الرجل النبيل في تعليم الشعب، ولا حد لاحتضانه وحمايته.";
"hex.19.yao.0" = "الاقتراب من الشعب بالتأثير المهذب (المعنى هنا: التأثير). الثبات على الاستقامة خير.";
"hex.19.yao.1" = "الاقتراب من الشعب بالتأثير المهذب. خير، وكل شيء نافع.";
"hex.19.yao.2" = "الاقتراب من الشعب بالكلام المعسول لا نفع فيه؛ فإذا أقلقك ذلك فأصلحته، فلا لوم.";
"hex.19.yao.3" = "الاقتراب من الشعب شخصيا وبلا واسطة. لا لوم.";
"hex.19.yao.4" = "الاقتراب من الشعب بالحكمة، وهو ما يليق بالملك العظيم. خير.";
"hex.19.yao.5" = "الاقتراب من الشعب بفضيلة راسخة وسخاء. خير ولا لوم.";
"hex.20.ci" = "في القربان، بعد غسل اليدين وسكب الخمر، وقبل تقديم القرابين (لحظة أشد الوقار): صدق في القلب وهيئة مهيبة تبعث الإجلال.";
"hex.20.daxiang" = "تهب الريح فوق الأرض: «التأمّل». هكذا جاب الملوك الأوائل الأقاليم، وتفقدوا أحوال الشعب، وأقاموا التعليم والتهذيب.";
"hex.20.yao.0" = "نظر سطحي كنظر الطفل؛ لا لوم فيه على الوضيع، وفيه أسف للرجل النبيل.";
"hex.20.yao.1" = "التطلع من شق الباب. ينفع ثبات المرأة على الاستقامة.";
"hex.20.yao.2" = "تأمل أفعالك لتقرر التقدم أو التراجع.";
"hex.20.yao.3" = "مشاهدة بهاء البلاد وحسن حكمها. ينفع المثول ضيفا أمام الملك (للخدمة والمعاونة).";
"hex.20.yao.4" = "تأمل أفعالك؛ لا لوم على الرجل النبيل.";
"hex.20.yao.5" = "تأمل أفعال الآخرين (وقيل: أن يتأمل الآخرون أفعالك). لا لوم على الرجل النبيل.";
"hex.21.ci" = "نجاح. ينفع اللجوء إلى القضاء والعقوبات.";
"hex.21.daxiang" = "يتلاقى الرعد والبرق: «العضّ النافذ». هكذا أوضح الملوك الأوائل العقوبات وأحكموا القوانين.";
"hex.21.yao.0" = "قيد خشبي في القدمين يغطي الأصابع. لا لوم (عقوبة صغيرة تردع عن شر كبير).";
"hex.21.yao.1" = "عضّ اللحم الطري حتى يغوص فيه الأنف. لا لوم.";
"hex.21.yao.2" = "عضّ لحم مقدد صلب والعثور على سمّ. أسف قليل، ولا لوم.";
"hex.21.yao.3" = "عضّ لحم جاف ذي عظم والعثور على نصل سهم معدني (رمز للصلابة والاستقامة). ينفع الثبات على الاستقامة في المشقة. خير.";
"hex.21.yao.4" = "عضّ لحم جاف والعثور على ذهب (رمز للاعتدال والصلابة). الثبات على الاستقامة اتقاء للخطر؛ لا لوم.";
"hex.21.yao.5" = "حمل قيد خشبي على الكتفين يغطي الأذنين. سوء.";
"hex.22.ci" = "نجاح. في المضي نفع قليل.";
"hex.22.daxiang" = "تحت الجبل نار (نورها محدود): «الزينة». هكذا يوضح الرجل النبيل شؤون الحكم، ولا يجرؤ على التسرع في الفصل في الخصومات.";
"hex.22.yao.0" = "تزيين أصابع القدم، وترك العربة والسير على الأقدام.";
"hex.22.yao.1" = "تزيين اللحية.";
"hex.22.yao.2" = "زينة جميلة نضرة لامعة؛ والثبات الدائم على الاستقامة خير.";
"hex.22.yao.3" = "زينة بيضاء بسيطة، وخيل بيضاء تعدو كأنها تطير. القادمون ليسوا لصوصا، بل خاطبون.";
"hex.22.yao.4" = "تزيين التلال والبساتين (رمز لتقدير الفاضل البسيط). حزمة الحرير المتواضعة قليلة؛ ثمة أسف، لكن الخاتمة خير.";
"hex.22.yao.5" = "البياض البسيط زينة. لا لوم.";
"hex.23.ci" = "لا ينفع المضي إلى وجهة.";
"hex.23.daxiang" = "الجبل يستند إلى الأرض: «التفكّك». هكذا يحسن أهل المراتب العليا إلى من دونهم، ليستقر المسكن.";
"hex.23.yao.0" = "يتآكل السرير بدءا بقوائمه؛ وتُهدم الاستقامة. سوء.";
"hex.23.yao.1" = "يبلغ تآكل السرير موضع اتصال هيكله بقوائمه (أي إطار السرير)؛ وتُهدم الاستقامة. سوء.";
"hex.23.yao.2" = "في زمن التساقط (مع الانفراد بالصلة بخط اليانغ الأعلى). لا لوم.";
"hex.23.yao.3" = "بلغ تآكل السرير جلد النائم. سوء.";
"hex.23.yao.4" = "قيادة قوى الين تباعا كالسمك المنظوم في خيط، ونيل حظوة الملك كنساء القصر. كل شيء نافع.";
"hex.23.yao.5" = "ثمرة كبيرة لم تؤكل. ينال الرجل النبيل عربة (تأييد الشعب)، أما الوضيع فيهدم مسكنه.";
"hex.24.ci" = "نجاح. خروج ودخول بلا مرض، ومجيء الأصدقاء بلا لوم. للذهاب والإياب دورة منتظمة؛ بعد سبعة أيام تكون العودة. ينفع المضي إلى وجهة.";
"hex.24.daxiang" = "الرعد في باطن الأرض: «العودة». هكذا أغلق الملوك الأوائل المعابر يوم الانقلاب الشتوي؛ فلا يسافر التجار والمسافرون، ولا يجوب الحاكم الأقاليم.";
"hex.24.yao.0" = "العودة إلى الطريق القويم قبل الابتعاد كثيرا. لا ندم كبير؛ خير عظيم.";
"hex.24.yao.1" = "عودة حسنة إلى الطريق القويم. خير.";
"hex.24.yao.2" = "تكرار العودة إلى الطريق القويم (وقيل: العودة بوجه عابس من القلق). ثمة خطر، لكن لا لوم.";
"hex.24.yao.3" = "السير بين قوى الين والعودة منفردا إلى الطريق القويم.";
"hex.24.yao.4" = "العودة إلى الطريق القويم بقلب مخلص راسخ. لا ندم.";
"hex.24.yao.5" = "الضلال وعدم معرفة العودة. سوء ونوازل. إن خرج الجيش، انتهى إلى هزيمة كبرى يصيب سوؤها الملك أيضا، فلا يستطيع الخروج للقتال عشر سنوات.";
"hex.25.ci" = "نجاح عظيم. ينفع الثبات على الاستقامة. من حاد عنها أصابته نازلة؛ ولا ينفع المضي.";
"hex.25.daxiang" = "يسير الرعد تحت السماء، فلا تجرؤ الكائنات على الطيش. هكذا اجتهد الملوك الأوائل في موافقة أوقات السماء ورعاية الكائنات.";
"hex.25.yao.0" = "اجتناب التصرف الطائش؛ والمضي خير.";
"hex.25.yao.1" = "الحرث دون التطلع إلى الحصاد، واستصلاح البور دون ترقب الحقل المعمور (اتباع الطبيعة دون استباق النتائج). عندئذ ينفع المضي.";
"hex.25.yao.2" = "نازلة غير متوقعة: ربط أحدهم بقرة، فأخذها عابر سبيل، ووقع ضرر الشبهة على أهل البلدة.";
"hex.25.yao.3" = "يمكن الثبات على الاستقامة؛ لا لوم.";
"hex.25.yao.4" = "مرض لم ينشأ عن الطيش؛ فلا حاجة إلى دواء، ويأتي الشفاء والفرح.";
"hex.25.yao.5" = "مع اجتناب الطيش، يجلب التحرك نازلة (إذ بلغ الوقت نهايته). لا نفع في شيء.";
"hex.26.ci" = "ينفع الثبات على الاستقامة. تناول الطعام خارج البيت (من رزق البلاط) خير. ينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر).";
"hex.26.daxiang" = "السماء في الجبل: «ترويض العظيم». هكذا يكثر الرجل النبيل من تعلّم أقوال الفضلاء وأفعال الحكماء السابقين، لينمّي فضيلته.";
"hex.26.yao.0" = "ثمة خطر؛ والتوقف نافع.";
"hex.26.yao.1" = "ينفصل صندوق العربة عن كتلة تثبيته فوق المحور (قطعة الربط)، فلا يمكن التقدم.";
"hex.26.yao.2" = "خيول أصيلة تتسابق. ينفع الثبات على الاستقامة في المشقة. التمرن يوميا على قيادة العربة والدفاع؛ وينفع المضي.";
"hex.26.yao.3" = "ربط خشبة عرضية بقرني العجل (حاجز واق) كي لا ينطح الناس. خير عظيم.";
"hex.26.yao.4" = "أنياب الخنزير المخصي باقية، لكنها لا تؤذي الناس. خير.";
"hex.26.yao.5" = "ما أوسع طريق السماء! نجاح. (وقيل إن اللفظ «هه» يُقرأ بمعنى «يحمل»، أي تحمّل طريق السماء.)";
"hex.27.ci" = "الثبات على الاستقامة خير. تأمل طريق التغذية، وكيف يطلب المرء طعامه بنفسه.";
"hex.27.daxiang" = "تحت الجبل رعد: «التغذية». هكذا يحذر الرجل النبيل في كلامه ويعتدل في طعامه وشرابه.";
"hex.27.yao.0" = "تترك مزيتك الشبيهة بالسلحفاة العجيبة (التي تغذي نفسها دون طعام)، وتنظر إليّ أشداقي تتحرك بالأكل فتشتهي. سوء.";
"hex.27.yao.1" = "طلب الغذاء من الأدنى بعكس النظام المعتاد، ثم طلبه من التل العالي (خط اليانغ الأعلى). المضي سوء.";
"hex.27.yao.2" = "مخالفة الطريق القويم للتغذية. سوء حتى مع الثبات على الاستقامة؛ عشر سنوات دون إمكان العمل، ولا نفع في شيء.";
"hex.27.yao.3" = "طلب الغذاء من الأدنى (لإطعام العالم) خير. نظر مركز إلى الأسفل كنظر الببر، وسعي لا يتوقف. لا لوم.";
"hex.27.yao.4" = "مخالفة النظام المعتاد (بالاعتماد على غذاء خط اليانغ الأعلى). الاستقرار والثبات على الاستقامة خير. لا تعبر النهر الكبير (لا تلائم المخاطرة).";
"hex.27.yao.5" = "يعتمد العالم عليه في التغذية. خطر، لكنه خير. ينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر).";
"hex.28.ci" = "تنحني عارضة السقف. ينفع المضي؛ نجاح.";
"hex.28.daxiang" = "ماء البحيرة يغمر الأشجار: «غلبة العظيم». هكذا يقف الرجل النبيل وحده بلا خوف، ويعتزل العالم بلا ضيق.";
"hex.28.yao.0" = "فرش عشب أبيض نظيف (تحت القرابين). لا لوم.";
"hex.28.yao.1" = "حور ذابل ينبت براعم جديدة، وشيخ يتزوج شابة. كل شيء نافع.";
"hex.28.yao.2" = "تنحني عارضة السقف. سوء.";
"hex.28.yao.3" = "ترتفع عارضة السقف (متينة لا تنحني). خير؛ وإن كانت هناك تعلقات أخرى، فأسف.";
"hex.28.yao.4" = "حور ذابل يزهر، وعجوز تتزوج شابا. لا لوم ولا ثناء.";
"hex.28.yao.5" = "التوغل في الماء عند العبور حتى يغمر الرأس. سوء، لكن لا لوم (إذ لا يُلام من يعمل من أجل الحق).";
"hex.29.ci" = "مخاطر متتابعة، وصدق في القلب. ما دام القلب سالكا إلى النجاح، نال العمل التقدير.";
"hex.29.daxiang" = "الماء يأتي متتابعا: «الهاوية». هكذا يديم الرجل النبيل فضيلته، ويكرر التمرن على شؤون الحكم والتعليم.";
"hex.29.yao.0" = "وسط مخاطر متتابعة، سقوط آخر في قاع الحفرة. سوء.";
"hex.29.yao.1" = "في الهاوية خطر باق؛ فلا يُطلب إلا مكسب قليل.";
"hex.29.yao.2" = "في الإقبال والإدبار مهاو؛ خطر أمامك ولا سند مأمون خلفك. سقوط في قاع الحفرة؛ لا مجال للعمل.";
"hex.29.yao.3" = "إناء خمر ووعاءان من الأرز في أوان فخارية؛ وتقديم علامة بسيطة للثقة من النافذة (رمز للرابطة الصادقة). لا لوم في النهاية.";
"hex.29.yao.4" = "لم يفض ماء الحفرة، لكنه بلغ مستوى الضفة (اللفظ «تشي» يُفسر بـ«دي»، أي ربوة صغيرة؛ وقيل معناه «فقط»). لا لوم.";
"hex.29.yao.5" = "توثيق بالحبال وحبس بين الشوك؛ وثلاث سنوات بلا خلاص. سوء.";
"hex.30.ci" = "ينفع الثبات على الاستقامة؛ نجاح. تربية بقرة (رمز لفضيلة اللين) خير.";
"hex.30.daxiang" = "نور يطلع مرتين متتابعتين: «المتشبّث». هكذا يواصل الرجل العظيم الفاضل إنارة الجهات الأربع.";
"hex.30.yao.0" = "خطوات متداخلة مضطربة؛ ومع الاحترام والحذر لا لوم.";
"hex.30.yao.1" = "نور التعلق الأصفر (الأصفر لون الوسط). خير عظيم.";
"hex.30.yao.2" = "ضياء الشمس المائلة للغروب. إن لم تضرب الجرة وتغنّ (لتفرح في أوانك)، لم يبق إلا تنهّد الشيخوخة. سوء.";
"hex.30.yao.3" = "مجيء مفاجئ كحريق، يعقبه موت ونبذ.";
"hex.30.yao.4" = "دموع غزيرة، وحزن وتنهّد. خير.";
"hex.30.yao.5" = "يرسله الملك في حملة فيحقق مأثرة حسنة: يقطع رأس زعيم العدو، ولا يأسر عموم أتباعه (يعاقب رأس الشر وحده). لا لوم.";
"hex.31.ci" = "نجاح. ينفع الثبات على الاستقامة، والزواج خير. (التأثير المتبادل هو التجاوب، وصورته انجذاب الفتى والفتاة.)";
"hex.31.daxiang" = "على الجبل بحيرة (يستوعبها الجبل بتجويفه): «التأثير المتبادل». هكذا يتقبل الرجل النبيل الآخرين بقلب منفتح.";
"hex.31.yao.0" = "يبدأ التجاوب في إصبع القدم الكبير. (بداية ضعيفة، لكن القصد اتجه إلى الخارج.)";
"hex.31.yao.1" = "التجاوب في ربلة الساق. الحركة الطائشة المتعجلة سوء؛ والبقاء ساكنا خير.";
"hex.31.yao.2" = "التجاوب في الفخذ. الإصرار على الحركة تبعا للآخرين يجعل المضي مورثا للأسف.";
"hex.31.yao.3" = "الثبات على الاستقامة خير، والندم يزول. إن اضطرب القلب وكثر ذهابه وإيابه، لم يتبع فكرك إلا الأصدقاء المشابهون لك. (تجاوب ضيق غير شامل.)";
"hex.31.yao.4" = "التجاوب في عضلات الظهر؛ لا ندم. (المقصود لحم الظهر: لا يبلغ التجاوب القلب؛ وقيل إنه ضعيف سطحي.)";
"hex.31.yao.5" = "التجاوب في اللثة والخدين واللسان. (تأثير بالكلام وحده.)";
"hex.32.ci" = "نجاح ولا لوم. ينفع الثبات على الاستقامة، وينفع المضي. (الدوام هو الاستمرار الطويل.)";
"hex.32.daxiang" = "الرعد والريح متلازمان: «الدوام». هكذا يثبت الرجل النبيل على الاستقامة، ولا يغيّر وجهته بسهولة.";
"hex.32.yao.0" = "طلب الدوام بإفراط منذ البداية (كالحفر العميق). سوء حتى مع الثبات على الاستقامة؛ ولا نفع في شيء.";
"hex.32.yao.1" = "يزول الندم. (خط اليانغ الثاني في موضع لين، لكنه في الوسط، فيستطيع دوام اتباع الاعتدال.)";
"hex.32.yao.2" = "عدم دوام الفضيلة يعرّض المرء للعار؛ وحتى مع الثبات على الاستقامة يبقى الأسف.";
"hex.32.yao.3" = "صيد بلا طرائد. (رمز لطول البقاء في موضع غير مناسب، وجهد بلا ثمرة.)";
"hex.32.yao.4" = "دوام فضيلة (اللين) والثبات على الاستقامة؛ خير للمرأة وسوء للرجل.";
"hex.32.yao.5" = "طلب الدوام بتقلب واضطراب (حركة لا تهدأ). سوء.";
"hex.33.ci" = "نجاح (بالانسحاب). في صغار الأمور ينفع الثبات على الاستقامة. (الانسحاب هو التراجع اتقاء للخطر.)";
"hex.33.daxiang" = "تحت السماء جبل (مهما علا بقيت السماء بعيدة عنه): «الانسحاب». هكذا يبتعد الرجل النبيل عن الوضيعين، بلا إظهار بغض ومع الوقار والحزم.";
"hex.33.yao.0" = "التأخر في الانسحاب (في مؤخرته) خطر؛ لا ينفع المضي.";
"hex.33.yao.1" = "توثيق محكم بسير من جلد بقرة صفراء، لا يقدر أحد على فكه. (رمز لثبات العزم؛ وقيل لاستبقاء الفاضل.)";
"hex.33.yao.2" = "تعلق يمنع الانسحاب، كالمرض، وفيه خطر. إيواء الخدم والجواري خير.";
"hex.33.yao.3" = "الانسحاب بحزم رغم التعلق. خير للرجل النبيل، ولا يقدر عليه الوضيع.";
"hex.33.yao.4" = "انسحاب حسن في أوانه. الثبات على الاستقامة خير.";
"hex.33.yao.5" = "انسحاب هادئ رحب (اللفظ يعني السعة؛ وقيل: التحليق عاليا والابتعاد). كل شيء نافع.";
"hex.34.ci" = "ينفع الثبات على الاستقامة. («قوة العظيم» هي اشتداد قوة اليانغ الصلبة.)";
"hex.34.daxiang" = "الرعد فوق السماء (قوي مهيب): «قوة العظيم». هكذا لا يقدم الرجل النبيل على ما يخالف آداب السلوك.";
"hex.34.yao.0" = "القوة في أصابع القدم (عجلة إلى التقدم). الخروج للقتال سوء محقق. (الصدق هنا بمعنى اليقين.)";
"hex.34.yao.1" = "الثبات على الاستقامة خير.";
"hex.34.yao.2" = "يتكل الوضيع على القوة، ولا يفعل الرجل النبيل ذلك (اللفظ يفيد النفي؛ وقيل: استعمال الشبكة). حتى مع الثبات على الاستقامة ثمة خطر. ينطح الكبش السياج فتعلق قرناه.";
"hex.34.yao.3" = "الثبات على الاستقامة خير، والندم يزول. ينفتح السياج ولا تعلق القرون؛ والقوة في مثبت محور العربة الكبيرة. (قطعة تصل المحور بالصندوق، ترمز إلى المتانة التي تتيح حمل الأثقال والتقدم.)";
"hex.34.yao.4" = "فقدان الكبش دون انتباه في موضع سهل. لا ندم. (وقيل إن اللفظ يعني حدّ الحقل.)";
"hex.34.yao.5" = "ينطح الكبش السياج، فلا يستطيع التراجع ولا التقدم. لا نفع في شيء؛ وإدراك المشقة والثبات على الاستقامة خير.";
"hex.35.ci" = "يُمنح الأمير كانغ (أمير يحفظ سلام البلاد؛ وقيل: كانغ شو، أخو الملك وو من أسرة تشو) خيولا وعربات كثيرة، ويستقبله الملك ثلاث مرات في يوم واحد. («التقدّم» يعني الارتقاء.)";
"hex.35.daxiang" = "يطلع النور فوق الأرض: «التقدّم». هكذا يُظهر الرجل النبيل فضيلته المضيئة بنفسه.";
"hex.35.yao.0" = "سعي إلى التقدم يعترضه الصدّ. الثبات على الاستقامة خير. إن لم تُكتسب الثقة، فالهدوء ورحابة الصدر لا لوم فيهما.";
"hex.35.yao.1" = "سعي إلى التقدم مع الحزن. الثبات على الاستقامة خير. تأتي بركة عظيمة من الجدة. (الجدة ترمز إلى المقام الرفيع لخط الين الخامس.)";
"hex.35.yao.2" = "يثق الجميع ويوافقون؛ فيزول الندم.";
"hex.35.yao.3" = "ارتقاء كالقارض (جشع وجبان). خطر حتى مع الثبات على الاستقامة.";
"hex.35.yao.4" = "يزول الندم. لا تقلق بشأن الربح والخسارة. المضي خير، وكل شيء نافع.";
"hex.35.yao.5" = "بلوغ طرف القرن في الارتقاء (أقصى الحد). لا يصلح إلا لإخضاع مدينتك (إخماد فتنة داخلية). خطر، لكنه خير ولا لوم؛ ومع الثبات على الاستقامة يبقى الأسف.";
"hex.36.ci" = "ينفع الثبات على الاستقامة في المشقة. («إظلام النور» هو إصابة النور بالأذى.)";
"hex.36.daxiang" = "يغيب النور في باطن الأرض: «إظلام النور». هكذا يحكم الرجل النبيل الناس، مظهرا الغموض وحافظا البصيرة في داخله.";
"hex.36.yao.0" = "طيران في زمن أذى النور بأجنحة متدلية. يعجل الرجل النبيل بالرحيل، فلا يجد وقتا للطعام ثلاثة أيام. حيث يمضي يلقى لوم المضيف.";
"hex.36.yao.1" = "أذى النور: إصابة في الفخذ اليسرى؛ والاستعانة بحصان قوي للنجاة خير.";
"hex.36.yao.2" = "حملة إلى الجنوب في زمن أذى النور، وأسر رأس الشر. لا تتعجل تقويم (المفاسد المتراكمة)، بل تدرّج.";
"hex.36.yao.3" = "الدخول في يسار البطن (التوغل إلى الداخل)، ومعرفة خفايا أذى النور، ثم الخروج من الدار (الرحيل).";
"hex.36.yao.4" = "أذى النور كما عند جي تسي (عمّ ملك ين تشو، الذي تظاهر بالجنون ليتقي البلاء). ينفع الثبات على الاستقامة.";
"hex.36.yao.5" = "ظلام بدل الإشراق؛ صعود إلى السماء أولا، ثم سقوط تحت الأرض.";
"hex.37.ci" = "ينفع ثبات المرأة على الاستقامة. («العائلة» هي طريق تدبير البيت.)";
"hex.37.daxiang" = "تنشأ الريح من النار (من الداخل إلى الخارج): «العائلة». هكذا يكون كلام الرجل النبيل ذا مضمون ثابت، ويكون فعله مستمرا.";
"hex.37.yao.0" = "إقامة قواعد البيت منذ البداية (للوقاية). يزول الندم.";
"hex.37.yao.1" = "عدم الاستبداد بالرأي، وتولي الطعام في البيت (شؤونه الداخلية). الثبات على الاستقامة خير.";
"hex.37.yao.2" = "حكم البيت بصرامة يثير تذمر أهله (أصوات الشدة). رغم الندم والخطر، فالخاتمة خير. أما إفراط النساء والأطفال في اللهو والضحك، فعاقبته الأسف.";
"hex.37.yao.3" = "إغناء البيت. خير عظيم.";
"hex.37.yao.4" = "يؤثر الملك في بيته بفضيلته (يبلغ القلوب ويهذبها). لا تقلق؛ خير.";
"hex.37.yao.5" = "صدق في القلب مع هيبة؛ والخاتمة خير.";
"hex.38.ci" = "في صغار الأمور خير. («التعارض» هو التباعد والتدابر.)";
"hex.38.daxiang" = "النار فوق والبحيرة تحت (طبيعتاهما متعاكستان): «التعارض». هكذا يطلب الرجل النبيل الاتفاق في الأصول مع إبقاء الفروق الصغيرة.";
"hex.38.yao.0" = "يزول الندم. لا تطارد الحصان الضائع؛ سيعود بنفسه. لقاء الشرير (دون رفض مقابلته) لا لوم فيه.";
"hex.38.yao.1" = "لقاء السيد في زقاق. لا لوم.";
"hex.38.yao.2" = "رؤية العربة تُسحب إلى الخلف، وثورها يُعاق، وسائقها يُعاقب بوشم الجبهة (عقوبة تيان) وقطع الأنف (عقوبة يي). بداية متعثرة، وخاتمة حسنة.";
"hex.38.yao.3" = "تباعد ووحدة، ثم لقاء رجل قوي ناضج (خط اليانغ الأول)، وتواصل بصدق متبادل. خطر، لكن لا لوم.";
"hex.38.yao.4" = "يزول الندم. يسهل الائتلاف مع القريب (خط اليانغ الثاني) كعضّ اللحم الطري؛ فأي لوم في المضي؟";
"hex.38.yao.5" = "تباعد ووحدة. (الشك يولد الأوهام.) يُخيّل إليه خنزير مغطى بالوحل، وعربة مليئة بالأشباح. يشدّ القوس أولا ثم يرخيها؛ فالقادمون ليسوا لصوصا، بل خاطبون. المضي ولقاء المطر (انسجام الين واليانغ) خير.";
"hex.39.ci" = "ينفع الجنوب الغربي (الأرض السهلة)، ولا ينفع الشمال الشرقي (الأرض الوعرة الخطرة). ينفع لقاء الرجل العظيم الفاضل؛ والثبات على الاستقامة خير. («العائق» هو مشقة السير.)";
"hex.39.daxiang" = "على الجبل ماء (عوائق متتابعة): «العائق». هكذا يراجع الرجل النبيل نفسه ويهذب فضيلته.";
"hex.39.yao.0" = "المضي يلقى المشقة، والرجوع يكسب الثناء.";
"hex.39.yao.1" = "يخوض خادم الملك المشقات المتكررة (ساعيا إلى النجدة)، لا من أجل نفسه.";
"hex.39.yao.2" = "المضي يلقى المشقة، فيكون الرجوع (إلى خطي الين في الأسفل).";
"hex.39.yao.3" = "المضي يلقى المشقة، والرجوع يجمع الناس.";
"hex.39.yao.4" = "في المحنة الكبرى يأتي الأصدقاء للعون.";
"hex.39.yao.5" = "المضي يلقى المشقة، والرجوع يتيح إنجازا عظيما. خير؛ وينفع لقاء الرجل العظيم الفاضل.";
"hex.40.ci" = "ينفع الجنوب الغربي. إن لم يبق أمر يحتاج إلى حل، فالعودة إلى الموضع الأول خير. وإن كان ثمة مقصد، فالمبادرة المبكرة خير. («الانفراج» هو زوال الخطر والمحنة.)";
"hex.40.daxiang" = "يهب الرعد والمطر: «الانفراج». هكذا يعفو الرجل النبيل عن الزلات ويسامح في الجرائم.";
"hex.40.yao.0" = "لا لوم.";
"hex.40.yao.1" = "صيد ثلاثة ثعالب، والحصول على سهم أصفر. الثبات على الاستقامة خير. (الثعالب رمز للوضيعين، والسهم الأصفر للاعتدال والاستقامة.)";
"hex.40.yao.2" = "حمل المتاع على الظهر مع ركوب العربة (وضيع يستولي على مقام رفيع) يجلب اللصوص. حتى مع الثبات على الاستقامة يبقى الأسف.";
"hex.40.yao.3" = "تحرير إصبع القدم الكبير (التخلص من الوضيع المتعلق بك)؛ فيأتي الأصدقاء ويتعاملون بصدق.";
"hex.40.yao.4" = "يستطيع الرجل النبيل إزالة المحنة. خير؛ وانسحاب الوضيعين دليل ذلك. (الصدق هنا بمعنى التحقق؛ وقيل: اكتساب ثقة الوضيعين.)";
"hex.40.yao.5" = "يرمي الأمير صقرا على سور عال فيصيبه. كل شيء نافع.";
"hex.41.ci" = "صدق في القلب؛ خير عظيم ولا لوم. يمكن الثبات على الاستقامة، وينفع المضي. بماذا يكون القربان؟ يكفي طعام بسيط في وعاءين من نوع غوي (وعاء لحبوب الدخن). («النقصان» هو التقليل.)";
"hex.41.daxiang" = "تحت الجبل بحيرة (تنقص لتزيد علوه): «النقصان». هكذا يكظم الرجل النبيل غضبه ويكبح رغباته.";
"hex.41.yao.0" = "أتمّ عملك ثم أسرع (لمساعدة غيرك). لا لوم؛ لكن قدّر مقدار ما تنقصه من نصيبك.";
"hex.41.yao.1" = "ينفع الثبات على الاستقامة؛ والخروج للقتال سوء. يمكن زيادة نصيب غيرك دون إنقاص نفسك.";
"hex.41.yao.2" = "إن سار ثلاثة معا نقص منهم واحد؛ وإن سار واحد وحده وجد رفيقه.";
"hex.41.yao.3" = "تقليل العلة والإسراع بتحسنها يجلب الفرح. لا لوم.";
"hex.41.yao.4" = "يزيده أحدهم؛ وحتى سلحفاة نفيسة قيمتها عشرة بنغ (وحدة نقدية قديمة) لا تخالف ذلك (فالاستفتاءات كلها مواتية). خير عظيم.";
"hex.41.yao.5" = "زيادة الغير دون إنقاص النفس. لا لوم؛ والثبات على الاستقامة خير، والمضي نافع. نيل رعايا ينضمون من أنحاء العالم (دون الاقتصار على بيت واحد).";
"hex.42.ci" = "ينفع المضي، وينفع عبور النهر الكبير (رمز للمخاطرة لإنجاز أمر). («الزيادة» هي الإضافة.)";
"hex.42.daxiang" = "الريح والرعد يتعاونان: «الزيادة». هكذا يقتدي الرجل النبيل بالخير إذا رآه، ويصلح خطأه إذا وقع فيه.";
"hex.42.yao.0" = "ينفع القيام بعمل عظيم. خير عظيم ولا لوم.";
"hex.42.yao.1" = "يزيده أحدهم، ولا تخالف ذلك حتى سلحفاة نفيسة قيمتها عشرة بنغ. الثبات الدائم على الاستقامة خير. يستعين به الملك لتقديم القربان لحاكم السماء. خير.";
"hex.42.yao.2" = "استخدام الزيادة في إغاثة المنكوبين. لا لوم. بصدق واعتدال واستقامة، يُرفع الأمر إلى الأمير مع حمل صولجان اليشم.";
"hex.42.yao.3" = "التصرف باعتدال واستقامة، ورفع الأمر إلى الأمير فيقبله. ينفع نقل العاصمة بالاعتماد (على الأعلى مرتبة).";
"hex.42.yao.4" = "صدق في القلب وإحسان إلى الناس؛ لا حاجة للسؤال، فذلك خير عظيم. يذكر العالم إحساني بامتنان صادق.";
"hex.42.yao.5" = "لا يزيده أحد، بل يهاجمه بعضهم. لا ثبات في القصد؛ سوء.";
"hex.43.ci" = "إعلان (جرائم الوضيعين) في بلاط الملك، ونداء الناس بصدق. يبقى الخطر (فلتكن اليقظة). ابدأ بتحذير مدينتك. لا ينفع اللجوء فورا إلى السلاح؛ وينفع المضي. («الحسم» هو الفصل والإزالة.)";
"hex.43.daxiang" = "يرتفع ماء البحيرة إلى السماء (ليهبط مطرا): «الحسم». هكذا يوزع الرجل النبيل العطايا على الشعب؛ واحتباس النعم دون بذلها يجلب الكراهية.";
"hex.43.yao.0" = "القوة في أصابع القدم المتقدمة. المضي دون نصر يصير موضع لوم.";
"hex.43.yao.1" = "نداء يقظ متحذر؛ فلا قلق حتى إن هاجم العدو ليلا.";
"hex.43.yao.2" = "القوة تظهر في عظام الوجنتين (غضب باد على الوجه)، وفيها سوء. يمضي الرجل النبيل بحزم منفردا، فيلقى المطر ويبتل ويثير الاستياء؛ ولا لوم (في النهاية).";
"hex.43.yao.3" = "الأليتان بلا جلد، والمشي عسير (تردد دون تقدم أو تراجع). إن سار كالكبش المقود (مع القطيع)، زال الندم؛ لكنه يسمع القول ولا يصدقه.";
"hex.43.yao.4" = "إزالة حاسمة كاقتلاع شيان لو (عشب لين هش سريع النمو). اتباع طريق الاعتدال لا لوم فيه.";
"hex.43.yao.5" = "لا جدوى من النداء (لا أحد ينقذ). في النهاية سوء.";
"hex.44.ci" = "المرأة مفرطة القوة؛ لا تتزوج مثلها. («اللقاء» هو الالتقاء.)";
"hex.44.daxiang" = "تحت السماء ريح (تهب على الكائنات كلها): «اللقاء». هكذا يصدر الحاكم أوامره ويعلنها في الجهات الأربع.";
"hex.44.yao.0" = "الربط بمكبح عربة معدني متين (ني). الثبات على الاستقامة خير؛ والمضي يلقى السوء، كخنزيرة هزيلة لا بد أن تضطرب. (رمز لقوة الين اللينة، حديثة النشأة والمضطربة.)";
"hex.44.yao.1" = "في اللفافة سمك (اللفظ يعني اللفافة؛ وقيل: المطبخ). لا لوم، لكنه لا يصلح (لتقديمه) إلى الضيوف.";
"hex.44.yao.2" = "الأليتان بلا جلد، والمشي عسير. ثمة خطر، لكن لا لوم كبير.";
"hex.44.yao.3" = "لا سمك في اللفافة؛ والنهوض للعمل سوء.";
"hex.44.yao.4" = "تغطية البطيخ بأغصان شجرة تشي وأوراقها (حماية الأعلى للأدنى). فضيلة مضمرة، وبركة تنزل من السماء.";
"hex.44.yao.5" = "لقاء عند طرف القرن (أقصى الحد). أسف، لكن لا لوم.";
"hex.45.ci" = "نجاح. يأتي الملك إلى معبد الأسلاف للقربان. ينفع لقاء الرجل العظيم الفاضل؛ نجاح، وينفع الثبات على الاستقامة. تقديم ماشية كبيرة قربانا خير، والمضي نافع. («التجمّع» هو الاجتماع.)";
"hex.45.daxiang" = "يتجمع ماء البحيرة فوق الأرض: «التجمّع». هكذا يصلح الرجل النبيل السلاح ويتأهب للطوارئ.";
"hex.45.yao.0" = "صدق لا يدوم حتى النهاية، فيضطرب القلب ويجتمع بلا هدى. إن نادى طالبا التجاوب، كفت مصافحة لتحويل الدمع إلى ضحك. لا تقلق؛ لا لوم في المضي.";
"hex.45.yao.1" = "الانجذاب إلى الاجتماع خير ولا لوم. مع صدق القلب ينفع حتى قربان يويه البسيط (قربان الصيف).";
"hex.45.yao.2" = "طلب الاجتماع مع التنهّد المتواصل لا نفع فيه. لا لوم في المضي، وإنما أسف قليل.";
"hex.45.yao.3" = "خير عظيم، وبه وحده ينتفي اللوم.";
"hex.45.yao.4" = "المقام الرفيع عند الاجتماع لا لوم فيه. إن بقي من لا يثق، فالتمسك بالخير العظيم والثبات الدائم على الاستقامة يزيلان الندم.";
"hex.45.yao.5" = "تنهّد وبكاء (دموع من العين وسيلان من الأنف). لا لوم.";
"hex.46.ci" = "نجاح عظيم. يحسن لقاء الرجل العظيم الفاضل. لا تقلق؛ والخروج جنوبا خير. («الصعود» هو الارتفاع.)";
"hex.46.daxiang" = "تنمو شجرة من باطن الأرض: «الصعود». هكذا يتبع الرجل النبيل الفضيلة، ويجمع صغار الحسنات حتى يبلغ العظمة.";
"hex.46.yao.0" = "صعود بفضل الثقة. خير عظيم. (اللفظ يعني الثقة؛ وقيل: التقدم.)";
"hex.46.yao.1" = "مع صدق القلب ينفع حتى قربان يويه البسيط. لا لوم.";
"hex.46.yao.2" = "الصعود إلى مدينة خالية (بلا عائق).";
"hex.46.yao.3" = "يقدم الملك القربان على جبل تشي (موطن نشأة قوة تشو). خير ولا لوم.";
"hex.46.yao.4" = "الثبات على الاستقامة خير؛ والصعود على الدرج.";
"hex.46.yao.5" = "الإمعان في الصعود وسط الغفلة. ينفع توجيه ذلك إلى الثبات على الاستقامة بلا انقطاع.";
"hex.47.ci" = "نجاح وثبات على الاستقامة؛ خير للرجل العظيم الفاضل ولا لوم. كلام يقال ولا يُصدّق. («الضيق» هو العسر والفاقة.)";
"hex.47.daxiang" = "البحيرة بلا ماء: «الضيق». هكذا يبذل الرجل النبيل حياته ليحقق مقصده.";
"hex.47.yao.0" = "ضيق الأليتين على جذع مقطوع؛ ودخول واد مظلم عميق، وثلاث سنوات دون رؤية أحد.";
"hex.47.yao.1" = "ضيق في الخمر والطعام (وقيل: نقصهما). يوشك أن يأتي صاحب مئزر الركبتين القرمزي (وجيه). ينفع تقديم القربان؛ والخروج للقتال سوء، ولا لوم.";
"hex.47.yao.2" = "حصار بالحجر واتكاء على الشوك؛ وعودة إلى البيت دون رؤية الزوجة. سوء.";
"hex.47.yao.3" = "مجيء بطيء، تعوقه عربة مزينة بالمعدن (خط اليانغ الثاني). أسف، لكن للأمر نهاية.";
"hex.47.yao.4" = "قطع الأنف والقدمين (رمز للضيق من الأعلى والأسفل)، وضيق يسببه صاحب مئزر الركبتين الأحمر. ثم يأتي الخلاص تدريجيا؛ وينفع تقديم القربان.";
"hex.47.yao.5" = "ضيق في تشابك الكروم، ومقام متزعزع. يراجع نفسه قائلا: «إن تحركت ندمت». فإن صدق ندمه، كان الخروج خيرا.";
"hex.48.ci" = "يمكن نقل المدينة ولا تنتقل البئر معها. لا ينقص ماؤها بالسحب ولا يزيد بتركه؛ والناس يأتون ويذهبون ليستقوا منها. يكاد الإناء يبلغ الفوهة، لكنه ينكسر قبل خروجه. سوء.";
"hex.48.daxiang" = "يدخل الدلو الخشبي الماء ويرفعه: «البئر». هكذا يواسي الرجل النبيل الشعب في تعبه، ويحث الناس على التعاون.";
"hex.48.yao.0" = "قاع البئر مليء بالطين، فلا يصلح ماؤها للشرب. البئر القديمة المهجورة لا تأتيها حتى الطيور لتشرب.";
"hex.48.yao.1" = "في منخفض قاع البئر لا يمكن إلا رمي السمك الصغير (وقيل: العلجوم)، وإناء السحب قديم يسرّب الماء؛ فلا تؤدي البئر وظيفتها.";
"hex.48.yao.2" = "نُظفت البئر ولا يشرب منها أحد؛ فيحزن قلبي. يمكن سحب مائها؛ ولو كان الملك مستنيرا، لنال الأعلى والأدنى بركتها معا.";
"hex.48.yao.3" = "ترميم جدران البئر بالآجر والحجر. لا لوم.";
"hex.48.yao.4" = "ماء البئر صاف؛ وماء النبع البارد صالح للشرب.";
"hex.48.yao.5" = "سُحب ماء البئر؛ لا تغطّ فوهتها (ليستقي الجميع). صدق في القلب وخير عظيم.";
"hex.49.ci" = "لا تُكتسب الثقة إلا في يوم جي (وقيل: بعد اكتمال التغيير). نجاح عظيم، وينفع الثبات على الاستقامة؛ ويزول الندم.";
"hex.49.daxiang" = "في البحيرة نار: «الثورة». هكذا يراجع الرجل النبيل التقويم ويوضح مواعيد الفصول.";
"hex.49.yao.0" = "التوثيق بإحكام بجلد بقرة صفراء (رمز للتمسك بالاعتدال واللين، دون حركة طائشة).";
"hex.49.yao.1" = "في يوم جي يبدأ التغيير. التقدم خير ولا لوم.";
"hex.49.yao.2" = "العجلة في التقدم سوء، والجمود خطر. حين تُناقش أقوال التغيير ثلاثا ويُحسم الرأي، تُكتسب الثقة.";
"hex.49.yao.3" = "يزول الندم. تغيير أمر السماء بصدق (إصلاح النظام القديم) خير.";
"hex.49.yao.4" = "يُحدث الرجل العظيم الفاضل التغيير كببر يبدل كساءه فتتجدد نقوشه. تُكتسب الثقة حتى قبل الاستفتاء.";
"hex.49.yao.5" = "يتغير الرجل النبيل كنمر أرقط يبدل كساءه، ويغير الوضيع مظهره خضوعا للنظام الجديد. مزيد من الاندفاع سوء؛ والاستقرار والثبات على الاستقامة خير.";
"hex.50.ci" = "خير عظيم ونجاح.";
"hex.50.daxiang" = "النار تشتعل فوق الخشب: «القِدر». هكذا يصحح الرجل النبيل موضعه ويحفظ مهمته بثبات.";
"hex.50.yao.0" = "قلب القِدر حتى تعلو قوائمه يتيح إفراغ الأوساخ المتراكمة؛ كمثل اتخاذ جارية طلبا للولد. لا لوم.";
"hex.50.yao.1" = "القِدر ملآن بالطعام. قريني (وقيل: عدوي) مريض، فلا يستطيع الاقتراب مني. خير.";
"hex.50.yao.2" = "تتلف أذنا القِدر ويتعذر نقله، فلا يؤكل حساء التدرج الدسم. حين ينسجم الين واليانغ وينزل المطر، يقل الندم؛ والخاتمة خير.";
"hex.50.yao.3" = "تنكسر قائمة القِدر وينقلب طعام الأمير، ويتلطخ القِدر رطبا (وقيل: عقوبة شديدة). سوء.";
"hex.50.yao.4" = "للقِدر أذنان صفراوان وعارضة حمل معدنية. ينفع الثبات على الاستقامة.";
"hex.50.yao.5" = "للقِدر عارضة حمل من اليشم. خير عظيم، وكل شيء نافع.";
"hex.51.ci" = "نجاح. يأتي الرعد فيبعث الخوف والتلفت، ثم يعقبه كلام وضحك مطمئنان. يهز الرعد مائة لي، لكن القائم بالقربان لا يسقط الملعقة والخمر العطرية من يده (ملعقة القرابين وخمر الطقس المعطرة).";
"hex.51.daxiang" = "رعد يتلوه رعد: «المُثير». هكذا يخشى الرجل النبيل، ويهذب نفسه ويراجعها.";
"hex.51.yao.0" = "يأتي الرعد فيبعث الخوف والاضطراب، ثم يعقبه كلام وضحك مطمئنان. خير.";
"hex.51.yao.1" = "يأتي الرعد شديدا وفيه خطر؛ ويُتوقع فقد المال (الأصداف، وهي نقد قديم). الاحتماء بالتلال العالية. لا تطارد المفقود؛ يعود بعد سبعة أيام.";
"hex.51.yao.2" = "يرجّ الرعد النفس ويقلقها؛ والتحرك بيقظة وخشية يمنع النازلة.";
"hex.51.yao.3" = "يهز الرعد، لكن المرء يغوص في الوحل (عاجزا عن النهوض).";
"hex.51.yao.4" = "الرعد يجيء ويذهب والخطر قائم. لكن لا يُتوقع فقد، ويمكن حفظ العمل المطلوب (وقيل: شؤون القربان).";
"hex.51.yao.5" = "يرجّ الرعد النفس ويرعب النظر. المضي سوء. التأهب حين يصيب الرعد الجار، قبل أن يصيبك، لا لوم فيه؛ لكن في أمر الزواج أقاويل.";
"hex.52.ci" = "إسكان الظهر (دون الانجذاب لما تراه العين)، ونسيان الذات. السير في الفناء دون أن يرى بعضهم بعضا. لا لوم.";
"hex.52.daxiang" = "جبل فوق جبل: «السكون». هكذا لا يتجاوز فكر الرجل النبيل حدود منصبه.";
"hex.52.yao.0" = "إسكان أصابع القدم. لا لوم؛ وينفع الثبات الدائم على الاستقامة.";
"hex.52.yao.1" = "إسكان ربلة الساق، مع العجز عن إنقاذ من تتبعه (عن منعه من الطيش). القلب غير راض.";
"hex.52.yao.2" = "إسكان الخصر حتى يتيبس الظهر كأنه انقطع قسمين؛ وخطر يحرق القلب كالدخان والنار.";
"hex.52.yao.3" = "إسكان الجذع. لا لوم.";
"hex.52.yao.4" = "ضبط الفم والخدين، وانتظام الكلام. يزول الندم.";
"hex.52.yao.5" = "السكون بفضيلة راسخة صادقة. خير.";
"hex.53.ci" = "زواج الفتاة وفق الآداب والتدرج خير؛ وينفع الثبات على الاستقامة.";
"hex.53.daxiang" = "تنمو الأشجار على الجبل: «التطوّر التدريجي». هكذا يراكم الرجل النبيل الفضيلة ويحسن العادات.";
"hex.53.yao.0" = "الإوز البري يتقدم تدريجيا إلى الضفة. خطر على الشاب ولوم بالكلام، لكن لا لوم عليه.";
"hex.53.yao.1" = "الإوز البري يتقدم تدريجيا إلى صخرة كبيرة. طعام وشراب في هناء وطمأنينة. خير.";
"hex.53.yao.2" = "الإوز البري يتقدم تدريجيا إلى أرض مرتفعة مستوية. يخرج الزوج للقتال ولا يعود، وتحمل الزوجة ولا تلد. سوء؛ وينفع صدّ الغزاة.";
"hex.53.yao.3" = "الإوز البري يتقدم تدريجيا إلى الشجرة؛ وقد يجد غصنا مستويا يأوي إليه. لا لوم.";
"hex.53.yao.4" = "الإوز البري يتقدم تدريجيا إلى التل. لا تحمل الزوجة ثلاث سنوات، لكن لا شيء يغلب الطريق القويم في النهاية. خير.";
"hex.53.yao.5" = "الإوز البري يرتفع تدريجيا إلى العلو (وقيل: طريق السحاب). يصلح ريشه لزينة الطقوس. خير.";
"hex.54.ci" = "زواج الفتاة (خلافا للآداب الصحيحة). المضي سوء، ولا نفع في شيء.";
"hex.54.daxiang" = "فوق البحيرة رعد: «الفتاة المُزوَّجة». هكذا يطلب الرجل النبيل الدوام وحسن الختام، ويستشرف ما قد يظهر من خلل.";
"hex.54.yao.0" = "تتزوج الفتاة بصفتها الأخت الصغرى المرافقة للعروس، كالأعرج الذي يستطيع السير. المضي خير.";
"hex.54.yao.1" = "كمثل ذي العين الواحدة الذي يرى. ينفع ثبات المعتزل على الاستقامة.";
"hex.54.yao.2" = "تنتظر الفتاة الزواج معتدة بمكانتها (وقيل إن اللفظ يعني الأخت الكبرى أو الجارية الوضيعة)، ثم لا تتزوج إلا بصفتها الأخت الصغرى المرافقة للعروس.";
"hex.54.yao.3" = "تتأخر الفتاة عن موعد زواجها؛ وتأخرها انتظار للأوان المناسب.";
"hex.54.yao.4" = "دي يي (ملك من أسرة شانغ) يزوّج أخته الصغرى. لباسها بصفتها الزوجة الرئيسية أقل زينة من لباس مرافقتها. القمر يكاد يكتمل (دون بلوغ التمام). خير.";
"hex.54.yao.5" = "تحمل المرأة سلة خيزران فارغة، ويذبح الرجل شاة بلا دم (لا يتم القربان). لا نفع في شيء.";
"hex.55.ci" = "نجاح. يبلغ الملك هذه الوفرة العظيمة. لا تقلق؛ يحسن أن يضيء العالم كشمس الظهيرة.";
"hex.55.daxiang" = "يأتي الرعد والبرق معا: «الوفرة». هكذا يفصل الرجل النبيل في القضايا وينفذ العقوبات.";
"hex.55.yao.0" = "لقاء سيد يوافقك؛ لا لوم حتى مع تساويكما، والمضي يجلب التقدير.";
"hex.55.yao.1" = "حصير الحجب عظيم، حتى تُرى نجوم المغرفة الشمالية عند الظهيرة. المضي يلقى الشك والبغض؛ والتأثير في الآخر بصدق خير.";
"hex.55.yao.2" = "ستار الحجب عظيم، حتى تُرى النجوم الصغيرة عند الظهيرة. كسر الذراع اليمنى؛ لا لوم.";
"hex.55.yao.3" = "حصير الحجب عظيم، حتى تُرى نجوم المغرفة الشمالية عند الظهيرة. لقاء سيد مماثل في الفضيلة خير.";
"hex.55.yao.4" = "استقدام أهل الموهبة يجلب البهجة والثناء. خير.";
"hex.55.yao.5" = "بيت عظيم، لكنه محجوب تماما. النظر من بابه يكشف سكونا بلا أحد؛ وثلاث سنوات لا يُرى فيها إنسان. سوء.";
"hex.56.ci" = "نجاح قليل. ثبات المسافر في غربته على الاستقامة خير.";
"hex.56.daxiang" = "على الجبل نار: «المسافر». هكذا يتبصر الرجل النبيل ويحذر في العقاب، ولا يطيل أمد القضايا والحبس.";
"hex.56.yao.0" = "تصرف المسافر بخسة ودناءة يجلب له البلاء بيده.";
"hex.56.yao.1" = "يأوي المسافر إلى نزل، ويحفظ ماله معه، وينال خادما شابا وفيا.";
"hex.56.yao.2" = "يحترق نزل المسافر ويفقد خادمه الشاب. البقاء على هذا الحال خطر.";
"hex.56.yao.3" = "يجد المسافر مأوى مؤقتا ومالا وفأسا (وقيل: زاد الطريق ونفقته)، لكن قلبي غير راض.";
"hex.56.yao.4" = "رمي طائر التدرج وفقدان سهم واحد؛ وفي النهاية ثناء وتولية رتبة.";
"hex.56.yao.5" = "يحترق عش الطائر. يضحك المسافر أولا ثم ينتحب. يفقد بقرته عند الحدود (وقيل: في بلاد يو يي، أو بسبب الغفلة). سوء.";
"hex.57.ci" = "نجاح قليل. ينفع المضي، وينفع لقاء الرجل العظيم الفاضل الرفيع المقام.";
"hex.57.daxiang" = "ريح تتلوها ريح: «اللطيف». هكذا يوضح الرجل النبيل الأوامر وينفذ شؤون الحكم.";
"hex.57.yao.0" = "تردد بين التقدم والتراجع؛ وينفع الحزم والثبات على الاستقامة كالمحارب.";
"hex.57.yao.1" = "انحناء متواضع تحت السرير، والاستعانة بالكهنة والوسطاء الروحيين لتكرار إظهار الصدق للأرواح. خير ولا لوم.";
"hex.57.yao.2" = "تكرار إظهار الطاعة على مضض. أسف.";
"hex.57.yao.3" = "يزول الندم. صيد طرائد من ثلاثة أصناف (للقرابين، وللضيوف، وللمطبخ).";
"hex.57.yao.4" = "الثبات على الاستقامة خير، والندم يزول؛ وكل شيء نافع. بداية متعثرة وخاتمة حسنة. إصدار الأمر قبل يوم غنغ بثلاثة أيام، وفحص أثره بعده بثلاثة أيام. خير.";
"hex.57.yao.5" = "إفراط في التواضع تحت السرير، وفقدان المال والفأس (رمز لفقد الحزم والسند). الإصرار على ذلك سوء.";
"hex.58.ci" = "نجاح. ينفع الثبات على الاستقامة.";
"hex.58.daxiang" = "بحيرتان متصلتان: «البهيج». هكذا يناقش الرجل النبيل العلم ويدرس المبادئ مع الأصدقاء.";
"hex.58.yao.0" = "إدخال السرور على الناس بروح مسالمة. خير.";
"hex.58.yao.1" = "إدخال السرور بالصدق. خير، والندم يزول.";
"hex.58.yao.2" = "الإقبال طلبا للسرور (بالتملق والاسترضاء). سوء.";
"hex.58.yao.3" = "التردد فيمن ينبغي إرضاؤه يزعج القلب؛ وقطع أسباب الشر يجلب الفرح.";
"hex.58.yao.4" = "الثقة بالوضيعين الذين يقوّضون قوة اليانغ خطر.";
"hex.58.yao.5" = "إغراء الآخرين بطلب السرور معا.";
"hex.59.ci" = "نجاح. يأتي الملك إلى معبد الأسلاف للقربان (لجمع القلوب المتفرقة). ينفع عبور النهر الكبير، وينفع الثبات على الاستقامة.";
"hex.59.daxiang" = "تهب الريح فوق الماء: «التبدّد». هكذا قدم الملوك الأوائل القرابين للحاكم الأعلى، وأقاموا معابد الأسلاف (لجمع القلوب).";
"hex.59.yao.0" = "الاستعانة بحصان قوي للنجاة. خير.";
"hex.59.yao.1" = "الإسراع زمن التشتت إلى منضدة يمكن الاتكاء عليها (رمز لنيل السند). يزول الندم.";
"hex.59.yao.2" = "تبديد الأنانية في النفس. لا ندم.";
"hex.59.yao.3" = "تفريق التكتلات الخاصة خير عظيم. من التفرق ينشأ جمع كالتل؛ وهو ما لا يخطر للناس العاديين.";
"hex.59.yao.4" = "إطلاق أمر عظيم زمن التشتت كما يخرج العرق من الجسد، وتوزيع مدخرات الملك (وقيل: استقرار الملك في موضعه الصحيح لجمع القلوب). لا لوم.";
"hex.59.yao.5" = "إزالة أذى الدماء والابتعاد عنه. لا لوم.";
"hex.60.ci" = "نجاح. لا يصح دوام التقييد المفرط في القسوة.";
"hex.60.daxiang" = "فوق البحيرة ماء: «التقييد». هكذا يضع الرجل النبيل قواعد الآداب والمقاييس، وينظر في الفضائل والأفعال.";
"hex.60.yao.0" = "عدم الخروج من الفناء الداخلي. لا لوم.";
"hex.60.yao.1" = "عدم الخروج من الفناء الخارجي (حين ينبغي الخروج). سوء.";
"hex.60.yao.2" = "ترك الاعتدال يجلب التنهّد والندم؛ فمن يُلام؟ (وقيل: إن تأوه وندم على نفسه، فلا لوم.)";
"hex.60.yao.3" = "التزام الاعتدال بطمأنينة. نجاح.";
"hex.60.yao.4" = "تقييد لطيف معتدل. خير؛ والمضي يجلب التقدير.";
"hex.60.yao.5" = "تقييد مفرط القسوة. الاستمرار فيه سوء؛ لكن التوبة والتصحيح يزيلان الندم.";
"hex.61.ci" = "يبلغ أثر الصدق الخنازير الصغيرة والسمك (حتى أحقر الكائنات وأصغرها). خير؛ وينفع عبور النهر الكبير، وينفع الثبات على الاستقامة.";
"hex.61.daxiang" = "فوق البحيرة ريح: «الصدق الباطن». هكذا يتأنى الرجل النبيل في بحث القضايا، ويتمهل في أحكام الموت.";
"hex.61.yao.0" = "الطمأنينة إلى أداء الواجب (وقيل: التقدير والاستعداد) خير؛ وطلب غيره يمنع السكينة.";
"hex.61.yao.1" = "ينادي الكركي في ظل الشجر فتجيبه أمثاله. عندي خمر طيبة، أشاركك شربها ومتعتها.";
"hex.61.yao.2" = "لقاء خصم: تارة قرع الطبل والهجوم، وتارة التوقف عن القتال؛ تارة بكاء وتارة غناء.";
"hex.61.yao.3" = "القمر يكاد يكتمل، والحصان يفقد قرينه. لا لوم.";
"hex.61.yao.4" = "صدق في القلب يربط الناس بإحكام. لا لوم.";
"hex.61.yao.5" = "صياح الديك يصعد إلى السماء (شهرة تتجاوز الحقيقة). الإصرار على ذلك سوء.";
"hex.62.ci" = "نجاح. ينفع الثبات على الاستقامة. تصلح صغار الأمور، ولا تصلح كبارها. يترك الطائر المحلق صوته (يبلغ الأسفل). لا يلائم التحليق عاليا، بل النزول للاستقرار. خير عظيم.";
"hex.62.daxiang" = "فوق الجبل رعد: «غلبة الصغير». هكذا يزيد الرجل النبيل قليلا في احترامه، وفي حزنه عند المآتم، وفي اقتصاده في الإنفاق.";
"hex.62.yao.0" = "الطائر المحلق (يرفض البقاء منخفضا ويجاهد للصعود) يجلب السوء لنفسه.";
"hex.62.yao.1" = "تجاوز الجد ولقاء الجدة؛ وعدم تجاوز الحاكم ولقاء خادمه. لا لوم.";
"hex.62.yao.2" = "رفض المبالغة في الحذر، وترك الأمر مع الاتّباع، قد يجلب الأذى. سوء.";
"hex.62.yao.3" = "لا لوم. يمكن اللقاء دون إفراط في الصلابة. المضي خطر يوجب الحذر؛ ولا يصح الجمود الطويل.";
"hex.62.yao.4" = "سحب كثيفة بلا مطر تأتي من ضواحينا الغربية. يصطاد الأمير بسهم ذي حبل الطريدة المختبئة في الحفرة.";
"hex.62.yao.5" = "لا يتحقق اللقاء، بل يحدث تجاوز للحد، كطائر يقع في الشبكة. سوء؛ وتلك هي النازلة.";
"hex.63.ci" = "نجاح، ونجاح في صغار الأمور. ينفع الثبات على الاستقامة؛ خير في البداية، واضطراب في النهاية.";
"hex.63.daxiang" = "الماء فوق النار: «بعد الإتمام». هكذا يفكر الرجل النبيل في الأخطار المحتملة ويحتاط لها مسبقا.";
"hex.63.yao.0" = "كبح العجلة (لمنع اندفاع العربة)، وابتلال ذيل الثعلب عند العبور. لا لوم.";
"hex.63.yao.1" = "تفقد المرأة ستار عربتها. لا تطارده؛ يعود بعد سبعة أيام.";
"hex.63.yao.2" = "حارب غاوزونغ (وو دينغ، ملك شانغ) غوي فانغ (قبيلة شمالية)، ولم يخضعها إلا بعد ثلاث سنوات. لا يولّى الوضيعون.";
"hex.63.yao.3" = "الثياب الفاخرة تصير خرقا (وقيل: إعداد الخرق لسد تسرب القارب). اليقظة طوال اليوم.";
"hex.63.yao.4" = "يذبح الجار الشرقي بقرة في قربان عظيم؛ لكن قربان يويه البسيط عند الجار الغربي (قربان صيفي متواضع) أجدى في نيل البركة حقا.";
"hex.63.yao.5" = "ابتلال الرأس عند العبور. خطر.";
"hex.64.ci" = "نجاح. يكاد الثعلب الصغير يعبر النهر، فيبتل ذيله. لا نفع في شيء.";
"hex.64.daxiang" = "النار فوق الماء: «قبل الإتمام». هكذا يميّز الرجل النبيل الأشياء بعناية، ويضع كلا منها في موضعه المناسب.";
"hex.64.yao.0" = "ابتلال الذيل. أسف.";
"hex.64.yao.1" = "كبح العجلة (دون عجلة إلى التقدم). الثبات على الاستقامة خير.";
"hex.64.yao.2" = "لم يكتمل العبور. التقدم سوء؛ وينفع عبور النهر الكبير (وقيل إن النص يفتقد أداة النفي، فيكون المعنى: لا ينفع).";
"hex.64.yao.3" = "الثبات على الاستقامة خير، والندم يزول. قتال غوي فانغ بقوة الرعد؛ وبعد ثلاث سنوات تأتي مكافأة من المملكة الكبرى.";
"hex.64.yao.4" = "الثبات على الاستقامة خير، ولا ندم. نور الرجل النبيل في صدقه. خير.";
"hex.64.yao.5" = "شرب الخمر بطمأنينة وصدق لا لوم فيه؛ لكن الإفراط حتى يبتل الرأس بالخمر يضيّع الطريق القويم، ولو بقي الصدق.";
"hex.1.yong" = "تظهر جماعة من التنانين، ولا يتنافس أي منها على الزعامة. خير.";
"hex.2.yong" = "ينفع الثبات الدائم على الاستقامة.";
