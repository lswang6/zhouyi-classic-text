/* Hexagrammes (ordre du roi Wen) et trigrammes (ordre du Ciel antérieur) — français */

"tri.1.k" = "Qián";
"tri.1.nat" = "Ciel";
"tri.2.k" = "Duì";
"tri.2.nat" = "Lac";
"tri.3.k" = "Lí";
"tri.3.nat" = "Feu";
"tri.4.k" = "Zhèn";
"tri.4.nat" = "Tonnerre";
"tri.5.k" = "Xùn";
"tri.5.nat" = "Vent";
"tri.6.k" = "Kǎn";
"tri.6.nat" = "Eau";
"tri.7.k" = "Gèn";
"tri.7.nat" = "Montagne";
"tri.8.k" = "Kūn";
"tri.8.nat" = "Terre";

"hex.1.name" = "Qián";
"hex.1.full" = "Le Créateur";
"hex.1.bh" = "Le ciel redoublé, les six traits fermes : l’image d’une force créatrice inlassable. Le Jugement la dit « grande et originelle » ; les traits suivent un dragon caché dans les profondeurs, qui apparaît dans le champ, vole dans le ciel et finit par dépasser la mesure.";

"hex.2.name" = "Kūn";
"hex.2.full" = "Le Réceptif";
"hex.2.bh" = "La terre redoublée, les six traits souples : l’image de la terre qui porte et soutient toutes choses. Le Jugement compare sa fermeté à celle d’une jument ; les traits vont du givre qui annonce la glace dure aux dragons qui combattent en rase campagne.";

"hex.3.name" = "Zhūn";
"hex.3.full" = "La Difficulté initiale";
"hex.3.bh" = "Le tonnerre en bas et les nuages en haut : l’image d’une pousse qui perce le sol au milieu d’un orage. Le texte traite de la confusion des tout premiers commencements ; les traits montrent un cheval et un char arrêtés, un prétendant d’abord éconduit et un chasseur égaré sans guide.";

"hex.4.name" = "Méng";
"hex.4.full" = "La Folie juvénile";
"hex.4.bh" = "Une source qui jaillit au pied d’une montagne : l’image de l’inexpérience de la jeunesse. Le Jugement décrit le maître et l’élève : c’est le jeune qui cherche le maître, et les questions posées encore et encore restent sans réponse ; les traits traitent de la discipline, de la patience et du jeune resté sans instruction.";

"hex.5.name" = "Xū";
"hex.5.full" = "L’Attente";
"hex.5.bh" = "Des nuages qui montent au ciel avant que la pluie ne tombe : l’image de l’attente. Le Jugement lie l’attente à la sincérité et à la traversée des grandes eaux ; les traits attendent dans les faubourgs, sur le sable, dans la boue, auprès du vin et des mets, et enfin dans une fosse.";

"hex.6.name" = "Sòng";
"hex.6.full" = "Le Conflit";
"hex.6.bh" = "Le ciel qui monte et l’eau qui descend, s’éloignant l’un de l’autre : l’image du conflit et du procès. Le Jugement oppose le fait d’arrêter une dispute à mi-chemin à celui de la pousser jusqu’au bout ; les traits montrent des querelles abandonnées, un retour chez soi et une ceinture de cuir honorifique retirée trois fois en un jour.";

"hex.7.name" = "Shī";
"hex.7.full" = "L’Armée";
"hex.7.bh" = "L’eau contenue dans la terre : l’image d’une force levée parmi le peuple. Le texte traite de la discipline d’une armée et de la nécessité d’un chef expérimenté ; les traits passent du départ en bon ordre, par des chariots chargés de cadavres, au souverain qui distribue les récompenses à la fin de la campagne.";

"hex.8.name" = "Bǐ";
"hex.8.full" = "La Solidarité";
"hex.8.bh" = "L’eau qui s’étend sur la terre : l’image de choses qui se rapprochent et s’unissent. Le Jugement parle de ceux qui viennent s’unir et du retardataire ; les traits décrivent l’union fondée sur la sincérité, l’union de l’intérieur et de l’extérieur, et l’union sans tête.";

"hex.9.name" = "Xiǎo Chù";
"hex.9.full" = "Le Pouvoir d’apprivoisement du petit";
"hex.9.bh" = "Le vent qui passe dans le ciel : l’image d’une force douce qui retient pour un temps. Les « nuages denses, mais pas de pluie » venus des marches de l’ouest, dans le Jugement, donnent le thème ; les traits montrent un retour à sa propre voie, un char qui perd les rayons de ses roues et enfin la pluie qui tombe.";

"hex.10.name" = "Lǚ";
"hex.10.full" = "La Marche";
"hex.10.bh" = "Le ciel au-dessus d’un lac : l’image du juste ordre entre le haut et le bas. La figure du Jugement est celle d’un homme qui marche sur la queue d’un tigre qui ne mord pas ; les traits retracent une conduite simple, un chemin plat et paisible, un borgne qui tente de voir et un dernier regard sur les pas accomplis.";

"hex.11.name" = "Tài";
"hex.11.full" = "La Paix";
"hex.11.bh" = "La terre en haut et le ciel en bas, dont les influences se rencontrent : l’image du ciel et de la terre en harmonie. Le Jugement parle du « petit qui s’en va, du grand qui vient » ; les traits vont des joncs arrachés ensemble, en passant par « pas de plaine sans pente », jusqu’au rempart qui retombe dans son fossé.";

"hex.12.name" = "Pǐ";
"hex.12.full" = "La Stagnation";
"hex.12.bh" = "Le ciel en haut et la terre en bas, qui s’écartent sans se toucher : l’image de la stagnation. Le Jugement parle du « grand qui s’en va, du petit qui vient » ; les traits vont d’un mauvais temps que l’on endure, en passant par un destin attaché à une touffe de mûriers, jusqu’à la stagnation enfin renversée.";

"hex.13.name" = "Tóng Rén";
"hex.13.full" = "La Communauté avec les hommes";
"hex.13.bh" = "Le ciel au-dessus du feu, tous deux tendus vers le haut : l’image de personnes unies par une cause commune. Le Jugement place la communauté en rase campagne ; les traits retracent la communauté à la porte, au sein d’un même clan, des troupes cachées dans les fourrés et des alliés qui d’abord pleurent puis rient.";

"hex.14.name" = "Dà Yǒu";
"hex.14.full" = "Le Grand Avoir";
"hex.14.bh" = "Le feu haut dans le ciel, qui éclaire tout ce qui est en dessous : l’image du grand avoir. Le Jugement parle d’un grand progrès ; les traits traitent des responsabilités de la richesse : un grand chariot pour charger, une offrande au Fils du Ciel et l’abondance tenue sans excès.";

"hex.15.name" = "Qiān";
"hex.15.full" = "L’Humilité";
"hex.15.bh" = "Une montagne cachée dans la terre : l’image d’une grandeur qui se tient en bas. Le Jugement dit que l’homme noble mène les choses à leur terme ; les traits décrivent les formes de l’humilité : l’humilité à l’égard de sa propre humilité, l’humilité qui s’exprime et l’humilité unie au mérite.";

"hex.16.name" = "Yù";
"hex.16.full" = "L’Enthousiasme";
"hex.16.bh" = "Le tonnerre qui jaillit de la terre : l’image d’une énergie libérée qui met toutes choses en mouvement. La Grande Image la relie à la musique composée par les anciens rois ; les traits opposent l’enthousiasme vantard ou replié sur soi à un caractère ferme comme un roc.";

"hex.17.name" = "Suí";
"hex.17.full" = "La Suite";
"hex.17.bh" = "Le tonnerre qui repose au milieu du lac : l’image de celui qui suit la saison et s’y adapte. Le Jugement lie la suite à la fermeté et à la rectitude ; les traits montrent l’attachement au petit ou au grand, la sincérité sur la voie juste et quelqu’un lié solidement par la loyauté.";

"hex.18.name" = "Gǔ";
"hex.18.full" = "Le Travail sur ce qui est corrompu";
"hex.18.bh" = "Le vent qui souffle au pied d’une montagne, là où les choses stagnent : l’image d’une corruption à réparer. Le Jugement parle de trois jours avant et trois jours après un nouveau départ ; les traits traitent de la réparation de ce que le père et la mère ont laissé se corrompre, tandis que le trait du haut ne sert ni roi ni seigneur.";

"hex.19.name" = "Lín";
"hex.19.full" = "L’Approche";
"hex.19.bh" = "La terre au-dessus d’un lac : l’image du supérieur qui s’approche de ceux d’en bas. Le Jugement ajoute une mise en garde au sujet du huitième mois, quand le cycle s’inverse ; les traits décrivent une approche commune, facile, complète, sage et généreuse.";

"hex.20.name" = "Guān";
"hex.20.full" = "La Contemplation";
"hex.20.bh" = "Le vent qui passe sur la terre : l’image de regarder et d’être regardé. La figure du Jugement est un fidèle qui s’est lavé les mains mais n’a pas encore fait l’offrande ; les traits s’élargissent du regard d’un enfant et d’un coup d’œil par une porte jusqu’à la contemplation de sa propre vie.";

"hex.21.name" = "Shì Kè";
"hex.21.full" = "Mordre au travers";
"hex.21.bh" = "Le tonnerre et l’éclair ensemble : l’image d’un obstacle entre les mâchoires qu’il faut mordre au travers. Le texte traite de l’usage de la loi et des châtiments ; les traits vont des pieds pris dans les entraves, en passant par la viande tendre et la viande séchée que l’on mord, jusqu’au cou pris dans la cangue.";

"hex.22.name" = "Bì";
"hex.22.full" = "La Grâce";
"hex.22.bh" = "Le feu au pied d’une montagne, qui l’illumine : l’image de la grâce et de la parure. Le Jugement ne permet que les petites affaires ; les traits vont des pieds et de la barbe ornés, en passant par un éclat humide et un cheval blanc, jusqu’à une grâce devenue simplement blanche.";

"hex.23.name" = "Bō";
"hex.23.full" = "L’Éclatement";
"hex.23.bh" = "Cinq traits souples sous un trait ferme : une montagne qui repose sur la terre et s’use peu à peu. Les traits montrent un lit qui éclate à partir des pieds, puis du cadre, jusqu’à la peau ; au sommet, un gros fruit reste intact.";

"hex.24.name" = "Fù";
"hex.24.full" = "Le Retour";
"hex.24.bh" = "Le tonnerre au sein de la terre : l’image de la lumière qui revient au solstice d’hiver. Le Jugement parle d’un retour en sept jours ; les traits distinguent un retour rapide, un retour paisible, des retours répétés, la marche solitaire et un retour manqué par confusion.";

"hex.25.name" = "Wú Wàng";
"hex.25.full" = "L’Innocence";
"hex.25.bh" = "Le tonnerre qui roule sous le ciel : l’image de choses qui agissent selon leur propre nature, sans artifice. Le Jugement lie l’innocence à la rectitude ; les traits comprennent un bœuf attaché par un homme et emmené par un passant, et une maladie qui passe sans remède.";

"hex.26.name" = "Dà Chù";
"hex.26.full" = "Le Pouvoir d’apprivoisement du grand";
"hex.26.bh" = "Le ciel contenu dans la montagne : l’image d’une grande énergie retenue et accumulée. La Grande Image parle d’accumuler les paroles et les actes des temps anciens ; les traits vont d’un char dont l’essieu a été retiré et de la corne protégée d’un jeune taureau jusqu’à la voie du ciel qui s’ouvre au sommet.";

"hex.27.name" = "Yí";
"hex.27.full" = "Les Commissures des lèvres";
"hex.27.bh" = "Le tonnerre sous une montagne, comme des mâchoires qui se referment sur la nourriture : l’image de l’alimentation. Le Jugement porte l’attention sur ce dont chacun cherche à remplir sa bouche ; les traits opposent celui qui délaisse sa tortue magique pour lorgner la nourriture d’autrui à la nourriture tirée de sources justes.";

"hex.28.name" = "Dà Guò";
"hex.28.full" = "La Prépondérance du grand";
"hex.28.bh" = "Le lac qui monte au-dessus des arbres : l’image d’une poutre faîtière qui ploie sous un poids trop lourd. Le texte traite des temps extraordinaires ; les traits montrent une natte de joncs blancs, un saule desséché qui fait des pousses, une poutre faîtière qui ploie et une traversée où l’eau passe par-dessus la tête.";

"hex.29.name" = "Kǎn";
"hex.29.full" = "L’Insondable";
"hex.29.bh" = "L’eau redoublée, qui s’écoule d’un ravin à l’autre : l’image du danger répété. Le Jugement met en avant la sincérité et un esprit sans trouble ; les traits parlent d’une fosse dans la fosse, de vin et de riz passés par une fenêtre et d’un captif lié de cordes.";

"hex.30.name" = "Lí";
"hex.30.full" = "Ce qui s’attache";
"hex.30.bh" = "Le feu redoublé, clarté sur clarté : l’image de la lumière qui s’attache à ce qu’elle éclaire. Le Jugement y ajoute le soin d’une vache ; les traits vont de pas confus, en passant par la lumière jaune et le soleil couchant, jusqu’à une flamme soudaine et l’expédition punitive d’un roi.";

"hex.31.name" = "Xián";
"hex.31.full" = "L’Influence";
"hex.31.bh" = "Un lac posé sur une montagne : l’image de l’attirance mutuelle entre un jeune homme et une jeune fille. Le Jugement évoque le fait de prendre femme ; les traits remontent le corps : le gros orteil, les mollets, les cuisses, le dos et enfin les mâchoires et la langue.";

"hex.32.name" = "Héng";
"hex.32.full" = "La Durée";
"hex.32.bh" = "Le tonnerre et le vent, toujours ensemble : l’image de ce qui dure. La Grande Image montre quelqu’un qui se tient ferme sans changer de direction ; les traits opposent la recherche trop hâtive de la durée, un caractère inconstant et un champ où il n’y a pas de gibier.";

"hex.33.name" = "Dùn";
"hex.33.full" = "La Retraite";
"hex.33.bh" = "Une montagne qui s’élève sous le ciel, lequel se retire devant elle : l’image de la retraite. Le Jugement traite du retrait opportun quand les forces inférieures avancent ; les traits vont de la queue d’une retraite et de quelqu’un tenu ferme par une peau de bœuf jaune jusqu’à un retrait joyeux et sans hâte.";

"hex.34.name" = "Dà Zhuàng";
"hex.34.full" = "La Puissance du grand";
"hex.34.bh" = "Le tonnerre haut dans le ciel : l’image d’une grande force en mouvement. La Grande Image lie la puissance à la bienséance ; les traits montrent un bélier qui donne de la tête contre une haie et s’y empêtre les cornes, puis la haie qui finit par s’ouvrir.";

"hex.35.name" = "Jìn";
"hex.35.full" = "Le Progrès";
"hex.35.bh" = "Le soleil qui se lève sur la terre : l’image d’un progrès rapide et aisé. Le Jugement montre un prince honoré de nombreux chevaux et reçu trois fois en un jour ; les traits opposent le progrès entravé ou affligé à celui d’un hamster et à celui de qui avance avec les cornes.";

"hex.36.name" = "Míng Yí";
"hex.36.full" = "L’Obscurcissement de la lumière";
"hex.36.bh" = "Le soleil enfoncé sous la terre : l’image de la clarté blessée et cachée. Le texte parle de dissimuler sa lumière en des temps obscurs, avec l’exemple du prince de Ji ; les traits comprennent un faisan qui vole les ailes pendantes et une chasse dans le sud.";

"hex.37.name" = "Jiā Rén";
"hex.37.full" = "La Famille";
"hex.37.bh" = "Le vent qui sort du feu : l’image de la famille, dont l’influence rayonne de l’intérieur vers l’extérieur. Le Jugement souligne le rôle de la femme ; les traits traitent de règles fermes au foyer, de la préparation des repas et de l’influence du roi sur sa famille.";

"hex.38.name" = "Kuí";
"hex.38.full" = "L’Opposition";
"hex.38.bh" = "Le feu au-dessus d’un lac, chacun s’éloignant de l’autre : l’image de l’opposition et de la désunion. Le Jugement permet les petites affaires ; les traits comprennent un cheval perdu qui revient de lui-même, la rencontre de son seigneur dans une ruelle étroite et un porc couvert de boue.";

"hex.39.name" = "Jiǎn";
"hex.39.full" = "L’Obstacle";
"hex.39.bh" = "L’eau au sommet d’une montagne : l’image d’un chemin dangereux qui s’ouvre devant soi. Le Jugement oppose le sud-ouest au nord-est et parle de voir le grand homme ; les traits alternent entre l’avancée vers l’obstacle et le retour en arrière pour trouver un appui.";

"hex.40.name" = "Xiè";
"hex.40.full" = "La Libération";
"hex.40.bh" = "Le tonnerre et la pluie qui relâchent la tension d’un orage : l’image de la libération. Le Jugement parle d’un retour rapide une fois la difficulté passée ; les traits comprennent trois renards capturés, un porteur qui voyage en voiture et un faucon abattu sur une haute muraille.";

"hex.41.name" = "Sǔn";
"hex.41.full" = "La Diminution";
"hex.41.bh" = "Un lac au pied d’une montagne, dont l’eau monte nourrir la pente : l’image de la diminution. Le Jugement note que deux petits bols peuvent suffire au sacrifice ; les traits traitent de ce qui diminue en bas pour augmenter en haut, et de ce que l’on gagne par ce que l’on donne.";

"hex.42.name" = "Yì";
"hex.42.full" = "L’Augmentation";
"hex.42.bh" = "Le vent et le tonnerre qui se renforcent l’un l’autre : l’image de l’augmentation. Le texte traite du haut qui donne au bas, et la Grande Image le relie au mouvement vers le bien ; les traits comprennent le don de dix paires de carapaces de tortue et un cœur sans constance.";

"hex.43.name" = "Guài";
"hex.43.full" = "La Percée";
"hex.43.bh" = "Un lac élevé au-dessus du ciel : l’image d’une percée. Le Jugement parle de proclamer l’affaire à la cour du roi ; les traits traitent de l’action résolue contre le mal : une avancée trop hâtive, des herbes arrachées et un voyageur solitaire trempé par la pluie.";

"hex.44.name" = "Gòu";
"hex.44.full" = "Venir à la rencontre";
"hex.44.bh" = "Le vent qui souffle sous le ciel : l’image d’un seul trait souple qui vient à la rencontre de cinq traits fermes. Le Jugement déconseille d’épouser une telle femme ; les traits comprennent un poisson dans le vivier, un melon couvert de feuilles de saule et une rencontre avec les cornes.";

"hex.45.name" = "Cuì";
"hex.45.full" = "Le Rassemblement";
"hex.45.bh" = "Un lac qui s’élève au-dessus de la terre : l’image des eaux rassemblées et des gens qui se réunissent. Le Jugement évoque le roi qui s’approche de son temple et de grandes offrandes ; les traits traitent du rassemblement au début, du fait d’être attiré vers les autres, des soupirs de la séparation et des larmes.";

"hex.46.name" = "Shēng";
"hex.46.full" = "La Poussée vers le haut";
"hex.46.bh" = "Le bois qui pousse au sein de la terre : l’image d’une croissance régulière vers le haut. Le Jugement évoque la rencontre avec le grand homme et le départ vers le sud ; les traits retracent une montée vers une ville vide, l’offrande du roi sur le mont Qi et l’ascension d’un escalier.";

"hex.47.name" = "Kùn";
"hex.47.full" = "L’Accablement";
"hex.47.bh" = "Un lac dont l’eau s’est écoulée : l’image de l’épuisement et de l’adversité. Le Jugement note qu’en un tel temps les paroles ne sont pas crues ; les traits comprennent l’accablement sous un arbre dénudé, auprès du vin et des mets, parmi les rochers et les épines, et par des plantes grimpantes.";

"hex.48.name" = "Jǐng";
"hex.48.full" = "Le Puits";
"hex.48.bh" = "Le bois qui descend dans l’eau pour la puiser : l’image d’un puits, source de nourriture qui ne tarit jamais. Le Jugement note qu’une ville peut se déplacer, mais pas son puits ; les traits vont d’un puits boueux et délaissé à un puits laissé ouvert à tous.";

"hex.49.name" = "Gé";
"hex.49.full" = "La Révolution";
"hex.49.bh" = "Le feu au sein d’un lac, chacun cherchant à éteindre l’autre : l’image d’un changement radical. Le Jugement dit qu’on ne croit au changement que le jour où il est accompli ; les traits retracent le changement lié dans une peau de bœuf jaune, le grand homme qui change comme un tigre et l’homme noble qui change comme une panthère.";

"hex.50.name" = "Dǐng";
"hex.50.full" = "Le Chaudron";
"hex.50.bh" = "Le bois sous le feu : l’image du ding, le chaudron de bronze où l’on cuisait les offrandes et les festins. Le Jugement parle d’un grand progrès ; les traits vont d’un chaudron renversé pour le vider, en passant par des pieds brisés et des anses altérées, jusqu’à des anneaux de transport en or et en jade.";

"hex.51.name" = "Zhèn";
"hex.51.full" = "L’Éveilleur";
"hex.51.bh" = "Le tonnerre redoublé : l’image du choc et de la peur. Le Jugement montre l’effroi suivi du rire, et quelqu’un qui ne lâche ni la cuillère sacrificielle ni le vin ; les traits suivent les réactions au choc, de la perte de trésors et de l’ascension des neuf collines jusqu’à l’enlisement dans la boue.";

"hex.52.name" = "Gèn";
"hex.52.full" = "L’Immobilisation";
"hex.52.bh" = "La montagne redoublée : l’image de l’immobilité et du repos. Le Jugement montre le dos tenu immobile et la marche dans la cour sans voir personne ; les traits remontent le corps, des orteils aux mollets, aux hanches, au tronc et aux mâchoires, jusqu’à une noble immobilité au sommet.";

"hex.53.name" = "Jiàn";
"hex.53.full" = "Le Développement";
"hex.53.bh" = "Un arbre qui pousse sur une montagne : l’image du développement graduel. Le Jugement prend l’exemple du mariage d’une jeune fille ; les traits suivent une oie sauvage qui avance pas à pas du rivage au rocher, au plateau, à l’arbre, au sommet et aux hauteurs au-delà.";

"hex.54.name" = "Guī Mèi";
"hex.54.full" = "L’Épousée";
"hex.54.bh" = "Le tonnerre au-dessus d’un lac : l’image d’une sœur cadette mariée comme épouse secondaire. La Grande Image médite sur le fait de connaître la fin dès le commencement ; les traits comprennent un boiteux qui marche, un borgne qui voit, un mariage retardé et les manches d’une épousée plus simples que celles de sa demoiselle d’honneur.";

"hex.55.name" = "Fēng";
"hex.55.full" = "L’Abondance";
"hex.55.bh" = "Le tonnerre et l’éclair qui arrivent ensemble : l’image de l’abondance à son apogée. Le Jugement compare le roi au soleil de midi ; les traits décrivent le soleil voilé au point qu’on voit les étoiles à midi, et une grande maison restée vide.";

"hex.56.name" = "Lǚ";
"hex.56.full" = "Le Voyageur";
"hex.56.bh" = "Le feu sur une montagne, qui brûle et passe plus loin : l’image du voyageur. Le Jugement permet les petites affaires ; les traits décrivent un voyageur dans des auberges, avec ou sans serviteurs ni biens, et un nid d’oiseau qui brûle tandis que le voyageur d’abord rit, puis pleure.";

"hex.57.name" = "Xùn";
"hex.57.full" = "Le Doux";
"hex.57.bh" = "Le vent redoublé, qui pénètre partout : l’image du doux et du pénétrant. Le Jugement parle d’un progrès dans les petites choses et de voir le grand homme ; les traits comprennent des devins et des exorcistes sous le lit, du gibier pris pour trois usages, et trois jours avant et après un changement.";

"hex.58.name" = "Duì";
"hex.58.full" = "Le Serein";
"hex.58.bh" = "Le lac redoublé, deux lacs qui s’alimentent l’un l’autre : l’image de la joie partagée. La Grande Image la relie à des amis qui discutent et s’exercent ensemble ; les traits opposent la joie harmonieuse et sincère à la joie recherchée, calculée ou séductrice.";

"hex.59.name" = "Huàn";
"hex.59.full" = "La Dissolution";
"hex.59.bh" = "Le vent qui souffle sur l’eau : l’image de la dissolution de ce qui est rigide ou divisé. Le Jugement évoque le roi qui s’approche de son temple et la traversée des grandes eaux ; les traits comprennent la dissolution de son propre moi, de son propre groupe, et un grand cri qui se répand comme la sueur.";

"hex.60.name" = "Jié";
"hex.60.full" = "La Limitation";
"hex.60.bh" = "L’eau au-dessus d’un lac, qui ne peut en contenir qu’une certaine quantité : l’image des limites et de la régulation. Le Jugement dit que des limites dures et amères ne peuvent durer ; les traits opposent le fait de ne pas sortir de la cour, des limites acceptées avec aisance et des limites amères.";

"hex.61.name" = "Zhōng Fú";
"hex.61.full" = "La Vérité intérieure";
"hex.61.bh" = "Le vent au-dessus d’un lac : l’image d’une sincérité qui atteint jusqu’aux porcs et aux poissons. Les traits comprennent une grue qui appelle à l’ombre et ses petits qui lui répondent, une coupe de vin partagée, un cheval dont le compagnon d’attelage s’en va et un coq qui tente de s’envoler jusqu’au ciel.";

"hex.62.name" = "Xiǎo Guò";
"hex.62.full" = "La Prépondérance du petit";
"hex.62.bh" = "Le tonnerre au-dessus d’une montagne : l’image du petit qui dépasse. Le Jugement montre un oiseau en vol dont on entend le cri, et oppose les petites affaires aux grandes ; les traits montrent un oiseau qui vole trop haut et le fait de passer devant l’aïeul pour aller à la rencontre de l’aïeule.";

"hex.63.name" = "Jì Jì";
"hex.63.full" = "Après l’accomplissement";
"hex.63.bh" = "L’eau au-dessus du feu, chaque trait à sa juste place : l’image des choses accomplies. Le Jugement note l’ordre au début et le désordre à la fin ; les traits comprennent des freins sur une roue, un rideau de char perdu et un renard qui se mouille la tête.";

"hex.64.name" = "Wèi Jì";
"hex.64.full" = "Avant l’accomplissement";
"hex.64.bh" = "Le feu au-dessus de l’eau, aucun trait à sa juste place : l’image d’une transition pas encore achevée. Le Jugement montre un jeune renard qui a presque traversé le fleuve et se mouille la queue ; les traits vont de cette traversée inachevée au vin bu en confiance à la fin.";
