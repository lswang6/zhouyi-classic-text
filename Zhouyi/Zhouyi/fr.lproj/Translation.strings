/* 周易 · fr · 经文译文. Translated by the Zhouyi app editors from the classical text. Source: fr.json */
"hex.1.ci" = "Quatre vertus : puissance créatrice, succès, harmonie bénéfique et persévérance dans la rectitude.";
"hex.1.daxiang" = "Le ciel poursuit sa course avec vigueur, sans relâche. Ainsi, l’être noble s’affermit sans cesse.";
"hex.1.yao.0" = "Le dragon demeure caché sous l’eau. Ce n’est pas encore le moment d’agir.";
"hex.1.yao.1" = "Le dragon apparaît dans les champs. Il est favorable de voir le grand homme.";
"hex.1.yao.2" = "L’être noble œuvre sans relâche tout le jour ; le soir encore, il reste vigilant, comme face au danger. Aucun blâme.";
"hex.1.yao.3" = "Le dragon s’élance ou se retire dans les profondeurs, selon le moment. Aucun blâme.";
"hex.1.yao.4" = "Le dragon vole dans le ciel. Il est favorable de voir le grand homme.";
"hex.1.yao.5" = "Le dragon s’élève trop haut. Il y aura du regret.";
"hex.2.ci" = "Puissance créatrice et succès. Il est favorable de persévérer dans la rectitude avec la docilité d’une jument. L’être noble entreprend un voyage : en prenant les devants, il s’égare ; en suivant, il trouve un maître. Cela est favorable. Au sud-ouest, il trouve des amis ; au nord-est, il en perd. Demeurer paisiblement dans la rectitude : heureuse issue.";
"hex.2.daxiang" = "La terre est souple, vaste et profonde. Ainsi, l’être noble porte tous les êtres par l’ampleur de sa vertu.";
"hex.2.yao.0" = "Marcher sur le givre annonce l’arrivée de la glace épaisse (prévenir le mal dès ses premiers signes).";
"hex.2.yao.1" = "Droiture, intégrité et grandeur : sans exercice délibéré, rien qui ne soit favorable.";
"hex.2.yao.2" = "Garder sa vertu cachée permet de persévérer dans la rectitude. Si l’on sert le roi, ne pas s’attribuer le mérite, mais mener l’œuvre à son terme.";
"hex.2.yao.3" = "Fermer le sac (garder un silence prudent). Aucun blâme, aucun éloge.";
"hex.2.yao.4" = "Porter un vêtement inférieur jaune (couleur du centre et position basse, images de la juste mesure et de l’humilité). Très heureuse issue.";
"hex.2.yao.5" = "Les dragons combattent dans la plaine ; leur sang mêle le bleu-noir et le jaune (couleurs du ciel et de la terre : le yin et le yang s’affrontent et se blessent mutuellement).";
"hex.3.ci" = "Puissance créatrice et succès. Il est favorable de persévérer dans la rectitude. Ne pas se hâter d’entreprendre. Il est favorable d’établir des princes (instituer un souverain et chercher des auxiliaires).";
"hex.3.daxiang" = "Nuages en haut, tonnerre en bas : La Difficulté initiale. Ainsi, l’être noble ordonne et gouverne le monde, comme on démêle des fils de soie.";
"hex.3.yao.0" = "Hésiter sans avancer. Il est favorable de demeurer dans la rectitude et d’établir des princes.";
"hex.3.yao.1" = "Avancer péniblement, hésiter ; à cheval, tourner en rond. Ce ne sont pas des brigands, mais des prétendants. La jeune femme reste fidèle à la rectitude et refuse de se fiancer ; après dix ans seulement, elle y consent.";
"hex.3.yao.2" = "Poursuivre le cerf sans garde forestier (officier chargé des forêts) ne fait qu’égarer dans les bois. L’être noble en perçoit les signes et préfère renoncer. Poursuivre apporte l’humiliation.";
"hex.3.yao.3" = "À cheval, tourner en rond. Aller demander une union : heureuse issue. Rien qui ne soit favorable.";
"hex.3.yao.4" = "Les bienfaits s’accumulent sans pouvoir se répandre. Persévérer dans la rectitude apporte une heureuse issue dans les petites affaires, une issue funeste dans les grandes.";
"hex.3.yao.5" = "À cheval, tourner en rond ; verser des torrents de larmes de sang.";
"hex.4.ci" = "Succès. Ce n’est pas moi qui cherche le jeune ignorant ; c’est lui qui me cherche. À la première consultation, je réponds. Répéter deux ou trois fois la demande est une profanation ; à la profanation, je ne réponds plus. Il est favorable de persévérer dans la rectitude.";
"hex.4.daxiang" = "Une source jaillit au pied de la montagne : La Folie juvénile. Ainsi, l’être noble agit résolument et cultive sa vertu.";
"hex.4.yao.0" = "Éclairer l’ignorance. Il est favorable de discipliner par les peines pour délivrer des entraves ; persister dans le seul châtiment apporte l’humiliation.";
"hex.4.yao.1" = "Accueillir l’ignorant avec patience : heureuse issue. Prendre épouse : heureuse issue. Le fils est capable de diriger la maison.";
"hex.4.yao.2" = "Ne pas épouser cette femme : à la vue d’un homme riche, elle s’abandonne sans retenue. Rien de favorable.";
"hex.4.yao.3" = "Rester prisonnier de l’ignorance : humiliation.";
"hex.4.yao.4" = "Chercher à apprendre avec la simplicité d’un enfant : heureuse issue.";
"hex.4.yao.5" = "Combattre fermement l’ignorance. Il n’est pas favorable d’agir avec la violence d’un brigand ; il est favorable de se défendre contre les agressions.";
"hex.5.ci" = "Avec sincérité, clarté et succès. Persévérer dans la rectitude : heureuse issue. Il est favorable de traverser le grand fleuve (affronter le risque pour accomplir une entreprise).";
"hex.5.daxiang" = "Les nuages montent au ciel (attendant le moment de donner la pluie) : L’Attente. Ainsi, l’être noble mange, boit et se réjouit, attendant sereinement son heure.";
"hex.5.yao.0" = "Attendre loin de la ville. Il est favorable de rester constant. Aucun blâme.";
"hex.5.yao.1" = "Attendre sur le sable. Quelques querelles de paroles ; à la fin, heureuse issue.";
"hex.5.yao.2" = "Attendre dans la boue attire les brigands.";
"hex.5.yao.3" = "Attendre dans le sang (en un lieu où l’on subit des blessures), puis sortir de la fosse.";
"hex.5.yao.4" = "Attendre paisiblement au milieu des mets et du vin. Persévérer dans la rectitude : heureuse issue.";
"hex.5.yao.5" = "Tomber dans la fosse. Trois hôtes arrivent sans invitation. Les traiter avec respect : à la fin, heureuse issue.";
"hex.6.ci" = "La sincérité se heurte à un obstacle. Rester vigilant et s’arrêter à mi-chemin : heureuse issue. Mener le conflit jusqu’au bout : issue funeste. Il est favorable de voir le grand homme (pour obtenir un jugement équitable). Il n’est pas favorable de traverser le grand fleuve.";
"hex.6.daxiang" = "Le ciel monte, l’eau descend : ils suivent des voies opposées. Le Conflit. Ainsi, l’être noble prépare soigneusement toute entreprise dès son commencement (pour prévenir les différends).";
"hex.6.yao.0" = "Ne pas prolonger le conflit. Quelques querelles de paroles ; à la fin, heureuse issue.";
"hex.6.yao.1" = "Perdre le procès, rentrer et se retirer. Son domaine ne compte que trois cents foyers : aucun désastre.";
"hex.6.yao.2" = "Vivre des bienfaits et émoluments d’autrefois. Persévérer dans la rectitude face au danger : à la fin, heureuse issue. Si l’on sert le roi, ne pas s’attribuer le mérite.";
"hex.6.yao.3" = "Perdre le procès, revenir à l’ordre juste, changer d’intention et demeurer paisiblement dans la rectitude : heureuse issue.";
"hex.6.yao.4" = "Régler le litige (par un jugement équitable) : très heureuse issue.";
"hex.6.yao.5" = "Même si l’on reçoit une somptueuse ceinture en récompense, elle sera retirée trois fois en une seule journée.";
"hex.7.ci" = "Persévérance dans la rectitude. Sous la conduite d’un ancien respecté pour sa vertu : heureuse issue, aucun blâme.";
"hex.7.daxiang" = "L’eau repose au sein de la terre : L’Armée. Ainsi, l’être noble accueille le peuple et entretient la multitude.";
"hex.7.yao.0" = "L’armée part en campagne sous une discipline ferme. Une discipline défaillante mène à une issue funeste.";
"hex.7.yao.1" = "Commander au milieu de l’armée : heureuse issue, aucun blâme. Le roi accorde à plusieurs reprises ses marques de faveur.";
"hex.7.yao.2" = "L’armée risque de revenir chargée de cadavres. Issue funeste.";
"hex.7.yao.3" = "L’armée se replie et établit son camp. Aucun blâme.";
"hex.7.yao.4" = "Il y a du gibier dans les champs (image d’une invasion ennemie). Il est favorable de le dénoncer et de le capturer. Aucun blâme. Que le fils aîné commande l’armée ; si un cadet sans vertu en prend la tête, elle reviendra chargée de cadavres. Même avec rectitude, issue funeste.";
"hex.7.yao.5" = "Le souverain proclame ses ordres : il récompense les mérites en confiant des principautés ou des domaines. Ne pas employer les hommes mesquins.";
"hex.8.ci" = "Heureuse issue. Examiner le sens premier de l’oracle : avec l’initiative, la constance et la rectitude, aucun blâme. Les pays troublés viennent se rallier. Pour celui qui tarde à venir, issue funeste.";
"hex.8.daxiang" = "L’eau repose sur la terre (toutes deux étroitement unies) : La Solidarité. Ainsi, les anciens rois établissaient les nombreux États et entretenaient des liens avec les princes.";
"hex.8.yao.0" = "S’unir aux autres avec sincérité. Aucun blâme. La sincérité remplit le vase de terre comme un vin qui déborde ; à la fin, un bienfait inattendu survient. Heureuse issue.";
"hex.8.yao.1" = "S’unir du fond du cœur. Persévérer dans la rectitude : heureuse issue.";
"hex.8.yao.2" = "S’unir à ceux auxquels il ne faudrait pas s’unir.";
"hex.8.yao.3" = "S’unir au sage au-dehors. Persévérer dans la rectitude : heureuse issue.";
"hex.8.yao.4" = "S’unir ouvertement et loyalement. À la chasse, le roi fait rabattre le gibier de trois côtés et laisse fuir les bêtes par le côté libre. Les habitants n’ont pas à se méfier les uns des autres. Heureuse issue.";
"hex.8.yao.5" = "S’unir sans prendre les devants à temps (selon une autre lecture, sans bon commencement) : issue funeste.";
"hex.9.ci" = "Succès. Des nuages denses s’élèvent de nos faubourgs occidentaux, sans donner de pluie.";
"hex.9.daxiang" = "Le vent souffle au-dessus du ciel : Le Pouvoir d’apprivoisement du petit. Ainsi, l’être noble affine sa culture et sa vertu.";
"hex.9.yao.0" = "Revenir à sa juste voie : quel blâme pourrait-il y avoir ? Heureuse issue.";
"hex.9.yao.1" = "Se laisser entraîner ensemble vers la juste voie. Heureuse issue.";
"hex.9.yao.2" = "Les rayons de la roue se détachent. L’époux et l’épouse se brouillent.";
"hex.9.yao.3" = "Avec sincérité, les épreuves s’éloignent et les craintes se dissipent. Aucun blâme.";
"hex.9.yao.4" = "La sincérité unit les êtres ; on partage la prospérité avec ses voisins.";
"hex.9.yao.5" = "La pluie est tombée ; le yang, contenu, repose. Ainsi agit la vertu honorée et accumulée. Pour la femme, même la rectitude comporte un danger. La lune approche de sa plénitude (le yin grandit jusqu’à rivaliser avec le yang). Pour l’être noble, partir en campagne mène à une issue funeste.";
"hex.10.ci" = "Marcher sur la queue du tigre sans qu’il morde. Succès.";
"hex.10.daxiang" = "Le ciel en haut, le lac en bas : La Marche. Ainsi, l’être noble distingue les rangs supérieurs et inférieurs et affermit le cœur du peuple.";
"hex.10.yao.0" = "Agir avec une simplicité naturelle. Avancer : aucun blâme.";
"hex.10.yao.1" = "La voie est large et unie. Pour celui qui vit retiré et paisible, persévérer dans la rectitude apporte une heureuse issue.";
"hex.10.yao.2" = "Le borgne se croit capable de bien voir ; le boiteux se croit capable d’aller loin. Marcher sur la queue du tigre et se faire mordre : issue funeste. Tel un homme de guerre qui prétend devenir souverain.";
"hex.10.yao.3" = "Marcher sur la queue du tigre, avec crainte et prudence. À la fin, heureuse issue.";
"hex.10.yao.4" = "Agir avec une ferme résolution. Même avec rectitude, il y a danger.";
"hex.10.yao.5" = "Revoir le chemin parcouru et examiner les signes de bonheur et de malheur. Si tout est accompli avec plénitude, très heureuse issue.";
"hex.11.ci" = "Le petit s’en va, le grand vient (le yin se retire, le yang arrive). Heureuse issue et succès.";
"hex.11.daxiang" = "Le ciel et la terre s’unissent : La Paix. Ainsi, le souverain ordonne l’action du ciel et de la terre, soutient leurs bienfaits créateurs et aide le peuple.";
"hex.11.yao.0" = "Arracher des herbes dont les racines s’entrelacent en touffe. Partir avec ses semblables : heureuse issue.";
"hex.11.yao.1" = "Accueillir même ce qui est inculte, oser traverser le fleuve à gué, ne pas délaisser les sages lointains ni former de clans par intérêt : ainsi mérite-t-on l’estime par la voie du juste milieu.";
"hex.11.yao.2" = "Nulle plaine sans pente, nul départ sans retour. Persévérer dans la rectitude au milieu des difficultés : aucun blâme. Ne pas s’inquiéter de gagner la confiance ; on jouira de bienfaits et de subsistance.";
"hex.11.yao.3" = "Descendre avec légèreté. S’unir à ses voisins sans s’appuyer sur la richesse ; se traiter avec sincérité, sans méfiance.";
"hex.11.yao.4" = "Di Yi (roi de la dynastie Shang) donne sa sœur cadette en mariage. Il en reçoit une bénédiction : très heureuse issue.";
"hex.11.yao.5" = "Le rempart s’effondre dans le fossé. Ne pas employer l’armée. Proclamer les ordres dans sa propre cité. Même avec rectitude, humiliation.";
"hex.12.ci" = "La stagnation est étrangère à la juste voie humaine (selon une autre lecture, elle est causée par les hommes mesquins). Elle ne favorise pas la rectitude de l’être noble. Le grand s’en va, le petit vient (le yang se retire, le yin arrive).";
"hex.12.daxiang" = "Le ciel et la terre ne s’unissent pas : La Stagnation. Ainsi, l’être noble garde sa vertu discrète pour éviter les malheurs et ne recherche ni honneurs ni charges lucratives.";
"hex.12.yao.0" = "Arracher des herbes dont les racines s’entrelacent en touffe. Avec ses semblables, persévérer dans la rectitude : heureuse issue et succès.";
"hex.12.yao.1" = "Accueillir les supérieurs et se soumettre à eux : heureuse issue pour l’homme mesquin. Le grand homme demeure ferme dans la stagnation et trouve ainsi le succès.";
"hex.12.yao.2" = "Dissimuler sa honte.";
"hex.12.yao.3" = "Suivre le mandat du ciel : aucun blâme. Les semblables s’unissent et partagent les bienfaits.";
"hex.12.yao.4" = "Mettre fin à la stagnation : heureuse issue pour le grand homme. Rester vigilant : « La ruine menace ! La ruine menace ! » Ainsi demeure-t-on solide, comme attaché à une touffe de mûriers.";
"hex.12.yao.5" = "Renverser la stagnation. D’abord l’obstruction, puis la joie.";
"hex.13.ci" = "S’unir aux autres en pleine campagne : succès. Il est favorable de traverser le grand fleuve (affronter le risque pour accomplir une entreprise). La persévérance de l’être noble dans la rectitude est favorable.";
"hex.13.daxiang" = "Le ciel et le feu s’accordent : La Communauté avec les hommes. Ainsi, l’être noble distingue les groupes et les choses selon leur nature, unissant les ressemblances sans effacer les différences.";
"hex.13.yao.0" = "S’unir aux autres dès le seuil franchi. Aucun blâme.";
"hex.13.yao.1" = "Ne s’unir qu’aux membres de son clan. Humiliation.";
"hex.13.yao.2" = "Cacher des soldats dans les broussailles, monter sur une haute colline pour guetter, sans oser lancer les troupes pendant trois ans.";
"hex.13.yao.3" = "Monter sur la muraille adverse, mais finalement renoncer à l’attaque. Heureuse issue.";
"hex.13.yao.4" = "Pour s’unir aux autres, d’abord pleurer à grands cris, puis rire. Après la victoire de la grande armée, on peut se retrouver.";
"hex.13.yao.5" = "S’unir aux autres aux abords de la ville. Aucun regret (bien que l’union ne s’étende pas encore à la pleine campagne).";
"hex.14.ci" = "Grand succès.";
"hex.14.daxiang" = "Le feu brille au-dessus du ciel : Le Grand Avoir. Ainsi, l’être noble réprime le mal, exalte le bien et suit le bienveillant mandat du ciel.";
"hex.14.yao.0" = "Ne pas s’allier à ce qui nuit évite la faute. Rester conscient des difficultés : aucun blâme.";
"hex.14.yao.1" = "Charger les biens sur un grand chariot et entreprendre un voyage. Aucun blâme.";
"hex.14.yao.2" = "Le prince présente son tribut au Fils du Ciel (selon une autre lecture, il est reçu à son festin). L’homme mesquin n’en est pas capable.";
"hex.14.yao.3" = "Ne pas étaler excessivement sa grandeur. Aucun blâme.";
"hex.14.yao.4" = "Sincérité dans les rapports avec supérieurs et subordonnés, jointe à la dignité. Heureuse issue.";
"hex.14.yao.5" = "Le ciel lui-même accorde sa protection. Heureuse issue ; rien qui ne soit favorable.";
"hex.15.ci" = "Succès. L’être noble mène les choses à une bonne fin.";
"hex.15.daxiang" = "Une montagne au sein de la terre : L’Humilité. Ainsi, l’être noble réduit l’excès et comble le manque, pesant les choses pour les répartir équitablement.";
"hex.15.yao.0" = "L’être noble, humble entre les humbles, peut ainsi traverser le grand fleuve (affronter le danger pour réussir). Heureuse issue.";
"hex.15.yao.1" = "L’humilité est reconnue au loin. Persévérer dans la rectitude : heureuse issue.";
"hex.15.yao.2" = "L’être noble demeure humble malgré ses mérites. À la fin, heureuse issue.";
"hex.15.yao.3" = "Rien qui ne soit favorable. Déployer l’humilité (la mettre en œuvre et la faire rayonner).";
"hex.15.yao.4" = "Obtenir l’appui de ses voisins sans s’appuyer sur la richesse. Il est favorable de soumettre les récalcitrants par les armes. Rien qui ne soit favorable.";
"hex.15.yao.5" = "L’humilité est reconnue au loin. Il est favorable de mobiliser l’armée pour soumettre les cités et les pays de son propre domaine.";
"hex.16.ci" = "Il est favorable d’établir des princes et de faire marcher l’armée.";
"hex.16.daxiang" = "Le tonnerre surgit puissamment de la terre : L’Enthousiasme. Ainsi, les anciens rois composaient la musique pour honorer la vertu et l’offraient solennellement au Souverain d’en haut, en y associant leurs ancêtres.";
"hex.16.yao.0" = "Se vanter bruyamment de la faveur reçue et de sa joie. Issue funeste.";
"hex.16.yao.1" = "Ferme comme le roc, discerner le moment d’agir avant même la fin du jour. Persévérer dans la rectitude : heureuse issue.";
"hex.16.yao.2" = "Chercher la quiétude en levant des regards flatteurs : regret. Tarder à s’éveiller : encore du regret.";
"hex.16.yao.3" = "Par lui, tous trouvent la joie ; grands sont les gains. Ne pas douter : les amis se réunissent comme les cheveux autour d’une épingle.";
"hex.16.yao.4" = "Persévérer dans la rectitude malgré la maladie ; elle dure, sans mener à la mort.";
"hex.16.yao.5" = "S’abîmer aveuglément dans les plaisirs. Si l’on change, aucun blâme.";
"hex.17.ci" = "Grand succès. Il est favorable de persévérer dans la rectitude. Aucun blâme.";
"hex.17.daxiang" = "Le tonnerre repose dans le lac : La Suite. Ainsi, l’être noble rentre se reposer à la tombée du jour.";
"hex.17.yao.0" = "La tâche que l’on dirige change (selon une autre lecture, les idées changent). Persévérer dans la rectitude : heureuse issue. Sortir et nouer des relations porte ses fruits.";
"hex.17.yao.1" = "S’attacher au jeune garçon fait perdre l’homme mûr.";
"hex.17.yao.2" = "S’attacher à l’homme mûr fait perdre le jeune garçon. En suivant autrui, on obtient ce que l’on cherche. Il est favorable de demeurer dans la rectitude.";
"hex.17.yao.3" = "Suivre apporte des gains, mais même avec rectitude, une issue funeste menace. Avec sincérité, fidélité à la juste voie et discernement, quel blâme pourrait-il y avoir ?";
"hex.17.yao.4" = "Être sincère envers les êtres bons et vertueux. Heureuse issue.";
"hex.17.yao.5" = "Le retenir et le lier, puis serrer ses liens pour qu’il suive. Le roi offre un sacrifice sur la montagne de l’Ouest (le mont Qi).";
"hex.18.ci" = "Grand succès. Il est favorable de traverser le grand fleuve (affronter le risque pour accomplir une entreprise). Trois jours avant le jour Jia (jour Xin), préparer ; trois jours après (jour Ding), examiner et réfléchir.";
"hex.18.daxiang" = "Le vent souffle au pied de la montagne : Le Travail sur ce qui est corrompu. Ainsi, l’être noble relève le peuple et cultive la vertu.";
"hex.18.yao.0" = "Réparer les désordres laissés par le père. Avec un tel fils, le père défunt est exempt de blâme. Danger, mais à la fin, heureuse issue.";
"hex.18.yao.1" = "Réparer les désordres laissés par la mère. Ne pas se montrer rigide ou obstiné (agir avec tact).";
"hex.18.yao.2" = "Réparer les désordres laissés par le père. Un peu de regret, mais aucun grand blâme.";
"hex.18.yao.3" = "Tolérer les désordres laissés par le père. Continuer ainsi mène à l’humiliation.";
"hex.18.yao.4" = "Réparer les désordres laissés par le père et en recevoir les éloges.";
"hex.18.yao.5" = "Ne servir ni rois ni princes ; tenir haut ses aspirations et sa conduite.";
"hex.19.ci" = "Grand succès. Il est favorable de persévérer dans la rectitude. Au huitième mois, une issue funeste survient.";
"hex.19.daxiang" = "La terre au-dessus du lac : L’Approche. Ainsi, l’être noble ne cesse de réfléchir à l’instruction du peuple ; son accueil et sa protection sont sans limites.";
"hex.19.yao.0" = "S’approcher du peuple en touchant son cœur (par l’influence morale). Persévérer dans la rectitude : heureuse issue.";
"hex.19.yao.1" = "S’approcher du peuple en touchant son cœur. Heureuse issue ; rien qui ne soit favorable.";
"hex.19.yao.2" = "S’approcher du peuple par de douces paroles : rien de favorable. En prendre souci et se corriger : aucun blâme.";
"hex.19.yao.3" = "S’approcher personnellement du peuple, au plus près. Aucun blâme.";
"hex.19.yao.4" = "S’approcher du peuple avec sagesse, comme il convient à un grand souverain. Heureuse issue.";
"hex.19.yao.5" = "S’approcher du peuple avec une généreuse bonté. Heureuse issue, aucun blâme.";
"hex.20.ci" = "Lors du sacrifice, les mains sont lavées et la libation versée, mais les offrandes ne sont pas encore présentées (instant du plus profond recueillement). La sincérité et la dignité inspirent le respect.";
"hex.20.daxiang" = "Le vent parcourt la terre : La Contemplation. Ainsi, les anciens rois visitaient les régions, observaient la condition du peuple et organisaient son instruction.";
"hex.20.yao.0" = "Contempler avec le regard borné d’un enfant. Aucun blâme pour l’homme mesquin ; humiliation pour l’être noble.";
"hex.20.yao.1" = "Observer par la fente de la porte. La persévérance de la femme dans la rectitude est favorable.";
"hex.20.yao.2" = "Examiner ses propres actes pour décider d’avancer ou de se retirer.";
"hex.20.yao.3" = "Contempler l’éclat d’un pays bien gouverné. Il est favorable d’être reçu comme hôte par le roi (pour entrer à son service et l’assister).";
"hex.20.yao.4" = "Examiner ses propres actes. Pour l’être noble, aucun blâme.";
"hex.20.yao.5" = "Examiner les actes d’autrui (selon une autre lecture, voir ses propres actes examinés par autrui). Pour l’être noble, aucun blâme.";
"hex.21.ci" = "Succès. Il est favorable de recourir à la justice pénale.";
"hex.21.daxiang" = "Tonnerre et éclair s’unissent : Mordre au travers. Ainsi, les anciens rois rendaient les peines claires et veillaient à la rigueur des lois.";
"hex.21.yao.0" = "Les pieds sont pris dans des entraves qui cachent les orteils. Aucun blâme (une petite peine sert de grand avertissement).";
"hex.21.yao.1" = "Mordre dans une chair tendre jusqu’à y enfouir le nez. Aucun blâme.";
"hex.21.yao.2" = "Mordre dans une viande séchée et dure, y trouver du poison. Légère humiliation, aucun blâme.";
"hex.21.yao.3" = "Mordre dans une viande séchée avec os et trouver une pointe de flèche métallique (image de fermeté et de droiture). Il est favorable de persévérer dans la rectitude au milieu des difficultés. Heureuse issue.";
"hex.21.yao.4" = "Mordre dans une viande séchée et trouver de l’or jaune (image de juste mesure et de fermeté). Persévérer dans la rectitude face au danger. Aucun blâme.";
"hex.21.yao.5" = "Porter sur les épaules une cangue qui cache les oreilles. Issue funeste.";
"hex.22.ci" = "Succès. Entreprendre est quelque peu favorable.";
"hex.22.daxiang" = "Le feu au pied de la montagne (sa lumière porte peu) : La Grâce. Ainsi, l’être noble éclaire les affaires du gouvernement, mais n’ose juger les procès à la légère.";
"hex.22.yao.0" = "Parer ses orteils ; abandonner le char et aller à pied.";
"hex.22.yao.1" = "Parer sa barbe.";
"hex.22.yao.2" = "Une parure somptueuse, fraîche et éclatante. Persévérer durablement dans la rectitude : heureuse issue.";
"hex.22.yao.3" = "Une parure d’un blanc pur ; un cheval blanc court comme s’il volait. Ce n’est pas un brigand, mais un prétendant.";
"hex.22.yao.4" = "Parer les collines et les jardins (honorer les sages épris de simplicité). Le rouleau de soie offert est modeste. Humiliation, mais à la fin, heureuse issue.";
"hex.22.yao.5" = "Le blanc pur pour toute parure. Aucun blâme.";
"hex.23.ci" = "Il n’est pas favorable d’entreprendre.";
"hex.23.daxiang" = "La montagne repose sur la terre : L’Éclatement. Ainsi, ceux d’en haut traitent généreusement ceux d’en bas et assurent la stabilité de leur demeure.";
"hex.23.yao.0" = "Le lit se désagrège à partir des pieds. La juste voie est détruite. Issue funeste.";
"hex.23.yao.1" = "Le lit se désagrège jusqu’à la jonction des pieds et du cadre. La juste voie est détruite. Issue funeste.";
"hex.23.yao.2" = "Au temps de la désagrégation (seul en accord avec le trait yang supérieur), aucun blâme.";
"hex.23.yao.3" = "La désagrégation du lit atteint la peau. Issue funeste.";
"hex.23.yao.4" = "Comme des poissons enfilés, les forces yin avancent en ordre et reçoivent la faveur du roi, telles les femmes du palais. Rien qui ne soit favorable.";
"hex.23.yao.5" = "Le gros fruit reste intact. L’être noble reçoit un char (le soutien du peuple) ; l’homme mesquin détruit sa propre demeure.";
"hex.24.ci" = "Succès. Aller et venir sans maladie. Les amis arrivent : aucun blâme. Le cycle des départs et des retours suit sa loi ; après sept jours vient le retour. Il est favorable d’entreprendre.";
"hex.24.daxiang" = "Le tonnerre au sein de la terre : Le Retour. Ainsi, les anciens rois fermaient les passes au solstice d’hiver ; marchands et voyageurs ne circulaient pas, et le souverain ne visitait pas les régions.";
"hex.24.yao.0" = "Revenir à la juste voie avant de s’en être éloigné. Aucun grand regret. Très heureuse issue.";
"hex.24.yao.1" = "Revenir noblement à la juste voie. Heureuse issue.";
"hex.24.yao.2" = "Revenir sans cesse à la juste voie (selon une autre lecture, y revenir avec affliction). Danger, mais aucun blâme.";
"hex.24.yao.3" = "Au milieu des forces yin, revenir seul à la juste voie.";
"hex.24.yao.4" = "Revenir à la juste voie d’un cœur sincère et généreux. Aucun regret.";
"hex.24.yao.5" = "S’égarer sans savoir revenir. Issue funeste, calamités. Faire marcher l’armée ainsi mène à une grande défaite, entraîne le souverain dans le malheur et empêche toute expédition pendant dix ans.";
"hex.25.ci" = "Grand succès. Il est favorable de persévérer dans la rectitude. S’en écarter attire le malheur ; entreprendre n’est alors pas favorable.";
"hex.25.daxiang" = "Le tonnerre parcourt le monde sous le ciel ; nul être n’ose agir à tort. Ainsi, les anciens rois s’accordaient avec les saisons et nourrissaient tous les êtres.";
"hex.25.yao.0" = "Agir sans égarement. Avancer : heureuse issue.";
"hex.25.yao.1" = "Labourer sans songer d’avance à la récolte, défricher sans escompter une terre déjà féconde (suivre le cours naturel sans anticiper le gain). Alors il est favorable d’entreprendre.";
"hex.25.yao.2" = "Un malheur inattendu : quelqu’un a attaché un bœuf ; un passant l’emporte. Le passant y gagne, mais les habitants sont frappés par les soupçons.";
"hex.25.yao.3" = "Pouvoir persévérer dans la rectitude. Aucun blâme.";
"hex.25.yao.4" = "Une maladie qui ne vient pas d’un égarement. Sans remède, la guérison apporte la joie.";
"hex.25.yao.5" = "Même sans égarement, agir attire le malheur (le temps est arrivé à son terme). Rien de favorable.";
"hex.26.ci" = "Il est favorable de persévérer dans la rectitude. Ne pas se nourrir chez soi (mais recevoir sa subsistance de la cour) : heureuse issue. Il est favorable de traverser le grand fleuve (affronter le risque pour accomplir une entreprise).";
"hex.26.daxiang" = "Le ciel contenu dans la montagne : Le Pouvoir d’apprivoisement du grand. Ainsi, l’être noble étudie largement les paroles et les actes des sages du passé pour nourrir sa vertu.";
"hex.26.yao.0" = "Il y a danger. Il est favorable de s’arrêter.";
"hex.26.yao.1" = "La caisse du char s’est détachée de son support d’essieu ; le char ne peut avancer.";
"hex.26.yao.2" = "De bons chevaux courent et se poursuivent. Il est favorable de persévérer dans la rectitude au milieu des difficultés. S’exercer chaque jour à conduire le char et à se défendre ; il est favorable d’entreprendre.";
"hex.26.yao.3" = "Fixer une traverse aux cornes du jeune taureau pour l’empêcher de blesser. Très heureuse issue.";
"hex.26.yao.4" = "Le porc castré garde ses défenses, mais ne blesse plus. Heureuse issue.";
"hex.26.yao.5" = "Comme la grande voie du ciel est dégagée ! Succès. (Selon une autre lecture : recevoir la grande voie du ciel.)";
"hex.27.ci" = "Persévérer dans la rectitude : heureuse issue. Observer la manière de se nourrir et la façon dont chacun cherche sa propre subsistance.";
"hex.27.daxiang" = "Le tonnerre au pied de la montagne : Les Commissures des lèvres. Ainsi, l’être noble veille à ses paroles et modère ce qu’il mange et boit.";
"hex.27.yao.0" = "Tu délaisses les qualités de ta tortue sacrée (capable de se nourrir sans manger) et me regardes mâcher avec envie. Issue funeste.";
"hex.27.yao.1" = "Chercher sa nourriture en bas inverse l’ordre normal. La chercher sur la haute colline (auprès du trait yang supérieur) : avancer mène à une issue funeste.";
"hex.27.yao.2" = "S’écarter de la juste manière de nourrir. Même avec rectitude, issue funeste. Ne rien entreprendre pendant dix ans. Rien de favorable.";
"hex.27.yao.3" = "Chercher sa nourriture en bas (pour nourrir le monde) : heureuse issue. Fixer le bas comme un tigre, poursuivre sans relâche son désir. Aucun blâme.";
"hex.27.yao.4" = "S’écarter de l’ordre normal (dépendre du trait yang supérieur pour sa subsistance). Demeurer dans la rectitude : heureuse issue. Ne pas traverser le grand fleuve (éviter le risque).";
"hex.27.yao.5" = "Par lui, le monde reçoit sa nourriture. Danger, mais heureuse issue. Il est favorable de traverser le grand fleuve (affronter le risque pour accomplir une entreprise).";
"hex.28.ci" = "La poutre maîtresse ploie. Il est favorable d’entreprendre. Succès.";
"hex.28.daxiang" = "L’eau du lac submerge les arbres : La Prépondérance du grand. Ainsi, l’être noble demeure seul sans crainte et se retire du monde sans amertume.";
"hex.28.yao.0" = "Étendre des herbes blanches sous les offrandes. Aucun blâme.";
"hex.28.yao.1" = "Le peuplier desséché produit de nouveaux bourgeons ; un vieil homme épouse une jeune femme. Rien qui ne soit favorable.";
"hex.28.yao.2" = "La poutre maîtresse ploie. Issue funeste.";
"hex.28.yao.3" = "La poutre maîtresse se redresse, ferme : heureuse issue. D’autres attaches apportent l’humiliation.";
"hex.28.yao.4" = "Le peuplier desséché fleurit ; une vieille femme épouse un jeune homme. Aucun blâme, aucun éloge.";
"hex.28.yao.5" = "S’avancer trop loin dans l’eau, jusqu’à avoir la tête submergée. Issue funeste, mais aucun blâme (agir pour la justice ne mérite pas de reproche).";
"hex.29.ci" = "Dangers sur dangers. Avec sincérité, pourvu que le cœur demeure ouvert, l’action mérite l’estime.";
"hex.29.daxiang" = "L’eau arrive sans cesse : L’Insondable répété. Ainsi, l’être noble reste constant dans sa vertu et s’exerce sans relâche au gouvernement et à l’instruction.";
"hex.29.yao.0" = "Au milieu des dangers répétés, tomber au fond de la fosse. Issue funeste.";
"hex.29.yao.1" = "Dans l’abîme, le danger demeure. Ne rechercher qu’un petit gain.";
"hex.29.yao.2" = "À l’aller comme au retour, des abîmes. Devant, le danger ; derrière, aucun appui sûr. Tomber au fond de la fosse. Ne pas agir.";
"hex.29.yao.3" = "Une cruche de vin, deux écuelles de riz, de simples récipients de terre ; faire passer par la fenêtre ces modestes gages (s’unir par la sincérité). À la fin, aucun blâme.";
"hex.29.yao.4" = "L’eau de l’abîme ne déborde pas ; elle atteint seulement la rive (le terme peut désigner une petite hauteur ou signifier « seulement »). Aucun blâme.";
"hex.29.yao.5" = "Lié de cordes et enfermé au milieu des épines, sans délivrance pendant trois ans. Issue funeste.";
"hex.30.ci" = "Il est favorable de persévérer dans la rectitude. Succès. Élever une vache (image de la vertu docile) : heureuse issue.";
"hex.30.daxiang" = "La lumière se lève deux fois de suite : Ce qui s’attache. Ainsi, le grand homme fait rayonner sans interruption sa lumière dans les quatre directions.";
"hex.30.yao.0" = "Les pas se croisent en désordre. Respect et prudence : aucun blâme.";
"hex.30.yao.1" = "Une lumière jaune qui s’attache (le jaune est la couleur du centre). Très heureuse issue.";
"hex.30.yao.2" = "La lumière du soleil déclinant. Si l’on ne chante pas en frappant une jarre de terre (pour goûter la joie présente), on soupire comme un très vieil homme. Issue funeste.";
"hex.30.yao.3" = "Une arrivée soudaine, un embrasement ; puis la mort et l’abandon.";
"hex.30.yao.4" = "Des larmes à flots, des soupirs de douleur. Heureuse issue.";
"hex.30.yao.5" = "Le roi l’envoie en campagne. Belle victoire : le chef ennemi est décapité ; on ne s’empare pas de la foule de ses partisans (seul le principal coupable est châtié). Aucun blâme.";
"hex.31.ci" = "Succès. Il est favorable de persévérer dans la rectitude. Prendre épouse : heureuse issue. (L’Influence désigne la résonance mutuelle, figurée par l’attirance entre un jeune homme et une jeune femme.)";
"hex.31.daxiang" = "Un lac sur la montagne (elle l’accueille dans son creux) : L’Influence. Ainsi, l’être noble accueille autrui avec un cœur ouvert.";
"hex.31.yao.0" = "L’influence se fait sentir au gros orteil. (Elle naît à peine et reste superficielle ; l’intention se tourne déjà vers l’extérieur.)";
"hex.31.yao.1" = "L’influence atteint le mollet. S’agiter et agir à tort mène à une issue funeste ; demeurer tranquille apporte une heureuse issue.";
"hex.31.yao.2" = "L’influence atteint la cuisse. S’obstiner à suivre autrui : avancer apporte l’humiliation.";
"hex.31.yao.3" = "Persévérer dans la rectitude : heureuse issue, le regret disparaît. Si l’esprit hésite et va sans cesse d’un côté à l’autre, seuls les amis semblables à toi suivront tes pensées. (L’influence reste étroite.)";
"hex.31.yao.4" = "L’influence atteint la chair du dos. Aucun regret. (Elle ne touche pas le cœur ; selon une autre lecture, elle reste faible et superficielle.)";
"hex.31.yao.5" = "L’influence atteint les gencives, les joues et la langue. (Elle ne s’exerce que par les paroles.)";
"hex.32.ci" = "Succès, aucun blâme. Il est favorable de persévérer dans la rectitude et d’entreprendre. (La Durée signifie la constance.)";
"hex.32.daxiang" = "Le tonnerre et le vent s’accompagnent : La Durée. Ainsi, l’être noble se tient dans la rectitude et ne change pas aisément de direction.";
"hex.32.yao.0" = "Exiger d’emblée une constance profonde (creuser trop loin). Même avec rectitude, issue funeste. Rien de favorable.";
"hex.32.yao.1" = "Le regret disparaît. (Le deuxième trait, yang en position souple mais centrale, peut durablement tenir la voie du juste milieu.)";
"hex.32.yao.2" = "Ne pas rester constant dans sa vertu expose à la honte. Même avec rectitude, humiliation.";
"hex.32.yao.3" = "Chasser sans prendre de gibier. (Demeurer longtemps à une place qui ne convient pas : peine perdue.)";
"hex.32.yao.4" = "Demeurer constant dans la vertu de docilité et dans la rectitude : heureuse issue pour la femme, issue funeste pour l’homme.";
"hex.32.yao.5" = "Chercher la constance dans l’agitation (une instabilité incessante). Issue funeste.";
"hex.33.ci" = "Le retrait apporte le succès. Dans les petites affaires, il est favorable de persévérer dans la rectitude. (La Retraite signifie se retirer.)";
"hex.33.daxiang" = "Une montagne sous le ciel (si haute soit-elle, le ciel reste loin) : La Retraite. Ainsi, l’être noble s’éloigne des hommes mesquins, sans haine affichée, mais avec fermeté.";
"hex.33.yao.0" = "Se retirer en dernier : danger. Il ne convient pas d’entreprendre.";
"hex.33.yao.1" = "Le lier solidement avec une lanière de cuir de bœuf jaune : nul ne peut la défaire. (Image d’une volonté ferme ; selon une autre lecture, retenir un sage.)";
"hex.33.yao.2" = "Des attaches empêchent la retraite, comme une maladie ; danger. Entretenir serviteurs et servantes : heureuse issue.";
"hex.33.yao.3" = "Se retirer résolument malgré ses attachements. Heureuse issue pour l’être noble ; l’homme mesquin n’en est pas capable.";
"hex.33.yao.4" = "Se retirer noblement, au bon moment. Persévérer dans la rectitude : heureuse issue.";
"hex.33.yao.5" = "Se retirer avec aisance et sérénité (selon une autre lecture, s’envoler au loin). Rien qui ne soit favorable.";
"hex.34.ci" = "Il est favorable de persévérer dans la rectitude. (La Puissance du grand désigne la vigueur du yang.)";
"hex.34.daxiang" = "Le tonnerre au-dessus du ciel, dans toute sa puissance : La Puissance du grand. Ainsi, l’être noble n’accomplit rien qui soit contraire aux rites.";
"hex.34.yao.0" = "La force se manifeste dans les orteils (impatience d’avancer). Partir en campagne mène à une issue funeste, cela est certain.";
"hex.34.yao.1" = "Persévérer dans la rectitude : heureuse issue.";
"hex.34.yao.2" = "L’homme mesquin use de la force ; l’être noble s’en abstient (selon une autre lecture, il emploie un filet). Même avec rectitude, danger. Le bélier heurte la haie ; ses cornes s’y prennent.";
"hex.34.yao.3" = "Persévérer dans la rectitude : heureuse issue, le regret disparaît. La haie cède, les cornes se dégagent. La force réside dans l’attache d’essieu du grand char (pièce reliant l’essieu à la caisse, solide pour porter et avancer).";
"hex.34.yao.4" = "Perdre le mouton sans s’en apercevoir sur un terrain aisé. Aucun regret. (Selon une autre lecture, il s’agit de la limite d’un champ.)";
"hex.34.yao.5" = "Le bélier heurte la haie ; il ne peut ni reculer ni avancer. Rien de favorable. Reconnaître les difficultés et tenir la rectitude apporte une heureuse issue.";
"hex.35.ci" = "Le prince Kang (prince qui pacifie le pays ; selon une autre lecture, Kang Shu, frère cadet du roi Wu des Zhou) reçoit du roi de nombreux chars et chevaux, et trois audiences en une journée. (Le Progrès signifie l’élévation.)";
"hex.35.daxiang" = "La lumière s’élève au-dessus de la terre : Le Progrès. Ainsi, l’être noble fait lui-même rayonner sa lumineuse vertu.";
"hex.35.yao.0" = "Vouloir avancer, mais être repoussé. Persévérer dans la rectitude : heureuse issue. Sans encore obtenir la confiance, rester serein et patient : aucun blâme.";
"hex.35.yao.1" = "Vouloir avancer, mais être accablé de soucis. Persévérer dans la rectitude : heureuse issue. Recevoir une grande bénédiction de sa grand-mère (figure de la place honorée du cinquième trait yin).";
"hex.35.yao.2" = "Tous accordent leur confiance et leur approbation. Le regret disparaît.";
"hex.35.yao.3" = "Progresser comme un rat (avide et craintif). Même avec rectitude, danger.";
"hex.35.yao.4" = "Le regret disparaît. Ne pas se soucier des gains ni des pertes. Avancer : heureuse issue ; rien qui ne soit favorable.";
"hex.35.yao.5" = "Progresser jusqu’au bout des cornes (la limite extrême). Cela ne convient que pour soumettre sa propre cité (apaiser une révolte intérieure). Danger, mais heureuse issue et aucun blâme. Même avec rectitude, humiliation.";
"hex.36.ci" = "Il est favorable de persévérer dans la rectitude au milieu des difficultés. (L’Obscurcissement de la lumière signifie que la clarté est blessée.)";
"hex.36.daxiang" = "La lumière s’enfonce dans la terre : L’Obscurcissement de la lumière. Ainsi, l’être noble gouverne les hommes en voilant sa clarté au-dehors, tout en gardant son discernement au-dedans.";
"hex.36.yao.0" = "Au temps de la lumière blessée, voler les ailes baissées. L’être noble part en hâte, sans prendre le temps de manger pendant trois jours. En chemin, son hôte lui adresse des reproches.";
"hex.36.yao.1" = "La lumière est blessée, la cuisse gauche est atteinte. Un cheval vigoureux apporte le secours. Heureuse issue.";
"hex.36.yao.2" = "Au temps de la lumière blessée, mener une expédition au sud et capturer le principal coupable. Ne pas vouloir corriger précipitamment les désordres anciens ; procéder par étapes.";
"hex.36.yao.3" = "Entrer dans le côté gauche du ventre (pénétrer à l’intérieur), comprendre la cause de la lumière blessée, puis franchir la porte et partir.";
"hex.36.yao.4" = "Comme Jizi (oncle du roi Zhou des Shang, qui feignit la folie pour échapper au malheur), vivre au temps de la lumière blessée. Il est favorable de persévérer dans la rectitude.";
"hex.36.yao.5" = "Au lieu de briller, s’obscurcir. D’abord monter au ciel, puis tomber sous terre.";
"hex.37.ci" = "La persévérance de la femme dans la rectitude est favorable. (La Famille désigne l’art de gouverner la maison.)";
"hex.37.daxiang" = "Le vent naît du feu (du dedans vers le dehors) : La Famille. Ainsi, l’être noble donne du poids à ses paroles et de la constance à ses actes.";
"hex.37.yao.0" = "Dès le début, établir des règles protectrices dans la maison. Le regret disparaît.";
"hex.37.yao.1" = "Ne pas décider arbitrairement ; veiller aux repas de la maison. Persévérer dans la rectitude : heureuse issue.";
"hex.37.yao.2" = "Une discipline sévère fait gémir la famille. Regret et danger, mais finalement heureuse issue. Si femmes et enfants rient sans mesure, à la fin, humiliation.";
"hex.37.yao.3" = "Rendre la famille prospère. Très heureuse issue.";
"hex.37.yao.4" = "Le roi touche les siens par sa vertu. Ne pas s’inquiéter : heureuse issue.";
"hex.37.yao.5" = "Sincérité jointe à la dignité. À la fin, heureuse issue.";
"hex.38.ci" = "Heureuse issue dans les petites affaires. (L’Opposition signifie la séparation et la divergence.)";
"hex.38.daxiang" = "Le feu en haut, le lac en bas (leurs natures vont en sens contraire) : L’Opposition. Ainsi, l’être noble recherche l’accord essentiel tout en préservant les différences.";
"hex.38.yao.0" = "Le regret disparaît. Le cheval s’est égaré : ne pas le poursuivre, il reviendra de lui-même. Rencontrer l’homme mauvais sans refuser l’entrevue : aucun blâme.";
"hex.38.yao.1" = "Rencontrer son maître dans une ruelle. Aucun blâme.";
"hex.38.yao.2" = "Voir le char retenu, le bœuf empêché d’avancer, le conducteur puni par une marque au front et le nez coupé. Un mauvais commencement, mais une bonne fin.";
"hex.38.yao.3" = "Séparé et seul, rencontrer un homme ferme et vigoureux (le premier trait yang) et s’unir à lui avec sincérité. Danger, mais aucun blâme.";
"hex.38.yao.4" = "Le regret disparaît. S’unir à son parent (le deuxième trait yang) est aussi aisé que mordre une chair tendre. Quel blâme pourrait-il y avoir à avancer ?";
"hex.38.yao.5" = "Séparé et seul, croire voir un porc couvert de boue et un char plein de fantômes (le soupçon crée des visions). D’abord tendre l’arc, puis le détendre : ce ne sont pas des brigands, mais des prétendants. Avancer et rencontrer la pluie (harmonie du yin et du yang) : heureuse issue.";
"hex.39.ci" = "Le sud-ouest est favorable (terrain uni), le nord-est ne l’est pas (terrain périlleux). Il est favorable de voir le grand homme. Persévérer dans la rectitude : heureuse issue. (L’Obstacle désigne la difficulté d’avancer.)";
"hex.39.daxiang" = "L’eau sur la montagne (des obstacles répétés) : L’Obstacle. Ainsi, l’être noble s’examine lui-même et cultive sa vertu.";
"hex.39.yao.0" = "Avancer rencontre l’obstacle ; revenir apporte l’éloge.";
"hex.39.yao.1" = "Le serviteur du roi traverse difficulté sur difficulté pour porter secours, sans agir pour lui-même.";
"hex.39.yao.2" = "Avancer rencontre l’obstacle ; revenir sur ses pas (rejoindre les deux traits yin inférieurs).";
"hex.39.yao.3" = "Avancer rencontre l’obstacle ; revenir pour s’unir aux autres.";
"hex.39.yao.4" = "Dans une grande épreuve, les amis viennent aider.";
"hex.39.yao.5" = "Avancer rencontre l’obstacle ; revenir permet une grande œuvre. Heureuse issue. Il est favorable de voir le grand homme.";
"hex.40.ci" = "Le sud-ouest est favorable. S’il n’y a plus rien à résoudre, revenir apporte une heureuse issue. S’il reste une tâche à accomplir, agir tôt apporte une heureuse issue. (La Libération signifie la délivrance du danger.)";
"hex.40.daxiang" = "Tonnerre et pluie se lèvent : La Libération. Ainsi, l’être noble pardonne les fautes et se montre clément envers les crimes.";
"hex.40.yao.0" = "Aucun blâme.";
"hex.40.yao.1" = "À la chasse, capturer trois renards et obtenir une flèche jaune. Persévérer dans la rectitude : heureuse issue. (Les renards figurent les hommes mesquins ; la flèche jaune, la juste mesure et la droiture.)";
"hex.40.yao.2" = "Porter un fardeau tout en montant en char (un homme mesquin usurpe un rang élevé) attire les brigands. Même avec rectitude, humiliation.";
"hex.40.yao.3" = "Délier son gros orteil (se défaire des hommes mesquins qui s’attachent à soi). Les amis viendront et se montreront sincères.";
"hex.40.yao.4" = "L’être noble délivre du danger : heureuse issue. Le départ des hommes mesquins en est la preuve (selon une autre lecture, il gagne leur confiance).";
"hex.40.yao.5" = "Le prince décoche une flèche sur le faucon perché au sommet du haut rempart et l’atteint. Rien qui ne soit favorable.";
"hex.41.ci" = "Avec sincérité : très heureuse issue, aucun blâme. On peut persévérer dans la rectitude ; il est favorable d’entreprendre. Que présenter en sacrifice ? Deux écuelles de nourriture simple suffisent (vases rituels à millet). La Diminution signifie réduire.";
"hex.41.daxiang" = "Le lac au pied de la montagne (il se diminue pour l’accroître) : La Diminution. Ainsi, l’être noble maîtrise sa colère et réfrène ses désirs.";
"hex.41.yao.0" = "Ses propres affaires achevées, se hâter d’aller aider. Aucun blâme. Mesurer toutefois ce que l’on retranche à ses propres ressources.";
"hex.41.yao.1" = "Il est favorable de persévérer dans la rectitude. Partir en campagne : issue funeste. On peut accroître le bien d’autrui sans se diminuer soi-même.";
"hex.41.yao.2" = "Trois personnes cheminent ensemble : l’une se retire. Une personne chemine seule : elle trouve un compagnon.";
"hex.41.yao.3" = "Diminuer son mal ; une amélioration rapide apporte la joie. Aucun blâme.";
"hex.41.yao.4" = "Quelqu’un lui apporte un bienfait. Même une précieuse tortue valant dix peng (ancienne unité monétaire) ne saurait contredire ce signe favorable. Très heureuse issue.";
"hex.41.yao.5" = "Accroître le bien d’autrui sans se diminuer soi-même. Aucun blâme. Persévérer dans la rectitude : heureuse issue. Il est favorable d’entreprendre. On gagne l’adhésion de sujets de tout le pays, au-delà d’une seule maison.";
"hex.42.ci" = "Il est favorable d’entreprendre et de traverser le grand fleuve (affronter le risque pour accomplir une entreprise). L’Augmentation signifie accroître.";
"hex.42.daxiang" = "Le vent et le tonnerre se soutiennent : L’Augmentation. Ainsi, l’être noble imite le bien qu’il voit et corrige ses fautes.";
"hex.42.yao.0" = "Il est favorable d’accomplir de grandes œuvres. Très heureuse issue, aucun blâme.";
"hex.42.yao.1" = "Quelqu’un lui apporte un bienfait. Même une précieuse tortue valant dix peng ne saurait contredire ce signe. Persévérer durablement dans la rectitude : heureuse issue. Le roi l’emploie au sacrifice au Souverain céleste : heureuse issue.";
"hex.42.yao.2" = "Employer les ressources reçues à secourir dans le malheur. Aucun blâme. Avec sincérité et juste mesure, faire son rapport au prince en tenant la tablette de jade.";
"hex.42.yao.3" = "Agir selon le juste milieu ; faire son rapport au prince et obtenir son accord. Il est favorable de s’appuyer sur l’autorité supérieure pour déplacer la capitale.";
"hex.42.yao.4" = "Un cœur sincère et bienveillant : sans même interroger l’oracle, très heureuse issue. Tous reconnaissent sincèrement mes bienfaits.";
"hex.42.yao.5" = "Nul ne lui apporte de bienfait ; certains l’attaquent. Son cœur manque de constance. Issue funeste.";
"hex.43.ci" = "Proclamer publiquement à la cour royale les méfaits des hommes mesquins. Appeler les hommes avec sincérité ; rester vigilant, car le danger demeure. Avertir d’abord sa propre cité. Prendre aussitôt les armes n’est pas favorable ; entreprendre l’est. (La Percée signifie trancher et éliminer.)";
"hex.43.daxiang" = "L’eau du lac monte au ciel (pour se répandre en pluie) : La Percée. Ainsi, l’être noble distribue ses bienfaits au peuple ; les garder pour soi suscite le ressentiment.";
"hex.43.yao.0" = "La force se porte aux orteils qui veulent avancer. Partir sans pouvoir vaincre devient une faute.";
"hex.43.yao.1" = "Lancer l’alerte avec vigilance. Même si l’ennemi attaque en pleine nuit, ne pas s’inquiéter.";
"hex.43.yao.2" = "Montrer sa force dans les pommettes (laisser paraître sa colère) : issue funeste. L’être noble avance résolument ; seul sous la pluie, il est trempé et suscite l’irritation. À la fin, aucun blâme.";
"hex.43.yao.3" = "Les fesses à vif, marcher péniblement et hésiter. Conduire le mouton (aller avec le troupeau) ferait disparaître le regret ; pourtant, on entend ces paroles sans les croire.";
"hex.43.yao.4" = "Éliminer résolument, comme on arrache le xianlu (herbe tendre qui repousse aisément). Suivre le juste milieu : aucun blâme.";
"hex.43.yao.5" = "Inutile d’appeler encore (personne ne vient au secours). À la fin, issue funeste.";
"hex.44.ci" = "La femme est trop puissante. Il ne convient pas d’épouser une telle femme. (Venir à la rencontre signifie se rencontrer.)";
"hex.44.daxiang" = "Le vent sous le ciel souffle sur tous les êtres : Venir à la rencontre. Ainsi, le souverain publie ses ordres et les fait connaître dans les quatre directions.";
"hex.44.yao.0" = "Attaché à un solide frein de char en métal. Persévérer dans la rectitude : heureuse issue. Avancer expose à une issue funeste, comme une truie maigre qui ne peut manquer de s’agiter (image du yin naissant, déjà remuant).";
"hex.44.yao.1" = "Du poisson dans le paquet (selon une autre lecture, dans la cuisine). Aucun blâme. Il n’est pas favorable de l’offrir aux hôtes.";
"hex.44.yao.2" = "Les fesses à vif, marcher péniblement. Danger, mais aucun grand blâme.";
"hex.44.yao.3" = "Pas de poisson dans le paquet. Se mettre en mouvement mène à une issue funeste.";
"hex.44.yao.4" = "Envelopper le melon de branches et de feuilles de l’arbre qi (le haut protège le bas). Garder sa vertu cachée : les bienfaits descendent du ciel.";
"hex.44.yao.5" = "La rencontre se fait au bout des cornes (à la limite extrême). Humiliation, mais aucun blâme.";
"hex.45.ci" = "Succès. Le roi se rend au temple ancestral pour sacrifier. Il est favorable de voir le grand homme. Succès ; il est favorable de persévérer dans la rectitude. Offrir une grande victime animale : heureuse issue. Il est favorable d’entreprendre. (Le Rassemblement signifie se réunir.)";
"hex.45.daxiang" = "L’eau du lac se rassemble sur la terre : Le Rassemblement. Ainsi, l’être noble entretient les armes et se prépare à l’imprévu.";
"hex.45.yao.0" = "La sincérité ne dure pas jusqu’au bout ; le trouble conduit à se rassembler à tort. Appeler à l’aide : une poignée de main suffit à changer les larmes en rire. Ne pas s’inquiéter ; avancer n’encourt aucun blâme.";
"hex.45.yao.1" = "Se laisser attirer vers l’union : heureuse issue, aucun blâme. Avec sincérité, même un simple sacrifice d’été est favorable.";
"hex.45.yao.2" = "Vouloir se réunir, mais ne faire que soupirer. Rien de favorable. Avancer : aucun blâme, une légère humiliation seulement.";
"hex.45.yao.3" = "Une très heureuse issue est nécessaire pour qu’il n’y ait aucun blâme.";
"hex.45.yao.4" = "Occuper le rang éminent au rassemblement : aucun blâme. Si certains n’ont pas encore confiance, demeurer dans la grande bonté et persévérer durablement dans la rectitude. Le regret disparaît.";
"hex.45.yao.5" = "Soupirer et pleurer, larmes et nez qui coule. Aucun blâme.";
"hex.46.ci" = "Grand succès. Il convient de voir le grand homme ; ne pas s’inquiéter. Une expédition vers le sud apporte une heureuse issue. (La Poussée vers le haut signifie s’élever.)";
"hex.46.daxiang" = "Le bois croît au sein de la terre : La Poussée vers le haut. Ainsi, l’être noble suit la vertu et accumule les petits actes de bonté pour atteindre la grandeur.";
"hex.46.yao.0" = "S’élever grâce à la confiance reçue (selon une autre lecture, progresser). Très heureuse issue.";
"hex.46.yao.1" = "Avec sincérité, même un simple sacrifice d’été est favorable. Aucun blâme.";
"hex.46.yao.2" = "Monter dans une cité vide (sans rencontrer d’obstacle).";
"hex.46.yao.3" = "Le roi offre un sacrifice au mont Qi (berceau de la puissance des Zhou). Heureuse issue, aucun blâme.";
"hex.46.yao.4" = "Persévérer dans la rectitude : heureuse issue. Gravir les marches.";
"hex.46.yao.5" = "Continuer de monter dans l’aveuglement. Il est favorable d’appliquer cette ardeur à une persévérance incessante dans la rectitude.";
"hex.47.ci" = "Succès par la persévérance dans la rectitude. Pour le grand homme, heureuse issue, aucun blâme. Les paroles prononcées ne sont pas crues. (L’Accablement signifie la détresse.)";
"hex.47.daxiang" = "Le lac est sans eau : L’Accablement. Ainsi, l’être noble donne sa vie pour accomplir son aspiration.";
"hex.47.yao.0" = "Les fesses meurtries sur une souche, entrer dans une vallée obscure et ne voir personne pendant trois ans.";
"hex.47.yao.1" = "Accablé au milieu des mets et du vin (selon une autre lecture, privé de nourriture). Un dignitaire au tablier écarlate va venir. Il est favorable d’offrir un sacrifice. Partir en campagne : issue funeste. Aucun blâme.";
"hex.47.yao.2" = "Accablé par la pierre, prendre appui sur les épines. Rentrer chez soi sans y trouver son épouse. Issue funeste.";
"hex.47.yao.3" = "Venir lentement, retenu par un char orné de métal (figure du deuxième trait yang). Humiliation, mais l’affaire trouvera son terme.";
"hex.47.yao.4" = "Le nez et les pieds coupés (accablé en haut comme en bas), opprimé par ceux qui portent le tablier rouge. Peu à peu vient la délivrance. Il est favorable d’offrir un sacrifice.";
"hex.47.yao.5" = "Pris dans les lianes, sur un sol instable. Se dire : « Agir me fera regretter. » Si le repentir est sincère, partir apporte une heureuse issue.";
"hex.48.ci" = "On peut déplacer la cité, mais non le puits. Puiser ne l’épuise pas ; ne pas puiser ne l’accroît pas. Les hommes vont et viennent y prendre de l’eau. La cruche arrive presque au bord, mais se brise avant de sortir du puits : issue funeste.";
"hex.48.daxiang" = "Le seau de bois descend dans l’eau et la remonte : Le Puits. Ainsi, l’être noble réconforte le peuple et l’encourage à l’entraide.";
"hex.48.yao.0" = "Le puits est plein de vase ; son eau ne se boit pas. À ce vieux puits abandonné, même les oiseaux ne viennent plus boire.";
"hex.48.yao.1" = "Dans le creux du puits, on ne peut que viser de petits poissons (selon une autre lecture, des crapauds). La jarre usée fuit ; le puits ne remplit plus son office.";
"hex.48.yao.2" = "Le puits est nettoyé, mais nul ne boit ; mon cœur en est attristé. On pourrait pourtant y puiser. Si le roi est éclairé, tous partageront ses bienfaits.";
"hex.48.yao.3" = "Garnir les parois du puits de pierres ou de briques. Aucun blâme.";
"hex.48.yao.4" = "Le puits est limpide ; l’eau fraîche de la source est bonne à boire.";
"hex.48.yao.5" = "L’eau est puisée. Ne pas couvrir le puits (que tous puissent s’en servir). Avec sincérité : très heureuse issue.";
"hex.49.ci" = "Au jour Ji seulement, on gagne la confiance (selon une autre lecture, une fois la transformation achevée). Grand succès. Il est favorable de persévérer dans la rectitude. Le regret disparaît.";
"hex.49.daxiang" = "Le feu au sein du lac : La Révolution. Ainsi, l’être noble rectifie le calendrier et distingue clairement les saisons.";
"hex.49.yao.0" = "Lier fermement avec du cuir de bœuf jaune (garder la juste mesure et la docilité, sans agir à tort).";
"hex.49.yao.1" = "Au jour Ji seulement, entreprendre la transformation. Avancer : heureuse issue, aucun blâme.";
"hex.49.yao.2" = "Se hâter d’avancer mène à une issue funeste ; s’obstiner à rester comporte aussi un danger. Quand les propositions de transformation ont été débattues à plusieurs reprises et arrêtées, la confiance s’établit.";
"hex.49.yao.3" = "Le regret disparaît. Changer avec sincérité le mandat du ciel (réformer l’ordre ancien). Heureuse issue.";
"hex.49.yao.4" = "Le grand homme transforme comme le tigre renouvelle son pelage, avec un éclat nouveau. Avant même de consulter l’oracle, il a gagné la confiance.";
"hex.49.yao.5" = "L’être noble change comme le léopard renouvelle son pelage ; l’homme mesquin change de visage et se soumet au nouvel ordre. Avancer encore avec témérité : issue funeste. Demeurer dans la rectitude : heureuse issue.";
"hex.50.ci" = "Très heureuse issue. Succès.";
"hex.50.daxiang" = "Le feu brûle au-dessus du bois : Le Chaudron. Ainsi, l’être noble rectifie sa position et reste fidèle à sa mission.";
"hex.50.yao.0" = "Renverser le chaudron, pieds en l’air, permet d’en vider les impuretés. Comme prendre une concubine et obtenir un héritier : aucun blâme.";
"hex.50.yao.1" = "Le chaudron est plein de nourriture. Mon conjoint (selon une autre lecture, mon ennemi) est malade et ne peut m’approcher. Heureuse issue.";
"hex.50.yao.2" = "Les anses du chaudron se défont ou se déforment ; on ne peut le déplacer ni goûter le savoureux bouillon de faisan. Lorsque le yin et le yang s’accordent et que tombe la pluie, le regret diminue. À la fin, heureuse issue.";
"hex.50.yao.3" = "Un pied du chaudron se brise ; le mets du prince se renverse et souille le récipient (selon une autre lecture, une lourde peine est infligée). Issue funeste.";
"hex.50.yao.4" = "Le chaudron a des anses jaunes et une barre de portage en métal. Il est favorable de persévérer dans la rectitude.";
"hex.50.yao.5" = "Le chaudron a une barre de portage en jade. Très heureuse issue ; rien qui ne soit favorable.";
"hex.51.ci" = "Succès. Le tonnerre arrive : effroi et regards inquiets ; puis reviennent les paroles et les rires paisibles. Le tonnerre ébranle cent li, mais l’officiant ne lâche ni la cuiller des offrandes ni le vin parfumé du sacrifice.";
"hex.51.daxiang" = "Le tonnerre se succède : L’Éveilleur. Ainsi, l’être noble, saisi de crainte, se perfectionne et s’examine.";
"hex.51.yao.0" = "Le tonnerre arrive : effroi ; puis reviennent les paroles et les rires paisibles. Heureuse issue.";
"hex.51.yao.1" = "Le tonnerre arrive avec violence : danger. On s’attend à perdre ses cauris (ancienne monnaie) et se réfugie sur les hautes collines. Ne pas les rechercher : après sept jours, ils seront retrouvés.";
"hex.51.yao.2" = "Le tonnerre trouble l’esprit. Agir, averti par la crainte, évite le malheur.";
"hex.51.yao.3" = "Le tonnerre ébranle, mais on reste enlisé dans la boue (incapable de se ressaisir).";
"hex.51.yao.4" = "Le tonnerre va et vient : danger. Pourtant, aucune perte n’est attendue ; on peut préserver sa tâche (selon une autre lecture, le service du sacrifice).";
"hex.51.yao.5" = "Le tonnerre fait trembler et affole le regard. Avancer alors : issue funeste. Prendre ses précautions quand le choc atteint encore le voisin et non soi-même : aucun blâme. Mais le mariage suscite des médisances.";
"hex.52.ci" = "Immobiliser son dos (sans se laisser entraîner par ce que l’on voit), oublier son propre corps. Marcher dans la cour sans se voir les uns les autres. Aucun blâme.";
"hex.52.daxiang" = "Deux montagnes se superposent : L’Immobilisation. Ainsi, l’être noble ne laisse pas ses pensées dépasser les devoirs de sa fonction.";
"hex.52.yao.0" = "Immobiliser les orteils. Aucun blâme. Il est favorable de persévérer durablement dans la rectitude.";
"hex.52.yao.1" = "Immobiliser les mollets, sans pouvoir sauver celui que l’on suit (ni arrêter ses mouvements irréfléchis). Le cœur est mécontent.";
"hex.52.yao.2" = "Immobiliser la taille ; le dos se raidit comme s’il se brisait en deux. Le danger brûle le cœur comme la fumée et le feu.";
"hex.52.yao.3" = "Immobiliser le haut du corps. Aucun blâme.";
"hex.52.yao.4" = "Immobiliser les joues ; parler avec ordre. Le regret disparaît.";
"hex.52.yao.5" = "S’arrêter avec une vertu ferme et sincère. Heureuse issue.";
"hex.53.ci" = "Le mariage de la femme, accompli selon les rites et par étapes, apporte une heureuse issue. Il est favorable de persévérer dans la rectitude.";
"hex.53.daxiang" = "Un arbre croît sur la montagne : Le Développement. Ainsi, l’être noble accumule la vertu et améliore les mœurs.";
"hex.53.yao.0" = "L’oie sauvage approche peu à peu de la rive. Le jeune homme est en danger et subit des reproches. Aucun blâme.";
"hex.53.yao.1" = "L’oie sauvage approche peu à peu du grand rocher. Manger et boire dans la paix et la joie. Heureuse issue.";
"hex.53.yao.2" = "L’oie sauvage approche peu à peu du plateau. Le mari part en campagne et ne revient pas ; la femme enceinte ne peut enfanter. Issue funeste. Il est favorable de résister aux envahisseurs.";
"hex.53.yao.3" = "L’oie sauvage approche peu à peu de l’arbre. Elle trouvera peut-être une branche horizontale pour se poser. Aucun blâme.";
"hex.53.yao.4" = "L’oie sauvage approche peu à peu de la colline. La femme ne conçoit pas pendant trois ans, mais rien ne peut finalement prévaloir sur la juste voie. Heureuse issue.";
"hex.53.yao.5" = "L’oie sauvage atteint peu à peu les hauteurs (selon une autre lecture, la voie des nuages). Ses plumes peuvent servir d’ornements rituels. Heureuse issue.";
"hex.54.ci" = "La jeune femme se marie en dehors des rites justes. Avancer mène à une issue funeste. Rien de favorable.";
"hex.54.daxiang" = "Le tonnerre au-dessus du lac : L’Épousée. Ainsi, l’être noble cherche une union durable et une bonne fin, tout en discernant les défauts qui pourraient apparaître.";
"hex.54.yao.0" = "La jeune femme se marie comme sœur cadette accompagnant l’épouse principale. Tel un boiteux qui peut marcher, avancer apporte une heureuse issue.";
"hex.54.yao.1" = "Tel un borgne qui peut voir. La persévérance dans la rectitude de celui qui vit retiré est favorable.";
"hex.54.yao.2" = "La jeune femme attend, fière de son rang (le terme peut aussi désigner une sœur aînée ou une concubine de rang inférieur). Elle finit par se marier comme sœur cadette accompagnant l’épouse principale.";
"hex.54.yao.3" = "Le mariage de la jeune femme est retardé. Elle attend le moment favorable.";
"hex.54.yao.4" = "Di Yi (roi de la dynastie Shang) donne sa sœur cadette en mariage. La parure de l’épouse principale est moins somptueuse que celle de sa compagne. La lune approche de sa plénitude, sans encore l’atteindre. Heureuse issue.";
"hex.54.yao.5" = "La femme porte une corbeille de bambou vide ; l’homme égorge le mouton sans qu’il saigne (le sacrifice n’aboutit pas). Rien de favorable.";
"hex.55.ci" = "Succès. Le roi atteint cette plénitude. Ne pas s’inquiéter ; il convient d’éclairer le monde comme le soleil à midi.";
"hex.55.daxiang" = "Tonnerre et éclair arrivent ensemble : L’Abondance. Ainsi, l’être noble juge les affaires et applique les peines.";
"hex.55.yao.0" = "Rencontrer un maître qui nous correspond. Même à égalité de rang, aucun blâme. Avancer mérite l’estime.";
"hex.55.yao.1" = "La natte qui obscurcit est si vaste qu’à midi l’on voit la Grande Ourse. Avancer attire soupçons et aversion. Toucher l’autre par la sincérité : heureuse issue.";
"hex.55.yao.2" = "Le rideau qui obscurcit est si vaste qu’à midi l’on voit les petites étoiles. Le bras droit est brisé. Aucun blâme.";
"hex.55.yao.3" = "La natte qui obscurcit est si vaste qu’à midi l’on voit la Grande Ourse. Rencontrer un maître de même vertu : heureuse issue.";
"hex.55.yao.4" = "Faire venir les êtres de talent. Joie et éloges. Heureuse issue.";
"hex.55.yao.5" = "Une grande demeure, mais la maison est entièrement dissimulée. Regarder par la porte : silence, personne. Pendant trois ans, nul ne paraît. Issue funeste.";
"hex.56.ci" = "Petit succès. Pour le voyageur, persévérer dans la rectitude apporte une heureuse issue.";
"hex.56.daxiang" = "Le feu sur la montagne : Le Voyageur. Ainsi, l’être noble applique les peines avec discernement et prudence, sans laisser traîner les procès ni les détentions.";
"hex.56.yao.0" = "Se montrer mesquin et vil en voyage : c’est attirer soi-même le malheur.";
"hex.56.yao.1" = "Le voyageur trouve une auberge, garde son argent et obtient un jeune serviteur fidèle.";
"hex.56.yao.2" = "L’auberge du voyageur brûle ; il perd son jeune serviteur. Persister dans cette situation comporte un danger.";
"hex.56.yao.3" = "Le voyageur trouve un abri provisoire, de l’argent et une hache (selon une autre lecture, des frais de route). Pourtant, mon cœur n’est pas satisfait.";
"hex.56.yao.4" = "Tirer sur un faisan et perdre une flèche. À la fin, recevoir éloges et dignité.";
"hex.56.yao.5" = "Le nid de l’oiseau brûle. Le voyageur rit d’abord, puis pleure à grands cris. Perdre son bœuf à la frontière (selon d’autres lectures, dans le pays de Youyi ou par négligence). Issue funeste.";
"hex.57.ci" = "Petit succès. Il est favorable d’entreprendre et de voir le grand homme, éminent par sa vertu et son rang.";
"hex.57.daxiang" = "Le vent succède au vent : Le Doux. Ainsi, l’être noble réaffirme ses ordres et met en œuvre le gouvernement.";
"hex.57.yao.0" = "Hésiter entre avancer et reculer. Il est favorable de tenir la rectitude avec la résolution d’un guerrier.";
"hex.57.yao.1" = "S’incliner humblement sous le lit. Recourir aux prêtres et aux devins pour exprimer sans cesse sa sincérité aux esprits. Heureuse issue, aucun blâme.";
"hex.57.yao.2" = "Se forcer sans cesse à montrer de la soumission. Humiliation.";
"hex.57.yao.3" = "Le regret disparaît. La chasse procure un gibier varié, destiné à trois usages : les sacrifices, l’accueil des hôtes et la cuisine.";
"hex.57.yao.4" = "Persévérer dans la rectitude : heureuse issue, le regret disparaît. Rien qui ne soit favorable. Un mauvais commencement, mais une bonne fin. Trois jours avant le jour Geng, publier les ordres ; trois jours après, en vérifier les effets. Heureuse issue.";
"hex.57.yao.5" = "S’abaisser excessivement sous le lit et perdre son argent et sa hache (ses appuis et sa capacité de décision). Persister ainsi mène à une issue funeste.";
"hex.58.ci" = "Succès. Il est favorable de persévérer dans la rectitude.";
"hex.58.daxiang" = "Deux lacs se rejoignent : Le Serein. Ainsi, l’être noble discute et étudie avec ses amis.";
"hex.58.yao.0" = "Réjouir autrui par une attitude paisible. Heureuse issue.";
"hex.58.yao.1" = "Réjouir autrui par la sincérité. Heureuse issue ; le regret disparaît.";
"hex.58.yao.2" = "Venir chercher les bonnes grâces d’autrui par la flatterie. Issue funeste.";
"hex.58.yao.3" = "Peser sans cesse à qui plaire, sans trouver la paix. Écarter le mal qui ronge apporte la joie.";
"hex.58.yao.4" = "Faire confiance aux hommes mesquins qui sapent la vigueur du yang. Danger.";
"hex.58.yao.5" = "Attirer les autres dans la recherche du plaisir.";
"hex.59.ci" = "Succès. Le roi se rend au temple ancestral pour sacrifier (rassembler les cœurs dispersés). Il est favorable de traverser le grand fleuve et de persévérer dans la rectitude.";
"hex.59.daxiang" = "Le vent parcourt les eaux : La Dissolution. Ainsi, les anciens rois sacrifiaient au Souverain d’en haut et bâtissaient des temples ancestraux (pour unir les cœurs).";
"hex.59.yao.0" = "Un cheval vigoureux apporte le secours. Heureuse issue.";
"hex.59.yao.1" = "Au temps de la dispersion, courir vers la table où prendre appui (trouver un soutien). Le regret disparaît.";
"hex.59.yao.2" = "Dissoudre son égoïsme. Aucun regret.";
"hex.59.yao.3" = "Dissoudre les clans d’intérêt : très heureuse issue. De cette dispersion naît une union vaste comme une colline, au-delà de ce qu’imaginent les hommes ordinaires.";
"hex.59.yao.4" = "Au temps de la dispersion, répandre de grands ordres comme la sueur se répand sur le corps ; distribuer les réserves du roi (selon une autre lecture, le roi tient sa juste place pour unir les cœurs). Aucun blâme.";
"hex.59.yao.5" = "Dissiper les blessures sanglantes et s’éloigner au loin. Aucun blâme.";
"hex.60.ci" = "Succès. Une limitation trop amère et rigoureuse ne saurait être maintenue durablement.";
"hex.60.daxiang" = "L’eau au-dessus du lac : La Limitation. Ainsi, l’être noble établit rites et mesures et examine la vertu et la conduite.";
"hex.60.yao.0" = "Ne pas sortir de la cour intérieure. Aucun blâme.";
"hex.60.yao.1" = "Ne pas sortir de la cour au-delà du portail, alors qu’il le faudrait. Issue funeste.";
"hex.60.yao.2" = "Sans mesure, viennent les soupirs et le regret : à qui d’autre en faire le reproche ? (Selon une autre lecture, reconnaître sa faute en soupirant écarte le blâme.)";
"hex.60.yao.3" = "Pratiquer la limitation sereinement. Succès.";
"hex.60.yao.4" = "Pratiquer une limitation douce et mesurée. Heureuse issue. Avancer mérite l’estime.";
"hex.60.yao.5" = "Une limitation amère et excessive. Persister mène à une issue funeste ; reconnaître son erreur et se corriger fait disparaître le regret.";
"hex.61.ci" = "La sincérité touche même les porcelets et les poissons (jusqu’aux êtres les plus humbles). Heureuse issue. Il est favorable de traverser le grand fleuve et de persévérer dans la rectitude.";
"hex.61.daxiang" = "Le vent au-dessus du lac : La Vérité intérieure. Ainsi, l’être noble examine les procès avec soin et sursoit aux peines de mort.";
"hex.61.yao.0" = "Demeurer paisiblement dans son devoir (selon une autre lecture, réfléchir ou se préparer) : heureuse issue. Poursuivre d’autres desseins enlève la paix.";
"hex.61.yao.1" = "La grue crie à l’ombre ; ses semblables lui répondent. J’ai du bon vin, que je veux partager avec toi.";
"hex.61.yao.2" = "Rencontrer un adversaire : tantôt battre le tambour pour attaquer, tantôt cesser le combat ; tantôt pleurer, tantôt chanter.";
"hex.61.yao.3" = "La lune approche de sa plénitude. Le cheval perd son compagnon. Aucun blâme.";
"hex.61.yao.4" = "La sincérité unit étroitement les hommes. Aucun blâme.";
"hex.61.yao.5" = "Le chant du coq monte au ciel (la renommée dépasse le mérite réel). Persister ainsi mène à une issue funeste.";
"hex.62.ci" = "Succès. Il est favorable de persévérer dans la rectitude. Les petites affaires conviennent, les grandes non. L’oiseau en vol laisse son cri descendre. Il convient de se poser en bas plutôt que de voler haut. Très heureuse issue.";
"hex.62.daxiang" = "Le tonnerre sur la montagne : La Prépondérance du petit. Ainsi, l’être noble met un peu plus de respect dans sa conduite, de peine dans le deuil et d’économie dans ses dépenses.";
"hex.62.yao.0" = "L’oiseau veut voler haut au lieu de demeurer en bas ; il attire ainsi une issue funeste.";
"hex.62.yao.1" = "Passer au-delà du grand-père et rencontrer la grand-mère ; ne pas dépasser le souverain, mais rencontrer le ministre. Aucun blâme.";
"hex.62.yao.2" = "Ne pas prendre assez de précautions et laisser les choses suivre leur cours expose aux blessures. Issue funeste.";
"hex.62.yao.3" = "Aucun blâme. Sans excès de fermeté, on peut le rencontrer. Avancer est dangereux : rester sur ses gardes. Ne pas persister indéfiniment.";
"hex.62.yao.4" = "Des nuages denses viennent de nos faubourgs occidentaux, sans donner de pluie. Le prince, avec une flèche à corde, capture le gibier caché dans sa tanière.";
"hex.62.yao.5" = "Manquer la rencontre en allant trop loin, comme l’oiseau pris au filet. Issue funeste : voilà le désastre.";
"hex.63.ci" = "Succès dans les petites affaires. Il est favorable de persévérer dans la rectitude. D’abord une heureuse issue, puis le désordre.";
"hex.63.daxiang" = "L’eau au-dessus du feu : Après l’accomplissement. Ainsi, l’être noble réfléchit aux malheurs possibles et les prévient.";
"hex.63.yao.0" = "Retenir la roue du char pour freiner sa marche ; le renard mouille sa queue en traversant le fleuve. Aucun blâme.";
"hex.63.yao.1" = "La femme perd le rideau de son char. Ne pas le chercher ; il sera retrouvé après sept jours.";
"hex.63.yao.2" = "Gaozong (Wu Ding, roi des Shang) attaque les Guifang (peuple du Nord) et ne les soumet qu’après trois ans. Ne pas employer les hommes mesquins.";
"hex.63.yao.3" = "Les beaux vêtements deviennent des haillons (selon une autre lecture, préparer des chiffons pour boucher les voies d’eau du bateau). Rester vigilant tout le jour.";
"hex.63.yao.4" = "Le voisin de l’est sacrifie un bœuf en grande pompe ; il reçoit moins de bienfaits réels que le voisin de l’ouest avec son simple sacrifice d’été.";
"hex.63.yao.5" = "Se mouiller la tête en traversant le fleuve. Danger.";
"hex.64.ci" = "Succès. Le jeune renard est près d’achever la traversée du fleuve, mais mouille sa queue. Rien de favorable.";
"hex.64.daxiang" = "Le feu au-dessus de l’eau : Avant l’accomplissement. Ainsi, l’être noble distingue soigneusement les choses et donne à chacune sa juste place.";
"hex.64.yao.0" = "Mouiller sa queue. Humiliation.";
"hex.64.yao.1" = "Retenir la roue du char (ne pas se hâter d’avancer). Persévérer dans la rectitude : heureuse issue.";
"hex.64.yao.2" = "La traversée n’est pas achevée. Avancer : issue funeste. Il est favorable de traverser le grand fleuve (selon une autre lecture, il faudrait lire « il n’est pas favorable »).";
"hex.64.yao.3" = "Persévérer dans la rectitude : heureuse issue, le regret disparaît. Attaquer les Guifang avec la force du tonnerre ; après trois ans, recevoir les récompenses du grand royaume.";
"hex.64.yao.4" = "Persévérer dans la rectitude : heureuse issue, aucun regret. L’éclat de l’être noble réside dans sa sincérité. Heureuse issue.";
"hex.64.yao.5" = "Boire du vin paisiblement, avec sincérité : aucun blâme. Mais s’y abandonner jusqu’à avoir la tête trempée fait perdre la juste voie, même avec sincérité.";
"hex.1.yong" = "Un groupe de dragons apparaît ; aucun ne cherche à être le chef. Heureuse issue.";
"hex.2.yong" = "Il est favorable de persévérer à jamais dans la rectitude.";
